---
/**
 * Die Knopfzeile unter einem Redaktionstext: ein kurzer Satz, darunter
 * bis zu drei Knöpfe. Jeder Knopf führt irgendwohin — auf eine Seite,
 * zu einem Abschnitt, nach draußen oder zu einer Datei. Genutzt von den
 * Abschnitten (bausteine/Abschnitte.astro) und den Leistungsseiten
 * (pages/leistungen/[id].astro). Bis Oktober 2026 waren es höchstens
 * zwei: ein Verweis und ein PDF-Knopf.
 *
 * Ohne eingetragenen Knopf steht hier nichts — auch kein Satz. Die
 * Gestaltung (`.knopfzeile`) liegt in styles/global.css.
 */
import type { Knopf } from '../content/schema';
import { verweisArt } from '../lib/verweise';

interface Props {
  /** Die Zeile über den Knöpfen, z. B. „Mehr dazu erfahren Sie hier:" */
  satz?: string;
  knoepfe?: Knopf[];
  /** Steht die Zeile für sich (ohne Text darüber), bekommt sie mehr Luft */
  allein?: boolean;
  /** Blendet beim Hereinscrollen ein (scripts/einblenden.ts) */
  rein?: boolean;
}

const { satz = '', knoepfe = [], allein = false, rein = false } = Astro.props;
---

{knoepfe.length > 0 && (
  <div class:list={['knopfzeile', { 'knopfzeile--allein': allein }]} data-rein={rein ? '' : undefined}>
    {satz.trim() !== '' && <p class="knopfzeile__satz">{satz}</p>}
    <div class="knopfzeile__knoepfe">
      {knoepfe.map((k) => {
        const art = verweisArt(k.ziel);
        return (
          <a
            class="kn"
            href={k.ziel}
            download={art === 'datei' ? '' : undefined}
            target={art === 'extern' ? '_blank' : undefined}
            rel={art === 'extern' ? 'noopener' : undefined}
          >
            <span class="kn__f" aria-hidden="true"></span>{k.text}
            {art === 'extern' && <span class="nur-vorleser"> (öffnet in neuem Fenster)</span>}
          </a>
        );
      })}
    </div>
  </div>
)}
