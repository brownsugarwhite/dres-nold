---
/**
 * Hellgraue Trennlinie zwischen zwei Abschnitten der Startseite.
 *
 * Dieselbe Linie wie über den „Vorherige / Nächste"-Knöpfen der
 * aufgeklappten Leistungen — 1 px in `--farbe-linie`, auf Inhaltsbreite.
 * Sie zeichnet sich beim Hereinscrollen aus der Mitte nach außen, in
 * derselben Handschrift wie der Kreis um das Schließen-Kreuz.
 *
 * Einmalig: Wer wieder hochscrollt, sieht sie einfach stehen.
 * Ohne JavaScript und bei `prefers-reduced-motion` steht sie sofort da.
 */
---

<div class="trennlinie" data-trennlinie aria-hidden="true"><span class="trennlinie__strich"></span></div>

<style>
  .trennlinie {
    /* Liegt wie die Abschnitte über dem grauen Symbolgrund */
    position: relative;
    z-index: 40;
    width: 100%;
    background: var(--farbe-flaeche);
    /* Der Abstand gehört zur Linie, nicht zu den Abschnitten — so
       bleibt er überall gleich, egal was darüber und darunter steht. */
    padding-block: var(--abstand-l);
  }

  .trennlinie__strich {
    display: block;
    width: min(100% - 2 * var(--abstand-m), var(--breite-inhalt));
    margin-inline: auto;
    height: 1px;
    background: var(--farbe-linie);
    transform: scaleX(1);
    transform-origin: center;
  }

  /* Erst wenn das Skript übernommen hat, startet die Linie bei null —
     ohne JavaScript bleibt sie schlicht sichtbar. */
  .trennlinie[data-bereit] .trennlinie__strich {
    transform: scaleX(0);
    transition: transform 600ms var(--verlauf-betont);
  }

  .trennlinie[data-gezeichnet] .trennlinie__strich {
    transform: scaleX(1);
  }

  @media (max-width: 767px) {
    .trennlinie { padding-block: var(--abstand-m); }
  }

  @media (prefers-reduced-motion: reduce) {
    .trennlinie[data-bereit] .trennlinie__strich {
      transform: scaleX(1);
      transition: none;
    }
  }
</style>

<script>
  /**
   * Ein Beobachter für alle Linien der Seite. Er meldet jede Linie
   * genau einmal — danach bleibt sie stehen.
   */
  function trennlinienAufbauen() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const linien = [...document.querySelectorAll<HTMLElement>('[data-trennlinie]:not([data-bereit])')];
    if (!linien.length) return;

    const beobachter = new IntersectionObserver((eintraege) => {
      for (const eintrag of eintraege) {
        if (!eintrag.isIntersecting) continue;
        (eintrag.target as HTMLElement).dataset.gezeichnet = 'ja';
        beobachter.unobserve(eintrag.target);
      }
    }, { rootMargin: '0px 0px -15% 0px', threshold: 0 });

    for (const linie of linien) {
      linie.dataset.bereit = 'ja';
      beobachter.observe(linie);
    }
  }

  trennlinienAufbauen();
  document.addEventListener('astro:page-load', trennlinienAufbauen);
</script>
