---
/**
 * Freie Abschnitte im Praxis-Bereich — von der Praxis beliebig anlegbar,
 * ohne eigenen Menüeintrag (docs/entscheidungen.md). Je Abschnitt:
 * Überschrift, Text, optional ein Bild, optional ein Verweis oder ein
 * PDF zum Herunterladen.
 *
 * Die Breite wählt die Redaktion (`breite`):
 *   schmal  46 rem — dieselbe Lesebreite wie eine aufgeklappte Leistung
 *   breit   volle Inhaltsbreite wie der Rest der Startseite
 *
 * Bilder stehen immer über die volle Breite des Abschnitts und ohne
 * abgerundete Ecken. Sie lassen sich in der Redaktion direkt in den
 * Text setzen — dann steht Text darüber und darunter. Das Feld „Bild
 * oben" bleibt für einfache Fälle erhalten.
 */
import daten from '../content/abschnitte.json';

type Breite = 'schmal' | 'breit';

const abschnitte = daten.eintraege
  .filter((e) => e.aktiv && e.titel)
  .sort((a, b) => a.position - b.position)
  .map((e) => ({ ...e, breite: ((e as { breite?: string }).breite || 'schmal') as Breite }));
---

{abschnitte.length > 0 && (
  <div class="abschnitte" id="abschnitte">
    {abschnitte.map((a) => (
      <section class="abschnitt" id={`abschnitt-${a.id}`} data-breite={a.breite}>
        <h2>{a.titel}</h2>
        <div class="abschnitt__koerper">
          {a.bild && (
            <img class="abschnitt__bild" src={a.bild} alt={a.bild_alt || ''} width="900" height="600" loading="lazy" />
          )}
          <div class="abschnitt__inhalt redaktionstext" set:html={a.text} />
          {(a.link_ziel || a.pdf_datei) && (
            <p class="abschnitt__knoepfe">
              {a.link_ziel && (
                <a class="knopf" href={a.link_ziel} rel={/^https?:/.test(a.link_ziel) ? 'noopener' : undefined}>
                  {a.link_text || 'Mehr erfahren'}
                </a>
              )}
              {a.pdf_datei && (
                <a class="knopf knopf--pdf" href={a.pdf_datei} download>
                  {a.pdf_text || 'PDF herunterladen'}
                </a>
              )}
            </p>
          )}
        </div>
      </section>
    ))}
  </div>
)}

<style>
  .abschnitte {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-2xl);
    padding-block: var(--abstand-l);
  }

  /* Die Breite gehört zum Abschnitt, nicht zum Container — so kann jeder
     Abschnitt für sich schmal oder breit stehen. */
  .abschnitt {
    margin-inline: auto;
    width: min(100% - 2 * var(--abstand-m), 46rem);
  }

  .abschnitt[data-breite='breit'] {
    width: min(100% - 2 * var(--abstand-m), var(--breite-inhalt));
  }

  .abschnitt h2 { margin-bottom: var(--abstand-l); }

  .abschnitt__koerper { display: flow-root; }

  /* Bilder stehen über die volle Breite und ohne Rundung — sowohl das
     Feld „Bild oben" als auch Bilder aus dem Text. */
  .abschnitt__bild {
    width: 100%;
    height: auto;
    margin-bottom: var(--abstand-m);
  }

  .abschnitt__inhalt :global(p) { margin-bottom: var(--abstand-s); max-width: none; }
  .abschnitt__inhalt :global(h3) { margin-top: var(--abstand-m); }
  .abschnitt__inhalt :global(ul),
  .abschnitt__inhalt :global(ol) { margin: 0 0 var(--abstand-s); padding-left: var(--abstand-m); }

  .abschnitt__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--abstand-2xs);
    clear: both;
    margin: var(--abstand-s) 0 0;
  }

  .knopf {
    display: inline-block;
    padding: var(--abstand-2xs) var(--abstand-m);
    border: 1px solid var(--farbe-primaer);
    border-radius: var(--radius-rund);
    background: var(--farbe-primaer);
    color: var(--farbe-text-invers);
    font-weight: var(--gewicht-halbfett);
    text-decoration: none;
    transition: background-color var(--dauer-schnell) var(--verlauf), color var(--dauer-schnell) var(--verlauf);
  }

  .knopf:hover,
  .knopf:focus-visible { background: var(--farbe-dunkel); border-color: var(--farbe-dunkel); }

  .knopf--pdf {
    background: var(--farbe-flaeche);
    color: var(--farbe-primaer);
  }

  .knopf--pdf:hover,
  .knopf--pdf:focus-visible { background: var(--farbe-flaeche-gedeckt); color: var(--farbe-primaer); border-color: var(--farbe-primaer); }

  @media (max-width: 767px) {
    .abschnitte { gap: var(--abstand-xl); }
  }
</style>
