---
/**
 * Freie Abschnitte im Praxis-Bereich — von der Praxis beliebig anlegbar,
 * ohne eigenen Menüeintrag (docs/entscheidungen.md).
 *
 * Aufbau (Florian, 17. September 2026)
 * ------------------------------------
 * Ein Abschnitt hat eine Überschrift und darunter einen oder mehrere
 * BEREICHE. Jeder Bereich zeigt ein Bild NEBEN seinem Text — in der
 * Redaktion ist nur zu wählen, ob es links oder rechts steht. Der Text
 * umfließt das Bild nicht mehr.
 *
 * Mehrere Bereiche ergeben einen langen Abschnitt mit mehreren Bildern.
 * Ab dem zweiten Bereich ist eine Zwischenüberschrift sinnvoll.
 *
 * Vorher hatte ein Abschnitt genau ein Bild über dem Text, dazu eine
 * wählbare Breite (schmal / breit). Beides ist entfallen: Der Abschnitt
 * nutzt immer die volle Inhaltsbreite, weil er zwei Spalten trägt.
 *
 * Verweis und PDF-Knopf gelten für den ganzen Abschnitt und stehen im
 * Textteil des letzten Bereichs — bei einem einzelnen Bereich also
 * genau dort, wo der Entwurf sie zeigt.
 */
import daten from '../content/abschnitte.json';

const abschnitte = daten.eintraege
  .filter((e) => e.aktiv && e.titel)
  .sort((a, b) => a.position - b.position);

/** Ohne Bild steht der Text allein — dann braucht es keine zwei Spalten. */
const seite = (b: { bild?: string; bild_seite?: string }) =>
  b.bild ? (b.bild_seite === 'rechts' ? 'rechts' : 'links') : 'ohne';
---

{abschnitte.length > 0 && (
  <div class="abschnitte" id="abschnitte">
    {abschnitte.map((a) => {
      const bereiche = a.bereiche ?? [];
      const knoepfe = a.link_ziel || a.pdf_datei;

      return (
        <section class="abschnitt" id={`abschnitt-${a.id}`}>
          <div class="abschnitt__inhalt">
            <div class="kicker" data-rein>Aus der Praxis</div>
            <h2 class="bereich__titel" data-rein>{a.titel}</h2>

            {bereiche.map((b, i) => (
              <div class="block" data-bild={seite(b)} data-rein>
                {b.bild && (
                  <div class="block__bild">
                    <img src={b.bild} alt={b.bild_alt} width="900" height="675" loading="lazy" />
                  </div>
                )}

                <div class="block__text">
                  {b.titel && <h3 class="block__titel">{b.titel}</h3>}
                  <div class="redaktionstext" set:html={b.text} />

                  {knoepfe && i === bereiche.length - 1 && (
                    <div class="abschnitt__knoepfe">
                      {a.link_ziel && (
                        <a class="kn" href={a.link_ziel} rel={/^https?:/.test(a.link_ziel) ? 'noopener' : undefined}>
                          <span class="kn__f" aria-hidden="true"></span>{a.link_text || 'Mehr erfahren'}
                        </a>
                      )}
                      {a.pdf_datei && (
                        <a class="kn" href={a.pdf_datei} download>
                          <span class="kn__f" aria-hidden="true"></span>{a.pdf_text || 'PDF herunterladen'}
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            ))}

            {/* Abschnitt ohne Bereiche: die Knöpfe stehen dann für sich */}
            {knoepfe && bereiche.length === 0 && (
              <div class="abschnitt__knoepfe abschnitt__knoepfe--allein" data-rein>
                {a.link_ziel && (
                  <a class="kn" href={a.link_ziel} rel={/^https?:/.test(a.link_ziel) ? 'noopener' : undefined}>
                    <span class="kn__f" aria-hidden="true"></span>{a.link_text || 'Mehr erfahren'}
                  </a>
                )}
                {a.pdf_datei && (
                  <a class="kn" href={a.pdf_datei} download>
                    <span class="kn__f" aria-hidden="true"></span>{a.pdf_text || 'PDF herunterladen'}
                  </a>
                )}
              </div>
            )}
          </div>
        </section>
      );
    })}
  </div>
)}

<style>
  .abschnitte {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-abschnitt);
    padding-block: var(--abstand-abschnitt);
    padding-inline: var(--abstand-seitenrand);
  }

  .abschnitt__inhalt {
    width: min(100%, var(--breite-inhalt));
    margin-inline: auto;
  }

  /*
    Ein Bereich: Bild und Text nebeneinander. Welche Spalte das Bild
    bekommt, entscheidet die Redaktion — die Reihenfolge im HTML bleibt
    dieselbe (Bild, dann Text), damit Vorleseprogramme immer dasselbe
    hören.
  */
  .block {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
    margin-top: 48px;
  }

  .block[data-bild='rechts'] {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  }

  .block[data-bild='rechts'] .block__bild { grid-column: 2; grid-row: 1; }
  .block[data-bild='rechts'] .block__text { grid-column: 1; grid-row: 1; }

  /* Ohne Bild: nur Text, auf Lesebreite */
  .block[data-bild='ohne'] { grid-template-columns: minmax(0, 1fr); }
  .block[data-bild='ohne'] .block__text { max-width: 46rem; }

  .block__bild {
    overflow: hidden;
    border-radius: var(--radius-m);
  }

  .block__bild img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .block__text { min-width: 0; }

  .block__titel {
    margin: 0 0 var(--abstand-m);
    font-size: var(--text-titel-klein);
    font-weight: var(--gewicht-leicht);
    line-height: 1.22;
    letter-spacing: -0.011em;
  }

  /* Die Spalte ist schon schmal genug — der Absatz braucht keine
     eigene Höchstbreite mehr. */
  .block__text :global(p) {
    max-width: none;
    margin-bottom: var(--abstand-m);
    font-size: var(--text-flies);
    line-height: var(--zeilenhoehe-lese);
  }

  .block__text :global(p:last-child) { margin-bottom: 0; }

  .abschnitt__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .abschnitt__knoepfe--allein { margin-top: 44px; }

  /* Schmale Schirme: untereinander, Bild immer zuerst */
  @media (max-width: 800px) {
    .block,
    .block[data-bild='rechts'] {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--abstand-m);
      margin-top: 36px;
    }

    .block[data-bild='rechts'] .block__bild,
    .block[data-bild='rechts'] .block__text {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
