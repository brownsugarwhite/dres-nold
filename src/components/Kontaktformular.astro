---
/**
 * Kontaktformular — bewusst schlicht im Inhalt: Name, E-Mail, Telefon
 * (optional), Nachricht, Einverständnis. Es fragt KEINE Gesundheitsdaten
 * ab und darf das auch künftig nicht (CLAUDE.md, Abschnitt Rechtliches).
 *
 * Ohne JavaScript schickt der Browser das Formular normal an
 * /api/kontakt und landet danach wieder hier (?gesendet=1). Mit
 * JavaScript bleibt die Seite stehen und die Antwort erscheint direkt
 * unter dem Formular.
 *
 * Gegen Spam: ein verstecktes Feld, das Menschen nicht ausfüllen
 * (Honigtopf), und eine Mindestdauer zwischen Aufruf und Absenden.
 * Beides prüft functions/api/kontakt.ts.
 *
 * Gestaltung
 * ----------
 * Keine Kästen, kein grauer Grund: Jedes Feld steht auf einer feinen
 * Grundlinie auf Weiß. Beim Hineinklicken zeichnet sich darunter eine
 * zweite Linie in der Hausfarbe von links nach rechts — dieselbe
 * Handschrift wie der Kreis um das Schließen-Kreuz der
 * Leistungsseiten. Die Beschriftung rückt dabei nach oben und wechselt
 * die Farbe.
 *
 * Der Entwurf vom 17. September 2026 sah stattdessen feste Labels über
 * den Feldern vor. Diese Lösung hier bleibt (Florian) — übernommen
 * sind nur die Werte: 17 px Eingabeschrift, hellere Grundlinie
 * (`--farbe-formlinie`), 26 px zwischen den Feldern.
 *
 * Der Sendeknopf ist der Knopf der ganzen Seite (`.kn`). Nach
 * erfolgreichem Versand zeichnet sich ein Kreis mit Haken.
 */
---

<form class="formular" method="post" action="/api/kontakt" data-kontaktformular novalidate>
  <div class="feld">
    <input class="feld__eingabe" id="kontakt-name" name="name" type="text" autocomplete="name" placeholder=" " required maxlength="100" />
    <label class="feld__label" for="kontakt-name">Name</label>
    <span class="feld__linie" aria-hidden="true"></span>
  </div>

  <div class="feldpaar">
    <div class="feld">
      <input class="feld__eingabe" id="kontakt-email" name="email" type="email" autocomplete="email" placeholder=" " required maxlength="200" />
      <label class="feld__label" for="kontakt-email">E-Mail</label>
      <span class="feld__linie" aria-hidden="true"></span>
    </div>

    <div class="feld">
      <input class="feld__eingabe" id="kontakt-telefon" name="telefon" type="tel" autocomplete="tel" placeholder=" " maxlength="40" />
      <label class="feld__label" for="kontakt-telefon">Telefon <span class="feld__zusatz">(optional)</span></label>
      <span class="feld__linie" aria-hidden="true"></span>
    </div>
  </div>

  <div class="feld">
    <textarea class="feld__eingabe feld__eingabe--mehrzeilig" id="kontakt-nachricht" name="nachricht" placeholder=" " required maxlength="5000" rows="5"></textarea>
    <label class="feld__label" for="kontakt-nachricht">Ihre Nachricht</label>
    <span class="feld__linie" aria-hidden="true"></span>
  </div>

  {/* Honigtopf: für Menschen unsichtbar, Roboter füllen es aus */}
  <div class="feld--versteckt" aria-hidden="true">
    <label for="kontakt-website">Website</label>
    <input id="kontakt-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="zeit" value="" data-zeit />

  {/* Ein Hinweis, kein Häkchen: Die Angaben werden verarbeitet, um die
      Anfrage zu beantworten — Rechtsgrundlage ist Art. 6 Abs. 1 lit. b
      bzw. f DSGVO, nicht eine Einwilligung. Art. 13 verlangt hier
      Information, keine Zustimmung; ein Pflichthäkchen wäre sogar die
      schlechtere Grundlage, weil es jederzeit widerrufbar wäre
      (Florian, 18. September 2026). */}
  <p class="datenschutzhinweis">
    Wir verarbeiten Ihre Angaben, um Ihre Anfrage zu beantworten. Näheres
    und Ihre Rechte stehen in der
    <a href="/datenschutz/">Datenschutzerklärung</a>.
  </p>

  <div class="formular__fuss">
    <p class="formular__meldung" data-meldung role="status" aria-live="polite"></p>

    <button class="senden kn kn--voll" type="submit">
      <span class="kn__f" aria-hidden="true"></span>Absenden
    </button>
  </div>

  {/* Erscheint nach erfolgreichem Versand — der Kreis zeichnet sich,
      dann der Haken darin. */}
  <div class="gelungen" data-gelungen hidden>
    <svg class="gelungen__zeichen" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <circle class="gelungen__kreis" cx="24" cy="24" r="22" />
      <path class="gelungen__haken" d="M15 24.5l6 6 12-13" />
    </svg>
    <p class="gelungen__text" data-gelungen-text></p>
  </div>
</form>

<style>
  .formular {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .feld {
    position: relative;
    margin-bottom: 26px;
  }

  /* E-Mail und Telefon teilen sich eine Zeile, solange Platz ist */
  .feldpaar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--abstand-m);
  }

  /* Kein Kasten, keine Rundung, kein Schatten: nur eine Grundlinie. */
  .feld__eingabe {
    display: block;
    width: 100%;
    padding: var(--abstand-m) 0 11px;
    border: 0;
    border-bottom: 1px solid var(--farbe-formlinie);
    border-radius: 0;
    background: none;
    color: var(--farbe-text);
    font-family: var(--schrift);
    font-size: 17px;
    line-height: 1.4;
  }

  .feld__eingabe:focus {
    outline: none;
  }

  .feld__eingabe--mehrzeilig {
    min-height: 8em;
    resize: vertical;
  }

  /* Die zweite Linie zeichnet sich beim Hineinklicken von links nach
     rechts — wie der Kreis um das Schließen-Kreuz. */
  .feld__linie {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--farbe-primaer);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 320ms var(--verlauf-betont), background-color var(--dauer-schnell) var(--verlauf);
  }

  .feld__eingabe:focus ~ .feld__linie {
    transform: scaleX(1);
  }

  /* Ausgefülltes Feld behält eine ruhige, dünnere Linie */
  .feld__eingabe:not(:placeholder-shown) ~ .feld__linie {
    transform: scaleX(1);
    opacity: 0.35;
  }

  .feld__eingabe:focus ~ .feld__linie { opacity: 1; }

  /* Beschriftung steht im Feld und rückt beim Schreiben nach oben —
     so bleibt sie immer sichtbar (anders als ein Platzhalter). */
  .feld__label {
    position: absolute;
    top: var(--abstand-m);
    left: 0;
    color: var(--farbe-text-gedeckt);
    font-family: var(--schrift-titel);
    font-size: 17px;
    pointer-events: none;
    transform-origin: left top;
    transition: transform 260ms var(--verlauf-betont), color 260ms var(--verlauf);
  }

  .feld__zusatz { color: var(--farbe-text-gedeckt); }

  .feld__eingabe:focus + .feld__label,
  .feld__eingabe:not(:placeholder-shown) + .feld__label {
    transform: translateY(-1.55em) scale(0.75);
    color: var(--farbe-primaer);
  }

  .feld--versteckt {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ---------- Datenschutzhinweis ---------- */

  .datenschutzhinweis {
    max-width: none;
    margin: var(--abstand-2xs) 0 var(--abstand-m);
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
    line-height: 1.5;
  }

  /* ---------- Fuß: Meldung und Knopf ---------- */

  .formular__fuss {
    display: flex;
    flex-wrap: wrap;
    gap: var(--abstand-s);
    justify-content: space-between;
    align-items: center;
  }

  .formular__meldung {
    flex: 1 1 14rem;
    margin: 0;
    max-width: none;
    font-size: var(--text-s);
  }

  .formular__meldung:empty { display: none; }
  .formular__meldung[data-art='fehler'] { color: var(--farbe-fehler); }
  .formular__meldung[data-art='erfolg'] { color: var(--farbe-erfolg); }

  /* Der Knopf der ganzen Seite (styles/global.css, `.kn`) — hier nur
     an seinen Platz gerückt. */
  .senden { margin-left: auto; }

  .senden[disabled] {
    opacity: 0.65;
    cursor: wait;
  }

  /* ---------- Bestätigung ---------- */

  .gelungen {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--abstand-s);
    padding-block: var(--abstand-m);
    text-align: center;
  }

  .gelungen[hidden] { display: none; }

  .gelungen__zeichen {
    width: 64px;
    height: 64px;
    fill: none;
    stroke: var(--farbe-primaer);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gelungen__kreis {
    stroke-dasharray: 139;
    stroke-dashoffset: 139;
    transform: rotate(-90deg);
    transform-origin: center;
    transition: stroke-dashoffset 600ms var(--verlauf-betont);
  }

  .gelungen__haken {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    transition: stroke-dashoffset 300ms var(--verlauf-betont) 400ms;
  }

  .gelungen[data-gezeichnet] .gelungen__kreis,
  .gelungen[data-gezeichnet] .gelungen__haken { stroke-dashoffset: 0; }

  .gelungen__text {
    max-width: 28rem;
    margin: 0;
    color: var(--farbe-text);
  }

  /* Ungültige Felder erst nach dem ersten Sendeversuch markieren */
  .formular[data-geprueft] .feld__eingabe:invalid {
    border-bottom-color: var(--farbe-fehler);
  }

  .formular[data-geprueft] .feld__eingabe:invalid ~ .feld__linie {
    background: var(--farbe-fehler);
    transform: scaleX(1);
    opacity: 1;
  }

  @media (max-width: 560px) {
    .feldpaar { grid-template-columns: 1fr; gap: 0; }
    .senden { width: 100%; justify-content: center; margin-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .feld__linie,
    .feld__label,
    .gelungen__kreis,
    .gelungen__haken { transition: none; }
  }
</style>

<script>
  /**
   * Absenden ohne Seitenwechsel. Schlägt etwas fehl, sagt die Meldung
   * in Worten, was zu tun ist — nie nur ein rotes Feld.
   */
  function formularAufbauen() {
    const formular = document.querySelector<HTMLFormElement>('[data-kontaktformular]');
    if (!formular || formular.dataset.bereit) return;
    formular.dataset.bereit = 'ja';

    const meldung = formular.querySelector<HTMLElement>('[data-meldung]')!;
    const zeit = formular.querySelector<HTMLInputElement>('[data-zeit]');
    const knopf = formular.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const gelungen = formular.querySelector<HTMLElement>('[data-gelungen]')!;
    const gelungenText = formular.querySelector<HTMLElement>('[data-gelungen-text]')!;
    const felder = [...formular.querySelectorAll<HTMLElement>('.feld, .feldpaar, .datenschutzhinweis, .formular__fuss')];
    if (zeit) zeit.value = String(Date.now());

    const sagen = (art: 'fehler' | 'erfolg' | '', text: string) => {
      meldung.dataset.art = art;
      meldung.textContent = text;
    };

    /**
     * Nach erfolgreichem Versand treten die Felder zurück und der
     * gezeichnete Haken erscheint. Die Meldung bleibt für Vorlese-
     * programme im `role="status"`-Absatz stehen.
     */
    const bestaetigen = (text: string) => {
      gelungenText.textContent = text;
      gelungen.hidden = false;
      for (const feld of felder) feld.style.display = 'none';
      requestAnimationFrame(() => { gelungen.dataset.gezeichnet = 'ja'; });
    };

    /* Rückkehr ohne JavaScript: /?gesendet=1 bzw. /?fehler=1 */
    const params = new URLSearchParams(location.search);
    if (params.get('gesendet')) {
      sagen('erfolg', 'Danke! Ihre Nachricht ist bei uns angekommen.');
      bestaetigen('Danke! Ihre Nachricht ist bei uns angekommen. Wir melden uns schnellstmöglich.');
    }
    if (params.get('fehler')) sagen('fehler', 'Die Nachricht konnte nicht gesendet werden. Bitte rufen Sie uns an oder schreiben Sie eine E-Mail.');

    formular.addEventListener('submit', async (e) => {
      e.preventDefault();
      formular.dataset.geprueft = 'ja';

      if (!formular.checkValidity()) {
        const erstes = formular.querySelector<HTMLInputElement>(':invalid');
        if (erstes?.type === 'email') sagen('fehler', 'Bitte prüfen Sie Ihre E-Mail-Adresse.');
        else sagen('fehler', 'Bitte füllen Sie Name, E-Mail und Nachricht aus.');
        erstes?.focus();
        return;
      }

      knopf.disabled = true;
      sagen('', 'Wird gesendet …');

      try {
        const daten = Object.fromEntries(new FormData(formular).entries());
        const antwort = await fetch(formular.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(daten),
        });
        const ergebnis = (await antwort.json().catch(() => ({}))) as { ok?: boolean; fehler?: string };

        if (antwort.ok && ergebnis.ok) {
          formular.reset();
          delete formular.dataset.geprueft;
          if (zeit) zeit.value = String(Date.now());
          sagen('erfolg', 'Danke! Ihre Nachricht ist bei uns angekommen.');
          bestaetigen('Danke! Ihre Nachricht ist bei uns angekommen. Wir melden uns schnellstmöglich.');
        } else {
          sagen('fehler', ergebnis.fehler || 'Die Nachricht konnte nicht gesendet werden. Bitte rufen Sie uns an oder schreiben Sie eine E-Mail.');
        }
      } catch {
        sagen('fehler', 'Keine Verbindung. Bitte versuchen Sie es später noch einmal oder rufen Sie uns an.');
      } finally {
        knopf.disabled = false;
      }
    });
  }

  formularAufbauen();
  document.addEventListener('astro:page-load', formularAufbauen);
</script>
