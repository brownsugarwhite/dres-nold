---
/**
 * Kontakt — „So erreichen Sie uns".
 *
 * Aufbau nach dem Handoff vom 17. September 2026:
 *   Kicker, Überschrift, darunter Adresse und Telefon nebeneinander,
 *   dann zweispaltig: links die Karte, rechts das Formular.
 *
 * Die Karte kommt von Google Maps und lädt erst, wenn der Besucher das
 * Vorschaubild anklickt (scripts/einwilligung.ts merkt die Entscheidung
 * im Browser). Vorher steht dort ein selbst gehostetes Bild. Weil bis
 * dahin nichts von fremden Servern geladen wird, braucht die Seite kein
 * Einwilligungs-Banner beim Aufruf — der Hinweis steht dort, wo er
 * gebraucht wird: in der Karte selbst.
 *
 * Kein Schlagschatten an der Karte und kein grauer Kachelgrund hinter
 * dem Bereich (Florian, 17. September 2026) — alles steht auf Weiß.
 *
 * Kein Briefumschlag — der gehörte zu einem früheren Provisorium.
 */
import Kontaktformular from './Kontaktformular.astro';
import seite from '../content/seite.json';
import startseite from '../content/startseite.json';

const texte = startseite.kontakt;
const formulartexte = startseite.formular;
const { praxis } = seite;
const adresse = `${praxis.strasse}, ${praxis.plz} ${praxis.ort}`;
const kartenZiel = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(adresse);
const karteEinbettung = 'https://maps.google.com/maps?q=' + encodeURIComponent(adresse) + '&z=16&hl=de&output=embed';
---

<section class="kontakt bereich bereich--ohne-oben" id="contact" data-verlauf>
  <div class="bereich__inhalt">
    <div class="kicker" data-rein>Kontakt</div>
    <h2 class="bereich__titel" data-rein>{texte.titel}</h2>
    {texte.text && <p class="bereich__einleitung" data-rein>{texte.text}</p>}

    <div class="kontakt__adresse" data-rein>
      <address class="kontakt__spalte">
        <strong class="kontakt__praxis">Praxis {praxis.name.split('–')[0].trim()}</strong><br />
        {praxis.strasse}<br />
        {praxis.plz} {praxis.ort}
      </address>

      <address class="kontakt__spalte">
        Telefon <a href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a><br />
        Fax {praxis.fax}<br />
        <a class="kontakt__mail" href={`mailto:${praxis.email}`}>{praxis.email}</a>
      </address>
    </div>

    <div class="kontakt__inhalt">
      <div class="landkarte" data-rein data-landkarte data-einbettung={karteEinbettung}>
        <div class="landkarte__vorschau" data-landkarte-vorschau>
          <img src="/bilder/deko/karte-vorschau.jpg" alt={`Kartenausschnitt: ${adresse}`} width="1600" height="969" loading="lazy" />
          {/* Der Hinweis steht in der Karte, nicht am Seitenanfang:
              Er gehört genau dorthin, wo die Entscheidung ansteht. */}
          <div class="landkarte__hinweis">
            <p class="landkarte__text">
              Die Karte wird von Google Maps geladen. Dabei erhält Google Ihre IP-Adresse.
            </p>
            <div class="landkarte__knoepfe">
              <button class="kn kn--voll kn--klein" type="button" data-landkarte-laden>
                <span class="kn__f" aria-hidden="true"></span>Karte laden
              </button>
              <a class="tl" href={kartenZiel} target="_blank" rel="noopener">In Maps öffnen</a>
            </div>
          </div>
        </div>
      </div>

      <div class="kontakt__formular" data-rein>
        <div class="kicker kicker--klein">Nachricht</div>
        <h3 class="kontakt__formulartitel verlauf">{formulartexte.titel}</h3>
        {formulartexte.text && <p class="kontakt__formulartext">{formulartexte.text}</p>}
        <Kontaktformular />
      </div>
    </div>
  </div>
</section>

<style>
  .kontakt {
    position: relative;
    z-index: 40;
    width: 100%;
    background: var(--farbe-flaeche);
  }

  /* Adresse und Telefon nebeneinander, mit viel Luft dazwischen;
     wird es eng, rutscht der zweite Block unter den ersten. */
  .kontakt__adresse {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 80px);
    margin-top: 36px;
    color: var(--farbe-text);
    font-size: 17px;
    font-style: normal;
    line-height: 1.75;
  }

  .kontakt__spalte { font-style: normal; }

  .kontakt__praxis {
    font-weight: var(--gewicht-halbfett);
    color: var(--farbe-primaer);
  }

  .kontakt__spalte a {
    color: inherit;
    text-decoration: none;
  }

  .kontakt__spalte a:hover,
  .kontakt__spalte a:focus-visible { text-decoration: underline; }

  .kontakt__spalte a.kontakt__mail {
    font-weight: var(--gewicht-halbfett);
    color: var(--farbe-primaer);
  }

  /* Karte und Formular nebeneinander */
  .kontakt__inhalt {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(28px, 3.5vw, 48px);
    align-items: start;
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* Nur Rahmen und Rundung — kein Schatten (Florian, 17. September 2026) */
  .landkarte {
    position: relative;
    min-height: clamp(300px, 34vw, 470px);
    overflow: hidden;
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius-m);
    background: var(--farbe-flaeche-gedeckt);
  }

  .landkarte__vorschau {
    position: absolute;
    inset: 0;
  }

  .landkarte__vorschau img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Zurückhaltend, damit der Hinweis darüber lesbar bleibt */
    filter: saturate(0.55);
  }

  .landkarte__hinweis {
    position: absolute;
    inset: auto 20px 20px;
    padding: 20px 24px;
    background: rgb(255 255 255 / 94%);
    border-radius: var(--radius-m);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .landkarte__text {
    margin: 0 0 14px;
    max-width: none;
    color: var(--farbe-text);
    font-size: 15px;
    line-height: 1.55;
  }

  .landkarte__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  /* Die geladene Karte füllt den Kasten */
  .landkarte :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .kontakt__formular { min-width: 0; }

  .kontakt__formulartitel {
    margin: 14px 0 0;
    font-size: var(--text-titel-klein);
    font-weight: var(--gewicht-leicht);
    line-height: 1.22;
    letter-spacing: -0.011em;
  }

  .kontakt__formulartext {
    max-width: 30rem;
    margin: 12px 0 30px;
    color: var(--farbe-text-gedeckt);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .kontakt__inhalt { grid-template-columns: 1fr; }
    .landkarte { min-height: 360px; }
  }

  @media (max-width: 560px) {
    .landkarte { min-height: 300px; }
    .landkarte__hinweis { inset: auto 12px 12px; padding: 16px 18px; }
  }
</style>

<script>
  import { lesen, setzen, EREIGNIS } from '../scripts/einwilligung';

  /**
   * Lädt die Google-Karte, sobald die Einwilligung vorliegt — und nimmt
   * sie wieder heraus, wenn sie widerrufen wird.
   */
  function landkarteAufbauen() {
    const kasten = document.querySelector<HTMLElement>('[data-landkarte]');
    if (!kasten || kasten.dataset.bereit) return;
    kasten.dataset.bereit = 'ja';

    const vorschau = kasten.querySelector<HTMLElement>('[data-landkarte-vorschau]');
    const einbettung = kasten.dataset.einbettung || '';
    let rahmen: HTMLIFrameElement | null = null;

    const anwenden = () => {
      const erlaubt = lesen()?.karte === true;
      if (erlaubt && !rahmen) {
        rahmen = document.createElement('iframe');
        rahmen.src = einbettung;
        rahmen.title = 'Google-Maps-Karte: Lage der Praxis';
        rahmen.loading = 'lazy';
        rahmen.referrerPolicy = 'no-referrer-when-downgrade';
        rahmen.setAttribute('allowfullscreen', '');
        kasten.appendChild(rahmen);
        if (vorschau) vorschau.hidden = true;
      } else if (!erlaubt && rahmen) {
        rahmen.remove();
        rahmen = null;
        if (vorschau) vorschau.hidden = false;
      }
    };

    kasten.querySelector('[data-landkarte-laden]')?.addEventListener('click', () => setzen(true));
    document.addEventListener(EREIGNIS, anwenden);
    anwenden();
  }

  landkarteAufbauen();
  document.addEventListener('astro:page-load', landkarteAufbauen);
</script>
