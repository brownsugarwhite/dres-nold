---
/**
 * Kontakt — „So erreichen Sie uns".
 *
 * Ein Band über die volle Breite: dahinter das entsättigte Kartenbild
 * mit dem pulsierenden Punkt an der Praxis, darauf links die Anschrift
 * mit der großen Telefonnummer und den beiden Knöpfen, rechts das
 * Formular auf einer weißen Karte (Entwurf, 18. September 2026).
 *
 * Das eigene Band „Anfahrt" am Seitenfuß ist damit wieder aufgelöst —
 * Karte und Kontakt sind eins.
 *
 * **Die Karte wird nicht mehr eingebettet.** „Karte anzeigen" und
 * „Route planen" sind schlichte Verweise, die Google Maps in einem
 * neuen Fenster öffnen (Florian, 18. September 2026). Damit lädt die
 * Seite nichts mehr von fremden Servern — die Einwilligung ist
 * gegenstandslos geworden.
 *
 * Kein grauer Kachelgrund und kein Briefumschlag (Florian, 17.
 * September 2026). Die Felder des Formulars bleiben, wie sie sind —
 * gefüllte Kästen wie im Entwurf ausdrücklich nicht (Florian).
 */
import Kontaktformular from './Kontaktformular.astro';
import seite from '../content/seite.json';
import startseite from '../content/startseite.json';

const texte = startseite.kontakt;
const formulartexte = startseite.formular;
const { praxis } = seite;
const adresse = `${praxis.strasse}, ${praxis.plz} ${praxis.ort}`;
const kartenZiel = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(adresse);
const routenZiel = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(adresse);
---

<section class="kontakt" id="contact" data-verlauf>
  {/* Der Kartengrund. Rein schmückend — die Anschrift steht daneben im
      Text, deshalb ohne Beschriftung für Vorleseprogramme. */}
  <div class="kontakt__karte" data-karte aria-hidden="true">
    <span class="kontakt__bild"></span>
    <span class="kontakt__toenung"></span>
    <span class="kontakt__schleier"></span>

    {/* Die Marke des Entwurfs: ein Tropfen, der von oben hereinfällt,
        darunter zwei Ringe, die sich nacheinander ausbreiten. Ihre
        Spitze sitzt auf der Praxis. */}
    <span class="kontakt__marke" data-marke>
      <svg viewBox="0 0 52 72" focusable="false">
        <path
          d="M26 1C12.2 1 1 12 1 25.6 1 44.5 26 71 26 71S51 44.5 51 25.6C51 12 39.8 1 26 1Z"
          fill="currentColor" stroke="#ffffff" stroke-width="2"
        />
        <circle cx="26" cy="25.5" r="9.5" fill="#ffffff" />
        <circle cx="26" cy="25.5" r="4.2" fill="currentColor" />
      </svg>
      <span class="kontakt__halo"></span>
      <span class="kontakt__halo kontakt__halo--zwei"></span>
    </span>
  </div>

  {/* Die Zeichnung beruht auf OpenStreetMap-Daten; deren Lizenz (ODbL)
      verlangt die Namensnennung. Unten rechts an der Karte, wie im
      Entwurf. */}
  <p class="kontakt__herkunft">
    Kartengrundlage: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap-Mitwirkende</a>
  </p>

  <div class="kontakt__inhalt">
    <div class="kontakt__text" data-rein>
      <div class="kicker">Kontakt</div>
      <h2 class="kontakt__titel">{texte.titel}</h2>
      {texte.text && <p class="kontakt__einleitung">{texte.text}</p>}

      <a class="kontakt__telefon" href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>

      <address class="kontakt__anschrift">
        <span>{praxis.strasse} · {praxis.plz} {praxis.ort}</span>
        <a class="kontakt__mail" href={`mailto:${praxis.email}`}>{praxis.email}</a>
      </address>

      <p class="kontakt__zusatz">Fax {praxis.fax} · Parkplätze direkt vor der Praxis</p>

      <div class="kontakt__knoepfe">
        <a class="kn kn--voll" href={kartenZiel} target="_blank" rel="noopener">
          <span class="kn__f" aria-hidden="true"></span>Karte anzeigen
        </a>
        <a class="kn" href={routenZiel} target="_blank" rel="noopener">
          <span class="kn__f" aria-hidden="true"></span>Route planen
        </a>
      </div>

      <p class="kontakt__notiz">Beide Knöpfe öffnen Google Maps in einem neuen Fenster.</p>
    </div>

    <div class="kontakt__formular" data-rein>
      <div class="kicker kicker--klein">Nachricht</div>
      <h3 class="kontakt__formulartitel verlauf">{formulartexte.titel}</h3>
      <Kontaktformular hinweis={formulartexte.text} />
    </div>
  </div>
</section>

<style>
  .kontakt {
    position: relative;
    z-index: 40;
    width: 100%;
    overflow: hidden;
    background: var(--farbe-flaeche);
  }

  /*
    Der Kartengrund. Die Zeichnung ist ein eigenes SVG aus
    OpenStreetMap-Daten (Handoff vom 18. September 2026): Straßen,
    Gebäude und Grünflächen, keine Beschriftung, keine fremde Marke —
    und als Vektor auf jedem Schirm scharf. Sie liegt unter
    `public/bilder/deko/`, es wird nichts nachgeladen.

    Die Praxis liegt in der Mitte der Zeichnung; darauf sitzt die Marke.
  */
  .kontakt__karte {
    position: absolute;
    inset: 0;
  }

  /*
    Die Ebene der Zeichnung deckt den Bereich genau — sie liegt auf
    seinen vier Kanten und ist damit immer volle Breite. Verschoben
    wird nicht die Ebene, sondern die Zeichnung DARIN: Ihr Mittelpunkt
    ist die Praxis und liegt unter der Spitze der Marke, wo immer die
    gerade sitzt. Maß und Lage rechnet das Skript unten aus (`--karte-mass`,
    `--karte-lage`) und wählt das Maß dabei so groß, dass die Zeichnung
    auch bei weit außen stehender Marke bis in alle Ecken reicht.

    Ohne JavaScript bleibt es bei `cover` und mittiger Lage — der Punkt
    sitzt dann in der Mitte, wie die Zeichnung selbst.
  */
  .kontakt__bild {
    position: absolute;
    inset: 0;
    display: block;
    background-image: url('/bilder/deko/karte-bietigheim.svg');
    background-repeat: no-repeat;
    background-size: var(--karte-mass, cover);
    background-position: var(--karte-lage, center);
    /* Fährt beim Hereinscrollen ganz leicht heran — das ist der
       Anflug der Entwurfsfassung, nur ohne Karten-Bibliothek. Der
       Bezugspunkt ist die Marke: Die Praxis bleibt beim Anflug stehen,
       alles andere kommt auf sie zu. */
    transform-origin: var(--marke-x, 50%) var(--marke-y, 50%);
    scale: 1.1;
    transition: scale 2.2s cubic-bezier(0.22, 0.61, 0.24, 1);
  }

  .kontakt[data-da] .kontakt__bild { scale: 1; }

  /* Tönung in der Hausfarbe, 4,5 % (Handoff) */
  .kontakt__toenung {
    position: absolute;
    inset: 0;
    background: var(--farbe-primaer);
    opacity: 0.045;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* Weiß von oben nach unten auslaufend — die Stufen aus dem Handoff.
     Unten bleibt die Kante hart (Florian, 18. September 2026). */
  .kontakt__schleier {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      #ffffff 0,
      rgb(255 255 255 / 97%) 12%,
      rgb(255 255 255 / 86%) 30%,
      rgb(255 255 255 / 50%) 55%,
      rgb(255 255 255 / 12%) 80%,
      rgb(255 255 255 / 0) 100%
    );
  }

  @media (max-width: 1040px) {
    .kontakt__schleier {
      background: linear-gradient(
        to bottom,
        #ffffff 0,
        rgb(255 255 255 / 97%) 16%,
        rgb(255 255 255 / 85%) 36%,
        rgb(255 255 255 / 40%) 56%,
        rgb(255 255 255 / 0) 74%
      );
    }
  }

  /* Handys: Der Schleier zieht sich weiter nach oben zusammen, damit
     schon oberhalb des Formulars etwas von der Karte zu sehen ist —
     dort steht die Marke (Florian, 18. September 2026). */
  @media (max-width: 700px) {
    .kontakt__schleier {
      background: linear-gradient(
        to bottom,
        #ffffff 0,
        rgb(255 255 255 / 94%) 7%,
        rgb(255 255 255 / 76%) 18%,
        rgb(255 255 255 / 34%) 34%,
        rgb(255 255 255 / 0) 52%
      );
    }
  }

  /*
    Die Marke des Entwurfs: 52 × 72, die Spitze unten auf der Praxis.
    Sie fällt von oben herein, sobald der Anflug der Karte zu Ende ist
    (2,2 s), und darunter breiten sich zwei Ringe versetzt aus.
  */
  .kontakt__marke {
    position: absolute;
    left: var(--marke-x, 50%);
    top: var(--marke-y, 50%);
    width: 52px;
    height: 72px;
    /* Der Bezugspunkt ist die Spitze, nicht die Mitte */
    translate: -50% -100%;
    transform-origin: 50% 100%;
    color: var(--farbe-primaer);
  }

  .kontakt__marke svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    filter: drop-shadow(0 10px 14px rgb(30 8 22 / 35%));
  }

  /* Erst fliegt die Karte an (2,2 s), dann fällt die Marke */
  .kontakt[data-da] .kontakt__marke svg {
    animation: kontakt-marke-fallen 0.9s cubic-bezier(0.22, 0.61, 0.24, 1) 2.3s both;
  }

  @keyframes kontakt-marke-fallen {
    0% { opacity: 0; transform: translateY(-70px) scale(0.9); }
    60% { opacity: 1; transform: translateY(4px) scale(1.02); }
    80% { transform: translateY(-3px) scale(1); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  .kontakt__halo {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 26px;
    height: 26px;
    margin-left: -13px;
    margin-bottom: -13px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.3);
  }

  .kontakt[data-da] .kontakt__halo {
    animation: kontakt-halo 2.6s cubic-bezier(0.22, 0.61, 0.24, 1) 3.2s infinite;
  }

  .kontakt[data-da] .kontakt__halo--zwei { animation-delay: 4.5s; }

  @keyframes kontakt-halo {
    0% { opacity: 0.7; transform: scale(0.3); }
    100% { opacity: 0; transform: scale(4.5); }
  }

  .kontakt__herkunft {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 1;
    max-width: none;
    margin: 0;
    padding: 3px 10px;
    border-radius: var(--radius-s) 0 0 0;
    background: rgb(255 255 255 / 80%);
    color: var(--farbe-text-gedeckt);
    font-size: 11px;
    line-height: 1.4;
  }

  .kontakt__herkunft a {
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  .kontakt__herkunft a:hover,
  .kontakt__herkunft a:focus-visible { text-decoration: underline; }

  /* ---------- Inhalt ---------- */

  .kontakt__inhalt {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 96px);
    /* Oben bündig statt mittig: Die Anschrift links beginnt auf der
       Höhe der Formularkarte rechts (Florian, 18. September 2026). */
    align-items: start;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    margin-inline: auto;
    padding-block: var(--abstand-abschnitt);
  }

  /* Derselbe Innenabstand wie in der Formularkarte — damit stehen auch
     die beiden Kicker („Kontakt" und „Nachricht") auf einer Linie und
     nicht nur die Kanten der Spalten. */
  .kontakt__text {
    min-width: 0;
    padding-top: clamp(24px, 2.4vw, 36px);
  }

  .kontakt__titel {
    margin: 14px 0 0;
    color: var(--farbe-primaer);
    font-size: var(--text-titel);
    font-weight: var(--gewicht-leicht);
    line-height: 1.08;
    letter-spacing: -0.014em;
  }

  .kontakt__einleitung {
    max-width: 30rem;
    margin: 18px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-lead);
    line-height: var(--zeilenhoehe-lese);
  }

  /* Die Telefonnummer ist das Wichtigste im Bereich — entsprechend groß
     und als Verweis angelegt, damit sie am Handy gleich wählt. */
  .kontakt__telefon {
    display: inline-block;
    margin-top: clamp(28px, 3.5vw, 48px);
    color: var(--farbe-primaer);
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.4rem);
    font-weight: var(--gewicht-leicht);
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity 0.4s var(--verlauf);
  }

  .kontakt__telefon:hover,
  .kontakt__telefon:focus-visible { opacity: 0.7; }

  .kontakt__anschrift {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(18px, 2.5vw, 38px);
    margin-top: 22px;
    color: var(--farbe-text);
    font-size: 17px;
    font-style: normal;
    line-height: 1.5;
  }

  .kontakt__mail {
    color: var(--farbe-primaer);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition: opacity 0.4s var(--verlauf);
  }

  .kontakt__mail:hover,
  .kontakt__mail:focus-visible { opacity: 0.7; }

  .kontakt__zusatz {
    max-width: none;
    margin: 10px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 15px;
    line-height: 1.6;
  }

  .kontakt__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(26px, 3vw, 38px);
  }

  .kontakt__notiz {
    max-width: none;
    margin: 16px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ---------- Die Karte mit dem Formular ---------- */

  /*
    Das Formular steht auf einer eigenen weißen Karte: Es liegt auf dem
    Kartengrund, und nur so bleiben die feinen Linien der Felder
    ablesbar. Der Schatten ist der einzige auf der ganzen Seite — hier
    trägt er die Karte über den Grund, statt sie zu verzieren.
  */
  .kontakt__formular {
    min-width: 0;
    /* Feste Breite statt halber Spalte: So bleiben die Felder in einem
       ruhigen Maß, egal wie breit das Fenster ist (Florian,
       18. September 2026). */
    width: 100%;
    max-width: 480px;
    justify-self: end;
    padding: clamp(24px, 2.4vw, 36px);
    border-radius: var(--radius-l);
    background: var(--farbe-flaeche);
    box-shadow: 0 18px 60px rgb(30 8 22 / 8%);
  }

  .kontakt__formulartitel {
    margin: 12px 0 26px;
    font-size: var(--text-titel-klein);
    font-weight: var(--gewicht-leicht);
    line-height: 1.22;
    letter-spacing: -0.011em;
  }

  @media (max-width: 900px) {
    .kontakt__inhalt {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .kontakt__text { padding-top: 0; }
    .kontakt__formular { justify-self: start; }
  }

  /* Steht die Marke zwischen Knöpfen und Formular (Handys, siehe
     Skript), braucht sie dort Platz — die Reihenlücke wächst dann auf
     ihre Höhe plus Luft (Florian, 18. September 2026). */
  .kontakt[data-marke='unten'] .kontakt__inhalt { row-gap: 128px; }

  @media (max-width: 560px) {
    .kontakt__knoepfe .kn { flex: 1; justify-content: center; white-space: nowrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kontakt__bild,
    .kontakt__telefon,
    .kontakt__mail { transition: none; }
    .kontakt__bild { scale: 1; }
    .kontakt[data-da] .kontakt__marke svg { animation: none; }
    .kontakt__marke svg { opacity: 1; }
    .kontakt[data-da] .kontakt__halo { animation: none; opacity: 0.35; transform: scale(2.2); }
  }
</style>

<script>
  /**
   * Zwei Dinge: wo die Marke steht, und wann der Anflug losgeht.
   *
   * 1. Die Stelle
   *    Die Marke soll auf jeder Bildschirmgröße frei stehen — nicht
   *    hinter der Formularkarte und nicht unter dem Text. Wo das ist,
   *    hängt vom Umbruch ab und wird deshalb gemessen, nicht geraten
   *    (so hält es auch der Entwurf, `freiePosition()`):
   *
   *      nebeneinander   in der Lücke zwischen Text und Formular
   *      gestapelt, breit  rechts neben dem Formular (Tablets)
   *      gestapelt, schmal zwischen den Knöpfen und dem Formular
   *
   *    Die Zeichnung hängt an derselben Stelle (siehe CSS): Ihr
   *    Mittelpunkt ist die Praxis und liegt damit immer genau unter
   *    der Spitze — auf Handys und Tablets ebenso wie auf dem Desktop
   *    (Florian, 18. September 2026).
   *
   * 2. Der Anflug
   *    Sobald ein knappes Drittel des Bereichs im Bild ist, fährt die
   *    Karte von 110 % auf ihre Größe herunter; danach fällt die Marke
   *    herein — dieselbe Choreografie wie der `flyTo` des Entwurfs,
   *    nur ohne Karten-Bibliothek (Handoff, 18. September 2026).
   */
  function karteAufbauen() {
    const bereich = document.querySelector<HTMLElement>('#contact');
    if (!bereich || bereich.dataset.bereit) return;
    bereich.dataset.bereit = 'ja';

    const text = bereich.querySelector<HTMLElement>('.kontakt__text');
    const formular = bereich.querySelector<HTMLElement>('.kontakt__formular');
    const knoepfe = bereich.querySelector<HTMLElement>('.kontakt__knoepfe');

    /** Breite und Höhe der Marke (CSS) — sie darf nirgends anstoßen. */
    const MARKE = { breit: 52, hoch: 72 };

    /** Luft, die links und rechts der Marke frei bleiben soll. */
    const LUFT = 56;

    /**
     * Wie weit der Text WIRKLICH nach rechts reicht.
     *
     * Die Kästen der Absätze laufen über die ganze Spalte, der Satz
     * darin endet aber viel früher. Gemessen wird deshalb der Text
     * selbst (die Zeilenkästen eines Bereichs über den Inhalt), nicht
     * das Element — sonst säße die Marke zu weit rechts (Florian,
     * 18. September 2026).
     */
    const inhaltRechts = (el: HTMLElement): number => {
      let rechts = 0;
      /* Jede Textzeile einzeln: Ein Bereich über das ganze Element
         lieferte für Absätze deren Kasten zurück, und der läuft über
         die volle Spalte. */
      const lauf = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const stelle = document.createRange();
      for (let knoten = lauf.nextNode(); knoten; knoten = lauf.nextNode()) {
        if (!knoten.nodeValue?.trim()) continue;
        stelle.selectNodeContents(knoten);
        for (const zeile of stelle.getClientRects()) {
          if (zeile.width > 0) rechts = Math.max(rechts, zeile.right);
        }
      }
      /* Die Knöpfe sind breiter als ihre Beschriftung — sie zählen mit
         ihrem Kasten. */
      for (const knopf of el.querySelectorAll('a, button')) {
        const k = knopf.getBoundingClientRect();
        if (k.width > 0) rechts = Math.max(rechts, k.right);
      }
      return rechts || el.getBoundingClientRect().right;
    };

    const markeStellen = () => {
      if (!text || !formular) return;
      const b = bereich.getBoundingClientRect();
      const t = text.getBoundingClientRect();
      const f = formular.getBoundingClientRect();
      if (!b.width || !f.width) return;

      /* Stehen die beiden Spalten nebeneinander? */
      const nebeneinander = f.left > t.right + 24;
      /* Bleibt neben dem Formular genug frei für die Marke? */
      const platzRechts = b.right - f.right;

      let x: number;
      let y: number;
      let art: string;

      if (nebeneinander && f.left - inhaltRechts(text) >= MARKE.breit + 2 * LUFT) {
        /* Genug Lücke: die Marke steht mittig zwischen dem Text links
           und der Formularkarte rechts. */
        art = 'breit';
        x = (inhaltRechts(text) + f.left) / 2 - b.left;
        y = f.top + f.height * 0.62 - b.top;
      } else if (nebeneinander) {
        /* Zu eng dazwischen — dann unter die beiden Knöpfe (Florian,
           18. September 2026). Dort ist auf jeder Breite Platz. */
        art = 'unterknoepfe';
        const kn = (knoepfe ?? text).getBoundingClientRect();
        x = (kn.left + kn.right) / 2 - b.left;
        y = t.bottom - b.top + MARKE.hoch + 24;
      } else if (platzRechts > MARKE.breit + 64) {
        art = 'seite';
        x = (f.right + b.right) / 2 - b.left;
        y = f.top + f.height * 0.4 - b.top;
      } else {
        art = 'unten';
        x = b.width * 0.72;
        y = (t.bottom + f.top) / 2 - b.top + MARKE.hoch / 2;
      }

      /* Nie über den Rand hinaus */
      x = Math.max(MARKE.breit, Math.min(b.width - MARKE.breit, x));
      y = Math.max(MARKE.hoch + 8, Math.min(b.height - 16, y));

      bereich.dataset.marke = art;
      bereich.style.setProperty('--marke-x', `${Math.round(x)}px`);
      bereich.style.setProperty('--marke-y', `${Math.round(y)}px`);

      /*
        Maß und Lage der Zeichnung: Ihr Mittelpunkt — die Praxis —
        gehört unter die Spitze der Marke. Verschoben wird die
        Zeichnung, nicht ihre Ebene; die deckt den Bereich ohnehin
        (siehe CSS).

        Das Maß ist so gewählt, dass sie auch nach dem Verschieben bis
        in alle vier Ecken reicht: Vom Mittelpunkt bis zur fernsten
        Kante ist es `max(x, Breite − x)` — das Doppelte davon ist die
        Mindestbreite, senkrecht entsprechend.
      */
      const mass = Math.max(
        b.width / 1920,
        b.height / 1080,
        (2 * Math.max(x, b.width - x)) / 1920,
        (2 * Math.max(y, b.height - y)) / 1080,
      );
      const breit = Math.ceil(1920 * mass);
      const hoch = Math.ceil(1080 * mass);
      bereich.style.setProperty('--karte-mass', `${breit}px ${hoch}px`);
      bereich.style.setProperty('--karte-lage', `${Math.round(x - breit / 2)}px ${Math.round(y - hoch / 2)}px`);
    };

    /* Die Reihenlücke hängt ihrerseits von `data-marke` ab — deshalb
       zweimal messen: Der zweite Durchgang sieht die neue Lücke. */
    const messen = () => { markeStellen(); markeStellen(); };

    messen();
    requestAnimationFrame(messen);
    window.addEventListener('resize', messen, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(messen).observe(bereich);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      bereich.dataset.da = 'ja';
      return;
    }

    const beobachter = new IntersectionObserver((eintraege) => {
      if (!eintraege.some((e) => e.isIntersecting)) return;
      bereich.dataset.da = 'ja';
      beobachter.disconnect();
    }, { threshold: 0.3 });

    beobachter.observe(bereich);
  }

  karteAufbauen();
  document.addEventListener('astro:page-load', karteAufbauen);
</script>
