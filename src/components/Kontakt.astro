---
/**
 * Kontakt — „So erreichen Sie uns".
 *
 * Ein Band über die volle Breite: dahinter das entsättigte Kartenbild
 * mit dem pulsierenden Punkt an der Praxis, darauf links die Anschrift
 * mit der großen Telefonnummer und den beiden Knöpfen, rechts das
 * Formular auf einer weißen Karte (Entwurf, 18. September 2026).
 *
 * Das eigene Band „Anfahrt" am Seitenfuß ist damit wieder aufgelöst —
 * Karte und Kontakt sind eins.
 *
 * **Die Karte wird nicht mehr eingebettet.** „Karte anzeigen" und
 * „Route planen" sind schlichte Verweise, die Google Maps in einem
 * neuen Fenster öffnen (Florian, 18. September 2026). Damit lädt die
 * Seite nichts mehr von fremden Servern — die Einwilligung ist
 * gegenstandslos geworden.
 *
 * Kein grauer Kachelgrund und kein Briefumschlag (Florian, 17.
 * September 2026). Die Felder des Formulars bleiben, wie sie sind —
 * gefüllte Kästen wie im Entwurf ausdrücklich nicht (Florian).
 */
import Kontaktformular from './Kontaktformular.astro';
import seite from '../content/seite.json';
import startseite from '../content/startseite.json';

const texte = startseite.kontakt;
const formulartexte = startseite.formular;
const { praxis } = seite;
const adresse = `${praxis.strasse}, ${praxis.plz} ${praxis.ort}`;
const kartenZiel = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(adresse);
const routenZiel = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(adresse);
---

<section class="kontakt" id="contact" data-verlauf>
  {/* Der Kartengrund. Rein schmückend — die Anschrift steht daneben im
      Text, deshalb ohne Beschriftung für Vorleseprogramme. */}
  <div class="kontakt__karte" data-karte aria-hidden="true">
    <span class="kontakt__bild"></span>
    <span class="kontakt__toenung"></span>
    <span class="kontakt__schleier"></span>

    {/* Die Marke des Entwurfs: ein Tropfen, der von oben hereinfällt
        und beim Aufsetzen einen kurzen Bodenschatten wirft, darunter
        zwei Ringe, die sich nacheinander ausbreiten. Ihre Spitze sitzt
        auf der Praxis. */}
    <span class="kontakt__marke" data-marke>
      {/* Der Bodenschatten steht VOR dem Tropfen im Baum, damit er
          unter dessen Spitze gemalt wird und nicht darüber. */}
      <span class="kontakt__aufsetzer"></span>
      {/* `overflow="visible"`: Der weiße Saum an der Spitze ragt ein paar
          Zehntel über den Zeichenkasten hinaus und wurde sonst abgeschnitten. */}
      <svg viewBox="0 0 52 72" overflow="visible" focusable="false">
        <path
          d="M26 1C12.2 1 1 12 1 25.6 1 44.5 26 71 26 71S51 44.5 51 25.6C51 12 39.8 1 26 1Z"
          fill="currentColor" stroke="#ffffff" stroke-width="2"
        />
        <circle cx="26" cy="25.5" r="9.5" fill="#ffffff" />
        <circle cx="26" cy="25.5" r="4.2" fill="currentColor" />
      </svg>
      <span class="kontakt__halo"></span>
      <span class="kontakt__halo kontakt__halo--zwei"></span>
    </span>
  </div>

  {/* Die Zeichnung beruht auf OpenStreetMap-Daten; deren Lizenz (ODbL)
      verlangt die Namensnennung. Unten rechts an der Karte, wie im
      Entwurf. */}
  <p class="kontakt__herkunft">
    Kartengrundlage: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap-Mitwirkende</a>
  </p>

  <div class="kontakt__inhalt">
    <div class="kontakt__text" data-rein>
      <div class="kicker">Kontakt</div>
      <h2 class="kontakt__titel">{texte.titel}</h2>
      {texte.text && <p class="kontakt__einleitung">{texte.text}</p>}

      <a class="kontakt__telefon" href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>

      <address class="kontakt__anschrift">
        <span>{praxis.strasse} · {praxis.plz} {praxis.ort}</span>
        <a class="kontakt__mail" href={`mailto:${praxis.email}`}>{praxis.email}</a>
      </address>

      <p class="kontakt__zusatz">Fax {praxis.fax} · Parkplätze direkt vor der Praxis</p>

      <div class="kontakt__knoepfe">
        <a class="kn kn--voll" href={kartenZiel} target="_blank" rel="noopener">
          <span class="kn__f" aria-hidden="true"></span>Karte anzeigen
        </a>
        <a class="kn" href={routenZiel} target="_blank" rel="noopener">
          <span class="kn__f" aria-hidden="true"></span>Route planen
        </a>
      </div>

      <p class="kontakt__notiz">Beide Knöpfe öffnen Google Maps in einem neuen Fenster.</p>
    </div>

    <div class="kontakt__formular" data-rein>
      <div class="kicker kicker--klein">Nachricht</div>
      <h3 class="kontakt__formulartitel verlauf">{formulartexte.titel}</h3>
      <Kontaktformular hinweis={formulartexte.text} />
    </div>
  </div>
</section>

<style>
  .kontakt {
    position: relative;
    z-index: 40;
    width: 100%;
    overflow: hidden;
    /* Der Grundton der Zeichnung selbst — ihr eigener Randverlauf läuft
       auf genau dieses Grau aus. Nebeneinander deckt die Zeichnung den
       Bereich, und der Grund ist nie zu sehen; gestapelt ist sie
       kleiner als der Bereich und läuft weich in ihn aus (siehe die
       Maske unten). */
    background: var(--farbe-karte-grund);
  }

  /*
    Der Kartengrund. Die Zeichnung ist ein eigenes SVG aus
    OpenStreetMap-Daten (Handoff vom 18. September 2026): Straßen,
    Gebäude und Grünflächen, keine Beschriftung, keine fremde Marke —
    und als Vektor auf jedem Schirm scharf. Sie liegt unter
    `public/bilder/deko/`, es wird nichts nachgeladen.

    Die Praxis liegt in der Mitte der Zeichnung; darauf sitzt die Marke.
  */
  .kontakt__karte {
    position: absolute;
    inset: 0;
  }

  /*
    Die Ebene der Zeichnung deckt den Bereich genau — sie liegt auf
    seinen vier Kanten und ist damit immer volle Breite. Verschoben
    wird nicht die Ebene, sondern die Zeichnung DARIN: Die Praxis liegt
    unter der Spitze der Marke, wo immer die gerade sitzt. Maß und Lage
    rechnet das Skript unten aus (`--karte-mass`, `--karte-lage`).
    Nebeneinander wählt es das Maß so groß, dass die Zeichnung auch bei
    weit außen stehender Marke bis in alle Ecken reicht; gestapelt (bis
    900 px) steht eine HOCHKANTE Zeichnung (siehe unten im Umbruch),
    die bis zum unteren Rand reicht und über eine Maske weich in den
    Grund ausläuft.

    Ohne JavaScript bleibt es bei `cover` und mittiger Lage — der Punkt
    sitzt dann in der Mitte, wie die Zeichnung selbst.
  */
  .kontakt__bild {
    position: absolute;
    inset: 0;
    display: block;
    background-image: url('/bilder/deko/karte-bietigheim.svg');
    background-repeat: no-repeat;
    background-size: var(--karte-mass, cover);
    background-position: var(--karte-lage, center);
    /* Der Anflug: Beim Hereinscrollen zoomt die Zeichnung von ihrer
       deckenden Größe (100 %) auf 150 % heran — am Scrollweg, nicht an
       der Uhr; das Skript unten schreibt `--karte-zoom`. Der Bezugspunkt
       ist die Marke: Die Praxis bleibt beim Anflug stehen, alles andere
       kommt auf sie zu. Weil das Maß (unten) den Bereich schon bei 100 %
       deckt und der Bezugspunkt darin liegt, bleibt er beim Vergrößern
       in jeder Phase gedeckt — keine Kante, nie (Florian, 27. September
       2026). Ohne Skript steht die Zeichnung still auf 100 %. */
    transform-origin: var(--marke-x, 50%) var(--marke-y, 50%);
    scale: var(--karte-zoom, 1);
  }

  /* Tönung in der Hausfarbe, 4,5 % (Handoff) */
  .kontakt__toenung {
    position: absolute;
    inset: 0;
    background: var(--farbe-primaer);
    opacity: 0.045;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* Weiß von oben nach unten auslaufend — die Stufen aus dem Handoff.
     Unten bleibt die Kante hart (Florian, 18. September 2026). */
  .kontakt__schleier {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      #ffffff 0,
      rgb(255 255 255 / 97%) 12%,
      rgb(255 255 255 / 86%) 30%,
      rgb(255 255 255 / 50%) 55%,
      rgb(255 255 255 / 12%) 80%,
      rgb(255 255 255 / 0) 100%
    );
  }

  @media (max-width: 1040px) {
    .kontakt__schleier {
      background: linear-gradient(
        to bottom,
        #ffffff 0,
        rgb(255 255 255 / 97%) 16%,
        rgb(255 255 255 / 85%) 36%,
        rgb(255 255 255 / 40%) 56%,
        rgb(255 255 255 / 0) 74%
      );
    }
  }

  /* Handys: Der Schleier zieht sich weiter nach oben zusammen, damit
     schon oberhalb des Formulars etwas von der Karte zu sehen ist —
     dort steht die Marke (Florian, 18. September 2026). */
  @media (max-width: 700px) {
    .kontakt__schleier {
      background: linear-gradient(
        to bottom,
        #ffffff 0,
        rgb(255 255 255 / 94%) 7%,
        rgb(255 255 255 / 76%) 18%,
        rgb(255 255 255 / 34%) 34%,
        rgb(255 255 255 / 0) 52%
      );
    }
  }

  /*
    Die Marke des Entwurfs: 52 × 72, die Spitze unten auf der Praxis.
    Sie fällt herein, sobald der Anflug zu gut der Hälfte geschafft ist
    (`data-da`, siehe Skript): 0,6 s von oben, setzt kurz durch und
    federt zurück. Beim Aufsetzen wirft sie einen kleinen Bodenschatten,
    und darunter breiten sich zwei Ringe versetzt aus.
  */
  .kontakt__marke {
    position: absolute;
    left: var(--marke-x, 50%);
    top: var(--marke-y, 50%);
    width: 52px;
    height: 72px;
    /* Der Bezugspunkt ist die Spitze, nicht die Mitte */
    translate: -50% -100%;
    transform-origin: 50% 100%;
    color: var(--farbe-primaer);
  }

  .kontakt__marke svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    filter: drop-shadow(0 8px 12px rgb(30 8 22 / 30%));
  }

  .kontakt[data-da] .kontakt__marke svg {
    animation: kontakt-marke-fallen 0.6s var(--verlauf-betont) both;
  }

  /* Fallen, 4 px durchsetzen, zurückfedern */
  @keyframes kontakt-marke-fallen {
    0% { opacity: 0; transform: translateY(-56px) scale(0.92); }
    65% { opacity: 1; transform: translateY(4px) scale(1.03); }
    85% { transform: translateY(-2px) scale(0.995); }
    100% { opacity: 1; transform: none; }
  }

  /* Der Bodenschatten: eine flache Ellipse unter der Spitze, die im
     Moment des Aufsetzens aufblitzt und dann leicht zurücknimmt. */
  .kontakt__aufsetzer {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 26px;
    height: 9px;
    margin: 0 0 -4px -13px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(30 8 22 / 30%), rgb(30 8 22 / 0));
    opacity: 0;
    transform: scale(0.4);
  }

  .kontakt[data-da] .kontakt__aufsetzer {
    animation: kontakt-aufsetzen 0.6s var(--verlauf-betont) both;
  }

  /* Bis 45 % nichts — so lange ist die Marke noch in der Luft */
  @keyframes kontakt-aufsetzen {
    0%, 45% { opacity: 0; transform: scale(0.4); }
    70% { opacity: 1; transform: scale(1.15); }
    100% { opacity: 0.9; transform: scale(1); }
  }

  .kontakt__halo {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 26px;
    height: 26px;
    margin-left: -13px;
    margin-bottom: -13px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.3);
  }

  /* Die Ringe setzen ein, sobald die Marke aufgesetzt hat (bei 0,55 s
     von 0,6), und laufen um eine halbe Runde versetzt. */
  .kontakt[data-da] .kontakt__halo {
    animation: kontakt-halo 2.4s var(--verlauf-betont) 0.55s infinite;
  }

  .kontakt[data-da] .kontakt__halo--zwei { animation-delay: 1.75s; }

  @keyframes kontakt-halo {
    0% { opacity: 0.7; transform: scale(0.3); }
    100% { opacity: 0; transform: scale(4.5); }
  }

  .kontakt__herkunft {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 1;
    max-width: none;
    margin: 0;
    padding: 3px 10px;
    border-radius: var(--radius-s) 0 0 0;
    background: rgb(255 255 255 / 80%);
    color: var(--farbe-text-gedeckt);
    font-size: 11px;
    line-height: 1.4;
  }

  .kontakt__herkunft a {
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  .kontakt__herkunft a:hover,
  .kontakt__herkunft a:focus-visible { text-decoration: underline; }

  /* ---------- Inhalt ---------- */

  .kontakt__inhalt {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 96px);
    /* Oben bündig statt mittig: Die Anschrift links beginnt auf der
       Höhe der Formularkarte rechts (Florian, 18. September 2026). */
    align-items: start;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    margin-inline: auto;
    padding-block: var(--abstand-abschnitt);
  }

  /* Derselbe Innenabstand wie in der Formularkarte — damit stehen auch
     die beiden Kicker („Kontakt" und „Nachricht") auf einer Linie und
     nicht nur die Kanten der Spalten. */
  .kontakt__text {
    min-width: 0;
    padding-top: clamp(24px, 2.4vw, 36px);
  }

  .kontakt__titel {
    margin: 14px 0 0;
    color: var(--farbe-primaer);
    font-size: var(--text-titel);
    font-weight: var(--gewicht-titel);
    line-height: 1.08;
    letter-spacing: -0.011em;
  }

  .kontakt__einleitung {
    max-width: var(--breite-absatz);
    margin: 18px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-lead);
    line-height: var(--zeilenhoehe-lese);
  }

  /* Die Telefonnummer ist das Wichtigste im Bereich — entsprechend groß
     und als Verweis angelegt, damit sie am Handy gleich wählt. */
  .kontakt__telefon {
    display: inline-block;
    margin-top: clamp(28px, 3.5vw, 48px);
    color: var(--farbe-primaer);
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.4rem);
    font-weight: var(--gewicht-leicht);
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity 0.4s var(--verlauf);
  }

  .kontakt__telefon:hover,
  .kontakt__telefon:focus-visible { opacity: 0.7; }

  .kontakt__anschrift {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(18px, 2.5vw, 38px);
    margin-top: 22px;
    color: var(--farbe-text);
    font-size: 17px;
    font-style: normal;
    line-height: 1.5;
  }

  .kontakt__mail {
    color: var(--farbe-primaer);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition: opacity 0.4s var(--verlauf);
  }

  .kontakt__mail:hover,
  .kontakt__mail:focus-visible { opacity: 0.7; }

  .kontakt__zusatz {
    max-width: none;
    margin: 10px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 15px;
    line-height: 1.6;
  }

  .kontakt__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(26px, 3vw, 38px);
  }

  .kontakt__notiz {
    max-width: none;
    margin: 16px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 15px;
    line-height: 1.6;
  }

  /* ---------- Die Karte mit dem Formular ---------- */

  /*
    Das Formular steht auf einer eigenen weißen Karte: Es liegt auf dem
    Kartengrund, und nur so bleiben die feinen Linien der Felder
    ablesbar. Der Schatten ist der einzige auf der ganzen Seite — hier
    trägt er die Karte über den Grund, statt sie zu verzieren.
  */
  .kontakt__formular {
    min-width: 0;
    /* Feste Breite statt halber Spalte: So bleiben die Felder in einem
       ruhigen Maß, egal wie breit das Fenster ist (Florian,
       18. September 2026). */
    width: 100%;
    max-width: 480px;
    justify-self: end;
    padding: clamp(24px, 2.4vw, 36px);
    border-radius: var(--radius-l);
    background: var(--farbe-flaeche);
    box-shadow: 0 18px 60px rgb(30 8 22 / 8%);
  }

  .kontakt__formulartitel {
    margin: 12px 0 26px;
    font-size: var(--text-titel-klein);
    font-weight: var(--gewicht-titel);
    line-height: 1.22;
    letter-spacing: -0.009em;
  }

  @media (max-width: 900px) {
    .kontakt__inhalt {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .kontakt__text { padding-top: 0; }
    .kontakt__formular { justify-self: start; }

    /* Gestapelt steht die Zeichnung in festem Maß (siehe Skript,
       `MASS_SCHMAL`) und ist damit kleiner als der Bereich. Ihr eigener
       Randverlauf lässt an der Kante noch 15 % durch — die rechteckige
       Kante wäre zu sehen. Die Maske lässt sie deshalb ringsum
       auslaufen: bis zur Hälfte voll, dann bis zur Kante auf nichts.
       Maß und Lage sind die der Zeichnung, damit die Ellipse mit ihr
       wandert. Ohne Skript bleibt beides `cover`, und die Ellipse
       liegt auf dem Bereich selbst. Die `-webkit-`-Fassung braucht
       Safari bis 15 (Florian, 26. September 2026). */
    .kontakt__bild {
      /* Die hochkante Zeichnung (scripts/karte-zeichnen.mjs): dieselbe
         Karte, aber 1080 × 1646 mit der Praxis im oberen Drittel — sie
         reicht unter der Marke gut 1100 Bildpunkte weit nach unten.
         Mit dem 16:9-Bild blieb unter dem Formular nur der leere Grund
         (Florian, 26. September 2026). */
      background-image: url('/bilder/deko/karte-bietigheim-hoch.svg');
      /* Voll bis 75 % der Achsen (vorher 50): Seit der Anflug deckend
         beginnt und das Startmaß gestapelt kleiner ist, läge die linke
         Kante des Bereichs sonst schon im Verlauf (bei 375 px: 270 px
         von der Mitte, der Verlauf begänne bei 185). Mit 75 % beginnt
         er bei 278 — und unten, wo das Formular steht, bleibt die
         Zeichnung am Ende des Anflugs fast satt statt halb (Florian,
         27. September 2026). */
      -webkit-mask-image: radial-gradient(ellipse farthest-side at center, #000 75%, transparent 100%);
      -webkit-mask-size: var(--karte-mass, cover);
      -webkit-mask-position: var(--karte-lage, center);
      -webkit-mask-repeat: no-repeat;
      mask-image: radial-gradient(ellipse farthest-side at center, #000 75%, transparent 100%);
      mask-size: var(--karte-mass, cover);
      mask-position: var(--karte-lage, center);
      mask-repeat: no-repeat;
    }
  }

  /* Steht die Marke zwischen Knöpfen und Formular (Handys, siehe
     Skript), braucht sie dort Platz — die Reihenlücke wächst dann auf
     ihre Höhe plus Luft (Florian, 18. September 2026). */
  /* Die Marke steht in der Lücke zwischen Knöpfen und Formular — die
     Lücke ist so hoch, dass rundherum Karte zu sehen ist und die Marke
     nicht am Formular klebt (220 px; vorher 128, Florian, 26. September
     2026). */
  .kontakt[data-marke='unten'] .kontakt__inhalt { row-gap: 220px; }

  /* … und die Formularkarte nimmt dann die ganze Breite: Sie steht
     unter der Marke, nicht neben ihr — das feste Maß von 480 px ließe
     rechts nur einen leeren Streifen (Florian, 26. September 2026). */
  .kontakt[data-marke='unten'] .kontakt__formular { max-width: none; }

  @media (max-width: 560px) {
    .kontakt__knoepfe .kn { flex: 1; justify-content: center; white-space: nowrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kontakt__telefon,
    .kontakt__mail { transition: none; }
    /* Kein Anflug: Die Zeichnung steht auf 100 % (das Skript schreibt
       dann kein `--karte-zoom`), Marke und Bodenschatten stehen von
       Anfang an, die Ringe stehen still. */
    .kontakt__bild { scale: 1; }
    .kontakt[data-da] .kontakt__marke svg { animation: none; }
    .kontakt__marke svg { opacity: 1; }
    .kontakt[data-da] .kontakt__aufsetzer { animation: none; }
    .kontakt__aufsetzer { opacity: 0.9; transform: none; }
    .kontakt[data-da] .kontakt__halo { animation: none; opacity: 0.35; transform: scale(2.2); }
  }
</style>

<script>
  import { nachziehen } from '../scripts/scrollwege';

  /**
   * Zwei Dinge: wo die Marke steht, und wie die Karte anfliegt.
   *
   * 1. Die Stelle
   *    Die Marke soll auf jeder Bildschirmgröße frei stehen — nicht
   *    hinter der Formularkarte und nicht unter dem Text. Wo das ist,
   *    hängt vom Umbruch ab und wird deshalb gemessen, nicht geraten
   *    (so hält es auch der Entwurf, `freiePosition()`):
   *
   *      nebeneinander   in der Lücke zwischen Text und Formular
   *      gestapelt, breit  rechts neben dem Formular (Tablets)
   *      gestapelt, schmal zwischen den Knöpfen und dem Formular
   *
   *    Die Zeichnung hängt an derselben Stelle (siehe CSS): Ihr
   *    Mittelpunkt ist die Praxis und liegt damit immer genau unter
   *    der Spitze — auf Handys und Tablets ebenso wie auf dem Desktop
   *    (Florian, 18. September 2026).
   *
   * 2. Der Anflug
   *    Die Karte hängt am Scrollweg, nicht an der Uhr: Tritt die Spitze
   *    der Marke unten ins Fenster, steht die Zeichnung in ihrer
   *    deckenden Größe — von weit draußen gesehen; bis die Spitze 15 %
   *    unter der Oberkante angekommen ist, zoomt sie um die Marke auf
   *    das Anderthalbfache heran (ZOOM_ENDE) — sanft an- und
   *    auslaufend. Sie beginnt deckend und wird nur größer: So zeigt sie
   *    in keiner Phase eine Kante (Florian, 27. September 2026). Der
   *    gezeichnete Wert läuft dem Scrollwert träge nach (`nachziehen`
   *    mit eigener Trägheit). Bei 60 % des Wegs fällt die Marke herein
   *    (`data-da`), einmal und endgültig; die Ringe folgen ihr. Wer
   *    zurückscrollt, sieht die Karte wieder wegfahren — die Marke
   *    bleibt. Das ist die Choreografie des `flyTo` im Entwurf, nur
   *    ohne Karten-Bibliothek und ohne Uhr. Bis zum 27. September 2026
   *    kam sie von 125 % auf 100 % herunter, also von zu nah, über
   *    einen kürzeren Weg.
   *
   *    Vorher lief der Anflug als Übergang von 2,2 s, ausgelöst, sobald
   *    ein knappes Drittel des Bereichs im Bild war, und die Marke
   *    wartete noch 2,3 s länger. Wer flott herunterscrollte, sah davon
   *    nur den Rest (Florian, 26. September 2026).
   */
  function karteAufbauen() {
    const bereich = document.querySelector<HTMLElement>('#contact');
    if (!bereich || bereich.dataset.bereit) return;
    bereich.dataset.bereit = 'ja';

    const text = bereich.querySelector<HTMLElement>('.kontakt__text');
    const formular = bereich.querySelector<HTMLElement>('.kontakt__formular');
    const knoepfe = bereich.querySelector<HTMLElement>('.kontakt__knoepfe');

    /** Breite und Höhe der Marke (CSS) — sie darf nirgends anstoßen. */
    const MARKE = { breit: 52, hoch: 72 };

    /** Luft, die links und rechts der Marke frei bleiben soll. */
    const LUFT = 56;

    /** Wie nah der Anflug endet: das Anderthalbfache der deckenden
        Größe (Florian, 27. September 2026: „von deutlich weiter weg
        reinzoomen" — und dabei nie eine Kante zeigen; also beginnt er
        deckend und endet näher). */
    const ZOOM_ENDE = 1.5;

    /** Maß der Zeichnung am ANFANG des Anflugs, wenn Text und Formular
        gestapelt stehen — als Anteil ihrer vollen Größe (hochkant:
        1080 × 1646 → 540 × 823). Am Ende steht sie beim
        ZOOM_ENDE-fachen, also etwa bei 0,75 — der Nähe, die vorher fest
        stand (0,73: den Ort sehen, nicht den Häuserblock). Ist der
        Bereich höher, wächst das Maß, bis die Zeichnung unten ankommt. */
    const MASS_SCHMAL = 0.5;

    /* Die beiden Zeichnungen: nebeneinander das 16:9-Bild des Handoffs,
       gestapelt das hochkante aus scripts/karte-zeichnen.mjs (die CSS-
       Regel im Umbruch tauscht das Bild). `praxis` ist der Punkt, der
       unter die Spitze der Marke gehört. */
    const ZEICHNUNG = {
      breit: { breite: 1920, hoehe: 1080, praxis: { x: 960, y: 540 } },
      hoch: { breite: 1080, hoehe: 1646, praxis: { x: 540, y: 548.6 } },
    };

    /**
     * Wie weit der Text WIRKLICH nach rechts reicht.
     *
     * Die Kästen der Absätze laufen über die ganze Spalte, der Satz
     * darin endet aber viel früher. Gemessen wird deshalb der Text
     * selbst (die Zeilenkästen eines Bereichs über den Inhalt), nicht
     * das Element — sonst säße die Marke zu weit rechts (Florian,
     * 18. September 2026).
     */
    const inhaltRechts = (el: HTMLElement): number => {
      let rechts = 0;
      /* Jede Textzeile einzeln: Ein Bereich über das ganze Element
         lieferte für Absätze deren Kasten zurück, und der läuft über
         die volle Spalte. */
      const lauf = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const stelle = document.createRange();
      for (let knoten = lauf.nextNode(); knoten; knoten = lauf.nextNode()) {
        if (!knoten.nodeValue?.trim()) continue;
        stelle.selectNodeContents(knoten);
        for (const zeile of stelle.getClientRects()) {
          if (zeile.width > 0) rechts = Math.max(rechts, zeile.right);
        }
      }
      /* Die Knöpfe sind breiter als ihre Beschriftung — sie zählen mit
         ihrem Kasten. */
      for (const knopf of el.querySelectorAll('a, button')) {
        const k = knopf.getBoundingClientRect();
        if (k.width > 0) rechts = Math.max(rechts, k.right);
      }
      return rechts || el.getBoundingClientRect().right;
    };

    const markeStellen = () => {
      if (!text || !formular) return;
      const b = bereich.getBoundingClientRect();
      const t = text.getBoundingClientRect();
      const f = formular.getBoundingClientRect();
      if (!b.width || !f.width) return;

      /* Stehen die beiden Spalten nebeneinander? */
      const nebeneinander = f.left > t.right + 24;
      /* Bleibt neben dem Formular genug frei für die Marke? */
      const platzRechts = b.right - f.right;

      let x: number;
      let y: number;
      let art: string;

      if (nebeneinander && f.left - inhaltRechts(text) >= MARKE.breit + 2 * LUFT) {
        /* Genug Lücke: die Marke steht mittig zwischen dem Text links
           und der Formularkarte rechts. */
        art = 'breit';
        x = (inhaltRechts(text) + f.left) / 2 - b.left;
        y = f.top + f.height * 0.62 - b.top;
      } else if (nebeneinander) {
        /* Zu eng dazwischen — dann unter die beiden Knöpfe (Florian,
           18. September 2026). Dort ist auf jeder Breite Platz. */
        art = 'unterknoepfe';
        const kn = (knoepfe ?? text).getBoundingClientRect();
        x = (kn.left + kn.right) / 2 - b.left;
        y = t.bottom - b.top + MARKE.hoch + 24;
      } else if (platzRechts > MARKE.breit + 64) {
        art = 'seite';
        x = (f.right + b.right) / 2 - b.left;
        y = f.top + f.height * 0.4 - b.top;
      } else {
        art = 'unten';
        x = b.width * 0.72;
        y = (t.bottom + f.top) / 2 - b.top + MARKE.hoch / 2;
      }

      /* Nie über den Rand hinaus */
      x = Math.max(MARKE.breit, Math.min(b.width - MARKE.breit, x));
      y = Math.max(MARKE.hoch + 8, Math.min(b.height - 16, y));

      bereich.dataset.marke = art;
      bereich.style.setProperty('--marke-x', `${Math.round(x)}px`);
      bereich.style.setProperty('--marke-y', `${Math.round(y)}px`);

      /*
        Maß und Lage der Zeichnung: Ihr Mittelpunkt — die Praxis —
        gehört unter die Spitze der Marke. Verschoben wird die
        Zeichnung, nicht ihre Ebene; die deckt den Bereich ohnehin
        (siehe CSS).

        Nebeneinander ist das Maß so gewählt, dass sie auch nach dem
        Verschieben bis in alle vier Ecken reicht: Vom Mittelpunkt bis
        zur fernsten Kante ist es `max(x, Breite − x)` — das Doppelte
        davon ist die Mindestbreite, senkrecht entsprechend.

        Gestapelt (der Umbruch bei 900 px, hier gemessen statt geraten)
        ist der Bereich viel höher als breit, und dieselbe Rechnung
        bliese die Zeichnung auf gut das Doppelte auf — vom Ort blieb
        nur noch die nächste Straße. Dort steht deshalb die hochkante
        Zeichnung in festem Maß (`MASS_SCHMAL`), waagerecht bis in beide
        Ecken — und senkrecht so groß, dass sie unter der Marke bis zum
        unteren Rand des Bereichs reicht (Florian, 26. September 2026):
        Von der Praxis bis zur Unterkante der Zeichnung sind es
        `hoehe − praxis.y` Bildpunkte, gebraucht werden `Höhe − y` plus
        ein Stück Überstand (`UEBERSTAND`): Die Maske (CSS) lässt die
        Zeichnung zum Rand hin auslaufen — ragt sie unter den Bereich
        hinaus, fällt dieser Verlauf hinter die Unterkante, und die Karte
        bleibt bis unten satt. Was oben über den Rand hinausragt, deckt
        ohnehin der weiße Schleier.

        Alle Maße gelten für den ANFANG des Anflugs (Zoom 1). Die
        senkrechte Reichweite unter der Marke darf durch ZOOM_ENDE
        geteilt werden: Der untere Teil des Bereichs (das Formular) kommt
        erst ins Bild, wenn der Anflug längst zu Ende ist — und dann
        steht die Zeichnung beim ZOOM_ENDE-fachen, um die Marke
        vergrößert, also entsprechend weiter nach unten. Die waagerechte
        Deckung dagegen ist vom ersten Bild an zu sehen und bleibt
        ungeteilt.
      */
      const UEBERSTAND = 200;
      const z = nebeneinander ? ZEICHNUNG.breit : ZEICHNUNG.hoch;
      const mass = nebeneinander
        ? Math.max(
            b.width / z.breite,
            b.height / z.hoehe,
            (2 * Math.max(x, b.width - x)) / z.breite,
            (2 * Math.max(y, b.height - y)) / z.hoehe,
          )
        : Math.max(
            MASS_SCHMAL,
            (2 * Math.max(x, b.width - x)) / z.breite,
            (b.height + UEBERSTAND - y) / (z.hoehe - z.praxis.y) / ZOOM_ENDE,
          );
      const breit = Math.ceil(z.breite * mass);
      const hoch = Math.ceil(z.hoehe * mass);
      bereich.style.setProperty('--karte-mass', `${breit}px ${hoch}px`);
      /* Die Praxis der Zeichnung unter die Spitze der Marke */
      bereich.style.setProperty('--karte-lage', `${Math.round(x - z.praxis.x * mass)}px ${Math.round(y - z.praxis.y * mass)}px`);
    };

    /* ---------- 2. Der Anflug ---------- */

    const marke = bereich.querySelector<HTMLElement>('.kontakt__marke');
    const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** Ab diesem Anteil des Wegs fällt die Marke — die Zeichnung ist
        dann fast da und rollt nur noch aus. */
    const MARKE_BEI = 0.6;

    /** Länge des Anflugs in Fensterhöhen: von der Unterkante bis
        15 % unter der Oberkante (vorher bis 45 % — zu kurz). */
    const ANFLUG_WEG = 0.85;

    /** Trägheit des Nachlaufs: je näher an 1, desto weicher und länger
        läuft die Zeichnung dem Scrollwert nach (Grundwert 0,7 in
        scrollwege.ts; hier bewusst träger). */
    const TRAEGHEIT = 0.86;

    /**
     * Wie weit der Anflug ist (0 … 1): 0, wenn die Spitze der Marke
     * unten ins Fenster tritt; 1, wenn sie 15 % unter der Oberkante
     * steht. Gemessen wird die Marke selbst, nicht der Bereich — der
     * ist auf Handys so hoch, dass sein Anteil im Bild wenig über die
     * Karte sagt.
     */
    const fortschritt = (): number => {
      if (!marke) return 1;
      const spitze = marke.getBoundingClientRect().bottom;
      const fenster = window.innerHeight;
      return Math.min(1, Math.max(0, (fenster - spitze) / (ANFLUG_WEG * fenster)));
    };

    /* Der gezeichnete Wert läuft dem Scrollwert nach — wie beim
       Gruppenfoto (Team.astro): eine Schleife je Anstoß, die endet,
       sobald beide zusammengefunden haben. */
    let wert = 0;
    let laeuft = false;
    let zuletzt = 0;

    const zeichnen = () => {
      /* Von der deckenden Größe (1) auf ZOOM_ENDE, sanft an- und
         auslaufend (smoothstep) — die Trägheit des Nachlaufs rundet das
         noch einmal ab */
      const s = wert * wert * (3 - 2 * wert);
      const zoom = 1 + (ZOOM_ENDE - 1) * s;
      bereich.style.setProperty('--karte-zoom', zoom.toFixed(4));
      if (wert >= MARKE_BEI && !bereich.dataset.da) bereich.dataset.da = 'ja';
    };

    const schritt = (jetzt: number) => {
      const dt = zuletzt ? Math.min(100, jetzt - zuletzt) : 16.7;
      zuletzt = jetzt;

      const ziel = fortschritt();
      wert = nachziehen(wert, ziel, dt, TRAEGHEIT);
      if (Math.abs(ziel - wert) < 0.0005) wert = ziel;
      zeichnen();

      if (wert !== ziel) requestAnimationFrame(schritt);
      else laeuft = false;
    };

    const anstossen = () => {
      if (reduziert || laeuft) return;
      laeuft = true;
      zuletzt = 0;
      requestAnimationFrame(schritt);
    };

    /* ---------- Los ---------- */

    /* Reihenlücke und Formularbreite hängen ihrerseits von `data-marke`
       ab — deshalb zweimal messen: Der zweite Durchgang sieht das
       Ergebnis des ersten. Und vor dem ersten wird `data-marke`
       gelöscht, damit er immer vom selben Stand ausgeht (Karte auf
       480 px). Sonst hinge das Ergebnis davon ab, wo man herkommt: Eine
       Karte, die einmal auf volle Breite gegangen war, ließe rechts nie
       wieder Platz für die Marke (Florian, 26. September 2026).
       Danach läuft der Anflug einmal nach, weil die Marke gewandert
       sein kann. */
    const messen = () => {
      delete bereich.dataset.marke;
      markeStellen();
      markeStellen();
      anstossen();
    };

    messen();
    requestAnimationFrame(messen);
    window.addEventListener('resize', messen, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(messen).observe(bereich);

    if (reduziert) {
      /* Ohne Bewegung: Die Zeichnung bleibt auf 100 % (CSS), die Marke
         steht von Anfang an. */
      bereich.dataset.da = 'ja';
      return;
    }

    /* Ohne Nachlauf auf den Stand springen, den die Seite gerade hat —
       wer direkt zu #contact kommt, soll die Karte nicht erst
       heranfahren sehen. */
    wert = fortschritt();
    zeichnen();
    window.addEventListener('scroll', anstossen, { passive: true });
  }

  karteAufbauen();
  document.addEventListener('astro:page-load', karteAufbauen);
</script>
