---
/**
 * Kontakt — „So erreichen Sie uns".
 *
 * Ein Band über die volle Breite: dahinter das entsättigte Kartenbild
 * mit dem pulsierenden Punkt an der Praxis, darauf links die Anschrift
 * mit der großen Telefonnummer und den beiden Knöpfen, rechts das
 * Formular auf einer weißen Karte (Entwurf, 18. September 2026).
 *
 * Das eigene Band „Anfahrt" am Seitenfuß ist damit wieder aufgelöst —
 * Karte und Kontakt sind eins.
 *
 * **Die Karte wird nicht mehr eingebettet.** „Karte anzeigen" und
 * „Route planen" sind schlichte Verweise, die Google Maps in einem
 * neuen Fenster öffnen (Florian, 18. September 2026). Damit lädt die
 * Seite nichts mehr von fremden Servern — die Einwilligung ist
 * gegenstandslos geworden.
 *
 * Kein grauer Kachelgrund und kein Briefumschlag (Florian, 17.
 * September 2026). Die Felder des Formulars bleiben, wie sie sind —
 * gefüllte Kästen wie im Entwurf ausdrücklich nicht (Florian).
 */
import Kontaktformular from './Kontaktformular.astro';
import seite from '../content/seite.json';
import startseite from '../content/startseite.json';

const texte = startseite.kontakt;
const formulartexte = startseite.formular;
const { praxis } = seite;
const adresse = `${praxis.strasse}, ${praxis.plz} ${praxis.ort}`;
const kartenZiel = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(adresse);
const routenZiel = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(adresse);
---

<section class="kontakt" id="contact" data-verlauf>
  {/* Der Kartengrund. Rein schmückend — die Anschrift steht daneben im
      Text, deshalb ohne Beschriftung für Vorleseprogramme. */}
  <div class="kontakt__karte" aria-hidden="true">
    <span class="kontakt__bild"></span>
    <span class="kontakt__punkt"><span class="kontakt__welle"></span></span>
  </div>

  <div class="kontakt__inhalt">
    <div class="kontakt__text" data-rein>
      <div class="kicker">Kontakt</div>
      <h2 class="kontakt__titel">{texte.titel}</h2>
      {texte.text && <p class="kontakt__einleitung">{texte.text}</p>}

      <a class="kontakt__telefon" href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>

      <address class="kontakt__anschrift">
        <span>{praxis.strasse} · {praxis.plz} {praxis.ort}</span>
        <a class="kontakt__mail" href={`mailto:${praxis.email}`}>{praxis.email}</a>
      </address>

      <p class="kontakt__zusatz">Fax {praxis.fax} · Parkplätze direkt vor der Praxis</p>

      <div class="kontakt__knoepfe">
        <a class="kn kn--voll" href={kartenZiel} target="_blank" rel="noopener">
          <span class="kn__f" aria-hidden="true"></span>Karte anzeigen
        </a>
        <a class="kn" href={routenZiel} target="_blank" rel="noopener">
          <span class="kn__f" aria-hidden="true"></span>Route planen
        </a>
      </div>

      <p class="kontakt__notiz">Beide Knöpfe öffnen Google Maps in einem neuen Fenster.</p>
    </div>

    <div class="kontakt__formular" data-rein>
      <div class="kicker kicker--klein">Nachricht</div>
      <h3 class="kontakt__formulartitel verlauf">{formulartexte.titel}</h3>
      <Kontaktformular hinweis={formulartexte.text} />
    </div>
  </div>
</section>

<style>
  .kontakt {
    /* Die Stelle der Praxis im Kartenbild — Bildausrichtung und Punkt
       benutzen dieselben Werte, deshalb stehen sie hier einmal. */
    --marke-x: 52.77%;
    --marke-y: 48.94%;
    position: relative;
    z-index: 40;
    width: 100%;
    overflow: hidden;
    background: var(--farbe-flaeche);
  }

  /*
    Die Kartenebene. Sie rückt nach oben und zur Seite, damit der Punkt
    an der Praxis in der freien Fläche links steht und nicht halb hinter
    der Formularkarte verschwindet. Sie wird dabei um dasselbe Maß
    größer, damit an den Kanten keine Lücke entsteht — und weil Bild und
    Punkt in derselben Ebene liegen, bleiben sie dabei aufeinander.
  */
  .kontakt__karte {
    position: absolute;
    inset: 0 0 auto auto;
    width: calc(100% + var(--karte-seit, 0px));
    height: calc(100% + var(--karte-hoch, 0px));
    transform: translate(calc(-1 * var(--karte-seit, 0px)), calc(-1 * var(--karte-hoch, 0px)));
  }

  /*
    `background-position: p%` richtet den p-%-Punkt des Bildes auf den
    p-%-Punkt der Fläche aus — unabhängig davon, welches größer ist.

    `cover`, damit die Karte über die ganze Breite geht (Florian,
    18. September 2026). Das Bild ist 1600 Bildpunkte breit und wird
    dabei auf breiten Schirmen gestreckt — sobald es durch eine eigene
    Grafik ersetzt ist, fällt das nicht mehr ins Gewicht.

    Der Verlauf liegt nur oben: Die Karte blendet aus dem Weiß des
    Abschnitts darüber ein und endet unten mit einer harten Kante am
    Fußbereich.
  */
  .kontakt__bild {
    position: absolute;
    inset: 0;
    display: block;
    background: url('/bilder/deko/karte-vorschau.jpg') var(--marke-x) var(--marke-y) / cover no-repeat;
    filter: grayscale(1);
    opacity: 0.38;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%);
    mask-image: linear-gradient(to bottom, transparent, #000 22%);
  }

  /*
    Googles eigene Beschriftung deckt ein weiches weißes Oval zu:
    „Dr.med.dent. Paul Nold / Vor Kurzem angesehen" steht links neben
    der Marke, „Bietigheim" darunter. Sobald ein eigenes Kartenbild ohne
    Beschriftung da ist, kann das hier ersatzlos entfallen.
  */
  .kontakt__karte::after {
    content: '';
    position: absolute;
    left: var(--marke-x);
    top: var(--marke-y);
    /* Mit `cover` wächst die Karte mit dem Fenster — der Schleier
       ebenso. Die Bandhöhe hält den Maßstab bei etwa 1, deshalb der
       Mindestwert. */
    width: max(380px, 23vw);
    height: max(145px, 8.7vw);
    translate: -70% -32%;
    border-radius: 50%;
    background: var(--farbe-flaeche);
    filter: blur(24px);
    pointer-events: none;
  }

  /* Der Punkt deckt den Kopf der Google-Marke zu (im Bild 29,5 Punkte
     breit, auf dem Schirm um den Maßstab von `cover` größer). */
  .kontakt__punkt {
    position: absolute;
    z-index: 1;
    left: var(--marke-x);
    top: var(--marke-y);
    width: max(32px, 1.9vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: var(--radius-rund);
    background: var(--farbe-primaer);
    box-shadow: 0 0 0 3px var(--farbe-flaeche);
  }

  /* Der Ring geht immer wieder auf und verliert sich dabei */
  .kontakt__welle {
    position: absolute;
    inset: 0;
    border: 1px solid var(--farbe-primaer);
    border-radius: var(--radius-rund);
    animation: kontakt-welle 2.8s var(--verlauf) infinite;
  }

  @keyframes kontakt-welle {
    0% { transform: scale(1); opacity: 0.8; }
    70% { transform: scale(2.8); opacity: 0; }
    100% { transform: scale(2.8); opacity: 0; }
  }

  /* ---------- Inhalt ---------- */

  .kontakt__inhalt {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    margin-inline: auto;
    padding-block: var(--abstand-abschnitt);
  }

  .kontakt__text { min-width: 0; }

  .kontakt__titel {
    margin: 14px 0 0;
    color: var(--farbe-primaer);
    font-size: var(--text-titel);
    font-weight: var(--gewicht-leicht);
    line-height: 1.08;
    letter-spacing: -0.014em;
  }

  .kontakt__einleitung {
    max-width: 30rem;
    margin: 18px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-lead);
    line-height: var(--zeilenhoehe-lese);
  }

  /* Die Telefonnummer ist das Wichtigste im Bereich — entsprechend groß
     und als Verweis angelegt, damit sie am Handy gleich wählt. */
  .kontakt__telefon {
    display: inline-block;
    margin-top: clamp(28px, 3.5vw, 48px);
    color: var(--farbe-primaer);
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.4rem);
    font-weight: var(--gewicht-leicht);
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity 0.4s var(--verlauf);
  }

  .kontakt__telefon:hover,
  .kontakt__telefon:focus-visible { opacity: 0.7; }

  .kontakt__anschrift {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(18px, 2.5vw, 38px);
    margin-top: 22px;
    color: var(--farbe-text);
    font-size: 17px;
    font-style: normal;
    line-height: 1.5;
  }

  .kontakt__mail {
    color: var(--farbe-primaer);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition: opacity 0.4s var(--verlauf);
  }

  .kontakt__mail:hover,
  .kontakt__mail:focus-visible { opacity: 0.7; }

  .kontakt__zusatz {
    max-width: none;
    margin: 10px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 15px;
    line-height: 1.6;
  }

  .kontakt__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(26px, 3vw, 38px);
  }

  .kontakt__notiz {
    max-width: none;
    margin: 16px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ---------- Die Karte mit dem Formular ---------- */

  /*
    Das Formular steht auf einer eigenen weißen Karte: Es liegt auf dem
    Kartengrund, und nur so bleiben die feinen Linien der Felder
    ablesbar. Der Schatten ist der einzige auf der ganzen Seite — hier
    trägt er die Karte über den Grund, statt sie zu verzieren.
  */
  .kontakt__formular {
    min-width: 0;
    /* Feste Breite statt halber Spalte: So bleiben die Felder in einem
       ruhigen Maß, egal wie breit das Fenster ist (Florian,
       18. September 2026). */
    width: 100%;
    max-width: 480px;
    justify-self: end;
    padding: clamp(24px, 2.4vw, 36px);
    border-radius: var(--radius-l);
    background: var(--farbe-flaeche);
    box-shadow: 0 18px 60px rgb(30 8 22 / 8%);
  }

  .kontakt__formulartitel {
    margin: 12px 0 26px;
    font-size: var(--text-titel-klein);
    font-weight: var(--gewicht-leicht);
    line-height: 1.22;
    letter-spacing: -0.011em;
  }

  .kontakt {
    --karte-hoch: 150px;
    --karte-seit: 300px;
  }

  /* Einspaltig steht die Formularkarte unter dem Text — dann muss die
     Karte nicht zur Seite. */
  @media (max-width: 900px) {
    .kontakt { --karte-seit: 0px; }
  }

  @media (max-width: 900px) {
    .kontakt__inhalt {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .kontakt__formular { justify-self: start; }
  }

  @media (max-width: 560px) {
    .kontakt__knoepfe .kn { flex: 1; justify-content: center; white-space: nowrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kontakt__welle { animation: none; opacity: 0.5; }
    .kontakt__telefon,
    .kontakt__mail { transition: none; }
  }
</style>
