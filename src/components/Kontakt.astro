---
/**
 * Kontakt — „So erreichen Sie uns".
 *
 * Aufbau nach der Vorlage, um das dort nur ausgeblendete Formular
 * ergänzt (Entscheidung von Florian, September 2026):
 *   .contact          60 px oben, 200 px unten Innenabstand
 *   .div-block-27     Adresse zweispaltig, 30 px darüber
 *   .text-block-4/-5  20 px, Gewicht 300, Zeilenhöhe 26 px
 *   .contact-content  46 px darunter: links die Karte (60 %),
 *                     rechts das Formular (40 %); mobil untereinander
 *   .div-block-22     Karte mit weichem Schatten 1px 1px 17px -12px
 *
 * Die Karte kommt von Google Maps und lädt erst, wenn der Besucher das
 * Vorschaubild anklickt (scripts/einwilligung.ts merkt die Entscheidung
 * im Browser). Vorher steht dort ein selbst gehostetes Bild. Weil bis
 * dahin nichts von fremden Servern geladen wird, braucht die Seite kein
 * Einwilligungs-Banner beim Aufruf.
 *
 * Kein Briefumschlag — der gehörte zu einem früheren Provisorium.
 */
import Kontaktformular from './Kontaktformular.astro';
import seite from '../content/seite.json';
import startseite from '../content/startseite.json';

const texte = startseite.kontakt;
const formulartexte = startseite.formular;
const { praxis } = seite;
const adresse = `${praxis.strasse}, ${praxis.plz} ${praxis.ort}`;
const kartenZiel = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(adresse);
const karteEinbettung = 'https://maps.google.com/maps?q=' + encodeURIComponent(adresse) + '&z=16&hl=de&output=embed';
---

<section class="kontakt" id="contact" data-verlauf>
  <h2 class="kontakt__titel">{texte.titel}</h2>
  {texte.text && <p class="kontakt__einleitung">{texte.text}</p>}

  <div class="kontakt__adresse">
    <address class="kontakt__spalte kontakt__spalte--rechts">
      <strong>Praxis {praxis.name.split('–')[0].trim()}</strong><br />
      {praxis.strasse}<br />
      {praxis.plz} {praxis.ort}
    </address>

    <address class="kontakt__spalte kontakt__spalte--links">
      Telefon <a href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a><br />
      Fax {praxis.fax}<br />
      <a class="kontakt__mail" href={`mailto:${praxis.email}`}>{praxis.email}</a>
    </address>
  </div>

  <div class="kontakt__inhalt">
    <div class="landkarte" data-landkarte data-einbettung={karteEinbettung}>
      <div class="landkarte__vorschau" data-landkarte-vorschau>
        <img src="/bilder/deko/karte-vorschau.jpg" alt={`Kartenausschnitt: ${adresse}`} width="1600" height="969" loading="lazy" />
        <div class="landkarte__hinweis">
          <p class="landkarte__text">
            Die Karte wird von Google Maps geladen. Dabei erhält Google Ihre IP-Adresse.
          </p>
          <div class="landkarte__knoepfe">
            <button class="landkarte__knopf" type="button" data-landkarte-laden>Karte laden</button>
            <a class="landkarte__verweis" href={kartenZiel} target="_blank" rel="noopener">In Google Maps öffnen</a>
          </div>
        </div>
      </div>
    </div>

    <div class="kontakt__formular">
      <h3 class="kontakt__formulartitel ohne-verlauf">{formulartexte.titel}</h3>
      {formulartexte.text && <p class="kontakt__formulartext">{formulartexte.text}</p>}
      <Kontaktformular />
    </div>
  </div>
</section>

<style>
  /* .contact: 60 px oben, 200 px unten — der graue Symbolgrund scheint
     wie in der Vorlage hinter dem Bereich durch */
  .kontakt {
    position: relative;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding-block: 60px 200px;
    padding-inline: var(--abstand-m);
  }

  .kontakt__titel {
    margin-bottom: 0;
    text-align: center;
  }

  /* .div-block-27: 30 px Abstand darüber */
  .kontakt__einleitung {
    max-width: 46rem;
    margin: var(--abstand-s) 0 0;
    color: var(--farbe-text);
    text-align: center;
  }

  .kontakt__adresse {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 30px;
  }

  /* .text-block-4 / -5: 20 px, Gewicht 300, Zeilenhöhe 26 px */
  .kontakt__spalte {
    color: var(--farbe-text);
    font-size: 20px;
    font-weight: 300;
    font-style: normal;
    line-height: 26px;
  }

  .kontakt__spalte--rechts {
    text-align: right;
    margin-inline: 18px 40px;
  }

  .kontakt__spalte--links {
    text-align: left;
    margin-left: 40px;
  }

  .kontakt__spalte a {
    color: inherit;
    text-decoration: none;
  }

  .kontakt__spalte a:hover,
  .kontakt__spalte a:focus-visible { text-decoration: underline; }

  .kontakt__mail {
    font-weight: var(--gewicht-halbfett);
    color: var(--farbe-primaer);
  }

  /* .contact-content: Karte und Formular nebeneinander, 46 px darunter */
  .kontakt__inhalt {
    display: flex;
    gap: 40px;
    align-items: stretch;
    width: min(100%, var(--breite-inhalt));
    margin-top: 46px;
  }

  /* .div-block-22: 60 % breit, mindestens 40 vh hoch, weicher Schatten */
  .landkarte {
    position: relative;
    flex: 1 1 0;
    min-height: max(60vh, 560px);
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--farbe-flaeche-gedeckt);
    box-shadow: 1px 1px 17px -12px rgb(0 0 0 / 50%);
  }

  .landkarte__vorschau {
    position: absolute;
    inset: 0;
  }

  .landkarte__vorschau img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Zurückhaltend, damit der Hinweis darüber lesbar bleibt */
    filter: saturate(0.6);
  }

  .landkarte__hinweis {
    position: absolute;
    inset: auto var(--abstand-m) var(--abstand-m);
    padding: var(--abstand-s) var(--abstand-m);
    background: rgb(255 255 255 / 92%);
    border-radius: var(--radius-m);
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 30%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .landkarte__text {
    margin: 0 0 var(--abstand-2xs);
    max-width: none;
    font-size: var(--text-s);
    color: var(--farbe-text);
  }

  .landkarte__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--abstand-2xs) var(--abstand-s);
    align-items: center;
  }

  .landkarte__knopf {
    padding: var(--abstand-2xs) var(--abstand-s);
    border: 0;
    border-radius: var(--radius-rund);
    background: var(--farbe-primaer);
    color: var(--farbe-text-invers);
    font: inherit;
    font-size: var(--text-s);
    font-weight: var(--gewicht-halbfett);
    cursor: pointer;
    transition: background-color var(--dauer-schnell) var(--verlauf);
  }

  .landkarte__knopf:hover,
  .landkarte__knopf:focus-visible { background: var(--farbe-dunkel); }

  .landkarte__verweis {
    font-size: var(--text-s);
    color: var(--farbe-primaer);
  }

  /* Die geladene Karte füllt den Kasten */
  .landkarte :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* .div-block-23: 40 % breit */
  .kontakt__formular {
    flex: 1 1 0;
    min-width: 0;
  }

  .kontakt__formulartext {
    max-width: none;
    margin-bottom: var(--abstand-m);
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
  }

  .kontakt__formulartitel {
    margin-bottom: var(--abstand-2xs);
    color: var(--farbe-primaer);
    font-size: var(--text-l);
    font-weight: var(--gewicht-normal);
  }

  @media (max-width: 991px) {
    .kontakt__inhalt { flex-direction: column; }
    .landkarte { min-height: 420px; }
  }

  @media (max-width: 767px) {
    .kontakt { padding-block: 40px 120px; }
    .landkarte { min-height: 320px; }
    .kontakt__adresse { flex-direction: column; align-items: center; gap: var(--abstand-s); }
    .kontakt__spalte--rechts,
    .kontakt__spalte--links { text-align: center; margin: 0; }
    .landkarte__hinweis { inset: auto var(--abstand-s) var(--abstand-s); padding: var(--abstand-xs) var(--abstand-s); }
  }
</style>

<script>
  import { lesen, setzen, EREIGNIS } from '../scripts/einwilligung';

  /**
   * Lädt die Google-Karte, sobald die Einwilligung vorliegt — und nimmt
   * sie wieder heraus, wenn sie widerrufen wird.
   */
  function landkarteAufbauen() {
    const kasten = document.querySelector<HTMLElement>('[data-landkarte]');
    if (!kasten || kasten.dataset.bereit) return;
    kasten.dataset.bereit = 'ja';

    const vorschau = kasten.querySelector<HTMLElement>('[data-landkarte-vorschau]');
    const einbettung = kasten.dataset.einbettung || '';
    let rahmen: HTMLIFrameElement | null = null;

    const anwenden = () => {
      const erlaubt = lesen()?.karte === true;
      if (erlaubt && !rahmen) {
        rahmen = document.createElement('iframe');
        rahmen.src = einbettung;
        rahmen.title = 'Google-Maps-Karte: Lage der Praxis';
        rahmen.loading = 'lazy';
        rahmen.referrerPolicy = 'no-referrer-when-downgrade';
        rahmen.setAttribute('allowfullscreen', '');
        kasten.appendChild(rahmen);
        if (vorschau) vorschau.hidden = true;
      } else if (!erlaubt && rahmen) {
        rahmen.remove();
        rahmen = null;
        if (vorschau) vorschau.hidden = false;
      }
    };

    kasten.querySelector('[data-landkarte-laden]')?.addEventListener('click', () => setzen(true));
    document.addEventListener(EREIGNIS, anwenden);
    anwenden();
  }

  landkarteAufbauen();
  document.addEventListener('astro:page-load', landkarteAufbauen);
</script>
