---
/**
 * Praxisbilder als endlos gleitendes Band.
 *
 * Die Vorlage nutzt Swiper mit `autoplay.delay: 1` und `speed: 5000` —
 * also keinen klickbaren Slider, sondern ein ruhig durchlaufendes Band.
 * Hier mit einer CSS-Animation nachgebaut: kein Framework, kein
 * JavaScript für die Bewegung selbst, gleiche Wirkung.
 *
 * Format wie in der Vorlage (`.swiper { height: 450px }`): eine feste
 * Höhe, die Bilder behalten ihr Seitenverhältnis.
 *
 * Darunter eine Fortschrittsleiste (Handoff, 17. September 2026): eine
 * Haarlinie, auf der ein Reiter mitläuft, daneben der Zähler „01 / 05".
 * Sie ersetzt die frühere Punktreihe. Ein Klick auf die Leiste versetzt
 * das Band an diese Stelle; es läuft von dort ruhig weiter und wird
 * nicht zum schrittweisen Slider (Festlegung von Florian).
 *
 * Band und Leiste lassen sich mit der Maus oder dem Finger ziehen. Beim
 * bloßen Zeigen hält das Band dagegen NICHT mehr an — es soll ruhig
 * weiterlaufen (Florian, 17. September 2026). Angehalten wird es nur,
 * solange jemand zieht, und solange die Leiste sichtbar den Tastatur-
 * fokus hat; Letzteres ist der Halt, den WCAG 2.2.2 für dauernd
 * bewegte Inhalte verlangt.
 *
 * Die Bilder werden doppelt ausgegeben, damit der Übergang nahtlos ist.
 */
import galerie from '../content/galerie.json';

const bilder = galerie.eintraege
  .filter((e) => e.aktiv)
  .sort((a, b) => a.position - b.position);

/** Zweistellig, damit der Zähler nicht springt */
const zweistellig = (n: number) => String(n).padStart(2, '0');
---

{bilder.length > 0 && (
  <section class="galerie" id="galerie" aria-label="Einblicke in unsere Praxis" data-galerie>
    <div class="galerie__fenster" data-galeriefenster>
      <div class="galerie__band" data-galerieband>
        {[...bilder, ...bilder].map((b, i) => (
          <figure class="galerie__bild">
            <img
              src={b.bild}
              alt={i < bilder.length ? b.alt : ''}
              aria-hidden={i >= bilder.length ? 'true' : undefined}
              loading="lazy"
              width="1323"
              height="1050"
            />
          </figure>
        ))}
      </div>
    </div>

    {bilder.length > 1 && (
      <div class="galerie__leiste">
        <button
          class="fortschritt"
          type="button"
          data-galerieleiste
          aria-label="Bildlauf: ziehen oder mit den Pfeiltasten zum nächsten oder vorigen Bild"
        >
          <span class="fortschritt__grund" aria-hidden="true"></span>
          <span class="fortschritt__balken" data-galeriebalken aria-hidden="true"></span>
          <span class="fortschritt__reiter" data-galeriereiter aria-hidden="true"></span>
        </button>
        <span class="galerie__zaehler" data-galeriezaehler aria-hidden="true">
          01 / {zweistellig(bilder.length)}
        </span>
      </div>
    )}
  </section>
)}

<style>
  .galerie {
    width: 100%;
  }

  /* Das Fenster ist zugleich die Ziehfläche. `pan-y` lässt das
     senkrechte Scrollen der Seite durch und behält nur die waagerechte
     Bewegung für das Band. */
  .galerie__fenster {
    overflow: hidden;
    width: 100%;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  .galerie[data-zieht] .galerie__fenster,
  .galerie[data-zieht] .fortschritt { cursor: grabbing; }

  .galerie__band {
    display: flex;
    width: max-content;
    /* Ruhig durchlaufend. Die Dauer ist fest — je mehr Bilder, desto
       gemächlicher wandert jedes einzelne vorbei. */
    animation: galerie-lauf 70s linear infinite;
  }

  /* Feste Höhe wie `.swiper` der Vorlage, im Format 3 : 2 — etwas
     breiter als die Fotos selbst (Florian, 17. Oktober 2026). Das Bild
     ist darin ein Stück größer als sein Rahmen und wandert beim
     Durchlaufen leicht gegen das Band (Parallaxe, Skript unten). */
  .galerie__bild {
    flex: none;
    margin: 0;
    height: clamp(230px, 32vw, 430px);
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .galerie__bild img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transform: translateX(var(--parallaxe, 0px)) scale(1.12);
    /* Sonst nimmt der Browser das Bild selbst als Ziehgut auf */
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Handys: ein Bild über die ganze Breite, hochkant 4 : 5 (Florian,
     17. Oktober 2026). `--fensterbreite` ohne Rollleiste setzt
     Oeffnungszeiten.astro. */
  @media (max-width: 767px) {
    .galerie__bild {
      width: var(--fensterbreite, 100vw);
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }

  /* Das Band ist doppelt bestückt — nach der halben Strecke
     sieht es wieder aus wie am Anfang. */
  @keyframes galerie-lauf {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Anhalten nur, solange gezogen wird — und solange die Leiste
     sichtbar den Tastaturfokus hat. Beim bloßen Zeigen läuft das Band
     weiter (Florian, 17. September 2026); früher hielt es hier an, was
     mit dem Ziehen nicht zusammengeht und beim Überfahren der halben
     Seitenbreite ständig stockte.

     `:focus-visible` statt `:focus-within`: Sonst bliebe das Band nach
     einem Mausklick auf die Leiste stehen, weil der Knopf den Fokus
     behält. */
  .galerie[data-zieht] .galerie__band,
  .galerie[data-angehalten] .galerie__band,
  .galerie:has(.fortschritt:focus-visible) .galerie__band {
    animation-play-state: paused;
  }

  /* ---------- Fortschrittsleiste ---------- */

  .galerie__leiste {
    display: flex;
    align-items: center;
    gap: 20px;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    margin: 26px auto 0;
  }

  /* Die Leiste ist ein Knopf über die ganze Breite: 22 px hoch, damit
     sie sich auch mit dem Finger treffen lässt — sichtbar ist davon
     nur die Haarlinie in der Mitte. */
  .fortschritt {
    position: relative;
    flex: 1;
    height: 22px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* Beim Ziehen mit dem Finger soll die Seite nicht mitscrollen */
    touch-action: none;
  }

  .fortschritt__grund,
  .fortschritt__balken {
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    margin-top: -0.5px;
  }

  .fortschritt__grund { background: var(--farbe-linie); }

  .fortschritt__balken {
    background: var(--farbe-primaer);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .fortschritt__reiter {
    position: absolute;
    top: 50%;
    left: 0;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: var(--radius-rund);
    background: var(--farbe-primaer);
  }

  .galerie__zaehler {
    flex: none;
    font-family: var(--schrift-titel);
    font-size: var(--text-kicker);
    font-weight: var(--gewicht-mittel);
    line-height: 1;
    letter-spacing: var(--sperrung-kicker-klein);
    color: var(--farbe-text-gedeckt);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .galerie__band { animation: none; }
    .galerie__bild img { transform: none; }
    .galerie__fenster { overflow-x: auto; }
    /* Ohne laufendes Band hat die Leiste nichts anzuzeigen */
    .galerie__leiste { display: none; }
  }
</style>

<script>
  /**
   * Fortschrittsleiste zum laufenden Band.
   *
   * Der Stand kommt aus der laufenden CSS-Animation selbst
   * (`getAnimations()`), nicht aus einer eigenen Zeitrechnung — so
   * stimmen Band und Leiste immer überein. Geschrieben wird direkt ins
   * DOM, ohne Umweg.
   *
   * Dasselbe Prinzip trägt das Ziehen: Gezogen wird nicht am Band,
   * sondern an der **Zeit** der Animation. Das Band bleibt damit die
   * eine laufende CSS-Animation — es gibt keine zweite Rechnung, die
   * mit ihr in Streit geraten könnte, und nach dem Loslassen läuft
   * alles von der neuen Stelle ruhig weiter.
   *
   * Angehalten wird ausschließlich über `data-zieht` am Bereich; das
   * Anhalten selbst steht im CSS oben.
   */
  function galerieAufbauen() {
    const bereich = document.querySelector<HTMLElement>('[data-galerie]');
    const band = document.querySelector<HTMLElement>('[data-galerieband]');
    const leiste = document.querySelector<HTMLElement>('[data-galerieleiste]');
    if (!bereich || !band || !leiste || bereich.dataset.bereit) return;
    bereich.dataset.bereit = 'ja';

    const fenster = bereich.querySelector<HTMLElement>('[data-galeriefenster]');
    const balken = bereich.querySelector<HTMLElement>('[data-galeriebalken]');
    const reiter = bereich.querySelector<HTMLElement>('[data-galeriereiter]');
    const zaehler = bereich.querySelector<HTMLElement>('[data-galeriezaehler]');

    /* Das Band enthält jedes Bild zweimal — die Hälfte ist die Runde. */
    const anzahl = Math.max(1, band.children.length / 2);
    const zweistellig = (n: number) => String(n).padStart(2, '0');
    const gesamt = zweistellig(anzahl);

    const lauf = () => band.getAnimations()[0] as Animation | undefined;
    const dauer = () => {
      const zeiten = lauf()?.effect?.getComputedTiming();
      return typeof zeiten?.duration === 'number' ? zeiten.duration : 70000;
    };

    /** Stand der Runde, 0 … 1 */
    const anteil = () => {
      const zeit = Number(lauf()?.currentTime ?? 0);
      return (((zeit / dauer()) % 1) + 1) % 1;
    };

    let laeuft = false;
    let zuletzt = -1;
    /* Steht der Reiter am Ende, bleibt er dort — Rundenende und -anfang
       sind im Band dieselbe Stelle, auf der Leiste aber nicht */
    let amEnde = false;

    /* Parallaxe: Jedes Bild wandert in seinem Rahmen ein Stück gegen die
       Laufrichtung — um bis zu 6 % seiner Breite, je nachdem, wie weit
       sein Rahmen von der Fenstermitte entfernt ist. Berechnet aus dem
       Stand der Animation und der Lage im Band, ohne zu messen. */
    const rahmen = [...band.children] as HTMLElement[];
    const parallaxe = (a: number) => {
      const breite = document.documentElement.clientWidth;
      const fx = fenster?.getBoundingClientRect().left ?? 0;
      const r1 = runde();
      const versatz = r1 * a;
      for (const r of rahmen) {
        const w = r.offsetWidth;
        /* Die Lage des Rahmens im Fenster: das Band ist um `versatz`
           nach links verschoben (Animation `galerie-lauf`) */
        const mitte = fx + r.offsetLeft - versatz + w / 2;
        const d = Math.max(-1.2, Math.min(1.2, (mitte - breite / 2) / breite));
        r.style.setProperty('--parallaxe', `${(-d * 0.06 * w).toFixed(1)}px`);
      }
    };

    const zeichnen = () => {
      if (!laeuft) return;
      parallaxe(anteil());
      const a = amEnde ? 1 : anteil();
      balken?.style.setProperty('transform', `scaleX(${a.toFixed(4)})`);
      if (reiter) reiter.style.left = `${(a * 100).toFixed(2)}%`;

      const nummer = (Math.floor(a * anzahl) % anzahl) + 1;
      if (zaehler && nummer !== zuletzt) {
        zuletzt = nummer;
        zaehler.textContent = `${zweistellig(nummer)} / ${gesamt}`;
      }
      requestAnimationFrame(zeichnen);
    };

    /** Setzt die Animationszeit; Rundenanfang und -ende sind dieselbe
        Stelle, der Wert wird deshalb in eine Runde zurückgefaltet. */
    const zeitSetzen = (zeit: number) => {
      const spiel = lauf();
      if (!spiel) return;
      const d = dauer();
      spiel.currentTime = (((zeit % d) + d) % d);
    };

    /** Setzt das Band auf einen Stand 0 … 1 der Runde. */
    const springen = (a: number) => zeitSetzen(a * dauer());

    /* ---------- Ziehen ----------
       Eine Runde ist die halbe Bandbreite: So weit wandert das Band in
       einer Animationsdauer. Aus einem Ziehweg in Bildpunkten wird
       damit eine Zeitspanne. Nach rechts ziehen heißt: zurück in der
       Zeit. */
    const runde = () => Math.max(1, band.scrollWidth / 2);

    let anBand = false;
    let anLeiste = false;
    let griffX = 0;
    let griffZeit = 0;

    const anhalten = () => { bereich.dataset.zieht = 'ja'; };
    const weiterlaufen = () => { delete bereich.dataset.zieht; };

    /** Stand aus einer Stelle auf der Leiste. Ganz rechts bleibt der
        Reiter rechts stehen, statt an den Anfang zu springen (Florian,
        17. Oktober 2026). */
    const ausPunkt = (x: number) => {
      const r = leiste.getBoundingClientRect();
      const a = Math.min(1, Math.max(0, (x - r.left) / r.width));
      amEnde = a >= 0.999;
      springen(amEnde ? 0 : a);
    };

    /* Wer das Band über die Leiste bewegt hat, will es so sehen, wie er
       es gestellt hat: Es bleibt danach stehen (Florian, 17. Oktober
       2026). Ziehen am Band selbst lässt es weiterlaufen. */
    const festhalten = () => { bereich.dataset.angehalten = 'ja'; };

    const loslassen = (e: PointerEvent) => {
      if (!anBand && !anLeiste) return;
      const halter = anBand ? fenster : leiste;
      anBand = false;
      anLeiste = false;
      weiterlaufen();
      if (halter?.hasPointerCapture(e.pointerId)) halter.releasePointerCapture(e.pointerId);
    };

    /* Das Band: Der Ziehweg verschiebt die Zeit gegenüber dem Stand
       beim Zupacken. */
    fenster?.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || !lauf()) return;
      amEnde = false;
      fenster.setPointerCapture(e.pointerId);
      anBand = true;
      griffX = e.clientX;
      griffZeit = Number(lauf()?.currentTime ?? 0);
      anhalten();
    });

    fenster?.addEventListener('pointermove', (e) => {
      if (!anBand) return;
      zeitSetzen(griffZeit - ((e.clientX - griffX) / runde()) * dauer());
    });

    fenster?.addEventListener('pointerup', loslassen);
    fenster?.addEventListener('pointercancel', loslassen);
    /* Sonst hebt der Browser beim Ziehen das Bild selbst auf */
    fenster?.addEventListener('dragstart', (e) => e.preventDefault());

    /* Die Leiste: Das Band folgt unmittelbar der Stelle unter dem
       Zeiger — auch schon beim Aufsetzen, das ersetzt den früheren
       Klick. */
    leiste.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || !lauf()) return;
      leiste.setPointerCapture(e.pointerId);
      anLeiste = true;
      anhalten();
      festhalten();
      ausPunkt(e.clientX);
    });

    leiste.addEventListener('pointermove', (e) => {
      if (anLeiste) ausPunkt(e.clientX);
    });

    leiste.addEventListener('pointerup', loslassen);
    leiste.addEventListener('pointercancel', loslassen);

    /* Mit der Tastatur bedienbar: Die frühere Punktreihe hatte je Bild
       einen eigenen Knopf. Hier ist es einer — also müssen die
       Pfeiltasten ein Bild weiter- und zurückschalten. */
    leiste.addEventListener('keydown', (e) => {
      const schritt = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1
                    : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1
                    : 0;
      if (schritt === 0 && e.key !== 'Home' && e.key !== 'End') return;
      e.preventDefault();
      festhalten();
      amEnde = false;
      if (e.key === 'Home') springen(0);
      else if (e.key === 'End') springen((anzahl - 1) / anzahl);
      else springen(Math.round(anteil() * anzahl) / anzahl + schritt / anzahl);
    });

    /* Die Schleife läuft nur, solange das Band im Fenster steht. Sonst
       rechnete sie in jedem Bild der ganzen Seite mit — und stahl
       anderen Bewegungen (etwa dem Seitenwechsel) Rechenzeit. */
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const beobachter = new IntersectionObserver(([eintrag]) => {
        if (eintrag.isIntersecting && !laeuft) {
          laeuft = true;
          requestAnimationFrame(zeichnen);
        } else if (!eintrag.isIntersecting) {
          laeuft = false;
        }
      }, { threshold: 0 });
      beobachter.observe(bereich);
    }
  }

  galerieAufbauen();
  document.addEventListener('astro:page-load', galerieAufbauen);
</script>
