---
/**
 * Öffnungszeiten — schnalzt beim Scrollen herein.
 *
 * Aufbau wie in der Vorlage:
 *   • Weiße Fläche mit den drei Listen
 *   • Darunter die Lottie-Grafik: die untere Abschlusslinie mit dem
 *     Zipfel, der auf den Öffnungszeiten-Knopf zeigt
 *
 * Beide bewegen sich am Scrollweg entlang. Die Werte stammen aus der
 * beobachteten Vorlage (siehe docs/referenz/verstaendnis-mobile.md),
 * nicht aus abgeleiteten Annahmen:
 *
 *   Scrollweg   Versatz    Tempo
 *    0 – 20 %   700 → 682  fast Stillstand
 *   20 – 35 %   682 → 483  mittel
 *   35 – 50 %   483 → 150  schnellste Phase
 *   50 – 60 %   150 →  22  mittel
 *   60 – 70 %    22 →   0  rollt sanft aus
 *
 * Der Zipfel wächst, während die Fläche abbremst, und zieht sich
 * wieder ein, sobald sie steht:
 *   50 % → Bild 0 · 71 % → Bild 99 · 80 % → Bild 0
 */
import oz from '../content/oeffnungszeiten.json';

const listen = [oz.zahnaerztlich, oz.kieferorthopaedisch, oz.telefonisch];
---

<section class="ozbereich" id="oz_anchor" aria-label="Öffnungszeiten">
  <div class="ozbereich__buehne">
    <div class="ozblase" data-ozblase>
      <div class="ozblase__flaeche">
        <button class="ozblase__schliessen" type="button" aria-label="Öffnungszeiten ausblenden"></button>

        <div class="ozblase__spalten">
          {listen.map((liste) => (
            <section class="ozliste">
              <h2 class="ozliste__titel ohne-verlauf">{liste.titel}</h2>
              <dl class="ozzeiten">
                {liste.zeilen.filter((z) => z.zeiten).map((z) => (
                  <>
                    <dt>{z.tag}</dt>
                    <dd>{z.zeiten}</dd>
                  </>
                ))}
              </dl>
              {liste.zusatz && <p class="ozliste__zusatz">{liste.zusatz}</p>}
            </section>
          ))}
        </div>
      </div>

      {/* Untere Abschlusslinie mit Zipfel — die Lottie-Grafik */}
      <div class="ozblase__linie" data-ozlinie aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .ozbereich {
    position: relative;
    height: 300vh;
  }

  .ozbereich__buehne {
    position: sticky;
    bottom: 0;
    height: 100vh;
    pointer-events: none;
  }

  .ozblase {
    position: absolute;
    bottom: 110px;
    left: 50%;
    width: min(calc(100vw - 2 * var(--abstand-m)), 62rem);
    /* Vom Skript gesetzt */
    transform: translate(-50%, var(--oz-versatz, 700px));
    pointer-events: auto;
  }

  .ozblase__flaeche {
    position: relative;
    padding: var(--abstand-l) var(--abstand-l) var(--abstand-m);
    background: var(--farbe-flaeche);
  }

  /* Die Lottie-Grafik sitzt direkt darunter und schließt die Fläche ab */
  .ozblase__linie {
    width: 100%;
    line-height: 0;
  }

  .ozblase__linie :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .ozblase__schliessen {
    position: absolute;
    top: var(--abstand-s);
    right: var(--abstand-s);
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: url('/icons/ui/schliessen.svg') center / contain no-repeat transparent;
    cursor: pointer;
    transition: transform var(--dauer-schnell) var(--verlauf);
  }

  .ozblase__schliessen:hover,
  .ozblase__schliessen:focus-visible { transform: rotate(90deg); }

  /* Drei Listen nebeneinander — auf kleinen Bildschirmen untereinander */
  .ozblase__spalten {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--abstand-l);
    align-items: start;
  }

  .ozliste__titel {
    margin-bottom: var(--abstand-2xs);
    color: var(--farbe-primaer);
    font-size: var(--text-m);
    font-weight: var(--gewicht-normal);
  }

  .ozzeiten {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--abstand-3xs) var(--abstand-s);
    margin: 0;
    font-size: var(--text-s);
    color: var(--farbe-primaer);
  }

  /* Wochentage rechtsbündig, Zeiten links daneben — wie in der Vorlage */
  .ozzeiten dt { text-align: right; }
  .ozzeiten dd { margin: 0; white-space: pre-line; }

  .ozliste__zusatz {
    margin: var(--abstand-2xs) 0 0;
    color: var(--farbe-primaer);
    font-size: var(--text-s);
    text-align: right;
  }

  @media (max-width: 60rem) {
    .ozblase { width: calc(100vw - 2 * var(--abstand-s)); }
    .ozblase__flaeche { padding: var(--abstand-m); }
    .ozblase__spalten { grid-template-columns: 1fr; gap: var(--abstand-m); }
  }

  /* Ohne Bewegung: steht ruhig im Seitenfluss */
  @media (prefers-reduced-motion: reduce) {
    .ozbereich { height: auto; padding-block: var(--abstand-2xl); }
    .ozbereich__buehne { position: static; height: auto; }
    .ozblase { position: static; transform: none; margin-inline: auto; }
    .ozblase__linie { display: none; }
  }
</style>

<script>
  import { ladeAnimation } from '../scripts/lottie';
  import { ausStuetzstellen, type Stuetzstelle } from '../scripts/easing';

  /**
   * Fährt die Öffnungszeiten am Scrollweg entlang herein.
   * Stützstellen aus der beobachteten Vorlage.
   */
  function ozAufbauen() {
    const bereich = document.querySelector<HTMLElement>('.ozbereich');
    const blase = document.querySelector<HTMLElement>('[data-ozblase]');
    const linie = document.querySelector<HTMLElement>('[data-ozlinie]');
    if (!bereich || !blase || blase.dataset.bereit) return;
    blase.dataset.bereit = 'ja';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* Schlüsselstellen und Kurven exakt aus Ablauf a-19 der Vorlage.
       Die Kurve gehört zum Abschnitt, der an dieser Stelle BEGINNT —
       so wertet Webflow scrollgebundene Abläufe aus. Nachgerechnet
       gegen die Vorlage: Abweichung unter 2 px über den ganzen Weg. */
    const BLASE: Stuetzstelle[] = [
      { bei: 0.00, wert: 700, kurve: 'linear' },
      { bei: 0.15, wert: 700, kurve: 'easeIn' },
      { bei: 0.50, wert: 150, kurve: 'outCubic' },
      { bei: 0.71, wert: 0, kurve: 'linear' },
      { bei: 1.00, wert: 0 },
    ];

    /* Zipfel: wächst, während die Fläche einrastet, und zieht sich
       danach wieder ein. Werte 0 … 1 als Anteil der Bildfolge. */
    const ZIPFEL: Stuetzstelle[] = [
      { bei: 0.00, wert: 0, kurve: 'linear' },
      { bei: 0.50, wert: 0, kurve: 'outCubic' },
      { bei: 0.71, wert: 1, kurve: 'easeOut' },
      { bei: 0.80, wert: 0, kurve: 'linear' },
      { bei: 1.00, wert: 0 },
    ];

    let spieler: { goToAndStop: (w: number, b?: boolean) => void; totalFrames: number } | null = null;
    let geplant = false;

    const zeichnen = () => {
      geplant = false;
      const r = bereich.getBoundingClientRect();
      const weg = r.height - window.innerHeight;
      const p = weg > 0 ? Math.min(1, Math.max(0, -r.top / weg)) : 0;

      blase.style.setProperty('--oz-versatz', `${ausStuetzstellen(p, BLASE)}px`);

      if (spieler) {
        const anteil = ausStuetzstellen(p, ZIPFEL);
        spieler.goToAndStop(anteil * (spieler.totalFrames - 1), true);
      }
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(zeichnen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    zeichnen();

    if (linie) {
      ladeAnimation(linie, '/lottie/oeffnungszeiten-mobil.json').then((s) => {
        if (!s) return;
        spieler = s;
        zeichnen();
      });
    }
  }

  ozAufbauen();
  document.addEventListener('astro:page-load', ozAufbauen);
</script>
