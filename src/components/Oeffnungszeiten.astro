---
/**
 * Öffnungszeiten — schnalzen beim Scrollen von unten herein.
 *
 * Aufbau wie in der Vorlage (`.oz` / `.oz-container` / `.div-block-28`):
 *   • Ein 350vh hoher Bereich ganz am Seitenanfang
 *   • Darin eine Bühne, die über die volle Strecke stehen bleibt und
 *     ihren Überlauf abschneidet — die Blase ist unsichtbar, solange
 *     sie noch unterhalb steht
 *   • Die Blase selbst ruht 110 px über dem unteren Rand, also genau
 *     über der Symbolleiste, und wird vom Scrollweg dorthin gefahren
 *   • Darunter die Lottie-Grafik mit dem Zipfel
 *
 * Alle Werte stammen aus Ablauf `a-19` („oz test") der Vorlage:
 *
 *   bei 15 %   Blase  y = 700 px      Kurve easeIn   ⟶ holt Schwung
 *   bei 50 %   Blase  y = 150 px      Kurve outCubic ⟶ bremst ab
 *              Zipfel Bild 0
 *   bei 71 %   Blase  y =   0 px      — steht
 *              Zipfel Bild 99         Kurve easeOut
 *   bei 80 %   Zipfel Bild 0
 *
 * Die Kurve gehört jeweils zu dem Abschnitt, der an dieser Stelle
 * BEGINNT — so wertet Webflow scrollgebundene Abläufe aus. Daher das
 * Wechselspiel, das die Vorlage lebendig macht: die erste Bewegung
 * nach oben zieht mit easeIn an, der Rest läuft mit outCubic aus,
 * und der Zipfel schnalzt mit easeOut zurück.
 *
 * Wichtig ist außerdem, WIE der Fortschritt gezählt wird: nicht über
 * den sichtbaren Bereich, sondern wie Webflows „while scrolling in
 * view" über einen 350vh hohen Streifen am Dokumentanfang. Beim Laden
 * sind dadurch schon ~22 % zurückgelegt (siehe scripts/scrollwege.ts).
 */
import oz from '../content/oeffnungszeiten.json';

const listen = [oz.zahnaerztlich, oz.kieferorthopaedisch, oz.telefonisch];
---

{/*
  Zwei Ebenen, weil sie an verschiedenen Stellen im Stapel liegen
  müssen: die weiße Fläche unter dem Logo, die Blase darüber.

    Ebene  1  grauer Symbolgrund (fest im Fenster)
    Ebene  2  diese weiße Fläche — nimmt den Platz im Fluss ein
    Ebene 10  der Logobereich (fest im Fenster)
    Ebene 30  die Öffnungszeiten-Blase

  Der graue Grund wird dadurch erst unterhalb sichtbar
  (docs/entscheidungen.md), das Logo bleibt aber sichtbar, während
  die Blase darüber hereinfährt.
*/}
<div class="ozraum" aria-hidden="true"></div>

<section class="ozbereich" id="oz_anchor" aria-label="Öffnungszeiten">
  <div class="ozbereich__buehne">
    <div class="ozblase" data-ozblase>
      <div class="ozblase__flaeche">
        <button class="ozblase__schliessen" type="button" aria-label="Öffnungszeiten ausblenden"></button>

        <div class="ozblase__spalten">
          {listen.map((liste) => (
            <section class="ozliste">
              <h2 class="ozliste__titel ohne-verlauf">{liste.titel}</h2>
              <table class="ozzeiten">
                <tbody>
                  {liste.zeilen
                    .filter((z) => z.vormittag || z.nachmittag)
                    .map((z) => (
                      <tr>
                        <th scope="row">{z.tag}</th>
                        <td>{z.vormittag}</td>
                        <td>{z.nachmittag}</td>
                      </tr>
                    ))}
                </tbody>
              </table>
              {liste.zusatz && <p class="ozliste__zusatz">{liste.zusatz}</p>}
            </section>
          ))}
        </div>
      </div>

      {/* Untere Abschlusslinie mit Zipfel — die Lottie-Grafik */}
      <div class="ozblase__linie" data-ozlinie aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  /* Nimmt den Platz im Seitenfluss ein und deckt den grauen Grund ab.
     Höhe von `.trigger-oz-scroll` / `.oz` in der mobilen Vorlage. */
  .ozraum {
    position: relative;
    z-index: 2;
    /* 264 px kürzer als der Bereich darüber: so viel steht unter der
       Blase für den ausgefahrenen Zipfel frei. Ist er wieder
       eingezogen, wäre das nur leerer Raum vor der Begrüßung —
       der folgende Inhalt rückt deshalb um diesen Betrag auf. */
    height: calc(350vh - 264px);
    background: var(--farbe-flaeche);
  }

  /* Liegt deckungsgleich darüber, aber auf Ebene 30 — wie
     `.oz-container` in der Vorlage. Außerhalb des Flusses, damit die
     weiße Fläche darunter dieselbe Strecke belegt und nicht doppelt. */
  .ozbereich {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 30;
    width: 100%;
    height: 350vh;
  }

  /* Bleibt stehen, während der Bereich durchläuft.
     Oben klebend statt unten — bottom-sticky greift nur, wenn kein
     Vorfahre den Überlauf beschneidet, und ist damit brüchiger. */
  .ozbereich__buehne {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    /* Wie `.oz-container` auf Mobile: schneidet ab, was noch unterhalb
       steht — sonst schöbe sich die Blase über die Symbolleiste. */
    overflow: hidden;
    pointer-events: none;
  }

  /* Maße der Lottie-Grafik `oz_box_mobile.json`, nachgemessen:
       Artboard        600 × 400
       Abschlusslinie  bei y = 246
       Zipfelspitze    bei y = 400 (voll ausgefahren), x = 520
     Die Spitze fährt also 154 px aus. Genau so weit steigt die Blase
     zwischen 50 % und 71 % (150 px) — deshalb steht die Spitze
     während dieser Phase still. Das funktioniert nur, wenn die Grafik
     in ihrer ursprünglichen HÖHE steht; in der Breite darf sie
     gestreckt werden. */
  .ozblase {
    position: absolute;
    /* 110 px Leistenhöhe + 154 px Zipfellänge: so trifft die voll
       ausgefahrene Spitze genau die Oberkante der Symbolleiste. */
    bottom: 264px;
    left: 50%;
    width: min(calc(100vw - 2 * var(--abstand-m)), 62rem);
    /* Vom Skript gesetzt */
    transform: translate(-50%, var(--oz-versatz, 700px));
    pointer-events: auto;
  }

  .ozblase__flaeche {
    position: relative;
    padding: var(--abstand-m) var(--abstand-l);
    background: var(--farbe-flaeche);
    /* Nie höher als das Fenster — abzüglich Leiste und Zipfel */
    max-height: calc(100vh - 190px);
    overflow-y: auto;
  }

  /* Die Grafik hängt an der Unterkante der Fläche, ohne Platz zu
     brauchen: die Abschlusslinie (y = 246) liegt genau auf der Kante,
     der Zipfelbereich ragt 154 px darunter hinaus. */
  .ozblase__linie {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: -246px;
    width: 100%;
    height: 400px;
    line-height: 0;
    pointer-events: none;
    /* Die Grafik enthält oberhalb der Linie eine große weiße Fläche —
       in der Vorlage IST das der Kasten. Bei uns zeichnet ihn die
       Fläche darüber selbst, deshalb wird alles oberhalb der Linie
       weggeschnitten. 238 px statt 246, weil die Linie leicht schräg
       verläuft (rechts 241, links 259) und nicht angeschnitten werden
       darf. */
    clip-path: inset(238px 0 0 0);
  }

  .ozblase__linie :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ozblase__schliessen {
    position: absolute;
    top: var(--abstand-s);
    right: var(--abstand-s);
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: url('/icons/ui/schliessen.svg') center / contain no-repeat transparent;
    cursor: pointer;
    /* Ablauf a-34 / a-35: 300 ms, outQuad */
    transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ozblase__schliessen:hover,
  .ozblase__schliessen:focus-visible { transform: rotate(90deg); }

  /* Drei Listen nebeneinander — auf kleinen Bildschirmen untereinander */
  .ozblase__spalten {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--abstand-l);
    align-items: start;
  }

  .ozliste__titel {
    margin-bottom: var(--abstand-2xs);
    color: var(--farbe-primaer);
    font-size: var(--text-m);
    font-weight: var(--gewicht-normal);
  }

  /* Wochentag, Vormittag, Nachmittag — drei Spalten, damit die
     Zeitangaben nicht umbrechen. In der Vorlage stehen sie ebenso
     nebeneinander. */
  .ozzeiten {
    border-collapse: collapse;
    font-size: var(--text-s);
    color: var(--farbe-primaer);
  }

  .ozzeiten th,
  .ozzeiten td {
    padding: 0.1rem 0;
    font-weight: var(--gewicht-normal);
    white-space: nowrap;
    vertical-align: baseline;
  }

  .ozzeiten th {
    text-align: right;
    padding-right: var(--abstand-s);
  }

  .ozzeiten td + td { padding-left: var(--abstand-xs); }

  .ozliste__zusatz {
    margin: var(--abstand-2xs) 0 0;
    color: var(--farbe-primaer);
    font-size: var(--text-s);
    text-align: right;
  }

  @media (max-width: 60rem) {
    .ozblase { width: calc(100vw - 2 * var(--abstand-s)); }
    .ozblase__flaeche { padding: var(--abstand-m); }
    .ozblase__spalten { grid-template-columns: 1fr; gap: var(--abstand-m); }
  }

  /* Ohne Bewegung: steht ruhig im Seitenfluss */
  @media (prefers-reduced-motion: reduce) {
    .ozraum { display: none; }
    .ozbereich { position: static; height: auto; padding-block: var(--abstand-2xl); }
    .ozbereich__buehne { position: static; height: auto; }
    .ozblase { position: static; transform: none; margin-inline: auto; }
    .ozblase__linie { display: none; }
  }
</style>

<script>
  import { ladeAnimation } from '../scripts/lottie';
  import { ausStuetzstellen, type Stuetzstelle } from '../scripts/easing';
  import { OZ_WEG, beimScrollenSichtbar, nachziehen } from '../scripts/scrollwege';

  /**
   * Fährt die Öffnungszeiten am Scrollweg entlang herein — Ablauf a-19.
   */
  function ozAufbauen() {
    const bereich = document.querySelector<HTMLElement>('.ozbereich');
    const blase = document.querySelector<HTMLElement>('[data-ozblase]');
    const linie = document.querySelector<HTMLElement>('[data-ozlinie]');
    if (!bereich || !blase || blase.dataset.bereit) return;
    blase.dataset.bereit = 'ja';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* Schlüsselstellen aus a-19. Die Kurve gehört zum Abschnitt, der an
       dieser Stelle beginnt. Vor der ersten Stelle hält Webflow den
       ersten Wert — daher die Stütze bei 0 %. */
    /* Der Startwert der Vorlage ist 700 px. Er reicht dort, weil die
       Blase nur rund 400 px hoch ist. Unsere Listen stehen auf schmalen
       Schirmen untereinander, die Blase wird dadurch höher — dann muss
       der Startwert mitwachsen, sonst schaut sie beim Laden schon
       herein. Die Strecke ab 50 % (150 → 0) bleibt unangetastet: an ihr
       hängt, dass die Zipfelspitze stillsteht. */
    const RUHELAGE = 264; // bottom-Wert der Blase
    let start = 700;

    const startBestimmen = () => {
      const hoch = blase.getBoundingClientRect().height;
      start = Math.max(700, RUHELAGE + hoch + 40);
      BLASE[0].wert = start;
      BLASE[1].wert = start;
    };

    const BLASE: Stuetzstelle[] = [
      { bei: 0.00, wert: 700, kurve: 'linear' },
      { bei: 0.15, wert: 700, kurve: 'easeIn' },
      { bei: 0.50, wert: 150, kurve: 'outCubic' },
      { bei: 0.71, wert: 0, kurve: 'linear' },
      { bei: 1.00, wert: 0 },
    ];
    startBestimmen();

    /* Der Zipfel fährt aus, während die Blase einrastet, und zieht sich
       danach wieder ein. Werte als Anteil der Bildfolge (99 % = 0.99). */
    const ZIPFEL: Stuetzstelle[] = [
      { bei: 0.00, wert: 0, kurve: 'linear' },
      { bei: 0.50, wert: 0, kurve: 'outCubic' },
      { bei: 0.71, wert: 0.99, kurve: 'easeOut' },
      { bei: 0.80, wert: 0, kurve: 'linear' },
      { bei: 1.00, wert: 0 },
    ];

    let spieler: { goToAndStop: (w: number, b?: boolean) => void; totalFrames: number } | null = null;

    /** Der Wert, der gezeichnet wird — läuft dem Scrollwert nach. */
    let p = ziel();
    let laeuft = false;
    let zuletzt = 0;

    /** Scrollwert wie Webflows „while scrolling in view". */
    function ziel(): number {
      return beimScrollenSichtbar(OZ_WEG, bereich!.getBoundingClientRect().top);
    }

    const zeichnen = () => {
      blase.style.setProperty('--oz-versatz', `${ausStuetzstellen(p, BLASE)}px`);
      if (spieler) {
        const anteil = ausStuetzstellen(p, ZIPFEL);
        spieler.goToAndStop(anteil * (spieler.totalFrames - 1), true);
      }
    };

    /* Eigene Schleife statt reinem Scroll-Ereignis: Der Nachlauf muss
       auch dann noch weiterlaufen, wenn das Scrollen längst aufgehört
       hat. Sie hält an, sobald der Wert das Ziel erreicht hat. */
    const schritt = (jetzt: number) => {
      const dt = zuletzt ? Math.min(100, jetzt - zuletzt) : 16.7;
      zuletzt = jetzt;

      const z = ziel();
      p = nachziehen(p, z, dt);
      if (Math.abs(z - p) < 0.0002) p = z;

      zeichnen();

      if (p !== z) requestAnimationFrame(schritt);
      else laeuft = false;
    };

    const anstossen = () => {
      if (laeuft) return;
      laeuft = true;
      zuletzt = 0;
      requestAnimationFrame(schritt);
    };

    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', () => { startBestimmen(); anstossen(); }, { passive: true });
    zeichnen();

    if (linie) {
      /* 'none': in der Breite auf die Blase gestreckt, in der Höhe
         unverändert. Nur so bleibt der Zipfel 154 px lang. */
      ladeAnimation(linie, '/lottie/oeffnungszeiten-mobil.json', { verhaeltnis: 'none' }).then((s) => {
        if (!s) return;
        spieler = s;
        zeichnen();
      });
    }
  }

  ozAufbauen();
  document.addEventListener('astro:page-load', ozAufbauen);
</script>
