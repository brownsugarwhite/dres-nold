---
/**
 * Öffnungszeiten — Sprechblase mit Zipfel, scrollgesteuert.
 *
 * Nachbau von Ablauf `a-19` der Vorlage. Der Bereich ist 300vh hoch;
 * darin klebt die Blase am unteren Rand und wird über den Scrollweg
 * hereingefahren. Entscheidend für das Gefühl ist die ungleiche
 * Verteilung der Schlüsselstellen:
 *
 *   15 – 50 %   Blase fährt 700 px → 150 px   (schnell)
 *   50 – 71 %   Blase fährt 150 px → 0 px     (halbes Tempo)
 *   50 – 71 %   Zipfel wächst auf volle Länge (gleichzeitig)
 *   71 – 80 %   Zipfel zieht sich zusammen    (Blase steht)
 *
 * Die Blase bremst also genau dann ab, wenn der Zipfel wächst, und
 * rastet danach ein.
 *
 * Auf dem Desktop stehen die drei Listen nebeneinander, der Zipfel
 * zeigt nach rechts unten auf den Öffnungszeiten-Knopf der Leiste.
 */
import oz from '../content/oeffnungszeiten.json';
import seite from '../content/seite.json';

const listen = [oz.zahnaerztlich, oz.kieferorthopaedisch, oz.telefonisch];
const { praxis } = seite;
---

<section class="ozbereich" id="oz_anchor" aria-label="Öffnungszeiten">
  <div class="ozbereich__buehne">
    <div class="blase" data-blase>
      <h2 class="blase__titel ohne-verlauf">Öffnungszeiten</h2>

      <div class="blase__spalten">
        {listen.map((liste) => (
          <section class="spalte">
            <h3 class="spalte__titel">{liste.titel}</h3>
            <dl class="zeiten">
              {liste.zeilen.filter((z) => z.zeiten).map((z) => (
                <>
                  <dt>{z.tag}</dt>
                  <dd>{z.zeiten}</dd>
                </>
              ))}
            </dl>
            {liste.zusatz && <p class="spalte__zusatz">{liste.zusatz}</p>}
          </section>
        ))}
      </div>

      <p class="blase__telefon">
        Termine gerne telefonisch unter
        <a href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>
      </p>

      {/* Der Zipfel wächst mit dem Scrollen und zeigt auf den Knopf */}
      <span class="blase__zipfel" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  /* Scrollraum, über den die Blase hereingefahren wird */
  .ozbereich {
    position: relative;
    height: 300vh;
  }

  /* Bleibt am unteren Rand stehen, während der Bereich durchläuft */
  .ozbereich__buehne {
    position: sticky;
    bottom: 0;
    display: flex;
    justify-content: center;
    height: 100vh;
    pointer-events: none;
  }

  .blase {
    position: absolute;
    bottom: 110px;
    right: var(--abstand-l);
    width: min(calc(100vw - 2 * var(--abstand-m)), 62rem);
    padding: var(--abstand-m) var(--abstand-l) var(--abstand-l);
    background: var(--farbe-flaeche);
    border-radius: 30px;
    box-shadow: 0 18px 48px rgb(19 0 13 / 15%);
    pointer-events: auto;

    /* Vom Skript gesetzt: Höhe des Einfahrens und Länge des Zipfels */
    transform: translateY(var(--blase-versatz, 700px));
  }

  /* Zipfel: wächst nach unten auf den Knopf zu */
  .blase__zipfel {
    position: absolute;
    top: 100%;
    right: 3.5rem;
    width: 30px;
    height: var(--zipfel-laenge, 0px);
    background: var(--farbe-flaeche);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .blase__titel {
    margin-bottom: var(--abstand-m);
    color: var(--farbe-primaer);
    font-size: var(--text-xl);
  }

  .blase__spalten {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--abstand-l);
    align-items: start;
  }

  .spalte__titel {
    margin-bottom: var(--abstand-2xs);
    color: var(--farbe-primaer);
    font-size: var(--text-m);
    font-weight: var(--gewicht-normal);
  }

  .zeiten {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--abstand-3xs) var(--abstand-s);
    margin: 0;
    font-size: var(--text-s);
  }

  .zeiten dt { text-align: right; }
  .zeiten dd { margin: 0; white-space: pre-line; }

  .spalte__zusatz {
    margin: var(--abstand-2xs) 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
  }

  .blase__telefon {
    margin: var(--abstand-m) 0 0;
    padding-top: var(--abstand-s);
    border-top: 1px solid var(--farbe-linie);
    font-size: var(--text-s);
  }

  @media (max-width: 60rem) {
    .blase {
      right: 50%;
      translate: 50% 0;
      padding: var(--abstand-m);
    }
    .blase__spalten { grid-template-columns: 1fr; gap: var(--abstand-m); }
    .blase__zipfel { right: calc(50% - 15px); }
  }

  /* Ohne Bewegung: Blase steht einfach an ihrem Platz */
  @media (prefers-reduced-motion: reduce) {
    .ozbereich { height: auto; padding-block: var(--abstand-2xl); }
    .ozbereich__buehne { position: static; height: auto; }
    .blase { position: static; transform: none; margin-inline: auto; }
    .blase__zipfel { display: none; }
  }
</style>

<script>
  /**
   * Fährt die Blase am Scrollweg entlang herein.
   * Die Schlüsselstellen stammen aus Ablauf a-19 der Vorlage.
   */
  function ozScrollAufbauen() {
    const bereich = document.querySelector<HTMLElement>('.ozbereich');
    const blase = document.querySelector<HTMLElement>('[data-blase]');
    if (!bereich || !blase || blase.dataset.bereit) return;
    blase.dataset.bereit = 'ja';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ZIPFEL_MAX = 26; // px — volle Länge des Zipfels

    /** Wert zwischen zwei Schlüsselstellen linear überblenden. */
    const zwischen = (p: number, vonP: number, bisP: number, vonW: number, bisW: number) => {
      if (p <= vonP) return vonW;
      if (p >= bisP) return bisW;
      return vonW + ((p - vonP) / (bisP - vonP)) * (bisW - vonW);
    };

    let geplant = false;
    const zeichnen = () => {
      geplant = false;
      const r = bereich.getBoundingClientRect();
      const weg = r.height - window.innerHeight;
      // 0 = Bereich beginnt gerade, 1 = Bereich ist durchlaufen
      const p = weg > 0 ? Math.min(1, Math.max(0, -r.top / weg)) : 0;

      // 15–50 %: schnell herein · 50–71 %: halbes Tempo bis zum Anschlag
      const versatz = p < 0.5
        ? zwischen(p, 0.15, 0.50, 700, 150)
        : zwischen(p, 0.50, 0.71, 150, 0);

      // Zipfel wächst, während die Blase abbremst — und zieht sich danach zusammen
      const zipfel = p < 0.71
        ? zwischen(p, 0.50, 0.71, 0, ZIPFEL_MAX)
        : zwischen(p, 0.71, 0.80, ZIPFEL_MAX, 0);

      blase.style.setProperty('--blase-versatz', `${versatz}px`);
      blase.style.setProperty('--zipfel-laenge', `${zipfel}px`);
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(zeichnen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    zeichnen();
  }

  ozScrollAufbauen();
  document.addEventListener('astro:page-load', ozScrollAufbauen);
</script>
