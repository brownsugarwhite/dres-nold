---
/**
 * Der Einstieg der Startseite — eine große weiße Karte, die beim
 * Scrollen von unten hereinfährt und mit dem Zipfel einrastet.
 *
 * SIE ENTHÄLT DEN GANZEN ERSTEN ABSCHNITT (Florian, 17. September 2026):
 *
 *   Begrüßung  →  Bilderband  →  Sprechstunden  →  Zipfel
 *
 * Vorher waren Begrüßung und Band eigene Abschnitte im Seitenfluss und
 * nur die Sprechstunden-Blase fuhr herein. Das ließ sich nicht
 * zusammenbringen: Die Blase lebt davon, über das fest stehende Logo zu
 * fahren, also musste sie oben stehen — und stand damit vor der
 * Begrüßung. Jetzt fährt alles gemeinsam herein, und die Reihenfolge
 * stimmt wieder.
 *
 * Weil die Karte höher ist als das Fenster, sieht man beim Hereinfahren
 * zuerst ihren Kopf (die Begrüßung) und zuletzt ihren Fuß (die Zeiten) —
 * die Leserichtung stimmt also. In der Ruhelage steht ihr Fuß knapp
 * über der Symbolleiste; was darüber liegt, ist dann schon vorbei-
 * gezogen.
 *
 * AUF HANDYS (bis 991 px) IST DIE REIHENFOLGE DIE DER MOBILEN VORLAGE
 * (Florian, 26. September 2026): Logo → Sprechstunden-Blase schnalzt
 * herein → Begrüßung → Bilderband. Das Skript nimmt Begrüßung und Band
 * dafür aus der Karte und stellt sie an den Anfang von <main>
 * (`vorspannAnordnen`); die Karte ist dann nur die Sprechstunden, und
 * die ganze Bewegungsrechnung bleibt unverändert. Auf breiten Fenstern
 * fährt weiter alles gemeinsam herein.
 *
 * Aufbau wie in der Vorlage (`.oz` / `.oz-container` / `.div-block-28`):
 *   • Ein 350vh hoher Bereich ganz am Seitenanfang (Handys: 450vh —
 *     dort braucht das große Logo mehr Weg, um sich aufzulösen)
 *   • Darin eine Bühne, die über die volle Strecke stehen bleibt und
 *     ihren Überlauf abschneidet — die Karte ist unsichtbar, solange
 *     sie noch unterhalb steht
 *   • Die Karte selbst ruht knapp über der Symbolleiste und wird vom
 *     Scrollweg dorthin gefahren
 *   • Darunter die Abschlusslinie mit dem Zipfel — eine eigene
 *     SVG-Zeichnung, die auf den Sprechstunden-Knopf zeigt
 *
 * Alle Zeitwerte stammen aus Ablauf `a-19` („oz test") der Vorlage:
 *
 *   bei 15 %   Blase  y = 700 px      Kurve easeIn   ⟶ holt Schwung
 *   bei 50 %   Blase  y = Zipfellänge Kurve outCubic ⟶ bremst ab
 *              Zipfel eingezogen
 *   bei 71 %   Blase  y =   0 px      — steht
 *              Zipfel voll ausgefahren  Kurve easeOut
 *   bei 80 %   Zipfel eingezogen
 *
 * Die Kurve gehört jeweils zu dem Abschnitt, der an dieser Stelle
 * BEGINNT — so wertet Webflow scrollgebundene Abläufe aus. Daher das
 * Wechselspiel, das die Vorlage lebendig macht: die erste Bewegung
 * nach oben zieht mit easeIn an, der Rest läuft mit outCubic aus,
 * und der Zipfel schnalzt mit easeOut zurück.
 *
 * Wichtig ist außerdem, WIE der Fortschritt gezählt wird: nicht über
 * den sichtbaren Bereich, sondern wie Webflows „while scrolling in
 * view" über einen 350vh hohen Streifen am Dokumentanfang. Beim Laden
 * sind dadurch schon ~22 % zurückgelegt (siehe scripts/scrollwege.ts).
 *
 * Der Zipfel
 * ----------
 * In der Vorlage war das eine Lottie-Datei (`oz_box_mobile.json`): ein
 * weißes Polygon mit gestrichelter Kontur, bei dem drei Punkte wandern.
 * Hier wird dieselbe Form direkt als SVG gezeichnet. Vorteile:
 *   • die Grundlinie läuft von Fensterrand zu Fensterrand
 *   • die Spitze zeigt exakt auf die Mitte des Sprechstunden-Knopfs
 *     in der Symbolleiste — gemessen, nicht geschätzt
 *   • die Länge ist je Bildschirmgröße einstellbar (`--zipfel-laenge`)
 *   • keine 170 KB Lottie-Bibliothek für diesen Bereich
 *
 * Die Maße der Vorlage (Zipfel 155 px lang, Basis 117 → 33 px breit,
 * Spitze lehnt 44 px nach rechts, Grundlinie fällt 18 px auf 600 px
 * nach links ab) werden proportional zur eingestellten Länge skaliert.
 */
import OeffnungszeitenListen from './OeffnungszeitenListen.astro';
import Willkommen from './Willkommen.astro';
import Galerie from './Galerie.astro';
import startseite from '../content/startseite.json';

const texte = startseite.sprechstunden;
---

{/*
  Zwei Ebenen, weil sie an verschiedenen Stellen im Stapel liegen
  müssen: die weiße Fläche unter dem Logo, die Blase darüber.

    Ebene  2  diese weiße Fläche — nimmt den Platz im Fluss ein
    Ebene 10  der Logobereich (fest im Fenster)
    Ebene 30  die Sprechstunden-Blase

  Das Logo bleibt dadurch sichtbar, während die Blase darüber
  hereinfährt — genau das macht den Auftritt aus.
*/}
<div class="ozraum" aria-hidden="true"></div>

<section class="ozbereich" id="oz_anchor" aria-label="Einstieg">
  <div class="ozbereich__buehne">
    <div class="ozblase" data-ozblase>
      <div class="ozblase__flaeche">
        <Willkommen />

        <div class="ozband" data-ozband>
          <Galerie />
        </div>

        <div class="ozsprechstunden" aria-labelledby="oz-titel">
          {/* Wie in der mobilen Vorlage ein Kreuz oben rechts. Weil die
              Karte scrollgesteuert ist, „schließt" es sie, indem es sanft
              an den Bereich darunter scrollt. */}
          <div class="ozblase__kicker kicker">Sprechstunden</div>

          {/* Überschrift und Kreuz stehen in einer Zeile — so sitzt das
              Kreuz auf der Höhe von „Wann Sie uns antreffen" statt
              darüber zu schweben (Florian, 18. September 2026). */}
          <div class="ozblase__zeile">
            <h2 class="ozblase__titel ohne-verlauf" id="oz-titel">{texte.titel}</h2>
            <button class="schliessen schliessen--fest ozschliessen" type="button" data-ozschliessen aria-label="Einstieg überspringen">
              <svg class="schliessen__kreis" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" /></svg>
            </button>
          </div>
          {texte.text && <p class="ozblase__einleitung">{texte.text}</p>}

          <div class="ozblase__spalten">
            <OeffnungszeitenListen />
          </div>
        </div>
      </div>

      {/* Untere Abschlusslinie mit Zipfel — vom Skript gezeichnet */}
      <svg class="ozzipfel" data-ozzipfel aria-hidden="true" focusable="false">
        <path class="ozzipfel__flaeche" data-ozflaeche d="" />
        <path class="ozzipfel__kontur" data-ozkontur d="" />
      </svg>
    </div>
  </div>

  {/* Handys: Das Kreuz der Zeile klebt beim Scrollen oben — wie auf den
      Leistungsseiten (erst das nackte Kreuz, dann Grund und Kreis).
      Weil die Karte transformiert und beschnitten ist, übernimmt ab der
      Kopfzeile dieser Zwilling außerhalb der Bühne; das Skript setzt
      `data-klebt` und die Lage. Kein `hidden`: Aus `display: none`
      heraus liefe der Kreis-Übergang nicht an. */}
  <button class="schliessen ozschliessen-klebend" type="button" data-ozschliessen data-ozklebend aria-label="Einstieg überspringen" tabindex="-1">
    <svg class="schliessen__kreis" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" /></svg>
  </button>
</section>

<style>
  /* Wie lang der Zipfel voll ausgefahren ist. Mobil das Maß der
     Vorlage; auf dem Desktop länger, weil dort mehr Luft zwischen Karte
     und Symbolleiste steht (Florian: 90 → 130 → 175 px). Das Skript
     liest den Wert und richtet Ruhelage und Bewegung danach aus.

     Der Wert steht an der Wurzel: Raum, Karte, `scripts/anker.ts` und
     die Begrüßung (Willkommen.astro) lesen ihn. Bis zum 26. September
     2026 stand er am Raum — und kam nie bei der Karte an, die ein
     Geschwister ist: Der Desktop-Zipfel war 154 statt 175 px lang,
     während der Raum 175 abzog. Der Umbruch liegt bei 62 rem = 992 px,
     deckungsgleich mit dem Handy-Umbruch der Navigation. */
  :global(:root) { --zipfel-laenge: 154px; }
  @media (min-width: 62rem) {
    :global(:root) { --zipfel-laenge: 175px; }
  }

  /* Der Scrollweg, über den die Blase hereinfährt — muss zu `ozWeg()`
     in scripts/scrollwege.ts passen. Gezählt wird er wie Webflows
     „while scrolling in view": über Scrollweg PLUS eine Fensterhöhe. */
  .ozraum,
  .ozbereich { --oz-weg: 480vh; }
  @media (max-width: 991px) {
    .ozraum,
    .ozbereich { --oz-weg: 620vh; }
  }

  /* Bei 78 % des Ablaufs steht die Blase mit ausgefahrenem Zipfel, die
     Leisten tauschen (OZ_RAST in scripts/scrollwege.ts). Genau dort
     endet der Bereich: Die Bühne löst sich vom Fenster, und die Blase
     scrollt von da an mit dem Inhalt weiter (Florian, 14. September
     2026), statt bis zum Ende des Scrollwegs stehen zu bleiben. */
  .ozraum,
  .ozbereich { --oz-ende: calc(0.78 * (var(--oz-weg) + 100vh)); }

  /* Nimmt den Platz im Seitenfluss ein und deckt den grauen Grund ab.
     Höhe von `.trigger-oz-scroll` / `.oz` in der mobilen Vorlage. */
  .ozraum {
    position: relative;
    z-index: 2;
    /* Wie viel Platz der Einstieg im Fluss belegt.
       Ausgangspunkt: Beim Freigeben steht die Spitze des Zipfels knapp
       über der Symbolleiste (110 px). Davon geht die Zipfellänge
       noch ab — die Spitze zieht sich beim Weiterscrollen ein, und der
       Platz, den sie hatte, stünde sonst als leere Fläche zwischen
       Karte und nächstem Abschnitt (Florian, 17. September 2026).
       Während sie sich einzieht, reicht sie kurz in den Innenabstand
       des nächsten Abschnitts hinein; sie sitzt aber weit rechts, wo
       dort nichts steht. */
    height: calc(var(--oz-ende) - 110px - var(--zipfel-laenge));
    background: var(--farbe-flaeche);
  }

  /* Liegt deckungsgleich darüber, aber auf Ebene 30 — wie
     `.oz-container` in der Vorlage. Außerhalb des Flusses, damit die
     weiße Fläche darunter dieselbe Strecke belegt und nicht doppelt. */
  .ozbereich {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 30;
    width: 100%;
    height: var(--oz-ende);
  }

  /* Bleibt stehen, während der Bereich durchläuft.
     Oben klebend statt unten — bottom-sticky greift nur, wenn kein
     Vorfahre den Überlauf beschneidet, und ist damit brüchiger. */
  .ozbereich__buehne {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    /* Wie `.oz-container` auf Mobile: schneidet ab, was noch unterhalb
       steht — sonst schöbe sich die Blase über die Symbolleiste.
       `clip` statt `hidden`: `hidden` machte die Bühne zum
       Scroll-Container, und ein Tastaturfokus auf etwas Abgeschnittenes
       hätte ihren `scrollTop` verstellen und die Karte dauerhaft
       verschieben können. Mit `clip` geht das nicht. */
    overflow: hidden;
    overflow: clip;
    pointer-events: none;
  }

  .ozblase {
    position: absolute;
    /* Ruhelage: Leistenhöhe + Zipfellänge + Höhe der Grundlinie unter
       der Blase. So trifft die voll ausgefahrene Spitze genau die
       Oberkante der Symbolleiste. Vom Skript gesetzt. */
    bottom: var(--oz-ruhe, 264px);
    left: 50%;
    /* `100%` statt `100vw`: `vw` zählt die Rollleiste mit, die Blase
       säße dadurch ein paar Pixel zu weit rechts. */
    width: min(calc(100% - 2 * var(--abstand-seitenrand)), var(--breite-inhalt));
    /* Vom Skript gesetzt. Die Vorgabe stellt die Karte ganz unter die
       Bühne — `100%` ist ihre eigene Höhe, das entspricht dem Startwert
       von `startBestimmen()`. Vorher stand hier 700 px, und bis das
       Skript lief, ragte die Karte über das Logo (Florian,
       26. September 2026). Ohne JavaScript greift der Block unten. */
    transform: translate(-50%, var(--oz-versatz, calc(100% + var(--oz-ruhe, 264px) + 40px)));
    pointer-events: auto;
  }

  /* Die Karte selbst hat keinen Innenabstand — Begrüßung, Band und
     Sprechstunden bringen ihren eigenen mit. */
  .ozblase__flaeche {
    position: relative;
    background: var(--farbe-flaeche);
  }

  /* Abstände wie im Entwurf: eine kleine Fuge zwischen Begrüßung und
     Band, dann der volle Abschnittsabstand vor den Sprechstunden.

     Das Band bricht aus der Karte aus und läuft über die volle
     Fensterbreite (Florian, 17. September 2026). `--fensterbreite`
     setzt das Skript unten aus `clientWidth` — `100vw` ginge nicht,
     weil es die Rollleiste mitzählt und die Seite dann waagerecht
     überliefe. Ohne JavaScript bleibt es bei der Kartenbreite; das ist
     der ruhige Rückfall. */
  .ozband {
    width: var(--fensterbreite, 100%);
    /* Derselbe Abstand wie zwischen Band und Sprechstunden — innerhalb
       der Karte hat alles denselben Rhythmus (Florian, 17. September
       2026). */
    margin-top: var(--abstand-gruppe);
    margin-left: 50%;
    transform: translateX(-50%);
  }

  /* Seitlich derselbe Rand wie die Fortschrittsleiste des Bands — so
     stehen Zeiten und Leiste auf einer Fluchtlinie. Unten deutlich mehr
     Luft: Die Zeiten sollen nicht auf der gestrichelten Grundlinie
     sitzen (Florian, 17. September 2026). */
  .ozsprechstunden {
    position: relative;
    /* Oben der Gruppenabstand wie über dem Band; unten deutlich mehr,
       damit die Zeiten nicht auf der gestrichelten Grundlinie sitzen.
       Vorher stand oben der volle Abschnittsabstand — das riss die
       Sprechstunden zu weit vom Band weg (Florian). */
    padding: var(--abstand-gruppe) var(--abstand-seitenrand) var(--abstand-2xl);
  }

  /* Die Zeichnung hängt an der Unterkante der Fläche und ist so breit
     wie das Fenster; Breite und Höhe setzt das Skript in Bildpunkten,
     damit die Maße 1:1 stimmen. */
  .ozzipfel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    display: block;
    overflow: visible;
    pointer-events: none;
  }

  /* Weiße Fläche zwischen Blasenunterkante und schräger Grundlinie
     samt Zipfel — in der Vorlage ist das der Kasten selbst. */
  .ozzipfel__flaeche {
    fill: var(--farbe-flaeche);
    stroke: none;
  }

  /* Gestrichelte Kontur wie in der Lottie: 1 px, Muster 1/2 */
  .ozzipfel__kontur {
    fill: none;
    stroke: var(--farbe-primaer);
    stroke-width: 1;
    stroke-dasharray: 1 2;
    stroke-linejoin: round;
  }

  /* Kicker und Überschrift wie in jedem anderen Abschnitt — nur eine
     Spur kleiner, weil sie in der Blase stehen. */

  /* Überschrift links, Schließen-Kreuz rechts, beide auf einer Mitte.
     Der Abstand zum Kicker steht an der Zeile, nicht an der Überschrift:
     Läge er an ihr, zählte er zu ihrem Rand und das Kreuz säße um die
     halbe Höhe des Abstands zu hoch. */
  .ozblase__zeile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--abstand-m);
    margin-top: 20px;
  }

  .ozblase__titel {
    margin: 0;
    color: var(--farbe-primaer);
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem);
    font-weight: var(--gewicht-titel);
    line-height: 1.12;
    letter-spacing: -0.010em;
  }

  /* Dasselbe Schließen-Kreuz wie auf den Leistungsseiten (Aussehen in
     styles/global.css) — nur steht sein Kreis hier von Anfang an da,
     statt sich einzuzeichnen: Es gibt keinen Moment, in dem er anlaufen
     könnte, die Karte fährt ja schon herein (Florian, 17. September
     2026).

     Es steht in der Zeile der Überschrift und darf darin nicht
     schrumpfen. */
  .ozschliessen { flex: none; }

  .ozschliessen:hover,
  .ozschliessen:focus-visible {
    background-color: var(--farbe-flaeche-gedeckt);
  }

  /* ---- Das klebende Kreuz auf Handys (Florian, 26. September 2026) ----
     Exakt wie auf den Leistungsseiten: In der Zeile steht erst das
     nackte Kreuz ohne Kreis; sobald es beim Scrollen die Kopfleiste
     erreicht, übernimmt der Zwilling (Markup ganz unten) fest im
     Fenster — mit milchigem Grund, und der Kreis zeichnet sich ein
     (die geteilten Regeln stehen in styles/global.css, `[data-klebt]`).
     Lage und Zustand setzt `kreuzKleben()` im Skript, weil `sticky` in
     der transformierten, beschnittenen Karte nichts ausrichten kann. */
  .ozschliessen-klebend {
    position: fixed;
    top: var(--kreuz-oben, 96px);
    right: var(--kreuz-rechts, 34px);
    z-index: 1;
  }

  .ozschliessen-klebend:not([data-klebt]) { visibility: hidden; }
  .ozbereich[data-kreuz='klebt'] .ozschliessen { visibility: hidden; }

  @media (max-width: 991px) {
    /* Erst das nackte Kreuz — der Kreis kommt mit dem Kleben */
    .ozschliessen.schliessen--fest .schliessen__kreis { stroke-dashoffset: 139; }
  }

  @media (min-width: 62rem) {
    .ozschliessen-klebend { display: none; }
  }

  /* Über die volle Breite der Blase statt auf Lesebreite: In der Blase
     steht der Satz allein über drei Spalten und soll sie tragen
     (Florian, 17. September 2026). */
  .ozblase__einleitung {
    max-width: none;
    margin: 20px 0 48px;
    color: var(--farbe-text-gedeckt);
    font-size: 17px;
    line-height: var(--zeilenhoehe-lese);
  }

  /* Drei Listen nebeneinander — auf kleinen Bildschirmen untereinander */
  .ozblase__spalten {
    display: grid;
    /* Drei gleich breite Spalten. Die Zeilen darin laufen über die
       volle Spaltenbreite — Wochentag links, Zeit rechts, Haarlinie
       dazwischen. `minmax(0, 1fr)` statt `1fr`, damit lange Zeiten die
       Spalte nicht auseinanderdrücken. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 88px);
    align-items: start;
  }

  /* Handys: Listen untereinander. Die Blase darf höher sein als der
     Platz über der Leiste — sie ist kein Rollkasten; was oben hinaus-
     steht, kommt beim Weiterscrollen zum Vorschein. */
  /* Die drei Listen brauchen nebeneinander rund 840 px; darunter
     stehen sie untereinander. Vorher lag die Grenze bei 60 rem — dort
     passten sie schon nicht mehr und liefen seitlich heraus. */
  @media (max-width: 68rem) {
    .ozblase { width: calc(100% - 2 * var(--abstand-s)); }
    .ozsprechstunden { padding: var(--abstand-gruppe) var(--abstand-m) var(--abstand-xl); }
    .ozblase__spalten { grid-template-columns: 1fr; gap: var(--abstand-m); }
  }

  /* Handys: Die drei Listen stehen untereinander und machen den
     Abschnitt lang. Er wird deshalb enger getaktet, und oben wie unten
     steht derselbe Abstand — so sitzt der Block mittig zwischen
     Bilderband und Abschlusslinie statt nach unten versetzt (Florian,
     18. September 2026). */
  @media (max-width: 48rem) {
    /* Derselbe Rand wie überall sonst, statt eines eigenen Maßes —
       das bringt der Zeitentabelle nebenbei etwas mehr Breite. Oben
       knapper als unten: Unten bleibt Luft zur Grundlinie. Seit dem
       26. September 2026 noch einmal rund 130 px kürzer (Florian):
       Die Karte ist auf Handys nur noch die Sprechstunden und soll
       möglichst ganz ins Fenster passen. */
    .ozsprechstunden { padding: var(--abstand-m) var(--abstand-seitenrand) var(--abstand-l); }
    .ozblase__zeile { margin-top: var(--abstand-2xs); }
    .ozblase__titel { font-size: clamp(1.5rem, 1.2rem + 1.8vw, 2.75rem); }
    .ozblase__einleitung { margin: 10px 0 0; font-size: 15px; line-height: var(--zeilenhoehe-mittel); }
    .ozblase__spalten { gap: calc(var(--abstand-m) + var(--abstand-2xs)); margin-top: var(--abstand-m); }
  }

  /* Ohne Bewegung: Der Einstieg steht ruhig im Seitenfluss — Begrüßung,
     Band und Sprechstunden einfach untereinander. Das Schließen-Kreuz
     entfällt dabei: Es gibt nichts zu schließen, wenn nichts einfährt. */
  @media (prefers-reduced-motion: reduce) {
    .ozschliessen,
    .ozschliessen-klebend { display: none; }
    .ozraum { display: none; }
    .ozbereich { position: static; height: auto; padding-bottom: var(--abstand-abschnitt); }
    .ozbereich__buehne { position: static; height: auto; }
    .ozblase { position: static; transform: none; margin-inline: auto; }
    .ozzipfel { display: none; }
  }
</style>

{/* Ohne JavaScript dasselbe ruhige Bild wie bei reduzierter Bewegung —
    sonst stünde die Karte unsichtbar unter der Bühne. */}
<noscript>
  <style is:inline>
    .ozschliessen { display: none; }
    .ozraum { display: none; }
    .ozbereich { position: static; height: auto; padding-bottom: var(--abstand-abschnitt); }
    .ozbereich__buehne { position: static; height: auto; }
    .ozblase { position: static; transform: none; margin-inline: auto; }
    .ozzipfel { display: none; }
  </style>
</noscript>

<script>
  import { ausStuetzstellen, KURVEN, type Stuetzstelle } from '../scripts/easing';
  import {
    ozWeg, beimScrollenSichtbar, nachziehen, ozStuetzstellen,
    schnalzWeg, OZ_ZIPFEL_VOLL, SCHNALZ_DAUER,
  } from '../scripts/scrollwege';
  import { zuSprungmarke } from '../scripts/anker';

  /** Der Umbruch der Navigation — dort beginnt „Handy" */
  const HANDY = '(max-width: 991px)';

  /**
   * Handys: Begrüßung und Band stehen NACH der Karte — die Reihenfolge
   * der mobilen Vorlage (Logo → Blase → Willkommen → Galerie). Sie
   * wandern an den Anfang von <main>; die Karte ist dann nur die
   * Sprechstunden, und die ganze Bewegungsrechnung bleibt unverändert
   * (Florian, 26. September 2026). Auf dem Desktop kommen sie zurück in
   * die Karte. `scripts/anker.ts` misst Sprungmarken außerhalb der Karte
   * ganz normal.
   */
  function vorspannAnordnen() {
    const willkommen = document.getElementById('praxis');
    const band = document.querySelector<HTMLElement>('[data-ozband]');
    const sprechstunden = document.querySelector<HTMLElement>('.ozsprechstunden');
    const inhalt = document.getElementById('inhalt');
    if (!willkommen || !band || !sprechstunden || !inhalt) return;
    const handy = window.matchMedia(HANDY).matches;
    const draussen = willkommen.parentElement === inhalt;
    if (handy && !draussen) {
      inhalt.prepend(willkommen, band);
      willkommen.dataset.nachKarte = 'ja';
      band.dataset.nachKarte = 'ja';
    } else if (!handy && draussen) {
      sprechstunden.before(willkommen, band);
      delete willkommen.dataset.nachKarte;
      delete band.dataset.nachKarte;
    }
  }

  /**
   * Die Kreuze in der Karte (das in der Zeile und der klebende
   * Zwilling): Sie hängt am Scrollweg, lässt sich also nicht
   * „wegklicken". Stattdessen gleitet die Seite dorthin, wo der Einstieg
   * vorbei ist — auf dem Desktop ans Ende des Bereichs, auf Handys zur
   * Begrüßung, die dort als Nächstes folgt.
   */
  function ozSchliessenAufbauen() {
    const raum = document.querySelector<HTMLElement>('.ozraum');
    document.querySelectorAll<HTMLElement>('[data-ozschliessen]').forEach((knopf) => {
      if (!raum || knopf.dataset.bereit) return;
      knopf.dataset.bereit = 'ja';
      knopf.addEventListener('click', () => {
        if (window.matchMedia(HANDY).matches && zuSprungmarke('#praxis')) return;
        const unten = window.scrollY + raum.getBoundingClientRect().bottom - 96;
        window.scrollTo({
          top: Math.max(0, Math.round(unten)),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? ('instant' as ScrollBehavior)
            : 'smooth',
        });
      });
    });
  }

  /** Höhe der Symbolleiste unten — `.fussleiste__inhalt` */
  const LEISTE = 110;

  /** Luft zwischen der Spitze des Zipfels und der Oberkante der
      Symbolleiste. Ohne sie endete die Spitze genau auf deren
      Punktlinie und verschwand dahinter; sie soll knapp darüber stehen
      (Florian, 18. September 2026). */
  const LUFT = 10;

  /**
   * Die Fensterbreite OHNE Rollleiste als CSS-Wert. `100vw` zählt sie
   * mit; ein Element mit `width: 100vw` wäre also ein paar Pixel zu
   * breit und ließe die Seite waagerecht überlaufen.
   */
  let breiteGemerkt = false;
  function fensterbreiteMerken() {
    if (breiteGemerkt) return;
    breiteGemerkt = true;
    const setzen = () =>
      document.documentElement.style.setProperty('--fensterbreite', `${document.documentElement.clientWidth}px`);
    setzen();
    window.addEventListener('resize', setzen, { passive: true });
  }

  /* Maße des Zipfels aus der Lottie der Vorlage, bezogen auf die
     Spitze T bei voller Länge 155 px. Links/rechts der Basis als
     Abstand zu T: eingezogen (Bild 0) und ausgefahren (Bild 100). */
  const VORLAGE = {
    laenge: 155,
    basisLinks: { zu: -112, auf: -60 },
    spitze: { zu: -31, auf: 0 },
    basisRechts: { zu: 5, auf: -27 },
    /* Die Grundlinie fällt nach links ab: 18 px auf 600 px Breite */
    neigung: 18 / 600,
  };

  /**
   * Fährt die Sprechstunden am Scrollweg entlang herein — Ablauf a-19 —
   * und zeichnet Grundlinie und Zipfel.
   */
  function ozAufbauen() {
    const bereich = document.querySelector<HTMLElement>('.ozbereich');
    const blase = document.querySelector<HTMLElement>('[data-ozblase]');
    const svg = document.querySelector<SVGSVGElement>('[data-ozzipfel]');
    const flaeche = document.querySelector<SVGPathElement>('[data-ozflaeche]');
    const kontur = document.querySelector<SVGPathElement>('[data-ozkontur]');
    if (!bereich || !blase || !svg || !flaeche || !kontur || blase.dataset.bereit) return;
    blase.dataset.bereit = 'ja';

    /* Das Bilderband in der Karte läuft über die volle Fensterbreite und
       braucht sie deshalb als Zahl — auch dann, wenn die Karte selbst
       sich nicht bewegt. */
    fensterbreiteMerken();

    /* Eine Reihenfolge je Fensterbreite — auch ohne Bewegung */
    vorspannAnordnen();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* ---- Geometrie: wird bei Größenänderung neu vermessen ---- */
    let breite = 0;        // Fensterbreite
    let laenge = 154;      // Zipfellänge (--zipfel-laenge)
    let spitzeX = 0;       // x der Spitze = Mitte des Sprechstunden-Knopfs
    let versatzOben = 0;   // Grundlinie in der Mitte, unter der Blasenkante
    let ruhelage = 264;    // bottom-Wert der Blase in Ruhe

    /** y der Grundlinie an Stelle x (SVG-Koordinaten, 0 = Blasenkante) */
    const grundlinie = (x: number) => versatzOben + (breite / 2 - x) * VORLAGE.neigung;

    const vermessen = () => {
      breite = document.documentElement.clientWidth;
      laenge = parseFloat(getComputedStyle(blase).getPropertyValue('--zipfel-laenge')) || 154;

      /* Der Knopf in der Symbolleiste. Nur seine x-Lage zählt — die
         Leiste fährt beim Scrollen weg, ihre Höhe ist aber fest. */
      /* Es gibt zwei Leisten (Desktop und Handy); die sichtbare hat Breite. */
      const kr = [...document.querySelectorAll<HTMLElement>('.fussknopf[data-punkt="zeiten"]')]
        .map((k) => k.getBoundingClientRect())
        .find((r) => r.width > 0);
      spitzeX = kr ? kr.left + kr.width / 2 : breite * 0.8667;

      /* Die Linie darf rechts nicht über die Blasenkante steigen:
         Versatz so wählen, dass der höchste Punkt 2 px darunter liegt. */
      versatzOben = Math.max(4, (breite / 2) * VORLAGE.neigung + 2);

      /* Blase so hoch, dass die ausgefahrene Spitze knapp über der
         Leiste endet */
      ruhelage = LEISTE + LUFT + laenge + grundlinie(spitzeX);
      document.documentElement.style.setProperty('--oz-ruhe', `${ruhelage}px`);

      const hoehe = versatzOben * 2 + laenge + 4;
      svg.setAttribute('width', String(breite));
      svg.setAttribute('height', String(hoehe));
      svg.setAttribute('viewBox', `0 0 ${breite} ${hoehe}`);

    };

    /**
     * Zeichnet Fläche und Kontur.
     *
     * @param aus     Ausfahrgrad am Scrollweg, 0 … 1
     * @param schnalz 1 = der Zipfel steht, 0 = zurückgeschnalzt
     *
     * Die Spitze zeigt bis zum Schnalz EXAKT auf die Mitte des
     * Sprechstunden-Knopfs — beim Ausfahren wandert nur die Basis
     * (Florian, 18. September 2026). Erst beim Zurückschnalzen lehnt
     * sie sich weg; genau das gibt der Bewegung ihren Schwung.
     */
    const zipfelZeichnen = (aus: number, schnalz: number) => {
      const anteil = aus * schnalz;
      const f = laenge / VORLAGE.laenge;
      const zw = (m: { zu: number; auf: number }) => (m.zu + (m.auf - m.zu) * anteil) * f;
      const xL = spitzeX + zw(VORLAGE.basisLinks);
      const xS = spitzeX + VORLAGE.spitze.zu * (1 - schnalz) * f;
      const xR = spitzeX + zw(VORLAGE.basisRechts);
      const yL = grundlinie(xL);
      const yR = grundlinie(xR);
      const yS = grundlinie(xS) + anteil * laenge;

      const linie =
        `M0 ${grundlinie(0).toFixed(2)} L${xL.toFixed(2)} ${yL.toFixed(2)} ` +
        `L${xS.toFixed(2)} ${yS.toFixed(2)} L${xR.toFixed(2)} ${yR.toFixed(2)} ` +
        `L${breite} ${grundlinie(breite).toFixed(2)}`;

      kontur.setAttribute('d', linie);
      /* Fläche: dieselbe Linie, oben bis knapp über die Blasenkante
         geschlossen — deckt die Lücke zwischen Kante und Schräge. */
      flaeche.setAttribute('d', `${linie} L${breite} -2 L0 -2 Z`);
    };

    /* ---- Bewegung ---- */

    /* Schlüsselstellen aus a-19 — sie stehen in scripts/scrollwege.ts,
       weil scripts/anker.ts sie ebenfalls braucht (zum Umrechnen einer
       Sprungmarke INNERHALB der Karte in eine Scrolltiefe). */
    let BLASE = ozStuetzstellen(700, 154);

    /* Der Startwert der Vorlage ist 700 px. Er reicht dort, weil die
       Blase nur rund 400 px hoch ist. Unsere Karte trägt den ganzen
       Einstieg und ist ein Vielfaches davon — der Startwert muss also
       mitwachsen, sonst stünde sie beim Laden schon im Bild. Er wird
       zusätzlich als `--oz-start` veröffentlicht. */
    const startBestimmen = () => {
      const start = Math.max(700, ruhelage + blase.offsetHeight + 40);
      BLASE = ozStuetzstellen(start, laenge);
      blase.style.setProperty('--oz-start', `${Math.round(start)}px`);
    };

    /* Der Zipfel fährt aus, während die Blase einrastet — und bleibt
       dann stehen. Das Einziehen hängt NICHT mehr am Scrollweg: Es ist
       der Schnalz und läuft als eigene, schnelle Bewegung ab (unten).

       Die Stellen sind dieselben wie in der Vorlage, nur auf den um
       die Wartezeit verlängerten Weg umgerechnet: 50 % → 61 %,
       71 % → 74 % (OZ_ZIPFEL_VOLL). Vorher standen hier noch die
       ungerechneten Werte — deshalb passte der Schnalz nicht mehr
       (Florian, 18. September 2026). */
    const ZIPFEL: Stuetzstelle[] = [
      { bei: 0.00, wert: 0, kurve: 'linear' },
      { bei: 0.61, wert: 0, kurve: 'outCubic' },
      { bei: OZ_ZIPFEL_VOLL, wert: 0.99, kurve: 'linear' },
      { bei: 1.00, wert: 0.99 },
    ];

    /* Erst messen (das setzt Zipfellänge und Ruhelage), dann den
       Startwert daraus bestimmen. */
    vermessen();
    startBestimmen();

    /** Der Wert, der gezeichnet wird — läuft dem Scrollwert nach. */
    let p = ziel();
    let laeuft = false;
    let zuletzt = 0;

    /** Scrollwert wie Webflows „while scrolling in view". */
    function ziel(): number {
      return beimScrollenSichtbar(ozWeg(), bereich!.getBoundingClientRect().top);
    }

    /* ---- Der Schnalz ----
       Ab derselben Scrolltiefe, bei der die Leisten tauschen
       (`schnalzWeg()`, Navigation.astro), zieht sich der Zipfel zurück —
       nicht am Scrollrad, sondern in einer eigenen Bewegung von 300 ms
       mit easeOut, genau der Dauer und Kurve des Leistenwechsels.
       Beides zusammen ist der Schnalz (Florian, 18. September 2026).
       Rückwärts läuft er ebenso: Wer wieder hochscrollt, sieht den
       Zipfel in derselben Zeit wieder ausfahren. */
    const schnalzSoll = () => (window.scrollY > schnalzWeg() * window.innerHeight ? 0 : 1);

    let schnalz = schnalzSoll();
    let schnalzZiel = schnalz;
    let schnalzVon = schnalz;
    let schnalzStart = 0;

    /** Rückt den Schnalz einen Zeitschritt weiter; true, solange er läuft. */
    const schnalzSchritt = (jetzt: number): boolean => {
      const soll = schnalzSoll();
      if (soll !== schnalzZiel) {
        schnalzZiel = soll;
        schnalzVon = schnalz;
        schnalzStart = jetzt;
      }
      if (schnalz === schnalzZiel) return false;
      const t = Math.min(1, (jetzt - schnalzStart) / SCHNALZ_DAUER);
      schnalz = t >= 1 ? schnalzZiel : schnalzVon + (schnalzZiel - schnalzVon) * KURVEN.easeOut(t);
      return schnalz !== schnalzZiel;
    };

    /* ---- Das klebende Kreuz (Handys) ----
       Wie auf den Leistungsseiten, nur von Hand: `sticky` kann in der
       transformierten, beschnittenen Karte nichts ausrichten. Also wird
       je Bild gemessen, wo das Kreuz der Zeile steht — während der Fahrt
       und, nach der Freigabe, bei jedem Scrollen. Erreicht es die
       Kopfleiste, übernimmt der Zwilling fest im Fenster; beide stehen
       in diesem Moment deckungsgleich, Grund und Kreis laufen ab da an.
       Fährt die Karte oben hinaus, nimmt er das Kreuz mit. */
    const KOPF = 96;   // wie `.schliessen-halter { top }` der Unterseiten
    const kreuz = blase.querySelector<HTMLElement>('.ozschliessen');
    const klebend = bereich.querySelector<HTMLElement>('[data-ozklebend]');
    const kreuzLoesen = () => {
      if (klebend) delete klebend.dataset.klebt;
      delete bereich.dataset.kreuz;
    };
    const kreuzKleben = () => {
      if (!kreuz || !klebend) return;
      if (!window.matchMedia(HANDY).matches) { kreuzLoesen(); return; }
      const k = kreuz.getBoundingClientRect();
      const karte = blase.getBoundingClientRect();
      if (!(k.top < KOPF && karte.bottom > 0)) { kreuzLoesen(); return; }
      klebend.style.setProperty('--kreuz-oben', `${Math.round(Math.min(KOPF, karte.bottom - 48))}px`);
      klebend.style.setProperty('--kreuz-rechts', `${Math.round(document.documentElement.clientWidth - k.right)}px`);
      if (!klebend.dataset.klebt) {
        if (document.activeElement === kreuz) klebend.focus();
        klebend.dataset.klebt = 'ja';
        bereich.dataset.kreuz = 'klebt';
      }
    };

    const zeichnen = () => {
      blase.style.setProperty('--oz-versatz', `${ausStuetzstellen(p, BLASE)}px`);
      zipfelZeichnen(ausStuetzstellen(p, ZIPFEL), schnalz);
      kreuzKleben();
    };

    /* Eigene Schleife statt reinem Scroll-Ereignis: Der Nachlauf muss
       auch dann noch weiterlaufen, wenn das Scrollen längst aufgehört
       hat. Sie hält an, sobald der Wert das Ziel erreicht hat. */
    const schritt = (jetzt: number) => {
      const dt = zuletzt ? Math.min(100, jetzt - zuletzt) : 16.7;
      zuletzt = jetzt;

      const z = ziel();
      p = nachziehen(p, z, dt);
      if (Math.abs(z - p) < 0.0002) p = z;

      const schnalzt = schnalzSchritt(jetzt);

      zeichnen();

      if (p !== z || schnalzt) requestAnimationFrame(schritt);
      else laeuft = false;
    };

    const anstossen = () => {
      if (laeuft) return;
      laeuft = true;
      zuletzt = 0;
      requestAnimationFrame(schritt);
    };

    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', () => {
      /* Zuerst die Reihenfolge — sie ändert die Kartenhöhe, die alle
         folgenden Maße brauchen. (Nicht per `matchMedia('change')`:
         das feuert nach `resize`, die Messung wäre veraltet.) */
      vorspannAnordnen();
      vermessen();
      startBestimmen();
      zeichnen();
      anstossen();
    }, { passive: true });

    /* Die Symbolleiste könnte ihre Schrift erst nach dem ersten Bild
       gesetzt haben — einmal kurz danach nachmessen. */
    requestAnimationFrame(() => { vermessen(); zeichnen(); });
    zeichnen();
  }

  ozAufbauen();
  ozSchliessenAufbauen();
  document.addEventListener('astro:page-load', () => {
    ozAufbauen();
    ozSchliessenAufbauen();
  });
</script>
