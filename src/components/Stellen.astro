---
import { trennen, trennenHtml } from '../lib/silben';
/**
 * Stellenanzeigen — eigener Bereich, von der Praxis pflegbar.
 * Ist keine Stelle aktiv, erscheint der Bereich gar nicht.
 *
 * Gestaltung nach dem Handoff vom 17. September 2026: eine Liste auf
 * Haarlinien, jede Zeile klappt auf. **Alle Zeilen sind beim Laden
 * zugeklappt** (Florian, 18. September 2026); dass etwas dahinter
 * steckt, zeigt der Anriss unter der Bezeichnung.
 *
 * Ohne JavaScript sind alle Stellen offen (das Skript klappt sie erst
 * zu). Nichts ist dann unerreichbar.
 */
import Haken from './Haken.astro';
import daten from '../content/stellen.json';
import seite from '../content/seite.json';

const { praxis } = seite;

const stellen = daten.eintraege
  .filter((e) => e.aktiv && e.titel)
  .sort((a, b) => a.position - b.position);

/** Zweistellige Nummer vor jeder Zeile */
const nummer = (i: number) => String(i + 1).padStart(2, '0');

/**
 * Anriss für die zugeklappte Zeile: der erste Satz der Beschreibung,
 * ohne Auszeichnung und auf eine Zeile gekürzt.
 */
const anriss = (html: string, laenge = 110) => {
  const text = html.replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();
  if (text.length <= laenge) return text;
  const gekuerzt = text.slice(0, laenge);
  const luecke = gekuerzt.lastIndexOf(' ');
  return (luecke > 40 ? gekuerzt.slice(0, luecke) : gekuerzt) + ' …';
};

/** Bewerbung per E-Mail — mit der Stelle schon im Betreff */
const bewerbung = (titel: string) =>
  `mailto:${praxis.email}?subject=${encodeURIComponent(`Bewerbung: ${titel}`)}`;
---

{stellen.length > 0 && (
  <section class="stellen bereich bereich--ohne-oben" id="stellen" data-verlauf aria-labelledby="stellen-titel">
    <div class="bereich__inhalt">
      <div class="kicker" data-rein>Stellenangebote</div>
      <h2 class="bereich__titel" id="stellen-titel" data-rein>{daten.titel || 'Wir suchen Verstärkung'}</h2>
      {daten.einleitung && <p class="bereich__einleitung" data-rein>{daten.einleitung}</p>}

      <div class="stellen__liste" data-rein data-stellenliste>
        {stellen.map((s, i) => (
          <div class="stelle">
            <h3 class="stelle__kopf">
              <button
                class="stelle__knopf"
                type="button"
                aria-expanded="true"
                aria-controls={`stelle-${s.id}`}
                data-stellenknopf
              >
                <span class="stelle__nummer" aria-hidden="true">{nummer(i)}</span>
                <span class="stelle__titel">
                  <span class="stelle__titeltext">{s.titel}</span>
                  {/* Nur zu sehen, solange die Zeile zu ist — sonst
                      stünde der Anriss über seinem eigenen Text. */}
                  {s.beschreibung && <span class="stelle__anriss">{trennen(anriss(s.beschreibung))}</span>}
                </span>
                {s.umfang && <span class="stelle__umfang">{s.umfang}</span>}
                <span class="stelle__kreis" aria-hidden="true">
                  <Haken />
                </span>
              </button>
            </h3>

            <div class="stelle__klappe" id={`stelle-${s.id}`} data-stellenklappe>
              <div class="stelle__innen">
                <div class="stelle__spalten">
                  <div class="stelle__text redaktionstext" set:html={trennenHtml(s.beschreibung)} />

                  <div class="stelle__seite">
                    {s.ansprechpartner && (
                      <p class="stelle__ansprech">
                        <span class="kicker kicker--klein">Ansprechpartner</span>
                        {s.ansprechpartner}
                      </p>
                    )}
                    <div class="stelle__knoepfe">
                      <a class="kn kn--voll kn--klein" href={bewerbung(s.titel)}>
                        <span class="kn__f" aria-hidden="true"></span>Jetzt bewerben
                      </a>
                      {s.pdf_datei && (
                        <a class="kn kn--klein" href={s.pdf_datei} download>
                          <span class="kn__f" aria-hidden="true"></span>Ausschreibung (PDF)
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p class="stellen__fuss" data-rein>
        Keine passende Stelle dabei? Wir freuen uns auch über eine
        <a href={`mailto:${praxis.email}`}>unaufgeforderte Bewerbung</a>.
      </p>
    </div>
  </section>
)}

<style>
  /* Kein eigener Stapel (kein z-index): Die klebende Ansprechperson
     muss über den Randverläufen der Seite liegen können — und das
     geht nur, wenn zwischen ihr und der Wurzel kein Stapelkontext
     liegt (Florian, 27. September 2026; siehe `.stelle__seite`). */
  .stellen {
    position: relative;
    background: var(--farbe-flaeche);
    /* Nichts im Abschnitt darf die Seite waagerecht rollen lassen —
       auf Florians iPhone rollte sie bei offener Stelle (27. September
       2026); `clip` lässt das Kleben der Ansprechperson unberührt */
    overflow-x: clip;
  }

  /* Wie weit die Nummer nach links aus der Spalte ragt. Sie braucht
     rund 22 px plus Luft; mehr als der Seitenrand hergibt, darf es
     nicht sein — sonst stünde sie außerhalb des Fensters. */
  .stellen__liste { --nummer-versatz: 40px; }

  .stellen__liste {
    margin-top: 44px;
    border-top: 1px solid var(--farbe-linie);
  }

  .stelle { border-bottom: 1px solid var(--farbe-linie); }

  .stelle__kopf { margin: 0; }

  /* Größe der Bezeichnung und Höhe ihrer ersten Zeile: Daran richten
     sich Kreis, Umfang und (einspaltig) die Nummer aus. Auf Handys
     wächst die Bezeichnung beim Aufklappen (siehe unten). */
  .stelle__knopf {
    --titel-groesse: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    --titel-zeile: calc(1.28 * var(--titel-groesse));
    position: relative;
    display: flex;
    /* Oben ausgerichtet, nicht mittig: Beim Aufklappen zieht sich der
       Anriss unter der Bezeichnung zusammen — mittig gesetzt wanderten
       Kreis und Umfang dabei mit. Jetzt stehen sie fest auf der ersten
       Zeile (26. September 2026). */
    align-items: flex-start;
    gap: clamp(16px, 2.5vw, 40px);
    width: 100%;
    padding: clamp(22px, 2.6vw, 32px) 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  /* Die Nummer steht AUSSERHALB der Textspalte, im Seitenrand daneben:
     So beginnt die Bezeichnung auf derselben Fluchtlinie wie der Text
     darunter (Florian, 18. September 2026). */
  .stelle__nummer {
    position: absolute;
    left: calc(-1 * var(--nummer-versatz));
    top: clamp(28px, 3vw, 38px);
    color: var(--farbe-text-leise);
    font-size: var(--text-kicker);
    font-weight: var(--gewicht-mittel);
    line-height: 1;
    letter-spacing: var(--sperrung-kicker-klein);
    font-variant-numeric: tabular-nums;
  }

  .stelle__titel {
    flex: 1;
    min-width: 0;
    color: var(--farbe-primaer);
    font-size: var(--titel-groesse);
    font-weight: var(--gewicht-mittel);
    line-height: 1.28;
    letter-spacing: -0.012em;
  }

  /* Der Umfang ist eine Beigabe — auf schmalen Schirmen entfällt er,
     damit der Titel die Zeile behält.

     Mittig auf der ersten Zeile der Bezeichnung: 29 px hoch (13 px
     Zeile + 2 × 7 px Innenabstand + 2 × 1 px Rahmen). */
  .stelle__umfang {
    flex: none;
    margin-top: calc((var(--titel-zeile) - 29px) / 2);
    padding: 7px 16px;
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius-rund);
    color: var(--farbe-text-gedeckt);
    font-size: 13px;
    font-weight: var(--gewicht-mittel);
    line-height: 1;
    white-space: nowrap;
  }

  /* Der Kreis ebenso: 32 px, mittig auf der ersten Zeile. Ist die Zeile
     niedriger als er (auf Handys), wird der Abstand negativ und er ragt
     ein paar Pixel in den Innenabstand hinein — das ist gewollt. */
  .stelle__kreis {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-top: calc((var(--titel-zeile) - 32px) / 2);
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius-rund);
    transition: border-color 0.4s var(--verlauf-betont);
  }

  /* Wächst die Bezeichnung (Handys, beim Aufklappen), ziehen Kreis und
     Umfang auf ihrer Zeile mit — erst, wenn das Skript die Liste
     zugeklappt hat, sonst rutschten sie beim Laden. */
  .stellen__liste[data-bereit] .stelle__kreis {
    transition:
      border-color 0.4s var(--verlauf-betont),
      margin-top 0.6s var(--verlauf-betont);
  }

  .stellen__liste[data-bereit] .stelle__umfang {
    transition: margin-top 0.6s var(--verlauf-betont);
  }

  .stelle__knopf:hover .stelle__kreis,
  .stelle__knopf:focus-visible .stelle__kreis { border-color: var(--farbe-primaer); }


  /* Aufklappen über die Zeilenhöhe des Rasters: Das Ziel ist der
     natürliche Inhalt, keine geratene Höhe. */
  .stelle__klappe {
    display: grid;
    grid-template-rows: 1fr;
  }

  /* Die Bewegung wird erst freigegeben, wenn das Skript die Liste
     zugeklappt hat — sonst sähe man beim Laden, wie alle Stellen
     zusammenfahren. */
  .stellen__liste[data-bereit] .stelle__klappe {
    /* 0,7 s — etwas gemächlicher (Florian, 27. September 2026; vorher
       0,5). Muss mit `KLAPPEN` im Skript übereinstimmen. */
    transition: grid-template-rows 0.7s var(--verlauf-betont);
  }

  .stelle__klappe[data-zu] { grid-template-rows: 0fr; }

  /* `clip`, nicht `hidden`: Beides schneidet ab, aber `hidden` macht
     die Zelle zum Rollbereich — und damit zum Bezug für die klebende
     Ansprechperson (Handys, unten). Die klebte dann an der Zelle statt
     am Fenster, stand beim Aufklappen unsichtbar am Ende des Inhalts
     und sprang erst mit dem Öffnen ans Fenster. Mit `clip` bleibt das
     Fenster der Bezug: Die Leiste wird beim Wachsen freigelegt und
     klebt sofort (Florian, 27. September 2026). */
  .stelle__innen {
    overflow: clip;
    /* Etwas Luft für Fokusringe an den Rändern */
    overflow-clip-margin: 8px;
    min-height: 0;
    min-width: 0;
    /* Die Breite der Zelle richtet sich allein nach der Spalte, nie
       nach dem Inhalt — der Inhalt bricht in ihr um, auf jeder Größe */
    contain: inline-size;
  }

  /* Auch offen bleibt die Zelle beschnitten: `clip` stört das Kleben
     nicht, und nichts in der Klappe kann die Seite breiter machen — auf
     Florians iPhone rollte die Seite bei offener Stelle waagerecht
     (27. September 2026). Bis dahin stand hier `overflow: visible` für
     die offene Zeile. */

  .stelle__spalten {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(24px, 3vw, 56px);
    align-items: start;
    padding-bottom: clamp(28px, 3vw, 40px);
  }

  /*
    Der Anriss zeigt bei zugeklappter Zeile, was dahintersteckt — und
    übergibt beim Aufklappen an den echten Text: Er zieht sich zusammen
    und blendet aus, während derselbe Satz eine Zeile tiefer groß
    wieder auftaucht (Florian, 18. September 2026). Vorher verschwand
    er hart.
  */
  /* Höchstens drei Zeilen, sauber abgeschnitten (`line-clamp` setzt
     die Punkte) — vorher kappte `max-height: 4em` mitten in der dritten
     Zeile (Florian, 27. September 2026). Im Blocksatz wie die
     Lesetexte; die Trennstellen setzt der Build. */
  .stelle__anriss {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    max-width: 52ch;
    max-height: 4.5em;
    margin-top: 6px;
    color: var(--farbe-text-gedeckt);
    font-size: 15px;
    font-weight: var(--gewicht-normal);
    line-height: 1.5;
    text-align: justify;
    -webkit-hyphens: auto;
    hyphens: auto;
  }

  .stelle__titeltext { display: block; }

  .stellen__liste[data-bereit] .stelle__anriss {
    transition:
      max-height 0.6s var(--verlauf-betont),
      margin-top 0.6s var(--verlauf-betont),
      opacity 0.26s var(--verlauf);
  }

  .stelle__knopf[aria-expanded='true'] .stelle__anriss {
    max-height: 0;
    margin-top: 0;
    opacity: 0;
  }

  /*
    Der Inhalt kommt gestaffelt nach: erst der Text, dann die Spalte mit
    der Ansprechperson — beide leicht von unten und aufblendend, sobald
    die Klappe Platz gemacht hat.
  */
  .stelle__text,
  .stelle__seite {
    opacity: 0;
    transform: translateY(16px);
  }

  .stellen__liste[data-bereit] .stelle__text {
    transition:
      opacity 0.7s var(--verlauf-betont),
      transform 0.7s var(--verlauf-betont);
  }

  .stellen__liste[data-bereit] .stelle__seite {
    transition:
      opacity 0.4s var(--verlauf-betont),
      transform 0.4s var(--verlauf-betont);
  }

  .stelle__klappe:not([data-zu]) .stelle__text {
    opacity: 1;
    transform: none;
    transition-delay: 0.1s;
  }

  /*
    Die Ansprechperson kommt erst, wenn die Klappe steht.

    Sie klebt beim Scrollen (`position: sticky`) — und das wirkt erst,
    wenn der Überlauf freigegeben ist, also nach der Bewegung
    (`data-offen`, siehe Skript). Blendete sie vorher schon ein, spränge
    sie in genau diesem Moment an ihre klebende Lage. Jetzt fällt der
    Sprung in die Zeit, in der sie noch unsichtbar ist; sichtbar wird
    erst das ruhige Einblenden von ihrem endgültigen Platz aus
    (Florian, 18. September 2026). Sie kommt ohne Verzögerung — die
    Klappe hat ja schon gewartet.
  */
  .stelle__klappe[data-offen] .stelle__seite {
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  /*
    Zuklappen in zwei Schritten (26. September 2026): Erst blenden Text
    und Ansprechperson aus (`data-schliesst`, 0,2 s) — die Klappe steht
    dabei noch in voller Höhe, die Ansprechperson klebt noch. Erst dann
    nimmt das Skript den Überlauf zurück und fährt die Höhe zu. Vorher
    geschah beides zugleich, und die Ansprechperson sprang sichtbar von
    ihrer klebenden Lage zurück in die Zeile.

    Die Regeln stehen NACH denen für `[data-offen]` und
    `:not([data-zu])`: gleiche Spezifität, die spätere gewinnt — und
    während des Ausblendens sind beide Zustände noch gesetzt.
  */
  .stelle__klappe[data-schliesst] .stelle__text,
  .stelle__klappe[data-schliesst] .stelle__seite {
    opacity: 0;
    transform: translateY(16px);
    transition-duration: 0.2s;
    transition-delay: 0s;
  }

  /* Fällt die Klappe zu, ohne dass sie je ganz offen stand (schnelles
     Hin und Her, oder ohne Bewegung), geht der Inhalt gleich mit —
     ohne Verzögerung, damit nichts nachhängt. */
  .stelle__klappe[data-zu] .stelle__text {
    transition-duration: 0.2s;
    transition-delay: 0s;
  }

  .stelle__klappe[data-zu] .stelle__seite {
    transition-duration: 0.12s;
    transition-delay: 0s;
  }

  /* Dieselbe Textgröße wie in den freien Abschnitten (26. September
     2026); vorher 16,5 / 15,5 px fest. */
  .stelle__text :global(p) {
    /* Die Spalte begrenzt die Zeilenlänge; im Blocksatz muss der Absatz
       sie füllen (global.css, „Blocksatz") */
    max-width: none;
    margin-bottom: var(--abstand-s);
    font-size: var(--text-flies);
    line-height: var(--zeilenhoehe-lese);
  }

  .stelle__text :global(li) {
    font-size: var(--text-flies);
    line-height: 1.55;
  }

  /* Läuft beim Scrollen mit: Bei einer langen Anzeige bleiben
     Ansprechperson und Bewerbungsknopf im Bild (Florian, 18. September
     2026). 80 px sind die Kopfleiste, der Rest ist Luft. */
  .stelle__seite {
    position: sticky;
    top: calc(80px + var(--abstand-m));
    /* Über den Randverläufen (styles/global.css: --ebene-navigation − 3),
       unter Schleier und Leisten. Wirkt nur, weil weder `.stellen` noch
       `.seiteninhalt` einen eigenen Stapel aufmachen. */
    z-index: calc(var(--ebene-navigation) - 2);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .stelle__ansprech {
    max-width: none;
    margin: 0;
    color: var(--farbe-text);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .stelle__ansprech .kicker {
    display: block;
    margin-bottom: 8px;
  }

  .stelle__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .stellen__fuss {
    max-width: none;
    margin: 28px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 15.5px;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .stelle__umfang { display: none; }
  }

  /*
    Schmale Fenster: alles untereinander. Die Ansprechperson klebt dort
    **unten** am Bildschirmrand, solange man in der offenen Anzeige
    liest (Florian, 18. September 2026) — oben wäre kein Platz, dort
    steht schon die Kopfleiste.

    Dafür muss `.stelle__spalten` ein gewöhnlicher Block sein: In einem
    Raster ist die Zeile nur so hoch wie ihr Inhalt, und ein Element hat
    darin keinen Weg, an dem es kleben könnte.

    Und weil der Seitenrand hier nur 24 px misst, rückt die Nummer
    zurück in die Zeile.

    Die aufgeklappte Bezeichnung wächst hier (26. September 2026): Sie
    wird zur Überschrift dessen, was man gerade liest — einspaltig gibt
    es sonst nichts, was die offene Zeile von den zugeklappten abhebt.
    Auf breiten Fenstern bleibt sie gleich groß; dort zeigt schon die
    zweite Spalte, was offen ist.
  */
  @media (max-width: 800px) {
    .stelle__spalten { display: block; }

    /* Die Bezeichnung wächst über `transform`, nicht über den
       Schriftgrad: Ein wachsender Schriftgrad ist eine Layout-Animation,
       die bei jedem Bild die ganze Liste neu setzt — auf dem Handy
       ruckelte das (Florian, 27. September 2026). Deshalb liegt sie im
       LAYOUT immer in der offenen Größe (`--titel-gross`) und ist zu nur
       optisch auf 1/1,165 verkleinert, aus der linken oberen Ecke; die
       Umbrüche sind damit zu und offen von selbst dieselben. Zu bleibt
       unter der verkleinerten Schrift etwas Luft — die Höhe des
       größeren Kastens.

       `--titel-groesse` (klein zu, groß offen) bleibt für die
       Ausrichtung von Kreis und Nummer auf die erste Zeile
       (`--titel-zeile`); die läuft weiter über den Außenabstand mit. */
    .stelle__knopf {
      --titel-gross: clamp(1.35rem, 1.15rem + 0.85vw, 1.85rem);
      --titel-groesse: calc(var(--titel-gross) / 1.165);
    }

    .stelle__knopf[aria-expanded='true'] {
      --titel-groesse: var(--titel-gross);
    }

    .stelle__titel { font-size: var(--titel-gross); }

    .stelle__titeltext {
      transform: scale(0.8584);
      transform-origin: 0 0;
    }

    .stelle__knopf[aria-expanded='true'] .stelle__titeltext { transform: none; }

    .stellen__liste[data-bereit] .stelle__titeltext {
      transition: transform 0.6s var(--verlauf-betont);
    }

    /* Klebt am unteren Rand — ohne eigene Bewegung: Die Klappe legt sie
       beim Wachsen frei und nimmt sie wieder mit (Florian, 27. September
       2026; vorher fuhr sie 28 px von unten herauf). Sie liegt über dem
       unteren Randverlauf (z-index oben). */
    .stelle__seite,
    .stelle__klappe[data-offen] .stelle__seite,
    .stelle__klappe[data-schliesst] .stelle__seite {
      position: sticky;
      top: auto;
      bottom: 0;
      margin-top: var(--abstand-m);
      padding-block: var(--abstand-s);
      border-top: 1px solid var(--farbe-linie-leise);
      background: var(--farbe-flaeche);
      transform: none;
    }

    /* Immer sichtbar — die Klappe legt sie frei und nimmt sie wieder
       mit; keine eigene Blende, kein eigener Weg */
    .stellen__liste[data-bereit] .stelle__seite { transition: none; }
    .stelle__seite,
    .stelle__klappe[data-offen] .stelle__seite,
    .stelle__klappe[data-schliesst] .stelle__seite,
    .stelle__klappe[data-zu] .stelle__seite { opacity: 1; }

    /* Auf der ersten Zeile der Bezeichnung, wie Kreis und Umfang —
       12 px hoch (`--text-kicker` bei Zeilenhöhe 1). */
    .stelle__nummer {
      position: static;
      flex: none;
      margin-top: calc((var(--titel-zeile) - var(--text-kicker)) / 2);
    }

    .stellen__liste[data-bereit] .stelle__nummer {
      transition: margin-top 0.6s var(--verlauf-betont);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Mit dem Vorspann `.stellen__liste[data-bereit]`, weil die
       Bewegungen oben genau so freigegeben werden: Die Klasse allein
       hätte die geringere Spezifität, und die Regel bliebe ohne Wirkung
       (bis zum 26. September 2026 war das so). */
    .stelle__kreis,
    .stellen__liste[data-bereit] .stelle__klappe,
    .stellen__liste[data-bereit] .stelle__titel,
    .stellen__liste[data-bereit] .stelle__titeltext,
    .stellen__liste[data-bereit] .stelle__kreis,
    .stellen__liste[data-bereit] .stelle__umfang,
    .stellen__liste[data-bereit] .stelle__nummer,
    .stellen__liste[data-bereit] .stelle__anriss,
    .stellen__liste[data-bereit] .stelle__text,
    .stellen__liste[data-bereit] .stelle__seite { transition: none; }

    .stelle__text,
    .stelle__seite { opacity: 1; transform: none; }
  }
</style>

<script>
  import { KURVEN } from '../scripts/easing';
  /**
   * Stellen auf- und zuklappen — nur eine gleichzeitig offen.
   *
   * Im HTML stehen alle Zeilen offen. Erst dieses Skript klappt sie zu —
   * seit dem 18. September 2026 alle, auch die erste (Florian). Damit
   * ist ohne JavaScript alles lesbar, statt dass die Inhalte
   * verschwinden.
   *
   * `data-offen` kommt erst, wenn die Bewegung steht: Solange sie läuft,
   * muss der Inhalt beschnitten bleiben, danach darf er überlaufen —
   * nur so kann die Ansprechperson daneben kleben (siehe CSS).
   *
   * Zugeklappt wird in zwei Schritten (26. September 2026): Erst blendet
   * der Inhalt aus (`data-schliesst`), noch bei voller Höhe und noch
   * klebend; erst danach fällt `data-offen` und die Höhe fährt zu
   * (`data-zu`). So sieht niemand, wie die Ansprechperson von ihrer
   * klebenden Lage zurück in die Zeile springt.
   */
  function stellenAufbauen() {
    const liste = document.querySelector<HTMLElement>('[data-stellenliste]');
    if (!liste || liste.dataset.aufgebaut) return;
    liste.dataset.aufgebaut = 'ja';

    const knoepfe = [...liste.querySelectorAll<HTMLButtonElement>('[data-stellenknopf]')];

    const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Dauern in Millisekunden — müssen mit den Übergängen im CSS oben
       übereinstimmen: */
    const KLAPPEN = 700;     // die Höhe der Klappe (`grid-template-rows`)
    const AUSBLENDEN = 200;  // Text und Ansprechperson beim Zuklappen

    /* Kopfleiste (80 px) plus Luft — dieselben Werte wie in
       scripts/anker.ts. So tief unter den oberen Rand kommt die
       Bezeichnung einer aufgeklappten Stelle zu stehen. */
    const KOPF = 96;

    /*
      Was je Klappe gerade aussteht: die Zuhörer auf das Ende der
      Höhenbewegung und der Zeitgeber, der ihr Ende notfalls ersetzt (beim
      Öffnen) bzw. den zweiten Schritt des Zuklappens auslöst. Ein
      schnelles Hin und Her räumt damit immer erst auf, statt zweierlei
      stehen zu lassen.
    */
    type Laufend = {
      zuhoerer?: (e: TransitionEvent) => void;
      abbruch?: (e: TransitionEvent) => void;
      timer?: number;
    };
    const laufend = new WeakMap<HTMLElement, Laufend>();

    const aufraeumen = (klappe: HTMLElement) => {
      const l = laufend.get(klappe);
      if (!l) return;
      if (l.zuhoerer) klappe.removeEventListener('transitionend', l.zuhoerer);
      if (l.abbruch) klappe.removeEventListener('transitioncancel', l.abbruch);
      if (l.timer) window.clearTimeout(l.timer);
      laufend.delete(klappe);
    };

    /** Läuft auf der Klappe gerade eine Höhenbewegung? */
    const hoeheLaeuft = (klappe: HTMLElement) =>
      klappe.getAnimations().some((a) =>
        (a as CSSTransition).transitionProperty === 'grid-template-rows'
        && a.playState === 'running');

    const setzen = (knopf: HTMLButtonElement, offen: boolean) => {
      knopf.setAttribute('aria-expanded', String(offen));
      const klappe = document.getElementById(knopf.getAttribute('aria-controls') || '');
      if (!klappe) return;
      aufraeumen(klappe);

      if (!offen) {
        /* Stand die Klappe nie ganz offen (der Inhalt ist dann noch
           unsichtbar und klebt nicht), oder läuft keine Bewegung: gleich
           zu, ohne den ersten Schritt. */
        if (wenigerBewegung || !klappe.dataset.offen) {
          delete klappe.dataset.offen;
          delete klappe.dataset.schliesst;
          klappe.dataset.zu = 'ja';
          return;
        }

        /* Erster Schritt: ausblenden. Zweiter Schritt nach `AUSBLENDEN`:
           Überlauf zurücknehmen und die Höhe zufahren. */
        klappe.dataset.schliesst = 'ja';
        const timer = window.setTimeout(() => {
          laufend.delete(klappe);
          delete klappe.dataset.offen;
          delete klappe.dataset.schliesst;
          klappe.dataset.zu = 'ja';
        }, AUSBLENDEN);
        laufend.set(klappe, { timer });
        return;
      }

      delete klappe.dataset.zu;
      delete klappe.dataset.schliesst;

      /* Ohne Bewegung gibt es kein Ende, auf das sich warten ließe */
      if (wenigerBewegung) { klappe.dataset.offen = 'ja'; return; }

      /*
        Nach der Bewegung darf der Inhalt überlaufen — erst dann klebt
        die Ansprechperson, und erst dann blendet sie ein (siehe CSS).

        Geprüft wird beides: dass das Ereignis von der Klappe selbst
        kommt und dass es die Höhe betrifft. Der Inhalt darin hat eigene
        Überblendungen, deren Ereignisse hier ebenfalls ankommen — ohne
        die Prüfung gäbe eine davon zu früh frei.

        Kommt kein Ende (etwa weil die Bewegung abgebrochen wurde), gibt
        der Zeitgeber kurz nach der vorgesehenen Dauer frei.
      */
      const fertig = () => {
        aufraeumen(klappe);
        if (!klappe.dataset.zu) klappe.dataset.offen = 'ja';
      };
      const beiEnde = (e: TransitionEvent) => {
        if (e.target !== klappe || e.propertyName !== 'grid-template-rows') return;
        fertig();
      };
      /* Wird eine Klappe wieder geöffnet, während sie noch zufährt, bricht
         der Browser die alte Bewegung ab und beginnt sofort die neue —
         dann läuft das Warten weiter. Nur wenn danach nichts mehr läuft,
         gibt es nichts mehr abzuwarten. */
      const beiAbbruch = (e: TransitionEvent) => {
        if (e.target !== klappe || e.propertyName !== 'grid-template-rows') return;
        if (!hoeheLaeuft(klappe)) fertig();
      };
      const timer = window.setTimeout(fertig, KLAPPEN + 80);
      laufend.set(klappe, { zuhoerer: beiEnde, abbruch: beiAbbruch, timer });
      klappe.addEventListener('transitionend', beiEnde);
      klappe.addEventListener('transitioncancel', beiAbbruch);
    };

    /*
      Die Bezeichnung der eben geöffneten Stelle soll zu sehen sein —
      unter der Kopfleiste, nicht darüber. Gemessen wird ihre Zeile; war
      weiter oben eine andere Stelle offen, wird vorweggenommen, was
      deren Zuklappen an Höhe ändert: Die Klappe verschwindet, und der
      Anriss unter der Bezeichnung kommt wieder zum Vorschein. Steht die
      Zeile ohnehin tief genug, passiert nichts.
    */

    /**
     * Beim Öffnen gleitet die Zeile der Stelle unter die Kopfleiste —
     * geführt, Bild für Bild: Der Weg wird nicht vorausberechnet und
     * dann gescrollt, sondern die Zeile bekommt in jedem Bild die
     * Fensterposition, die sie auf ihrem Weg von jetzt zur Kopfleiste
     * gerade haben soll, und die Seite wird entsprechend gestellt. Was
     * sich währenddessen über oder unter ihr ändert — die eigene Klappe
     * wächst, eine andere darüber schließt —, fängt das ab; vorher
     * liefen Scrollen und Klappen gegeneinander, und es ging hoch und
     * wieder herunter (Florian, 27. September 2026). Dauer und Kurve
     * sind die der Klappen: Die Zeile kommt oben an, wenn die Bewegung
     * vorbei ist. Wer währenddessen selbst scrollt, übernimmt.
     */
    let fuehrung = 0;
    const titelFuehren = (knopf: HTMLButtonElement, dauer: number) => {
      const zeile = knopf.closest<HTMLElement>('.stelle__kopf') ?? knopf;
      if (wenigerBewegung) {
        window.scrollTo(0, Math.max(0, window.scrollY + zeile.getBoundingClientRect().top - KOPF));
        return;
      }
      const kennung = ++fuehrung;
      const von = zeile.getBoundingClientRect().top;
      const start = performance.now();
      const ereignisse = ['wheel', 'touchstart', 'keydown'];
      const abbrechen = () => { fuehrung++; };
      ereignisse.forEach((e) => window.addEventListener(e, abbrechen, { passive: true }));
      const aufraeumen = () => ereignisse.forEach((e) => window.removeEventListener(e, abbrechen));
      const schritt = (jetzt: number) => {
        if (kennung !== fuehrung) { aufraeumen(); return; }
        const t = Math.min(1, (jetzt - start) / dauer);
        const soll = von + (KOPF - von) * KURVEN.betont(t);
        const ist = zeile.getBoundingClientRect().top;
        window.scrollTo(0, Math.max(0, window.scrollY + ist - soll));
        if (t < 1) requestAnimationFrame(schritt);
        else aufraeumen();
      };
      requestAnimationFrame(schritt);
    };

    knoepfe.forEach((knopf) => {
      setzen(knopf, false);
      knopf.addEventListener('click', () => {
        const offen = knopf.getAttribute('aria-expanded') === 'true';
        const vorher = knoepfe.find((k) => k !== knopf && k.getAttribute('aria-expanded') === 'true');
        knoepfe.forEach((k) => { if (k !== knopf) setzen(k, false); });
        setzen(knopf, !offen);
        /* Schließt eine andere darüber, dauert die Bewegung länger:
           erst das Ausblenden, dann die Klappe */
        if (!offen) titelFuehren(knopf, vorher ? AUSBLENDEN + KLAPPEN : KLAPPEN);
      });
    });

    /* Erst jetzt darf sich etwas bewegen (siehe CSS) */
    requestAnimationFrame(() => { liste.dataset.bereit = 'ja'; });
  }

  stellenAufbauen();
  document.addEventListener('astro:page-load', stellenAufbauen);
</script>
