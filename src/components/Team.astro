---
/**
 * Team — Gruppenfoto mit Überschrift, darunter die Porträts.
 *
 * Maße aus dem Stylesheet der Vorlage:
 *   .team-header-container  Höhe 580 px, überlappungsfrei beschnitten
 *   .team-container         100 px oben, 140 px unten Innenabstand
 *   .team-image             Höhe 260 px, Bildausschnitt oben ausgerichtet
 */
import team from '../content/team.json';

const personen = team.eintraege
  .filter((e) => e.aktiv)
  .sort((a, b) => a.position - b.position);
const aerzte = personen.filter((e) => e.gruppe === 'aerzte');
const mitarbeitende = personen.filter((e) => e.gruppe === 'team');
---

<section class="team" id="team">
  <div class="team__kopf" data-teamkopf>
    <div class="team__bild" data-teambild role="img" aria-label="Das Ärzteteam der Praxis Dres. Nold"></div>
    <h2 class="team__titel ohne-verlauf">Wir freuen uns auf Sie</h2>
  </div>

  <div class="team__inhalt inhalt">
    <div class="team__reihe">
      {aerzte.map((a) => (
        <figure class="person">
          <img class="person__bild" data-personbild src={a.foto} alt={a.foto_alt} width="300" height="260" loading="lazy" />
          <figcaption class="person__text">
            <strong class="person__name">{a.name}</strong>
            <span class="person__funktion">{a.funktion}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="team__reihe team__reihe--klein">
      {mitarbeitende.map((m) => (
        <figure class="person">
          <img class="person__bild" data-personbild src={m.foto} alt={m.foto_alt} width="300" height="260" loading="lazy" />
          <figcaption class="person__text">
            <strong class="person__name">{m.name}</strong>
            <span class="person__funktion">{m.funktion}</span>
            {m.zusatz && <span class="person__zusatz">{m.zusatz}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .team {
    position: relative;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    background: var(--farbe-flaeche);
  }

  /* .team-header-container: 580 px hoch, Bild formatfüllend */
  .team__kopf {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 580px;
    overflow: hidden;
  }

  /* Ablauf a-3: wandert von −20 px auf 120 px und wächst dabei
     von 1 auf 1,1 — ein ruhiger Tiefeneffekt beim Scrollen. */
  .team__bild {
    position: absolute;
    inset: -10% 0;
    background: url('/bilder/aerzteteam.webp') center / cover no-repeat;
    transform:
      translateX(var(--kopf-fahrt, -50%))
      translateY(var(--kopf-versatz, -20px))
      scale(var(--kopf-groesse, 1));
    /* Ablauf a-22: fährt beim Hereinscrollen in 5 s von −50 % auf 0 %.
       a-23 setzt beim Verlassen wieder zurück. */
    transition: --kopf-fahrt 5000ms cubic-bezier(0.42, 0, 0.58, 1);
  }

  @property --kopf-fahrt {
    syntax: '<percentage>';
    inherits: false;
    initial-value: -50%;
  }

  .team__kopf[data-sichtbar] .team__bild { --kopf-fahrt: 0%; }

  .team__titel {
    position: relative;
    margin: 0;
    color: var(--farbe-text-invers);
    font-size: clamp(2rem, 1rem + 4vw, 4.5rem);
    font-weight: var(--gewicht-halbfett);
    text-align: center;
  }

  /* .team-container: 100 px oben, 140 px unten */
  .team__inhalt {
    padding-block: 100px 140px;
  }

  .team__reihe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
  }

  .team__reihe--klein {
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .person { margin: 0; }

  /* .team-image: 260 px hoch, Ausschnitt oben ausgerichtet */
  /* Ablauf a-2: Höhe 80 % → 100 %, Skalierung 1,2 → 1 über die
     ersten 90 % des Scrollwegs. Der Bildausschnitt beruhigt sich,
     während die Person ins Bild kommt. */
  .person__bild {
    width: 100%;
    height: 260px;
    object-fit: cover;
    object-position: 50% 0;
    background: var(--farbe-flaeche);
    transform: scale(var(--person-groesse, 1));
    transform-origin: 50% 0;
  }

  .person { overflow: hidden; }

  .person__text {
    display: flex;
    flex-direction: column;
    padding-top: var(--abstand-2xs);
  }

  .person__name {
    color: var(--farbe-primaer);
    font-weight: var(--gewicht-halbfett);
  }

  .person__funktion,
  .person__zusatz {
    color: var(--farbe-text);
    font-size: var(--text-s);
    font-weight: 300;
  }

  @media (prefers-reduced-motion: reduce) {
    .team__bild { transform: none; }
    .person__bild { transform: none; }
  }

  @media (max-width: 767px) {
    .team__kopf { height: 380px; }
    .team__inhalt { padding-block: 60px 80px; }
  }
</style>

<script>
  /**
   * Bewegungen im Team-Abschnitt, Werte aus den Abläufen der Vorlage.
   *
   *   a-3  Gruppenfoto: −20 px → 120 px, Skalierung 1 → 1,1
   *   a-2  Porträts:    Skalierung 1,2 → 1 über die ersten 90 %
   */
  function teamAufbauen() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const kopf = document.querySelector<HTMLElement>('[data-teamkopf]');
    const bild = document.querySelector<HTMLElement>('[data-teambild]');
    const portraets = [...document.querySelectorAll<HTMLElement>('[data-personbild]')];
    if (!kopf || kopf.dataset.bereit) return;
    kopf.dataset.bereit = 'ja';

    /** Anteil, zu dem ein Element den Blickbereich durchlaufen hat (0 … 1). */
    const anteil = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const weg = window.innerHeight + r.height;
      return Math.min(1, Math.max(0, (window.innerHeight - r.top) / weg));
    };

    let geplant = false;
    const zeichnen = () => {
      geplant = false;

      const p = anteil(kopf);
      bild?.style.setProperty('--kopf-versatz', `${-20 + 140 * p}px`);
      bild?.style.setProperty('--kopf-groesse', String(1 + 0.1 * p));

      portraets.forEach((b) => {
        const q = Math.min(1, anteil(b) / 0.9);
        b.style.setProperty('--person-groesse', String(1.2 - 0.2 * q));
      });
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(zeichnen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    zeichnen();

    /* Abläufe a-22 / a-23: Sobald der Kopfbereich ins Bild kommt, fährt
       das Foto in 5 Sekunden von −50 % auf 0 %. Verlässt er das Bild,
       springt es zurück, damit die Fahrt beim nächsten Mal erneut läuft. */
    const beobachter = new IntersectionObserver((eintraege) => {
      eintraege.forEach((e) => {
        if (e.isIntersecting) kopf.setAttribute('data-sichtbar', 'ja');
        else kopf.removeAttribute('data-sichtbar');
      });
    }, { threshold: 0.1 });
    beobachter.observe(kopf);
  }

  teamAufbauen();
  document.addEventListener('astro:page-load', teamAufbauen);
</script>
