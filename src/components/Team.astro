---
/**
 * Team — Gruppenfoto mit Überschrift, darunter Ärzte und Mitarbeitende.
 *
 * Nachbau des Team-Bereichs der Vorlage, Maße aus deren Stylesheet:
 *
 *   .team-header-container   580 px hoch (≤991: 400, ≤767: 600, ≤479: 500)
 *   .heading-3               86 px, Gewicht 600, weiß, Schatten,
 *                            am unteren Rand mit 40 px Abstand
 *   .docs-list-wrapper       Ärzte: drei Spalten in max. 900 px
 *   .div-block-19            Ärzte-Rahmen 300 px hoch (≤991: 260)
 *   .dres-bilder             Foto 300 px hoch, oben verankert
 *   .team-list-wrapper       Mitarbeitende: max. 1400 px, 40 px darunter
 *   .team-image-container    Karte 260 × 260 px (≤767: 50 % breit)
 *   .team-arrow / -shadow    weißer Pfeil (16 px) und Schattensaum (14 px)
 *                            an der Unterkante jedes Rahmens
 *   .heading-2 / -4          Name 22/26 px, Gewicht 400
 *   .text-block-2 / -3       Funktion 16 px, Gewicht 300
 *
 * Bewegungen (docs/referenz/animationen.md):
 *   a-3        Gruppenfoto: sinkt ab und wächst (1 → 1,16); der Weg
 *              ergibt sich aus der Vergrößerung, damit der Rahmen
 *              gefüllt bleibt
 *   a-22/a-23  entfallen: Die Sonderbewegung der Handys zeigte immer
 *              nur einen der drei Ärzte (Florian, 18. September 2026)
 *   a / a-2    Porträts: Ausschnitt 80 % → 100 %, Skalierung 1,2 → 1
 *              über die ersten 90 % des Scrollwegs
 *   Alle drei mit Webflows „smoothing 70" — hier `nachziehen()`.
 *
 * Die Tätigkeiten der Mitarbeitenden liegen zugeklappt hinter dem Namen
 * (Accordion wie in der Vorlage, nur eines gleichzeitig offen).
 *
 * Handoff, 17. September 2026: Kicker und Titel stehen links unten im
 * Banner statt mittig; darunter gliedern Gruppenzeilen mit Haarlinie.
 * Alles linksbündig — auf Handys (bis 767 px) dagegen mittig, siehe
 * den Umbruch unten (26. September 2026). Über dem Banner liegt ein
 * SEHR leichter Verlauf — gerade so viel, dass die weiße Schrift sicher
 * lesbar bleibt (der Entwurf hatte ihn deutlich kräftiger, Florian
 * wollte ihn zurück). Die Bewegung des Banners (Ablauf a-3) bleibt
 * unverändert.
 */
import Haken from './Haken.astro';
import team from '../content/team.json';
import startseite from '../content/startseite.json';

const texte = startseite.team;

const personen = team.eintraege
  .filter((e) => e.aktiv)
  .sort((a, b) => a.position - b.position);
const aerzte = personen.filter((e) => e.gruppe === 'aerzte');
const mitarbeitende = personen.filter((e) => e.gruppe === 'team');

/** Ohne Foto: neutraler Platzhalter, damit die Karte nicht leer bleibt */
const foto = (p: { foto?: string }) => p.foto || '/bilder/team/platzhalter.svg';
---

<section class="team" id="team">
  <div class="team__kopf" data-teamkopf>
    <div class="team__bild" data-teambild role="img" aria-label="Das Ärzteteam der Praxis Dres. Nold"></div>
    <span class="team__schleier" aria-hidden="true"></span>
    <div class="team__banner">
      <div class="team__kicker kicker">Unser Team</div>
      <h2 class="team__titel ohne-verlauf">{texte.titel}</h2>
    </div>
  </div>

  <div class="team__inhalt">
    <div class="gruppenzeile" data-rein>
      <span class="gruppenzeile__text">Ärztinnen und Ärzte</span>
      <span class="gruppenzeile__linie"></span>
    </div>

    <ul class="aerzte" role="list">
      {aerzte.map((a) => (
        <li class="arzt">
          <div class="portraetfeld">
            <div class="portraet" data-portraet>
              <div class="portraet__ausschnitt">
                <img class="portraet__bild" src={foto(a)} alt={a.foto_alt} width="720" height="960" loading="lazy" />
              </div>
            </div>
            {/* Saum und Pfeil liegen AUSSERHALB des beschnittenen
                Rahmens: Nur so kann der Saum in die Lücke zwischen zwei
                Karten hineinreichen und die Reihe zu einer
                durchgehenden Linie schließen. */}
            <span class="portraet__schatten" aria-hidden="true"></span>
            <span class="portraet__pfeil" aria-hidden="true"></span>
          </div>
          <p class="person">
            <span class="person__name">{a.name}</span>
            <span class="person__funktion">{a.funktion}</span>
          </p>
        </li>
      ))}
    </ul>

    <div class="gruppenzeile gruppenzeile--zweite" data-rein>
      <span class="gruppenzeile__text">Unser Praxisteam</span>
      <span class="gruppenzeile__linie"></span>
    </div>

    <ul class="mitarbeitende" role="list">
      {mitarbeitende.map((m) => {
        const taetigkeiten = (m.taetigkeiten || []).filter(Boolean);
        return (
          <li class="mitglied" data-mitglied>
            <div class="portraetfeld">
              <div class="portraet" data-portraet>
                <div class="portraet__ausschnitt">
                  <img class="portraet__bild" src={foto(m)} alt={m.foto_alt} width="820" height="1093" loading="lazy" />
                </div>
              </div>
              <span class="portraet__schatten" aria-hidden="true"></span>
              <span class="portraet__pfeil" aria-hidden="true"></span>
            </div>

            <p class="person">
              <span class="person__name">{m.name}</span>
              <span class="person__funktion">{m.funktion}</span>
            </p>

            {taetigkeiten.length > 0 && (
              <>
                {/* Name und Funktion stehen für sich; die Tätigkeiten
                    klappen darunter auf — so ist der Name auch dann
                    lesbar, wenn nichts aufgeklappt ist. */}
                <button
                  class="taetigkeitenknopf"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`taetigkeiten-${m.id}`}
                  aria-label={`Tätigkeiten von ${m.name}`}
                  data-aufklapper
                >
                  Tätigkeiten
                  <Haken />
                </button>
                <div class="taetigkeiten" id={`taetigkeiten-${m.id}`} data-taetigkeiten>
                  <ul class="taetigkeiten__liste" role="list">
                    {taetigkeiten.map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              </>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .team {
    position: relative;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    background: var(--farbe-flaeche);
    /* Der Schattensaum ragt an den Reihenenden 64 px über die
       Inhaltsbreite hinaus (siehe unten). Auf schmalen Fenstern ist
       daneben nur der Seitenrand frei — der Rest schob die ganze Seite
       waagerecht auf. Hier endet er am Fensterrand, das Auslaufen
       bleibt. `clip` statt `hidden`: kein Rollbereich, damit nichts
       anderes im Abschnitt seine Verankerung verliert. */
    overflow-x: clip;
  }

  /* ---------- Gruppenfoto ---------- */

  /* .team-header-container — Höhe aus dem Handoff */
  .team__kopf {
    position: relative;
    width: 100%;
    height: clamp(340px, 42vw, 560px);
    overflow: hidden;
  }

  /* .team-header: formatfüllend; Ablauf a-3 bewegt und vergrößert es.

     Der Bezugspunkt liegt an der UNTERKANTE: Das Bild wächst dadurch
     nach oben aus dem Rahmen heraus, und der Versatz schiebt es
     anschließend genau so weit wieder herunter, wie oben Bild
     vorhanden ist. So bleibt der Rahmen in jeder Phase gefüllt.
     Vorher war der Versatz ein fester Wert (−20 → 140 px) und der
     Rahmen zeigte in der Mitte der Bewegung einen weißen Streifen —
     auf dem flacheren Ausschnitt der Handys wäre das ein Drittel des
     Bildes gewesen (18. September 2026). */
  .team__bild {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: url('/bilder/aerzteteam.webp') center / cover no-repeat;
    transform-origin: 50% 100%;
    transform:
      translateY(var(--kopf-versatz, 0px))
      scale(var(--kopf-groesse, 1));
  }

  /* Ein sehr leichter Schleier über der unteren Hälfte — er soll die
     Schrift tragen, nicht das Bild abdunkeln. Der Entwurf setzte hier
     82 % Deckung an; das nahm dem Foto die Wirkung (Florian,
     17. September 2026). */
  .team__schleier {
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(
      to top,
      rgb(30 8 22 / 46%),
      rgb(30 8 22 / 18%) 45%,
      rgb(30 8 22 / 0)
    );
    pointer-events: none;
  }

  /* Kicker und Titel stehen links unten, auf der Inhaltsbreite */
  .team__banner {
    position: absolute;
    inset: auto 0 clamp(28px, 4vw, 52px);
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    margin-inline: auto;
  }

  .team__kicker {
    color: var(--farbe-text-invers);
    text-shadow: 0 0 18px rgb(0 0 0 / 55%);
  }

  .team__titel {
    /* Der Kicker rückt näher an den Titel (Florian, 26. September 2026) */
    margin: 8px 0 0;
    color: var(--farbe-text-invers);
    font-size: var(--text-banner);
    font-weight: var(--gewicht-titel);
    line-height: 1.02;
    letter-spacing: -0.010em;
    text-align: left;
    text-shadow: 0 0 20px rgb(0 0 0 / 55%);
  }

  /* ---------- Porträts ---------- */

  /* Alles linksbündig auf der Inhaltsbreite (Handoff); auf Handys
     mittig, siehe den Umbruch bei 767 px */
  .team__inhalt {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    margin-inline: auto;
    padding-block: clamp(64px, 8vw, 104px) clamp(72px, 9vw, 112px);
  }

  .gruppenzeile--zweite { margin-top: clamp(52px, 6vw, 80px); }

  ul[role='list'] {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Drei Spalten wie in der Vorlage, aber linksbündig und eine Spur
     schmaler. Der Entwurf zeigte die Ärzte im 3:4-Format über die volle
     Breite — das war zu groß (Florian, 17. September 2026). */
  /* Beide Raster teilen sich die Lücke — der Schattensaum greift sie
     auf, um zwischen zwei Karten durchzulaufen. */
  .aerzte,
  .mitarbeitende { --luecke: 24px; }

  /* Drei Spalten in den Maßen der alten Seite: Rahmen 300 px hoch, das
     Foto darin in seinem eigenen Format. Der Entwurf zeigte die Ärzte
     formatfüllend über die ganze Breite — das war zu groß (Florian). */
  .aerzte {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--luecke);
    width: 100%;
    max-width: 948px;
    margin-top: 28px;
  }

  .arzt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  /* Raster statt umbrechendem Flex: So füllen die Karten die
     Inhaltsbreite gleichmäßig aus, statt am rechten Rand Platz
     liegen zu lassen. */
  .mitarbeitende {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(236px, 1fr));
    gap: var(--luecke);
    align-items: start;
    width: 100%;
    margin-top: 28px;
  }

  .mitglied {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  /* .div-block-19 / .team-image-container: Rahmen mit abgeschnittenem
     Überlauf; das Foto sitzt unten, Pfeil und Schatten liegen darüber */
  /* Das Feld ist der Bezug für Saum und Pfeil; der Rahmen darin
     beschneidet das Foto. */
  .portraetfeld {
    position: relative;
    width: 100%;
  }

  /* Rahmenhöhen der alten Seite: Ärzte 300 px, Praxisteam 260 px.
     Das Foto steht in seinem eigenen Format mittig darin — es füllt den
     Rahmen NICHT aus. Nur so schaut die Person ganz aus dem Schattensaum
     heraus, statt an der Brust beschnitten zu werden (Florian). */
  .portraet {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    height: var(--portraet-hoehe, 260px);
    overflow: hidden;
    /* Weiß, nicht grau: Der Ausschnitt darin ist beim Hereinscrollen
       nur 80 % hoch (Ablauf a/a-2). Ein grauer Grund stünde in dieser
       Zeit als Balken über dem Foto. */
    background: var(--farbe-flaeche);
  }

  .arzt .portraet { --portraet-hoehe: 300px; }

  /* Der sichtbare Ausschnitt: 80 % → 100 % der Rahmenhöhe (Ablauf a / a-2),
     dabei 1,2 → 1 skaliert. Das Foto darin behält seine volle Höhe und
     bleibt oben verankert — wie `background-size: auto 300px` in der
     Vorlage: Ein kleinerer Ausschnitt zeigt weniger, nicht ein
     kleineres Bild. */
  .portraet__ausschnitt {
    display: flex;
    justify-content: center;
    width: 100%;
    height: calc(var(--ausschnitt, 1) * 100%);
    overflow: hidden;
    background: var(--farbe-flaeche);
    transform: scale(var(--groesse, 1));
  }

  /* Feste Höhe in Bildpunkten, nicht 100 % des Ausschnitts: Beim
     Hereinscrollen ist der Ausschnitt nur 80 % hoch (Ablauf a/a-2) —
     er soll dann WENIGER zeigen, nicht ein kleineres Bild. */
  .portraet__bild {
    width: auto;
    max-width: none;
    height: var(--portraet-hoehe, 260px);
    /* Beim Zeigen wächst das Foto leicht im Ausschnitt (Handoff). Die
       Skalierung sitzt auf dem Bild, nicht auf dem Ausschnitt — der
       trägt schon die scrollgebundene Bewegung der Vorlage. */
    transition: transform 0.8s var(--verlauf-betont);
  }

  .portraetfeld:hover .portraet__bild,
  .arzt:focus-within .portraet__bild,
  .mitglied:focus-within .portraet__bild { transform: scale(1.04); }

  /* .team-shadow: 14 px hoher Schattensaum an der Unterkante.
     Er sitzt je Karte, reicht aber um eine halbe Lücke nach links und
     rechts über sie hinaus — nebeneinander ergibt das EINE durchgehende
     Linie über die ganze Reihe, auch mit Abstand zwischen den Karten.

     Welche Karte am Anfang bzw. Ende einer Reihe steht, kann CSS bei
     einem umbrechenden Raster nicht wissen; das setzt das Skript unten
     als `data-reihe`. */
  .portraet__schatten {
    position: absolute;
    z-index: 1;
    bottom: 0;
    left: calc(var(--luecke, 24px) / -2);
    right: calc(var(--luecke, 24px) / -2);
    /* Höher und dadurch weicher als die 14 px der Vorlage: Der Verlauf
       der Zeichnung wird über mehr Pixel gestreckt und die Deckung
       etwas zurückgenommen (Florian, 17. September 2026). */
    height: 24px;
    opacity: 0.9;
    background: url('/icons/ui/linie-schatten.svg') 50% 100% / cover no-repeat;
  }

  /* An den Reihenenden läuft die Linie aus, statt abzureißen: Sie ragt
     dafür 64 px über die Inhaltsbreite hinaus und verliert sich auf
     dieser Strecke. */
  [data-reihe='anfang'] .portraet__schatten,
  [data-reihe='allein'] .portraet__schatten { left: -64px; }

  [data-reihe='ende'] .portraet__schatten,
  [data-reihe='allein'] .portraet__schatten { right: -64px; }

  [data-reihe='anfang'] .portraet__schatten {
    mask-image: linear-gradient(to right,
      rgb(0 0 0 / 0) 0%,
      rgb(0 0 0 / 0.25) 20%,
      rgb(0 0 0 / 0.6) 45%,
      rgb(0 0 0 / 0.9) 70%,
      rgb(0 0 0 / 1) 90%);
  }

  [data-reihe='ende'] .portraet__schatten {
    mask-image: linear-gradient(to left,
      rgb(0 0 0 / 0) 0%,
      rgb(0 0 0 / 0.25) 20%,
      rgb(0 0 0 / 0.6) 45%,
      rgb(0 0 0 / 0.9) 70%,
      rgb(0 0 0 / 1) 90%);
  }

  [data-reihe='allein'] .portraet__schatten {
    mask-image: linear-gradient(to right,
      rgb(0 0 0 / 0) 0%,
      rgb(0 0 0 / 0.5) 18%,
      rgb(0 0 0 / 1) 40%,
      rgb(0 0 0 / 1) 60%,
      rgb(0 0 0 / 0.5) 82%,
      rgb(0 0 0 / 0) 100%);
  }

  /* .team-arrow: weißer Pfeil, 16 px hoch, unten mittig auf der Karte */
  .portraet__pfeil {
    position: absolute;
    inset: auto 0 0;
    z-index: 10;
    height: 16px;
    background: url('/icons/ui/pfeil-team.svg') 50% 100% / auto 16px no-repeat;
  }

  /* ---------- Name und Funktion ---------- */

  .person {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
  }

  .taetigkeitenknopf {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--farbe-primaer);
    font-size: var(--text-kicker-klein);
    font-weight: var(--gewicht-halbfett);
    line-height: 1;
    letter-spacing: var(--sperrung-kicker-klein);
    text-transform: uppercase;
    cursor: pointer;
  }

  /* Namen tragen Gewicht 500 — kräftiger als der Fließtext, aber
     leichter als die gesperrten Beschriftungen (Handoff). */
  .person__name {
    display: block;
    width: 100%;
    margin-top: 14px;
    color: var(--farbe-primaer);
    font-size: 17px;
    font-weight: var(--gewicht-mittel);
    line-height: 1.3;
  }

  .arzt .person__name {
    margin-top: 18px;
    font-size: 20px;
    letter-spacing: -0.01em;
    /* Platz für zwei Zeilen: Ein langer Doppelname bricht um, und dann
       stünden die Funktionsangaben der drei Ärzte auf verschiedenen
       Höhen. */
    min-height: 2.6em;
  }

  .person__funktion {
    display: block;
    width: 100%;
    margin-top: 3px;
    color: var(--farbe-text-gedeckt);
    font-size: 14px;
    font-weight: var(--gewicht-normal);
    line-height: 1.45;
  }

  .arzt .person__funktion {
    margin-top: 5px;
    font-size: 15px;
    line-height: 1.5;
  }


  /* Tätigkeiten: klappen über die Zeilenhöhe des Rasters auf */
  .taetigkeiten {
    display: grid;
    grid-template-rows: 0fr;
    width: 100%;
    transition: grid-template-rows 400ms var(--verlauf-betont);
  }

  .taetigkeiten[data-offen] { grid-template-rows: 1fr; }

  .taetigkeiten__liste {
    overflow: hidden;
    min-height: 0;
    text-align: left;
  }

  .taetigkeiten__liste li {
    width: auto;
    margin: 7px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 14px;
    font-weight: var(--gewicht-normal);
    line-height: 1.45;
  }

  /* ---------- Umbrüche wie in der Vorlage ---------- */

  @media (max-width: 991px) {
    .arzt .portraet { --portraet-hoehe: 260px; }
  }

  @media (max-width: 767px) {
    /* Auf Handys galt hier die Sonderlösung der Vorlage (Abläufe
       a-22 / a-23): ein doppelt so breites Foto, das beim Hereinscrollen
       seitlich durchfuhr. Man sah dabei immer nur einen der drei Ärzte.
       Jetzt gilt dieselbe Bewegung wie auf dem Desktop (a-3), und der
       Ausschnitt ist so hoch gewählt, dass alle drei im Bild stehen
       (Florian, 18. September 2026).

       Das Seitenverhältnis bestimmt den Ausschnitt: Bei 1,55 : 1 zeigt
       das 1920 × 615 breite Foto rund 950 seiner Bildpunkte — die drei
       Personen stehen darin zwischen 560 und 1420, also mit Luft an
       beiden Seiten. Höhe in Bildpunkten stünde dem entgegen: Je
       schmaler das Fenster, desto enger der Ausschnitt. */
    .team__kopf {
      height: auto;
      aspect-ratio: 1.55 / 1;
    }

    /* Auf Handys steht alles mittig (Florian, 26. September 2026):
       Überschrift, Namen, Funktion, der Tätigkeiten-Knopf und die
       Liste darunter — die zweispaltigen Reihen wirken linksbündig
       ausgefranst, weil die Karte breiter ist als ihr Text. Auf
       breiten Fenstern bleibt es beim Handoff: alles links. */
    .team__kicker,
    .team__titel { text-align: center; }

    .arzt,
    .mitglied,
    .person { align-items: center; }

    .person,
    .taetigkeiten__liste { text-align: center; }

    /* Feste zwei Spalten statt `auto-fill` über 180 px: Das gab zwischen
       rund 655 und 767 px drei Spalten (3 × 180 + 2 × 24 = 588 px Inhalt
       bei 5 % Seitenrand) — und dann konnte CSS nicht wissen, welche
       Karte allein in ihrer Reihe steht. */
    .aerzte,
    .mitarbeitende {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: none;
    }

    /* Bleibt die letzte Karte allein in ihrer Reihe (drei Ärzte,
       dreizehn im Praxisteam), steht sie mittig — in Spaltenbreite, über
       beide Spalten gelegt. Nicht `justify-items: center` fürs ganze
       Raster: Damit schrumpften alle Karten auf ihren Inhalt, und
       das Porträt bezieht seine Größe aus der Kartenbreite. */
    .aerzte > .arzt:last-child:nth-child(odd),
    .mitarbeitende > .mitglied:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc(50% - var(--luecke) / 2);
    }
  }

  @media (max-width: 479px) {
    /* Enger zusammen und höher: Beides macht die Köpfe größer, ohne
       dass eine dritte Spalte nötig wäre (Florian, 18. September 2026).
       Die Höhe zählt mit, weil das Foto darin „contain" steht — bei
       einem flacheren Rahmen begrenzte sie das Bild, nicht die Breite. */
    .aerzte,
    .mitarbeitende { --luecke: 12px; }
    /* Auf schmalen Handys ist die Spalte schmaler als das Foto — dann
       darf es mitschrumpfen, sonst wird es seitlich beschnitten. */
    .portraet { height: auto; aspect-ratio: 1 / 1.25; }
    .portraet__bild { width: 100%; height: 100%; object-fit: contain; object-position: bottom; }
  }

  @media (prefers-reduced-motion: reduce) {
    .team__bild { transform: none; transition: none; }
    .portraet__ausschnitt { height: 100%; transform: none; }
    .portraet__bild { transition: none; }
    .portraetfeld:hover .portraet__bild { transform: none; }
    .taetigkeiten { transition: none; }
  }
</style>

<script>
  import { nachziehen } from '../scripts/scrollwege';

  /**
   * Bewegungen im Team-Abschnitt, Werte aus den Abläufen der Vorlage.
   *
   *   a-3    Gruppenfoto: Skalierung 1 → 1,16, dabei absinkend (0 … 100 %)
   *   a/a-2  Porträts: Ausschnitt 80 % → 100 %, Skalierung 1,2 → 1
   *          über die ersten 90 % des Scrollwegs
   *
   * Der Fortschritt zählt wie Webflows „while scrolling in view": 0 %
   * wenn die Oberkante unten ins Fenster tritt, 100 % wenn die
   * Unterkante oben hinausläuft. Der gezeichnete Wert läuft dem
   * Scrollwert nach (Webflow „smoothing 70").
   */
  function teamAufbauen() {
    const kopf = document.querySelector<HTMLElement>('[data-teamkopf]');
    if (!kopf || kopf.dataset.bereit) return;
    kopf.dataset.bereit = 'ja';

    accordionAufbauen();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const bild = kopf.querySelector<HTMLElement>('[data-teambild]');
    const portraets = [...document.querySelectorAll<HTMLElement>('[data-portraet]')];

    /** Anteil, zu dem ein Element den Blickbereich durchlaufen hat (0 … 1). */
    const anteil = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const weg = window.innerHeight + r.height;
      return Math.min(1, Math.max(0, (window.innerHeight - r.top) / weg));
    };

    /* Ein nachlaufender Wert je Element */
    const werte = new Map<HTMLElement, number>();
    const alle = [kopf, ...portraets];
    alle.forEach((el) => werte.set(el, anteil(el)));

    const zeichnen = () => {
      const p = werte.get(kopf) ?? 0;
      /* Ablauf a-3: Das Bild wächst und sinkt dabei ab. Wie weit es
         sinken darf, gibt seine eigene Vergrößerung vor — mehr Weg
         gäbe es nicht, ohne dass oben der weiße Grund durchschiene.
         Der Weg ist damit von selbst zur Rahmenhöhe proportional und
         stimmt auf jedem Bildschirm (Florian, 18. September 2026). */
      const groesse = 1 + 0.16 * p;
      const spiel = (groesse - 1) * kopf.offsetHeight;
      bild?.style.setProperty('--kopf-versatz', `${(spiel * p * 0.98).toFixed(2)}px`);
      bild?.style.setProperty('--kopf-groesse', groesse.toFixed(4));

      portraets.forEach((el) => {
        const q = Math.min(1, (werte.get(el) ?? 0) / 0.9);
        const ausschnitt = el.querySelector<HTMLElement>('.portraet__ausschnitt');
        ausschnitt?.style.setProperty('--ausschnitt', (0.8 + 0.2 * q).toFixed(4));
        ausschnitt?.style.setProperty('--groesse', (1.2 - 0.2 * q).toFixed(4));
      });
    };

    let laeuft = false;
    let zuletzt = 0;

    const schritt = (jetzt: number) => {
      const dt = zuletzt ? Math.min(100, jetzt - zuletzt) : 16.7;
      zuletzt = jetzt;

      let fertig = true;
      alle.forEach((el) => {
        const z = anteil(el);
        let w = nachziehen(werte.get(el) ?? z, z, dt);
        if (Math.abs(z - w) < 0.0005) w = z;
        else fertig = false;
        werte.set(el, w);
      });

      zeichnen();

      if (!fertig) requestAnimationFrame(schritt);
      else laeuft = false;
    };

    const anstossen = () => {
      if (laeuft) return;
      laeuft = true;
      zuletzt = 0;
      requestAnimationFrame(schritt);
    };

    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', anstossen, { passive: true });
    zeichnen();

  }

  /** Tätigkeiten auf- und zuklappen — nur eines gleichzeitig offen. */
  function accordionAufbauen() {
    const knoepfe = [...document.querySelectorAll<HTMLButtonElement>('[data-aufklapper]')];

    const setzen = (knopf: HTMLButtonElement, offen: boolean) => {
      knopf.setAttribute('aria-expanded', String(offen));
      const ziel = document.getElementById(knopf.getAttribute('aria-controls') || '');
      if (!ziel) return;
      if (offen) ziel.dataset.offen = 'ja';
      else delete ziel.dataset.offen;
    };

    knoepfe.forEach((knopf) => {
      knopf.addEventListener('click', () => {
        const offen = knopf.getAttribute('aria-expanded') === 'true';
        knoepfe.forEach((k) => { if (k !== knopf) setzen(k, false); });
        setzen(knopf, !offen);
      });
    });
  }

  /**
   * Reihenenden bestimmen.
   *
   * Die Karten stehen in einem umbrechenden Flex-Layout — es gibt kein
   * Element „Reihe", an dem CSS ansetzen könnte. Also werden die Karten
   * nach ihrem Abstand zum Seitenanfang gruppiert: Was auf derselben
   * Höhe beginnt, steht in derselben Reihe. Die erste und die letzte
   * Karte einer Reihe bekommen `data-reihe`; das CSS lässt ihren
   * Schattensaum dort auslaufen.
   *
   * Ohne JavaScript bleibt alles wie bisher — die Linie endet dann
   * eben hart, aber nichts fehlt.
   */
  function reihenendenMarkieren() {
    const listen = [...document.querySelectorAll<HTMLElement>('.aerzte, .mitarbeitende')]
      .filter((l) => !l.dataset.reihenbereit);
    if (!listen.length) return;
    for (const liste of listen) liste.dataset.reihenbereit = 'ja';

    const markieren = () => {
      for (const liste of listen) {
        const karten = [...liste.children] as HTMLElement[];
        let reihe: HTMLElement[] = [];
        let hoehe: number | null = null;

        const abschliessen = () => {
          if (!reihe.length) return;
          for (const karte of reihe) delete karte.dataset.reihe;
          if (reihe.length === 1) reihe[0].dataset.reihe = 'allein';
          else {
            reihe[0].dataset.reihe = 'anfang';
            reihe[reihe.length - 1].dataset.reihe = 'ende';
          }
          reihe = [];
        };

        for (const karte of karten) {
          /* Auf ganze Pixel gerundet: Unterpixel-Unterschiede sollen
             keine neue Reihe auslösen. */
          const oben = Math.round(karte.offsetTop);
          if (hoehe === null || Math.abs(oben - hoehe) > 2) {
            abschliessen();
            hoehe = oben;
          }
          reihe.push(karte);
        }
        abschliessen();
      }
    };

    markieren();

    /* Beim Aufklappen der Tätigkeiten und beim Größerziehen des
       Fensters können sich die Reihen ändern. */
    const beobachter = new ResizeObserver(() => markieren());
    for (const liste of listen) beobachter.observe(liste);
  }

  teamAufbauen();
  reihenendenMarkieren();
  document.addEventListener('astro:page-load', () => {
    teamAufbauen();
    reihenendenMarkieren();
  });
</script>
