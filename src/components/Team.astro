---
/**
 * Team — Gruppenfoto mit Überschrift, darunter Ärzte und Mitarbeitende.
 *
 * Nachbau des Team-Bereichs der Vorlage, Maße aus deren Stylesheet:
 *
 *   .team-header-container   580 px hoch (≤991: 400, ≤767: 600, ≤479: 500)
 *   .heading-3               86 px, Gewicht 600, weiß, Schatten,
 *                            am unteren Rand mit 40 px Abstand
 *   .docs-list-wrapper       Ärzte: drei Spalten in max. 900 px
 *   .div-block-19            Ärzte-Rahmen 300 px hoch (≤991: 260)
 *   .dres-bilder             Foto 300 px hoch, oben verankert
 *   .team-list-wrapper       Mitarbeitende: max. 1400 px, 40 px darunter
 *   .team-image-container    Karte 260 × 260 px (≤767: 50 % breit)
 *   .team-arrow / -shadow    weißer Pfeil (16 px) und Schattensaum (14 px)
 *                            an der Unterkante jedes Rahmens
 *   .heading-2 / -4          Name 22/26 px, Gewicht 400
 *   .text-block-2 / -3       Funktion 16 px, Gewicht 300
 *
 * Bewegungen (docs/referenz/animationen.md):
 *   a-3        Gruppenfoto: y −20 → 120 px, Skalierung 1 → 1,1
 *   a-22/a-23  nur auf Handys: Foto fährt in 5 s von −50 % auf 0 %
 *   a / a-2    Porträts: Ausschnitt 80 % → 100 %, Skalierung 1,2 → 1
 *              über die ersten 90 % des Scrollwegs
 *   Alle drei mit Webflows „smoothing 70" — hier `nachziehen()`.
 *
 * Die Tätigkeiten der Mitarbeitenden liegen zugeklappt hinter dem Namen
 * (Accordion wie in der Vorlage, nur eines gleichzeitig offen).
 */
import team from '../content/team.json';

const personen = team.eintraege
  .filter((e) => e.aktiv)
  .sort((a, b) => a.position - b.position);
const aerzte = personen.filter((e) => e.gruppe === 'aerzte');
const mitarbeitende = personen.filter((e) => e.gruppe === 'team');

/** Ohne Foto: neutraler Platzhalter, damit die Karte nicht leer bleibt */
const foto = (p: { foto?: string }) => p.foto || '/bilder/team/platzhalter.svg';
---

<section class="team" id="team">
  <div class="team__kopf" data-teamkopf>
    <div class="team__bild" data-teambild role="img" aria-label="Das Ärzteteam der Praxis Dres. Nold"></div>
    <h2 class="team__titel ohne-verlauf">Wir freuen uns auf Sie</h2>
  </div>

  <div class="team__inhalt">
    <ul class="aerzte" role="list">
      {aerzte.map((a) => (
        <li class="arzt">
          <div class="portraet portraet--gross" data-portraet>
            <div class="portraet__ausschnitt">
              <img class="portraet__bild" src={foto(a)} alt={a.foto_alt} width="720" height="960" loading="lazy" />
            </div>
            <span class="portraet__schatten" aria-hidden="true"></span>
            <span class="portraet__pfeil" aria-hidden="true"></span>
          </div>
          <p class="person">
            <span class="person__name">{a.name}</span>
            <span class="person__funktion">{a.funktion}</span>
          </p>
        </li>
      ))}
    </ul>

    <ul class="mitarbeitende" role="list">
      {mitarbeitende.map((m) => {
        const taetigkeiten = (m.taetigkeiten || []).filter(Boolean);
        return (
          <li class="mitglied" data-mitglied>
            <div class="portraet" data-portraet>
              <div class="portraet__ausschnitt">
                <img class="portraet__bild" src={foto(m)} alt={m.foto_alt} width="820" height="1093" loading="lazy" />
              </div>
              <span class="portraet__schatten" aria-hidden="true"></span>
              <span class="portraet__pfeil" aria-hidden="true"></span>
            </div>

            {taetigkeiten.length > 0 ? (
              <>
                <button
                  class="person person--knopf"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`taetigkeiten-${m.id}`}
                  data-aufklapper
                >
                  <span class="person__name">{m.name}</span>
                  <span class="person__funktion">{m.funktion}</span>
                  <span class="person__pfeil" aria-hidden="true"></span>
                </button>
                <div class="taetigkeiten" id={`taetigkeiten-${m.id}`} data-taetigkeiten>
                  <ul class="taetigkeiten__liste" role="list">
                    {taetigkeiten.map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              </>
            ) : (
              <p class="person">
                <span class="person__name">{m.name}</span>
                <span class="person__funktion">{m.funktion}</span>
              </p>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .team {
    position: relative;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    background: var(--farbe-flaeche);
  }

  /* ---------- Gruppenfoto ---------- */

  /* .team-header-container */
  .team__kopf {
    position: relative;
    width: 100%;
    height: 580px;
    overflow: hidden;
  }

  /* .team-header: formatfüllend; Ablauf a-3 bewegt und vergrößert es */
  .team__bild {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: url('/bilder/aerzteteam.webp') center / cover no-repeat;
    transform:
      translateX(var(--kopf-fahrt, 0%))
      translateY(var(--kopf-versatz, -20px))
      scale(var(--kopf-groesse, 1));
    transition: --kopf-fahrt 5000ms cubic-bezier(0.42, 0, 0.58, 1);
  }

  @property --kopf-fahrt {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  /* .heading-3: 86 px, Gewicht 600, weiß mit weichem Schatten,
     am unteren Rand mit 40 px Abstand */
  .team__titel {
    position: absolute;
    inset: auto 0 0;
    margin: 0 0 40px;
    color: var(--farbe-text-invers);
    font-size: 86px;
    font-weight: var(--gewicht-halbfett);
    line-height: 1;
    text-align: center;
    text-shadow: 0 0 18px rgb(0 0 0 / 30%);
  }

  /* ---------- Porträts ---------- */

  /* .team-container: 100 px oben, 140 px unten */
  .team__inhalt {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding-block: 100px 140px;
  }

  ul[role='list'] {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* .docs-list-wrapper: drei Spalten in max. 900 px */
  .aerzte {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    max-width: 900px;
  }

  .arzt {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* .team-list-wrapper: max. 1400 px, 40 px unter den Ärzten;
     .accordion: umbrechend, mittig, oben ausgerichtet */
  .mitarbeitende {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    max-width: 1400px;
    margin-top: 40px;
  }

  /* .accordion__item: 260 px breit */
  .mitglied {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 260px;
  }

  /* .div-block-19 / .team-image-container: Rahmen mit abgeschnittenem
     Überlauf; das Foto sitzt unten, Pfeil und Schatten liegen darüber */
  .portraet {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: 260px;
    height: 260px;
    overflow: hidden;
  }

  .portraet--gross {
    width: 100%;
    height: 300px;
  }

  /* Der sichtbare Ausschnitt: 80 % → 100 % der Rahmenhöhe (Ablauf a / a-2),
     dabei 1,2 → 1 skaliert. Das Foto darin behält seine volle Höhe und
     bleibt oben verankert — wie `background-size: auto 300px` in der
     Vorlage: Ein kleinerer Ausschnitt zeigt weniger, nicht ein
     kleineres Bild. */
  .portraet__ausschnitt {
    display: flex;
    justify-content: center;
    width: 100%;
    height: calc(var(--ausschnitt, 1) * 100%);
    overflow: hidden;
    background: var(--farbe-flaeche);
    transform: scale(var(--groesse, 1));
  }

  .portraet__bild {
    width: auto;
    max-width: none;
    height: 300px;
  }

  .portraet:not(.portraet--gross) .portraet__bild { height: 260px; }

  /* .team-shadow: 14 px hoher Schattensaum, über die volle Breite */
  .portraet__schatten {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 14px;
    background: url('/icons/ui/linie-schatten.svg') 50% 100% / cover no-repeat;
  }

  /* .team-arrow: weißer Pfeil, 16 px hoch, unten mittig */
  .portraet__pfeil {
    position: absolute;
    inset: auto 0 0;
    z-index: 10;
    height: 16px;
    background: url('/icons/ui/pfeil-team.svg') 50% 100% / auto 16px no-repeat;
  }

  /* ---------- Name und Funktion ---------- */

  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: center;
  }

  .person--knopf { cursor: pointer; }

  .person--knopf:focus-visible {
    outline: 2px solid var(--farbe-primaer);
    outline-offset: 2px;
    border-radius: var(--radius-s);
  }

  /* .heading-2 / .heading-4: 22/26 px, Gewicht 400, 13 px Abstand oben */
  .person__name {
    display: block;
    width: 200px;
    margin-top: 13px;
    color: var(--farbe-primaer);
    font-size: 22px;
    font-weight: var(--gewicht-normal);
    line-height: 26px;
  }

  /* .text-block-2 / -3: 16 px, Gewicht 300, 7 px Abstand */
  .person__funktion {
    display: block;
    width: 200px;
    margin-top: 7px;
    color: var(--farbe-text);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.4;
  }

  /* Kleiner Pfeil als Hinweis, dass mehr dahinter steckt */
  .person__pfeil {
    display: block;
    width: 14px;
    height: 8px;
    margin-top: 6px;
    background: url('/icons/ui/pfeil-runter.svg') center / contain no-repeat;
    transition: transform 300ms var(--verlauf);
  }

  .person--knopf[aria-expanded='true'] .person__pfeil { transform: rotate(180deg); }

  /* Tätigkeiten: klappen in 300 ms auf (wie `slideToggle(300)`) */
  .taetigkeiten {
    display: grid;
    grid-template-rows: 0fr;
    width: 100%;
    transition: grid-template-rows 300ms var(--verlauf);
  }

  .taetigkeiten[data-offen] { grid-template-rows: 1fr; }

  .taetigkeiten__liste {
    overflow: hidden;
    min-height: 0;
    text-align: center;
  }

  .taetigkeiten__liste li {
    width: 60%;
    margin: 7px auto 0;
    color: var(--farbe-text);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.4;
  }

  /* ---------- Umbrüche wie in der Vorlage ---------- */

  @media (max-width: 991px) {
    .team__kopf { height: 400px; }
    .team__titel { font-size: 60px; }
    .portraet--gross { height: 260px; }
    .portraet--gross .portraet__bild { height: 260px; }
  }

  @media (max-width: 767px) {
    .team__kopf { height: 600px; }
    /* Das Foto ist doppelt so breit wie das Fenster und fährt beim
       Hereinscrollen von −50 % auf 0 % (Abläufe a-22 / a-23) */
    .team__bild {
      width: 200%;
      background-position: 50% 100%;
      background-size: contain;
      --kopf-fahrt: -50%;
    }
    .team__kopf[data-sichtbar] .team__bild { --kopf-fahrt: 0%; }
    .team__titel { font-size: 50px; }
    .aerzte { grid-template-columns: repeat(2, 1fr); }
    .mitglied { width: 50%; }
    .portraet { width: 100%; }
    .person__name { width: auto; font-size: 20px; line-height: 1.1; }
  }

  @media (max-width: 479px) {
    .team__kopf { height: 500px; }
    .team__bild { background-size: cover; }
    .team__titel { font-size: 60px; }
    /* Foto passt in den Rahmen, unten verankert */
    .portraet__ausschnitt { align-items: flex-end; }
    .portraet__bild,
    .portraet--gross .portraet__bild,
    .portraet:not(.portraet--gross) .portraet__bild { height: 100%; }
    .person__name { font-size: 18px; line-height: 1.2; }
    .person__funktion,
    .taetigkeiten__liste li { width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .team__bild { transform: none; transition: none; }
    .portraet__ausschnitt { height: 100%; transform: none; }
    .taetigkeiten, .person__pfeil { transition: none; }
  }
</style>

<script>
  import { nachziehen } from '../scripts/scrollwege';

  /**
   * Bewegungen im Team-Abschnitt, Werte aus den Abläufen der Vorlage.
   *
   *   a-3    Gruppenfoto: −20 px → 120 px, Skalierung 1 → 1,1 (0 … 100 %)
   *   a/a-2  Porträts: Ausschnitt 80 % → 100 %, Skalierung 1,2 → 1
   *          über die ersten 90 % des Scrollwegs
   *
   * Der Fortschritt zählt wie Webflows „while scrolling in view": 0 %
   * wenn die Oberkante unten ins Fenster tritt, 100 % wenn die
   * Unterkante oben hinausläuft. Der gezeichnete Wert läuft dem
   * Scrollwert nach (Webflow „smoothing 70").
   */
  function teamAufbauen() {
    const kopf = document.querySelector<HTMLElement>('[data-teamkopf]');
    if (!kopf || kopf.dataset.bereit) return;
    kopf.dataset.bereit = 'ja';

    accordionAufbauen();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const bild = kopf.querySelector<HTMLElement>('[data-teambild]');
    const portraets = [...document.querySelectorAll<HTMLElement>('[data-portraet]')];

    /** Anteil, zu dem ein Element den Blickbereich durchlaufen hat (0 … 1). */
    const anteil = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const weg = window.innerHeight + r.height;
      return Math.min(1, Math.max(0, (window.innerHeight - r.top) / weg));
    };

    /* Ein nachlaufender Wert je Element */
    const werte = new Map<HTMLElement, number>();
    const alle = [kopf, ...portraets];
    alle.forEach((el) => werte.set(el, anteil(el)));

    const zeichnen = () => {
      const p = werte.get(kopf) ?? 0;
      bild?.style.setProperty('--kopf-versatz', `${-20 + 140 * p}px`);
      bild?.style.setProperty('--kopf-groesse', String(1 + 0.1 * p));

      portraets.forEach((el) => {
        const q = Math.min(1, (werte.get(el) ?? 0) / 0.9);
        const ausschnitt = el.querySelector<HTMLElement>('.portraet__ausschnitt');
        ausschnitt?.style.setProperty('--ausschnitt', (0.8 + 0.2 * q).toFixed(4));
        ausschnitt?.style.setProperty('--groesse', (1.2 - 0.2 * q).toFixed(4));
      });
    };

    let laeuft = false;
    let zuletzt = 0;

    const schritt = (jetzt: number) => {
      const dt = zuletzt ? Math.min(100, jetzt - zuletzt) : 16.7;
      zuletzt = jetzt;

      let fertig = true;
      alle.forEach((el) => {
        const z = anteil(el);
        let w = nachziehen(werte.get(el) ?? z, z, dt);
        if (Math.abs(z - w) < 0.0005) w = z;
        else fertig = false;
        werte.set(el, w);
      });

      zeichnen();

      if (!fertig) requestAnimationFrame(schritt);
      else laeuft = false;
    };

    const anstossen = () => {
      if (laeuft) return;
      laeuft = true;
      zuletzt = 0;
      requestAnimationFrame(schritt);
    };

    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', anstossen, { passive: true });
    zeichnen();

    /* Abläufe a-22 / a-23 (nur Handys, siehe CSS): Sobald der Kopfbereich
       ins Bild kommt, fährt das Foto in 5 Sekunden von −50 % auf 0 %.
       Verlässt er das Bild, springt es zurück. */
    const beobachter = new IntersectionObserver((eintraege) => {
      eintraege.forEach((e) => {
        if (e.isIntersecting) kopf.setAttribute('data-sichtbar', 'ja');
        else kopf.removeAttribute('data-sichtbar');
      });
    }, { threshold: 0.1 });
    beobachter.observe(kopf);
  }

  /** Tätigkeiten auf- und zuklappen — nur eines gleichzeitig offen. */
  function accordionAufbauen() {
    const knoepfe = [...document.querySelectorAll<HTMLButtonElement>('[data-aufklapper]')];

    const setzen = (knopf: HTMLButtonElement, offen: boolean) => {
      knopf.setAttribute('aria-expanded', String(offen));
      const ziel = document.getElementById(knopf.getAttribute('aria-controls') || '');
      if (!ziel) return;
      if (offen) ziel.dataset.offen = 'ja';
      else delete ziel.dataset.offen;
    };

    knoepfe.forEach((knopf) => {
      knopf.addEventListener('click', () => {
        const offen = knopf.getAttribute('aria-expanded') === 'true';
        knoepfe.forEach((k) => { if (k !== knopf) setzen(k, false); });
        setzen(knopf, !offen);
      });
    });
  }

  teamAufbauen();
  document.addEventListener('astro:page-load', teamAufbauen);
</script>
