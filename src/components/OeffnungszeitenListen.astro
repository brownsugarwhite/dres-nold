---
/**
 * Die drei Sprechstunden-Listen — der Inhalt der scrollgesteuerten Blase
 * in Oeffnungszeiten.astro. Auf allen Bildschirmgrößen dieselbe Blase
 * (docs/entscheidungen.md); nebeneinander, zu zweit oder untereinander —
 * je nach Platz (Oeffnungszeiten.astro, `spaltenWaehlen()`).
 *
 * Gestaltung: Die Spaltentitel als gesperrte Versalien in der Hausfarbe
 * (Handoff vom 17. September 2026); die Zeilen darunter wie auf der
 * alten Seite (Florian, 26. September 2026) — der Wochentag rechtsbündig
 * in leichtem Schnitt, daneben Vor- und Nachmittag als zwei Angaben
 * nebeneinander (nie untereinander), alles in der Hausfarbe, ohne Linien. „…und nach
 * Vereinbarung" steht in der Zeitspalte. Die Haarlinien und der graue
 * Wochentag des Handoffs sind zurückgenommen.
 */
import oz from '../content/oeffnungszeiten.json';

const listen = [oz.zahnaerztlich, oz.kieferorthopaedisch, oz.telefonisch];

/** Vor- und Nachmittag, leere Hälften fallen weg. Zwei Stücke
    nebeneinander, die nie umbrechen — weder in sich noch zwischen
    einander (Florian, 27. September 2026). Wo der Platz nicht reicht,
    wählt Oeffnungszeiten.astro weniger Spalten. */
const zeiten = (z: { vormittag?: string; nachmittag?: string }) =>
  [z.vormittag, z.nachmittag].filter(Boolean) as string[];
---

{listen.map((liste) => (
  <section class="ozliste">
    <h3 class="ozliste__titel ohne-verlauf">{liste.titel}</h3>
    <table class="ozzeiten">
      <tbody>
        {liste.zeilen
          .filter((z) => z.vormittag || z.nachmittag)
          .map((z) => (
            <tr>
              <th scope="row">{z.tag}</th>
              <td>
                {/* Zwei Angaben nebeneinander, nie untereinander */}
                <span class="ozzeiten__angaben">
                  {zeiten(z).map((t) => <span class="ozzeiten__stueck">{t}</span>)}
                </span>
              </td>
            </tr>
          ))}
        {liste.zusatz && (
          <tr>
            <td></td>
            <td class="ozzeiten__zusatz">{liste.zusatz}</td>
          </tr>
        )}
      </tbody>
    </table>
  </section>
))}

<style>
  .ozliste { min-width: 0; }

  /* Spaltenüberschrift als Kicker in der Hausfarbe */
  .ozliste__titel {
    margin: 0 0 var(--abstand-m);
    color: var(--farbe-primaer);
    font-size: var(--text-kicker);
    font-weight: var(--gewicht-halbfett);
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* `--oz-zeilen-faktor` setzt Oeffnungszeiten.astro nur, wenn selbst
     einspaltig die Breite nicht reicht (sehr schmale Handys) — dann
     werden die Zeilen verkleinert, statt umzubrechen. Die Abstände darin
     stehen deshalb in `em`: Sie schrumpfen mit. */
  .ozzeiten {
    border-collapse: collapse;
    color: var(--farbe-primaer);
    font-size: calc(16px * var(--oz-zeilen-faktor, 1));
  }

  /* Wie die alte Seite: keine Linien, alles in der Hausfarbe, enge
     Zeilen. Wochentag rechtsbündig und leicht — er ist Beschriftung,
     nicht Angabe —, die Zeiten daneben in normalem Schnitt. */
  .ozzeiten th,
  .ozzeiten td {
    padding: 2px 0;
    font-weight: var(--gewicht-normal);
    line-height: 1.4;
    vertical-align: baseline;
  }

  /* `width: 1%`: die Spalte so schmal wie ihr längster Wochentag */
  .ozzeiten th {
    width: 1%;
    padding-right: 1em;
    font-weight: var(--gewicht-leicht);
    text-align: right;
    white-space: nowrap;
  }

  .ozzeiten__angaben {
    display: flex;
    flex-wrap: nowrap;
    column-gap: 0.875em;
  }

  .ozzeiten__stueck { white-space: nowrap; }

  .ozzeiten__zusatz { padding-top: 8px; }

  /* Handys: eine Stufe kleiner, damit Wochentag, Vor- und Nachmittag
     nebeneinander stehen (bei 375 px reichen die 339 px dafür) */
  @media (max-width: 48rem) {
    .ozliste__titel { margin-bottom: var(--abstand-xs); }
    .ozzeiten { font-size: calc(15px * var(--oz-zeilen-faktor, 1)); }
  }
</style>
