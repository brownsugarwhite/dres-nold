  .fussknopf__symbol {
    transform-origin: 50% 50%;
    transition: transform 0.45s var(--verlauf-betont);
  }

  .fussknopf:hover .fussknopf__symbol,
  .fussknopf:focus-visible .fussknopf__symbol {
    transform: scale(1.1);
  }

  /* Die Beschriftung behält Farbe und Deckkraft — sie rückt nur
     (Florian, 27. September 2026; vorher blendete sie auf 65 %) */
  .fussknopf__text {
    transition: transform 0.45s var(--verlauf-betont);
  }

  .fussknopf:hover .fussknopf__text,
  .fussknopf:focus-visible .fussknopf__text {
    transform: translateY(3px);
