---
/**
 * Navigation — Nachbau der Webflow-Vorlage.
 *
 * Zwei Leisten, die beim Scrollen die Rollen tauschen:
 *
 *   Ganz oben auf der Seite   Kontaktzeile (40 px) sichtbar,
 *                             Symbolleiste am unteren Rand sichtbar,
 *                             Kopfleiste eingefahren (Höhe 0)
 *
 *   Nach dem Scrollen         Kontaktzeile eingefahren,
 *                             Kopfleiste (80 px) ausgefahren,
 *                             Symbolleiste 110 px nach unten hinaus
 *
 * Werte aus den Abläufen `schnalz in` (a-26) und `schnalz out` (a-16):
 * 300 ms, easeOut.
 *
 * Neu gegenüber der Vorlage: Der Punkt „Leistungen" klappt zweispaltig
 * auf und listet die Einträge aus leistungen.json.
 */
import navi from '../content/navigation.json';
import leistungen from '../content/leistungen.json';
import seite from '../content/seite.json';
import neuigkeiten from '../content/neuigkeiten.json';

const { praxis } = seite;

const hatNeuigkeiten = neuigkeiten.eintraege.some((e) => e.aktiv);
const punkte = navi.eintraege
  .filter((e) => e.aktiv && (e.id !== 'neuigkeiten' || hatNeuigkeiten))
  .sort((a, b) => a.position - b.position);

const kopf = punkte.filter((e) => e.in_kopfleiste);
/* Die Symbolleiste unten hat in der Vorlage eine eigene Reihenfolge —
   und auf Handys eine andere als auf dem Desktop. Statt die Reihenfolge
   per CSS zu verschieben (fehleranfällig bei den Trennpunkten) werden
   beide Listen erzeugt und per Umbruchpunkt umgeschaltet. */
const fussGross = punkte
  /* Die Telefonnummer erscheint nur auf Handys — auf dem Desktop
     steht sie in der Kontaktzeile oben. */
  .filter((e) => e.in_fussleiste && e.id !== 'telefon')
  .sort((a, b) => (a.position_fussleiste ?? 99) - (b.position_fussleiste ?? 99))
  .filter((e) => e.id !== 'zeiten')
  .concat(punkte.filter((e) => e.id === 'zeiten'));   // Öffnungszeiten ans Ende

const fussKlein = ['kontakt', 'telefon', 'zeiten']
  .map((id) => punkte.find((e) => e.id === id))
  .filter(Boolean);

const dienste = leistungen.eintraege.filter((e) => e.aktiv).sort((a, b) => a.position - b.position);

/* Die Kategorien kommen aus dem Inhaltsmodell — die Praxis kann dort
   eigene anlegen. Leere Kategorien erscheinen nicht. */
const kategorien = (leistungen.kategorien ?? [])
  .filter((k) => k.aktiv)
  .sort((a, b) => a.position - b.position)
  .map((k) => ({ ...k, eintraege: dienste.filter((e) => e.kategorie === k.id) }))
  .filter((k) => k.eintraege.length > 0);
---

{/*
  `transition:persist`: Beim Seitenwechsel bleibt die Navigation samt
  Zustand (offenes Menü, Leistenwechsel) stehen und wird nicht neu
  aufgebaut. Die Leisten tragen eigene Übergangsnamen und bewegen
  sich nicht — so bleiben sie scharf, während der Rest verschwimmt
  (styles/uebergaenge.css).
*/}
<div class="navigation" transition:persist="navigation">
{/* Kontaktzeile — oben auf der Seite sichtbar */}
<div class="kontaktzeile" data-leiste="kontakt" transition:name="nav-kontakt" transition:animate="none">
  <div class="kontaktzeile__inhalt">
    <span class="kontaktzeile__text">{praxis.strasse}</span>
    <span class="punkt" aria-hidden="true"></span>
    <span class="kontaktzeile__text">{praxis.plz} {praxis.ort}</span>
    <span class="punkt punkt--ab-tablet" aria-hidden="true"></span>
    <span class="kontaktzeile__text kontaktzeile__text--ab-tablet">
      <a href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>
    </span>
    <span class="punkt" aria-hidden="true"></span>
    <span class="kontaktzeile__text">
      <a href={`mailto:${praxis.email}`}>{praxis.email}</a>
    </span>
  </div>
</div>

{/* Kopfleiste — fährt beim Scrollen ein */}
<header class="kopfleiste" data-leiste="kopf" transition:name="nav-kopf" transition:animate="none">
  <nav class="kopfleiste__inhalt" aria-label="Hauptnavigation">
    {/* Auf Handys: Logo und Menü-Knopf statt der Menüpunkte */}
    <div class="kopfleiste__mobil">
      <a class="logo" href="/" aria-label={`${praxis.name} — zur Startseite`}>
        <img src="/icons/logo.svg" alt="" width="80" height="80" />
      </a>
      <button
        class="menueknopf"
        type="button"
        data-menueknopf
        aria-expanded="false"
        aria-controls="mobilmenue"
        aria-label="Menü öffnen"
      >
        <span class="menueknopf__lottie" data-menuelottie aria-hidden="true"></span>
      </button>
    </div>

    <a class="logo logo--desktop" href="/" aria-label={`${praxis.name} — zur Startseite`}>
      <img src="/icons/logo.svg" alt="" width="80" height="80" />
    </a>
    <span class="punkt" aria-hidden="true"></span>

    {kopf.map((e, i) => (
      <>
        {e.id === 'leistungen' ? (
          <div class="aufklapp" data-aufklapp data-richtung="runter">
            <button class="menuepunkt menuepunkt--knopf" type="button" aria-expanded="false" aria-controls="leistungsmenue">
              <span class="menuepunkt__rolle">
                <span class="menuepunkt__text">{e.titel}</span>
                <span class="menuepunkt__text" aria-hidden="true">{e.titel}</span>
              </span>
            </button>

            <div class="aufklapp__inhalt" id="leistungsmenue" hidden>
              <span class="aufklapp__linie" aria-hidden="true"></span>

              <div class="aufklapp__spalten">
                {kategorien.map((k, i) => (
                  <a class="oberpunkt" href={`/#leistungen-${k.id}`} style={`--stufe: ${i}`}>
                    {k.icon && <img class="oberpunkt__symbol" src={k.icon} alt="" width="60" height="60" />}
                    <span class="oberpunkt__titel">{k.titel}</span>
                    {k.kurz && <span class="oberpunkt__kurz">{k.kurz}</span>}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="menuepunkt" href={e.ziel}>
            <span class="menuepunkt__rolle">
              <span class="menuepunkt__text">{e.titel}</span>
              <span class="menuepunkt__text" aria-hidden="true">{e.titel}</span>
            </span>
          </a>
        )}
        {i < kopf.length - 1 && <span class="punkt" aria-hidden="true"></span>}
      </>
    ))}
  </nav>
</header>
  {/* Ausklappmenü für Handys — Höhe 0 → 338 px (Ablauf a-25) */}
  <div class="mobilmenue" id="mobilmenue" data-mobilmenue>
    <div class="mobilmenue__inhalt">
      {punkte.map((e) => (
        e.id === 'leistungen' ? (
          <button class="mobilmenue__punkt mobilmenue__punkt--knopf" type="button" data-mobilleistungen>
            <img class="mobilmenue__symbol" src={e.icon} alt="" width="60" height="60" />
            <span class="mobilmenue__text">{e.titel}</span>
            <span class="mobilmenue__pfeil" aria-hidden="true">›</span>
          </button>
        ) : (
          <a class="mobilmenue__punkt" href={e.ziel}>
            <img class="mobilmenue__symbol" src={e.icon} alt="" width="60" height="60" />
            <span class="mobilmenue__text">{e.titel}</span>
          </a>
        )
      ))}
    </div>

    {/* Unterebene: erscheint beim Tippen auf „Leistungen“ */}
    <div class="unterebene" data-unterebene hidden>
      <button class="unterebene__zurueck" type="button" data-unterebeneZurueck>
        <span aria-hidden="true">‹</span> Zurück
      </button>
      <h2 class="unterebene__titel">Leistungen</h2>
      <div class="unterebene__liste">
        {kategorien.map((k, i) => (
          <a class="unterebene__punkt" href={`/#leistungen-${k.id}`} style={`--stufe: ${i}`}>
            {k.icon && <img class="mobilmenue__symbol" src={k.icon} alt="" width="60" height="60" />}
            <span class="unterebene__text">
              <span class="unterebene__name">{k.titel}</span>
              {k.kurz && <span class="unterebene__kurz">{k.kurz}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>

    {/* .div-block-30: Punktlinie oben, 40 px hoch */}
    <div class="mobilmenue__recht">
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/impressum/">Impressum</a>
    </div>
  </div>

</div>

{/* Symbolleiste am unteren Rand — oben auf der Seite sichtbar */}
<nav class="fussleiste" data-leiste="fuss" aria-label="Schnellzugriff" transition:name="nav-fuss" transition:animate="none">
  <div class="fussleiste__inhalt fussleiste__inhalt--gross">
    {fussGross.map((e, i) => (
      <>
        {e.id === 'leistungen' ? (
          <div class="aufklapp" data-aufklapp data-richtung="hoch">
            <button class="fussknopf fussknopf--knopf" type="button" aria-expanded="false" aria-controls="leistungsmenue-unten">
              <img class="fussknopf__symbol" src={e.icon} alt="" width="60" height="60" />
              <span class="fussknopf__text">{e.titel}</span>
            </button>

            <div class="aufklapp__inhalt" id="leistungsmenue-unten" hidden>
              <span class="aufklapp__linie" aria-hidden="true"></span>

              <div class="aufklapp__spalten">
                {kategorien.map((k, i) => (
                  <a class="oberpunkt" href={`/#leistungen-${k.id}`} style={`--stufe: ${i}`}>
                    {k.icon && <img class="oberpunkt__symbol" src={k.icon} alt="" width="60" height="60" />}
                    <span class="oberpunkt__titel">{k.titel}</span>
                    {k.kurz && <span class="oberpunkt__kurz">{k.kurz}</span>}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="fussknopf" href={e.ziel} data-punkt={e.id}>
            <img class="fussknopf__symbol" src={e.icon} alt="" width="60" height="60" />
            <span class="fussknopf__text">{e.titel}</span>
          </a>
        )}
        {i < fussGross.length - 1 && <span class="punkt punkt--fuss" aria-hidden="true"></span>}
      </>
    ))}
  </div>

  <div class="fussleiste__inhalt fussleiste__inhalt--klein">
    {fussKlein.map((e, i) => (
      <>
        <a class="fussknopf" href={e.ziel} data-punkt={e.id}>
          <img class="fussknopf__symbol" src={e.icon} alt="" width="60" height="60" />
          <span class="fussknopf__text">{e.titel}</span>
        </a>
        {i < fussKlein.length - 1 && <span class="punkt punkt--fuss" aria-hidden="true"></span>}
      </>
    ))}
  </div>
</nav>

<style>
  /* ---------- Umschlag beider Leisten ----------
     Oben fixiert, volle Breite, mit Weichzeichner und der Punktlinie
     am unteren Rand — wie in der Vorlage (.nav). */
  /* Werte aus .nav der Vorlage */
  .navigation {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    background: rgb(255 255 255 / 80%) url('/bilder/deko/punktlinie.png') 0 100% repeat-x;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  /* ---------- Kontaktzeile ---------- */
  .kontaktzeile {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    height: 40px;
    overflow: hidden;
    transition: height 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  .kontaktzeile__inhalt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 60%;
    max-width: 700px;
    height: 40px;
  }

  .kontaktzeile__text {
    display: flex;
    align-items: center;
    color: var(--farbe-primaer);
    font-size: var(--text-xs);
    font-weight: 300;
    white-space: nowrap;
  }

  .kontaktzeile__text a {
    color: inherit;
    text-decoration: none;
  }

  .kontaktzeile__text a:hover,
  .kontaktzeile__text a:focus-visible {
    text-decoration: underline;
  }

  /* ---------- Kopfleiste ---------- */
  .kopfleiste {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    height: 0;
    overflow: hidden;
    transition: height 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  /* Das Aufklappmenü ragt aus der Leiste heraus — solange es offen ist,
     darf sie den Überlauf nicht beschneiden. */
  .navigation:has(.aufklapp[data-offen]) .kopfleiste,
  .navigation:has(.aufklapp[data-offen]) { overflow: visible; }

  .fussleiste:has(.aufklapp[data-offen]) { overflow: visible; }

  .kopfleiste__inhalt {
    display: flex;
    justify-content: space-around;
    align-items: center;
    width: 60%;
    max-width: 700px;
    height: 80px;
  }

  /* .nav-buttons-mobile / -desktop: beide 80 px hoch */
  .kopfleiste__mobil {
    display: none;
    justify-content: space-around;
    align-items: center;
    width: 100%;
    height: 80px;
    overflow: hidden;
  }

  /* .lottie-animation-3: 50 × 50 */
  .menueknopf {
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menueknopf__lottie {
    display: block;
    width: 50px;
    height: 50px;
    /* Rückfall ohne Lottie: drei Striche */
    background:
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 14px / 26px 2px no-repeat,
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 24px / 26px 2px no-repeat,
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 34px / 26px 2px no-repeat;
  }

  .menueknopf__lottie[data-lottie-bereit] { background: none; }

  /* .mobile-expend: Höhe 0 → 338 px, 700 ms easeInOut */
  .mobilmenue {
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
    transition: height 700ms cubic-bezier(0.42, 0, 0.58, 1);
  }

  .navigation[data-menue-offen] .mobilmenue { height: 100vh; }

  /* .menu-button-container: 90 % Breite, 20 px Abstand oben.
     Als Liste untereinander statt zweizeilig — die Leistungen
     bekommen später Unterpunkte. */
  .mobilmenue__inhalt {
    display: flex;
    flex-direction: column;
    width: 90%;
    margin: 20px auto 0;
  }

  .mobilmenue__punkt {
    display: flex;
    align-items: center;
    gap: var(--abstand-s);
    padding: var(--abstand-2xs) 0;
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  /* Symbolgröße wie in der unteren Leiste */
  .mobilmenue__symbol {
    flex: none;
    width: 60px;
    height: 60px;
    object-fit: contain;
  }

  .mobilmenue__text {
    font-size: 18px;
    font-weight: 400;
  }

  /* Beim Tippen auf „Leistungen“ faden die übrigen Punkte aus … */
  .mobilmenue[data-unterebene-offen] .mobilmenue__inhalt {
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms cubic-bezier(0, 0, 0.58, 1);
  }

  .mobilmenue__inhalt {
    opacity: 1;
    transition: opacity 250ms cubic-bezier(0, 0, 0.58, 1);
  }

  .mobilmenue__punkt--knopf {
    width: 100%;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .mobilmenue__pfeil {
    margin-left: auto;
    font-size: 24px;
    color: var(--farbe-text-gedeckt);
  }

  /* … und die Unterebene schiebt sich von oben herein */
  .unterebene {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    padding: 20px 5% 0;
  }

  .unterebene[hidden] { display: none; }

  .unterebene__zurueck {
    padding: 0;
    border: 0;
    background: none;
    color: var(--farbe-text-gedeckt);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  /* Überschrift gleitet von oben herein */
  .unterebene__titel {
    margin: var(--abstand-2xs) 0 var(--abstand-m);
    color: var(--farbe-primaer);
    font-size: 24px;
    transform: translateY(-16px);
    opacity: 0;
    transition:
      transform 350ms cubic-bezier(0, 0, 0.58, 1),
      opacity 350ms cubic-bezier(0, 0, 0.58, 1);
  }

  .unterebene__liste { display: flex; flex-direction: column; }

  /* Die Kategorien erscheinen nacheinander */
  .unterebene__punkt {
    display: flex;
    align-items: center;
    gap: var(--abstand-s);
    padding: var(--abstand-2xs) 0;
    color: var(--farbe-primaer);
    text-decoration: none;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 300ms cubic-bezier(0, 0, 0.58, 1),
      transform 300ms cubic-bezier(0, 0, 0.58, 1);
    transition-delay: calc(200ms + var(--stufe, 0) * 90ms);
  }

  .mobilmenue[data-unterebene-offen] .unterebene__titel {
    transform: translateY(0);
    opacity: 1;
  }

  .mobilmenue[data-unterebene-offen] .unterebene__punkt {
    opacity: 1;
    transform: translateY(0);
  }

  .unterebene__text { display: flex; flex-direction: column; }
  .unterebene__name { font-size: 18px; }
  .unterebene__kurz { color: var(--farbe-text); font-size: 14px; font-weight: 300; }

  @media (prefers-reduced-motion: reduce) {
    .unterebene__titel,
    .unterebene__punkt { transition: none; }
  }

  /* .div-block-30: Punktlinie oben, 40 px hoch */
  .mobilmenue__recht {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--abstand-l);
    width: 100%;
    height: 40px;
    margin-top: var(--abstand-m);
    background: url('/bilder/deko/punktlinie.png') 50% 0 repeat-x;
    background-size: auto 1px;
  }

  .mobilmenue__recht a {
    color: var(--farbe-text);
    font-size: 14px;
    text-decoration: none;
  }

  .mobilmenue__recht a:hover,
  .mobilmenue__recht a:focus-visible { color: var(--farbe-primaer); }

  .logo img {
    width: 80px;
    height: 80px;
    object-fit: contain;
  }

  /* ---------- Menüpunkte mit Text-Roll ----------
     Zwei identische Texte übereinander; beim Zeigen rollt der Block
     um genau eine Höhe hoch. Aus Ablauf a-18 (300 ms, easeInOut).

     Wichtig: Die Vorlage kennt KEIN Hover-Out. Der Ablauf rollt hoch und
     springt danach in 0 ms auf den Anfang zurück — unsichtbar, weil beide
     Texte gleich sind. Beim Verlassen läuft also nichts zurück. Deshalb
     eine Animation ohne Nachzustand statt einer Transition: Fällt der
     Zeiger weg, endet die Animation, der Block steht wieder auf 0, und
     der nächste Hover startet sie erneut. */
  .menuepunkt {
    display: block;
    height: 80px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--farbe-primaer);
    font: inherit;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
  }

  .menuepunkt__rolle {
    display: flex;
    flex-direction: column;
  }

  @keyframes menue-rolle {
    to { transform: translateY(-80px); }
  }

  .menuepunkt__text {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80px;
    flex: none;
  }

  /* Ablauf a-18: 300 ms, easeInOut — einmal hoch, kein Zurückrollen */
  .menuepunkt:hover .menuepunkt__rolle {
    animation: menue-rolle 300ms cubic-bezier(0.42, 0, 0.58, 1);
  }

  /* Solange das Aufklappmenü offen ist, steht der Text still oben */
  .aufklapp[data-offen] .menuepunkt__rolle {
    transform: translateY(-80px);
    animation: none;
  }

  /* Tastatur: kein Rollen, dafür eine sichtbare Fokuslinie */
  .menuepunkt:focus-visible {
    outline: 2px solid var(--farbe-primaer);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .menuepunkt:hover .menuepunkt__rolle { animation: none; }
  }

  /* ---------- Aufklappmenü ---------- */
  .aufklapp {
    position: relative;
  }

  /* Klappt unter dem Menüpunkt auf. Solange die Leiste unten steht
     (Seite ganz oben), öffnet es nach oben; sobald sie oben klebt,
     nach unten. */
  .aufklapp__inhalt {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--ebene-menue);
    min-width: 34rem;
    padding: var(--abstand-m);
    background: var(--farbe-flaeche);
  }

  /* Untere Leiste: das Feld steht über der Leiste */
  .aufklapp[data-richtung='hoch'] .aufklapp__inhalt {
    bottom: 100%;
    box-shadow: 0 -12px 32px rgb(19 0 13 / 12%);
  }

  /* Obere Leiste: darunter */
  .aufklapp[data-richtung='runter'] .aufklapp__inhalt {
    top: 100%;
    box-shadow: 0 12px 32px rgb(19 0 13 / 12%);
  }

  .aufklapp__inhalt[hidden] { display: none; }

  /* Die gestrichelte Linie fährt aus dem Menüpunkt heraus —
     nach oben, wenn das Menü unten steht, sonst nach unten. */
  .aufklapp__linie {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: url('/bilder/deko/punktlinie.png') 0 0 repeat-x;
    background-size: auto 1px;
    transition:
      top 300ms cubic-bezier(0, 0, 0.58, 1),
      bottom 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  /* Sie startet an der Leiste und fährt an die andere Kante des Feldes —
     nach oben, wenn die Leiste unten steht, sonst nach unten. */
  .aufklapp[data-richtung='hoch'] .aufklapp__linie { bottom: 0; }
  .aufklapp[data-richtung='hoch'][data-offen] .aufklapp__linie { bottom: calc(100% - 1px); }

  .aufklapp[data-richtung='runter'] .aufklapp__linie { top: 0; }
  .aufklapp[data-richtung='runter'][data-offen] .aufklapp__linie { top: calc(100% - 1px); }

  /* Die Oberpunkte erscheinen nacheinander von links nach rechts */
  .oberpunkt {
    opacity: 0;
    transform: translateX(-16px);
    transition:
      opacity 300ms cubic-bezier(0, 0, 0.58, 1),
      transform 300ms cubic-bezier(0, 0, 0.58, 1),
      background-color var(--dauer-schnell) var(--verlauf);
    transition-delay: calc(120ms + var(--stufe, 0) * 90ms), calc(120ms + var(--stufe, 0) * 90ms), 0ms;
  }

  .aufklapp[data-offen] .oberpunkt {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .aufklapp__linie,
    .oberpunkt { transition: none; }
    .oberpunkt { opacity: 1; transform: none; }
  }

  .aufklapp__spalten {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--abstand-m);
  }

  /* Ein Oberpunkt je Kategorie — Symbol, Titel, Kurztext */
  .oberpunkt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--abstand-3xs);
    padding: var(--abstand-s);
    border-radius: var(--radius-m);
    color: var(--farbe-primaer);
    text-align: center;
    text-decoration: none;
  }

  .oberpunkt:hover,
  .oberpunkt:focus-visible { background: var(--farbe-flaeche-gedeckt); }

  .oberpunkt__symbol {
    width: 60px;
    height: 60px;
    margin-bottom: 5px;
    object-fit: contain;
  }

  .oberpunkt__titel {
    font-size: 16px;
    font-weight: var(--gewicht-halbfett);
  }

  .oberpunkt__kurz {
    color: var(--farbe-text);
    font-size: 14px;
    font-weight: 300;
  }

  /* ---------- Symbolleiste unten ---------- */
  /* .nav-bottom: fest am unteren Rand, Punktlinie oben */
  .fussleiste {
    position: fixed;
    inset: auto 0 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    background: rgb(255 255 255 / 80%) url('/bilder/deko/punktlinie.png') 0 0 repeat-x;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: transform 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  /* .nav-bottom-wrapper: feste Breite 700px, Höhe 110px */
  .fussleiste__inhalt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 700px;
    max-width: 700px;
    height: 110px;
  }

  /* Die kurze Fassung gilt erst ab der Handybreite (siehe unten) */
  .fussleiste__inhalt--klein { display: none; }

  .fussknopf--knopf {
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  /* Über die volle Leistenhöhe, damit das Aufklappfeld bündig an der
     Punktlinie der Leiste ansetzt und die Linie von dort losfährt */
  .fussleiste .aufklapp {
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  /* .nav-bottom-button: 4 px Abstand nach oben */
  .fussknopf {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    margin-top: 4px;
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  /* .nav-bottom-button-txt: 14 px, Gewicht 400 */
  .fussknopf__text {
    color: var(--farbe-primaer);
    font-size: 14px;
    font-weight: 400;
    text-align: center;
  }

  /* .nav-bottom-button-icon: 60 × 60 px, 5 px Abstand nach unten */
  .fussknopf__symbol {
    width: 60px;
    height: 60px;
    margin-bottom: 5px;
    object-fit: contain;
  }

  /* Die Vorlage kennt keinen Hover-Zustand für die Symbolknöpfe;
     nur die Tastatur bekommt eine sichtbare Fokuslinie. */
  .fussknopf:focus-visible {
    outline: 2px solid var(--farbe-primaer);
    outline-offset: 2px;
    border-radius: var(--radius-s);
  }

  /* ---------- Zustand „gescrollt" ----------
     Gesetzt vom Skript, sobald der Startbereich verlassen wird. */
  :global(body[data-gescrollt]) .kontaktzeile { height: 0; }
  :global(body[data-gescrollt]) .kopfleiste { height: 80px; }
  :global(body[data-gescrollt]) .fussleiste { transform: translateY(110px); }

  /* ---------- Punkte als Trenner ---------- */
  .punkt--fuss {
    align-self: center;
    margin-bottom: var(--abstand-s);
  }

  /* Der Punkt hinter dem jeweils letzten Knopf entfällt.
     Auf kleinen Bildschirmen ist das „Team", auf dem Desktop
     wandert „Öffnungszeiten" ans rechte Ende. */
  .punkt--fuss[data-nach='team'] { display: none; }

  @media (min-width: 992px) {
  }

  /* .dot: 3 × 3 px, schwarz */
  .punkt {
    flex: none;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #000;
  }

  /* ---------- Kleine Bildschirme ---------- */
  /* ---------- Kleine Bildschirme (Umbruchpunkt der Vorlage) ---------- */
  @media (max-width: 991px) {
    .kontaktzeile__inhalt,
    .kopfleiste__inhalt,
    .fussleiste__inhalt { width: 90%; }

    /* Auf Handys die kurze Leiste statt der langen */
    .fussleiste__inhalt--gross { display: none; }
    .fussleiste__inhalt--klein { display: flex; }

    /* Ohne Telefonnummer — die steht unten als eigener Knopf */
    .punkt--ab-tablet,
    .kontaktzeile__text--ab-tablet { display: none; }

    /* Statt der Menüpunkte: Logo mit Menü-Knopf */
    .kopfleiste__mobil { display: flex; }
    .logo--desktop,
    .menuepunkt,
    .aufklapp { display: none; }
    .kopfleiste__inhalt > .punkt { display: none; }

    /* Untere Leiste: nur Kontakt · Telefon · Öffnungszeiten */
    .fussknopf[data-klein='nein'],
    .punkt--fuss[data-klein='nein'] { display: none; }

    .fussknopf[data-punkt='kontakt'] { order: 1; }
    .punkt--fuss[data-nach='kontakt'] { order: 2; display: block; }
    .fussknopf[data-punkt='telefon'] { order: 3; }
    .punkt--fuss[data-nach='telefon'] { order: 4; display: block; }
    .fussknopf[data-punkt='zeiten'] { order: 5; }
    .punkt--fuss[data-nach='zeiten'] { display: none; }
  }

  /* ---------- Ab Tablet ---------- */
  @media (min-width: 992px) {
  }
</style>

<script>
  import { SCHNALZ_WEG } from '../scripts/scrollwege';
  /**
   * Verhalten der Navigation.
   *
   * 1. Leistenwechsel beim Scrollen: Sobald der Startbereich verlassen
   *    wird, trägt <body> die Markierung `data-gescrollt`. Alles Weitere
   *    erledigt CSS. Der Wechsel wird mit einem Puffer geschaltet, damit
   *    die Leisten an der Schwelle nicht flackern.
   *
   * 2. Aufklappmenü unter „Leistungen": öffnet per Klick, schließt per
   *    Escape, Klick nach außen oder wenn der Fokus den Bereich verlässt.
   */
  function navigationAufbauen() {
    // ---- Leistenwechsel ----
    // In der Vorlage hängt der Wechsel an einem eigenen unsichtbaren
    // Streifen (`.trigger-schnalz`, 250vh ab Dokumentanfang): sobald er
    // oben aus dem Bild läuft, fährt die untere Leiste weg und die obere
    // ein (Abläufe a-26 / a-16). Das ist deutlich später als das
    // Einrasten der Öffnungszeiten — die Blase steht also schon eine
    // Weile, bevor die Leisten tauschen.

    let gescrollt = false;
    let geplant = false;

    const pruefen = () => {
      geplant = false;
      const bereich = document.querySelector<HTMLElement>('.ozbereich');

      const sollGescrollt = bereich
        ? window.scrollY > SCHNALZ_WEG * window.innerHeight
        // Unterseiten (Leistung, Beitrag, Rechtliches) haben keinen
        // Logobereich: dort steht von Anfang an die Kopfleiste mit dem
        // Menü, die Symbolleiste bleibt eingefahren.
        : true;

      if (sollGescrollt !== gescrollt) {
        gescrollt = sollGescrollt;
        if (gescrollt) document.body.dataset.gescrollt = 'ja';
        else delete document.body.dataset.gescrollt;
      }
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(pruefen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    pruefen();

    // ---- Aufklappmenü ----
    document.querySelectorAll<HTMLElement>('[data-aufklapp]').forEach((huelle) => {
      if (huelle.dataset.bereit) return;
      huelle.dataset.bereit = 'ja';

      const knopf = huelle.querySelector<HTMLButtonElement>('button[aria-expanded]');
      const inhalt = huelle.querySelector<HTMLElement>('.aufklapp__inhalt');
      if (!knopf || !inhalt) return;

      const setzen = (offen: boolean) => {
        knopf.setAttribute('aria-expanded', String(offen));
        if (offen) {
          inhalt.hidden = false;
          // Zwei Bilder abwarten, sonst springt das Feld ohne Übergang auf
          requestAnimationFrame(() => requestAnimationFrame(() => {
            if (knopf.getAttribute('aria-expanded') === 'true') huelle.dataset.offen = 'ja';
          }));
        } else {
          delete huelle.dataset.offen;
          window.setTimeout(() => {
            if (knopf.getAttribute('aria-expanded') !== 'true') inhalt.hidden = true;
          }, 300);
        }
      };

      knopf.addEventListener('click', () => {
        setzen(knopf.getAttribute('aria-expanded') !== 'true');
      });

      // Auf Zeigegeräten öffnet auch das Überfahren
      huelle.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') setzen(true);
      });
      huelle.addEventListener('pointerleave', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') setzen(false);
      });

      // Schließen, wenn der Fokus den Bereich verlässt
      huelle.addEventListener('focusout', (e) => {
        const ziel = e.relatedTarget as Node | null;
        if (!ziel || !huelle.contains(ziel)) setzen(false);
      });

      // Schließen bei Klick außerhalb
      document.addEventListener('click', (e) => {
        if (!huelle.contains(e.target as Node)) setzen(false);
      });

      // Schließen mit Escape, Fokus zurück auf den Knopf
      huelle.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          setzen(false);
          knopf.focus();
        }
      });
    });

    // ---- Mobiles Ausklappmenü ----
    // Ablauf a-25 / a-27: Höhe 0 ↔ 338 px in 700 ms, der Lottie-Knopf
    // läuft dabei in 600 ms von Bild 0 auf 99 und zurück.
    const menueknopf = document.querySelector<HTMLButtonElement>('[data-menueknopf]');
    const navigation = document.querySelector<HTMLElement>('.navigation');
    const lottieKasten = document.querySelector<HTMLElement>('[data-menuelottie]');

    if (menueknopf && navigation && !menueknopf.dataset.bereit) {
      menueknopf.dataset.bereit = 'ja';
      let knopfSpieler: { playSegments: (b: [number, number], s?: boolean) => void; totalFrames: number } | null = null;

      if (lottieKasten) {
        import('../scripts/lottie').then(({ ladeAnimation }) => {
          ladeAnimation(lottieKasten, '/lottie/menue-button.json').then((s) => { knopfSpieler = s as never; });
        });
      }

      menueknopf.addEventListener('click', () => {
        const offen = navigation.hasAttribute('data-menue-offen');
        if (offen) {
          navigation.removeAttribute('data-menue-offen');
          menueknopf.setAttribute('aria-expanded', 'false');
          menueknopf.setAttribute('aria-label', 'Menü öffnen');
          knopfSpieler?.playSegments([knopfSpieler.totalFrames - 1, 0], true);
        } else {
          navigation.setAttribute('data-menue-offen', 'ja');
          menueknopf.setAttribute('aria-expanded', 'true');
          menueknopf.setAttribute('aria-label', 'Menü schließen');
          knopfSpieler?.playSegments([0, knopfSpieler.totalFrames - 1], true);
        }
      });

      // Unterebene „Leistungen“ öffnen und schließen
      const menue = document.querySelector<HTMLElement>('[data-mobilmenue]');
      const unter = document.querySelector<HTMLElement>('[data-unterebene]');
      const knopfLeistungen = document.querySelector<HTMLButtonElement>('[data-mobilleistungen]');
      const zurueck = document.querySelector<HTMLButtonElement>('[data-unterebeneZurueck]');

      knopfLeistungen?.addEventListener('click', () => {
        if (!menue || !unter) return;
        unter.hidden = false;
        requestAnimationFrame(() => requestAnimationFrame(() => {
          menue.setAttribute('data-unterebene-offen', 'ja');
        }));
      });

      zurueck?.addEventListener('click', () => {
        if (!menue || !unter) return;
        menue.removeAttribute('data-unterebene-offen');
        window.setTimeout(() => { unter.hidden = true; }, 300);
        knopfLeistungen?.focus();
      });

      // Ein Klick auf einen Menüpunkt schließt wieder (wie in a-27)
      document.querySelectorAll('.mobilmenue__punkt').forEach((a) => {
        a.addEventListener('click', () => {
          navigation.removeAttribute('data-menue-offen');
          menueknopf.setAttribute('aria-expanded', 'false');
          knopfSpieler?.playSegments([knopfSpieler.totalFrames - 1, 0], true);
        });
      });
    }
  }

  navigationAufbauen();
  document.addEventListener('astro:page-load', navigationAufbauen);
</script>
