  .fussleiste {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  /* .nav-bottom-wrapper: feste Breite 700px, Höhe 110px */
  /* Die Leiste war mit festen 700 px eng getaktet. Jetzt darf sie bis
     980 px atmen und staucht sich auf schmalen Fenstern von selbst.
     Zipfel und Aufklappmenue richten sich nach der gemessenen Knopfmitte
     (Oeffnungszeiten.astro `vermessen()`, Navigation `zeichnen()`) und
