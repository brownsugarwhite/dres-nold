</style>

<script>
  import { schnalzWeg } from '../scripts/scrollwege';
  /**
   * Verhalten der Navigation.
   *
   * 1. Leistenwechsel beim Scrollen: Sobald der Startbereich verlassen
   *    wird, trägt <body> die Markierung `data-gescrollt`. Alles Weitere
   *    erledigt CSS. Der Wechsel wird mit einem Puffer geschaltet, damit
   *    die Leisten an der Schwelle nicht flackern.
   *
   * 2. Aufklappmenü unter „Leistungen": öffnet per Klick, schließt per
   *    Escape, Klick nach außen oder wenn der Fokus den Bereich verlässt.
   */
  /* Der Leistenwechsel hängt sich an Fenster und Dokument — das darf
     nur einmal geschehen, auch wenn Astro nach jedem Seitenwechsel
     `astro:page-load` auslöst (die Navigation selbst bleibt erhalten). */
  let leistenwechselBereit = false;

  function navigationAufbauen() {
    if (!leistenwechselBereit) {
      leistenwechselBereit = true;
      leistenwechselAufbauen();
    }
    aufklappmenuesAufbauen();
    mobilmenueAufbauen();
  }

  function leistenwechselAufbauen() {
    // ---- Leistenwechsel ----
    // In der Vorlage hängt der Wechsel an einem eigenen unsichtbaren
    // Streifen (`.trigger-schnalz`, 250vh ab Dokumentanfang): sobald er
    // oben aus dem Bild läuft, fährt die untere Leiste weg und die obere
    // ein (Abläufe a-26 / a-16). Das ist deutlich später als das
    // Einrasten der Öffnungszeiten — die Blase steht also schon eine
    // Weile, bevor die Leisten tauschen.

    let gescrollt = document.body.hasAttribute('data-gescrollt');
    let geplant = false;

    /* Ab welcher Scrolltiefe die Leisten tauschen: sobald der Zipfel der
       Öffnungszeiten beginnt, sich einzuziehen (scripts/scrollwege.ts) */
    const schwelle = () => schnalzWeg() * window.innerHeight;

    /** Gehört zu dieser Scrolltiefe der gescrollte Zustand? */
    const gescrolltBei = (y: number, startseite: boolean) =>
      // Unterseiten (Leistung, Beitrag, Rechtliches) haben keinen
      // Logobereich: dort steht von Anfang an die Kopfleiste mit dem
      // Menü, die Symbolleiste bleibt eingefahren.
      startseite ? y > schwelle() : true;

    const pruefen = () => {
      geplant = false;
      const sollGescrollt = gescrolltBei(window.scrollY, !!document.querySelector('.ozbereich'));

      if (sollGescrollt !== gescrollt) {
        gescrollt = sollGescrollt;
        if (gescrollt) document.body.dataset.gescrollt = 'ja';
        else delete document.body.dataset.gescrollt;
      }
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(pruefen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    pruefen();

    // Beim Seitenwechsel tauscht Astro den <body> samt Attributen aus —
    // die Markierung wäre weg, die Kopfleiste würde in ihrer 300-ms-
    // Bewegung kurz auf Höhe 0 fallen und während des Übergangs
    // aufblitzen. Deshalb bekommt schon das NEUE Dokument die
    // Markierung, bevor es eingetauscht wird: Der Zustand steht dann
    // vom ersten Bild an fest, nichts bewegt sich.
    document.addEventListener('astro:before-swap', (ereignis) => {
      const e = ereignis as Event & { newDocument: Document; to: URL; navigationType: string };
      const startseite = !!e.newDocument.querySelector('.ozbereich');
      let merker = '';
      try { merker = sessionStorage.getItem('uebergang-ziel') || ''; } catch { /* egal */ }

      let soll: boolean;
      if (e.navigationType === 'traverse') {
        // Vor/Zurück im Verlauf: Astro stellt die gemerkte Scrolltiefe wieder her
        const y = (history.state && typeof history.state.scrollY === 'number') ? history.state.scrollY : 0;
        soll = gescrolltBei(y, startseite);
      } else if (!startseite || merker) {
        // Unterseite — oder zurück zur Übersicht, wo die Karte mittig gestellt wird
        soll = true;
      } else {
        // Sprungmarke tiefer auf der Seite? Der Anfang und die
        // Öffnungszeiten liegen oben, alles andere ist gescrollt.
        soll = !!e.to.hash && !['#start', '#oz_anchor', '#inhalt'].includes(e.to.hash);
      }
      if (soll) e.newDocument.body.dataset.gescrollt = 'ja';
      else delete e.newDocument.body.dataset.gescrollt;
      gescrollt = soll;
    });

    // Nach dem Tausch (noch vor dem ersten Bild) gegenprüfen — die
    // Scrollposition steht dann fest.
    document.addEventListener('astro:after-swap', () => {
      queueMicrotask(pruefen);
    });

  }

  function aufklappmenuesAufbauen() {
    // ---- Aufklappmenü („Blase") ----
    // Die Punktlinie der Leiste wölbt sich zu einem abgerundeten Feld.
    // Gezeichnet als SVG über die volle Breite: links und rechts die
    // Linie, in der Mitte die Wölbung, deren Höhe von 0 auf die Höhe
    // des Inhalts wächst — mit leichtem Überschwingen, damit es
    // organisch wirkt. Ein kleiner Pfeil zeigt auf den Menüpunkt.
    document.querySelectorAll<HTMLElement>('[data-aufklapp]').forEach((huelle) => {
      if (huelle.dataset.bereit) return;
      huelle.dataset.bereit = 'ja';

      const knopf = huelle.querySelector<HTMLButtonElement>('button[aria-expanded]');
      const inhalt = huelle.querySelector<HTMLElement>('.aufklapp__inhalt');
      const hoch = huelle.dataset.richtung === 'hoch';
      /* Wo die Zeichnung hängt und wer die Punktlinie trägt. Beides muss
         im selben Stapelkontext wie der Inhalt liegen — die Kopfleiste
         trägt einen Übergangsnamen und bildet damit einen eigenen. */
      const leiste = hoch ? huelle.closest<HTMLElement>('.fussleiste') : huelle.closest<HTMLElement>('.kopfleiste');
      const linienTraeger = hoch ? huelle.closest<HTMLElement>('.fussleiste-huelle') : huelle.closest<HTMLElement>('.navigation');
      if (!knopf || !inhalt || !leiste || !linienTraeger) return;

      const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Die Zeichnung: milchiger Grund (zugeschnitten) + gestrichelte Linie
      const NS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'blase');
      svg.setAttribute('aria-hidden', 'true');
      const linie = document.createElementNS(NS, 'path'); linie.setAttribute('class', 'blase__linie');
      const pfeil = document.createElementNS(NS, 'path'); pfeil.setAttribute('class', 'blase__pfeil');
      svg.append(linie, pfeil);
      svg.style.display = 'none';
      leiste.append(svg);

      let anteil = 0;        // 0 = Linie, 1 = voll aufgewölbt
      let ziel = 0;
      let laeuft = false;
      let hoehe = 0;         // Höhe der Wölbung in px
      let start = 0, von = 0, dauer = 520;
      const s = hoch ? -1 : 1;   // Richtung: nach oben oder unten
      const ECKE = 40;             // Rundung am Ende — wie im Entwurf

      /* Weich mit leichtem Überschwingen (nur beim Öffnen) */
      /* Wie eine Blase, die von unten drückt: langsam anschwellend, dann
         zügig steigend, mit einem Hauch Überschwingen zum Schluss */
      const kurveAuf = (t: number) => {
        const basis = 1 - Math.pow(1 - t, 3);
        const u = Math.max(0, (t - 0.45) / 0.55);
        return basis + 0.03 * Math.sin(Math.PI * u);
      };
      const kurveZu = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      const weich = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

      const zeichnen = () => {
        const breite = document.documentElement.clientWidth;
        const boxBreite = Math.min(400, breite - 32);
        const kr = knopf.getBoundingClientRect();
        const knopfX = kr.left + kr.width / 2;
        /* Die Blase sitzt so, dass der Menüpunkt im linken Drittel liegt */
        const links = Math.max(16, Math.min(breite - boxBreite - 16, knopfX - boxBreite * 0.15));
        const mitte = links + boxBreite / 2;

        /* Sie wächst in Höhe UND Breite — die Linie fließt auf, statt
           eine fertige Form hochzuschieben. Die Rundung ist nie größer
           als die halbe Höhe: so bleibt jede Zwischenform weich. */
        const h = Math.max(0, hoehe * anteil);
        const p = Math.min(1, anteil);
        /* Die Form wie eine Blase, die von unten gegen die Linie drückt:
           Anfangs ein breiter, flacher Hügel — die Ausrundungen an Fuß
           und Schulter sind weit gestreckte Ellipsenbögen (breit `a`,
           hoch `fa`). Mit der Höhe ziehen sie sich auf die 40-px-Kreise
           des Entwurfs zusammen, dazwischen wächst die senkrechte Wand.
           So gibt es in keiner Phase eine Ecke. */
        /* Der Fuß der Blase steht fest (Außenmaß = Endbreite + Rundung);
           nur der Scheitel weitet sich mit der Höhe, die Bögen werden
           dadurch von breit-flach zu 40-px-Kreisen und die Seiten steiler. */
        const aussen = boxBreite / 2 + ECKE;                   // halbe Fußbreite, fest
        /* Scheitelbreite: beginnt bei der halben Fußbreite — dann sind die
           Bögen genau so breit wie der halbe Scheitel und stoßen in der
           Mitte aneinander (reiner Hügel ohne Plateau). Breiter dürfen
           die Bögen nie sein, sonst liefe die Linie über sich zurück. */
        const w = aussen + (boxBreite - aussen) * weich(p);
        const fa = Math.min(ECKE, h / 2);                       // Höhe der Bögen
        const aB = Math.min(w / 2, Math.max(fa, aussen - w / 2)); // Breite der Bögen
        const k = 0.5523;
        const rand = 4;
        /* Grundlinie im SVG — auf halbe Pixel gelegt, damit der 1-px-Strich
           genau auf der Punktreihe der Leiste liegt und nicht verschmiert */
        const yBasis = hoch ? hoehe + rand + 0.5 : rand - 0.5;
        const y0 = yBasis;
        const xL = mitte - w / 2;
        const xR = mitte + w / 2;
        const gesamt = hoehe + 2 * rand;

        svg.style.width = `${breite}px`;
        svg.style.height = `${gesamt}px`;
        svg.style[hoch ? 'bottom' : 'top'] = `calc(100% - ${rand}px)`;
        svg.setAttribute('viewBox', `0 0 ${breite} ${gesamt}`);

        const f = (n: number) => n.toFixed(2);
        /* Die Wölbung als Pfadstück, um `dy` verschoben (die Maske des
           Leistengrunds hat einen anderen Nullpunkt als die Zeichnung).
           `auf` weitet die Form um so viele Bildpunkte nach außen — die
           Maske greift damit über den Strich hinaus, statt ihn zur
           Hälfte abzuschneiden. */
        const woelbungMit = (dy: number, auf = 0) => {
          const g = (n: number) => f(n + dy);
          const xL = mitte - w / 2 - auf;
          const xR = mitte + w / 2 + auf;
          const y0 = yBasis + s * auf;
          return (
            /* Fuß links: flacher Bogen von der Linie in die Wand */
            `L${f(xL - aB)} ${g(y0)} C${f(xL - aB + k * aB)} ${g(y0)} ${f(xL)} ${g(y0 + s * (fa - k * fa))} ${f(xL)} ${g(y0 + s * fa)} ` +
            /* Wand */
            `L${f(xL)} ${g(y0 + s * (h - fa))} ` +
            /* Schulter links */
            `C${f(xL)} ${g(y0 + s * (h - fa + k * fa))} ${f(xL + aB - k * aB)} ${g(y0 + s * h)} ${f(xL + aB)} ${g(y0 + s * h)} ` +
            /* Scheitel */
            `L${f(xR - aB)} ${g(y0 + s * h)} ` +
            /* Schulter rechts */
            `C${f(xR - aB + k * aB)} ${g(y0 + s * h)} ${f(xR)} ${g(y0 + s * (h - fa + k * fa))} ${f(xR)} ${g(y0 + s * (h - fa))} ` +
            /* Wand */
            `L${f(xR)} ${g(y0 + s * fa)} ` +
            /* Fuß rechts */
            `C${f(xR)} ${g(y0 + s * (fa - k * fa))} ${f(xR + aB - k * aB)} ${g(y0)} ${f(xR + aB)} ${g(y0)} `
          );
        };
        const woelbung = woelbungMit(0);
        /* Bei (fast) null Höhe eine reine Linie: Die Bögen hätten sonst
           Punkte, die um Bruchteile eines Pixels wackeln, und aus den
           Strichen würde in der Mitte ein durchgezogener Strich */
        linie.setAttribute('d', h < 1.5 ? `M0 ${f(y0)} L${breite} ${f(y0)}` : `M0 ${f(y0)} ${woelbung}L${breite} ${f(y0)}`);

        /* Dieselbe Wölbung von rechts nach links, um `dy` verschoben —
           für die Maske der oberen Leiste */
        const woelbungRueckwaerts = (dy: number, auf = 0) => {
          const g = (n: number) => f(n + dy);
          const xL = mitte - w / 2 - auf;
          const xR = mitte + w / 2 + auf;
          const y0 = yBasis + s * auf;
          return (
            `L${f(xR + aB)} ${g(y0)} ` +
            `C${f(xR + aB - k * aB)} ${g(y0)} ${f(xR)} ${g(y0 + s * (fa - k * fa))} ${f(xR)} ${g(y0 + s * fa)} ` +
            `L${f(xR)} ${g(y0 + s * (h - fa))} ` +
            `C${f(xR)} ${g(y0 + s * (h - fa + k * fa))} ${f(xR - aB + k * aB)} ${g(y0 + s * h)} ${f(xR - aB)} ${g(y0 + s * h)} ` +
            `L${f(xL + aB)} ${g(y0 + s * h)} ` +
            `C${f(xL + aB - k * aB)} ${g(y0 + s * h)} ${f(xL)} ${g(y0 + s * (h - fa + k * fa))} ${f(xL)} ${g(y0 + s * (h - fa))} ` +
            `L${f(xL)} ${g(y0 + s * fa)} ` +
            `C${f(xL)} ${g(y0 + s * (fa - k * fa))} ${f(xL - aB + k * aB)} ${g(y0)} ${f(xL - aB)} ${g(y0)} `
          );
        };

        /* Die Maske des Leistengrunds: Leiste plus Blase als eine Form,
           in den Koordinaten des Umschlags. Der reicht per Innenabstand
           (`--blase-hoehe`) über die Leiste hinaus — gemessen wird die
           Leiste selbst, also ohne diesen Abstand. */
        const lr = linienTraeger.getBoundingClientRect();
        const cs = getComputedStyle(linienTraeger);
        const leisteH = lr.height - (parseFloat(cs.paddingTop) || 0) - (parseFloat(cs.paddingBottom) || 0);
        linienTraeger.style.setProperty('--blase-hoehe', `${gesamt}px`);
        /* Nullpunkt-Versatz zwischen Zeichnung und Maske:
           unten liegt die Zeichnung `rand` unter dem oberen Umschlagrand,
           oben liegt die Grundlinie erst unter der Leiste */
        const dy = hoch ? rand : leisteH - rand;
        /* Der Strich liegt in der Zeichnung, die mit maskiert wird — die
           Maske greift deshalb 1 px über ihn hinaus */
        const auf = 1;
        const yM = y0 + dy + s * auf;
        const form = hoch
          ? `M0 ${f(gesamt + leisteH)} L0 ${f(yM)} ${woelbungMit(dy, auf)}L${breite} ${f(yM)} L${breite} ${f(gesamt + leisteH)} Z`
          : `M0 0 L${breite} 0 L${breite} ${f(yM)} ${woelbungRueckwaerts(dy, auf)}L0 ${f(yM)} Z`;
        linienTraeger.style.setProperty('--blase-form', `path("${form}")`);

        /* Kleiner Pfeil an der Grundlinie, auf den Menüpunkt zeigend */
        const py = y0 + s * 22;
        const sicht = Math.max(0, (anteil - 0.6) / 0.4);
        pfeil.setAttribute('d', `M${f(knopfX - 9)} ${f(py + s * -7)} L${f(knopfX)} ${f(py)} L${f(knopfX + 9)} ${f(py + s * -7)}`);
        pfeil.setAttribute('opacity', f(sicht));

        /* Der Inhalt liegt in der voll aufgewölbten Blase */
        const hr = huelle.getBoundingClientRect();
        inhalt.style.left = `${links - hr.left}px`;
      };

      const schritt = (jetzt: number) => {
        const t = Math.min(1, (jetzt - start) / dauer);
        const kurve = ziel === 1 ? kurveAuf : kurveZu;
        anteil = von + (ziel - von) * kurve(t);
        zeichnen();
        if (t < 1) { requestAnimationFrame(schritt); return; }
        laeuft = false;
        anteil = ziel;
        if (ziel === 0) {
          svg.style.display = 'none';
          linienTraeger.style.removeProperty('--blase-form');
          linienTraeger.style.removeProperty('--blase-hoehe');
          delete linienTraeger.dataset.ohneLinie;
          delete huelle.dataset.aktiv;
          if (knopf.getAttribute('aria-expanded') !== 'true') inhalt.hidden = true;
        }
      };

      const animieren = (nachZiel: number) => {
        ziel = nachZiel;
        von = anteil;
        start = performance.now();
        dauer = nachZiel === 1 ? 520 : 400;
        if (wenigerBewegung) { anteil = ziel; zeichnen(); dauer = 0; start = -1e9; }
        if (!laeuft) { laeuft = true; requestAnimationFrame(schritt); }
      };

      const setzen = (offen: boolean) => {
        if ((knopf.getAttribute('aria-expanded') === 'true') === offen) return;
        knopf.setAttribute('aria-expanded', String(offen));
        if (offen) {
          inhalt.hidden = false;
          hoehe = inhalt.getBoundingClientRect().height;
          huelle.dataset.aktiv = 'ja';
          linienTraeger.dataset.ohneLinie = 'ja';
          svg.style.display = 'block';
          zeichnen();
          requestAnimationFrame(() => { huelle.dataset.offen = 'ja'; });
          animieren(1);
        } else {
          delete huelle.dataset.offen;
          animieren(0);
        }
      };

      knopf.addEventListener('click', () => {
        setzen(knopf.getAttribute('aria-expanded') !== 'true');
      });

      // Auf Zeigegeräten öffnet auch das Überfahren — die Blase gehört dazu
      let schliessTimer = 0;
      huelle.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse') return;
        window.clearTimeout(schliessTimer);
        setzen(true);
      });
      huelle.addEventListener('pointerleave', (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse') return;
        schliessTimer = window.setTimeout(() => setzen(false), 120);
      });

      // Schließen, wenn der Fokus den Bereich verlässt
      huelle.addEventListener('focusout', (e) => {
        const ziel = e.relatedTarget as Node | null;
        if (!ziel || !huelle.contains(ziel)) setzen(false);
      });

      // Schließen bei Klick außerhalb
      document.addEventListener('click', (e) => {
        if (!huelle.contains(e.target as Node)) setzen(false);
      });

      // Schließen mit Escape, Fokus zurück auf den Knopf
      huelle.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          setzen(false);
          knopf.focus();
        }
      });

      window.addEventListener('resize', () => { if (huelle.dataset.aktiv) { hoehe = inhalt.getBoundingClientRect().height; zeichnen(); } }, { passive: true });
      // Beim Seitenwechsel schließen
      document.addEventListener('astro:before-preparation', () => setzen(false));
    });

  }

  function mobilmenueAufbauen() {
    // ---- Mobiles Ausklappmenü ----
    // Ablauf a-25 / a-27: Höhe 0 ↔ 338 px in 700 ms, der Lottie-Knopf
    // läuft dabei in 600 ms von Bild 0 auf 99 und zurück.
    const menueknopf = document.querySelector<HTMLButtonElement>('[data-menueknopf]');
    const navigation = document.querySelector<HTMLElement>('.navigation');
    const lottieKasten = document.querySelector<HTMLElement>('[data-menuelottie]');

    if (menueknopf && navigation && !menueknopf.dataset.bereit) {
      menueknopf.dataset.bereit = 'ja';
      let knopfSpieler: { playSegments: (b: [number, number], s?: boolean) => void; totalFrames: number } | null = null;

      if (lottieKasten) {
        import('../scripts/lottie').then(({ ladeAnimation }) => {
          ladeAnimation(lottieKasten, '/lottie/menue-button.json').then((s) => { knopfSpieler = s as never; });
        });
      }

      menueknopf.addEventListener('click', () => {
        const offen = navigation.hasAttribute('data-menue-offen');
        if (offen) {
          navigation.removeAttribute('data-menue-offen');
          menueknopf.setAttribute('aria-expanded', 'false');
          menueknopf.setAttribute('aria-label', 'Menü öffnen');
          knopfSpieler?.playSegments([knopfSpieler.totalFrames - 1, 0], true);
        } else {
          navigation.setAttribute('data-menue-offen', 'ja');
          menueknopf.setAttribute('aria-expanded', 'true');
          menueknopf.setAttribute('aria-label', 'Menü schließen');
          knopfSpieler?.playSegments([0, knopfSpieler.totalFrames - 1], true);
        }
      });

      // „Leistungen" klappt die Kategorien an Ort und Stelle auf
      const unter = document.querySelector<HTMLElement>('[data-mobilunter]');
      const knopfLeistungen = document.querySelector<HTMLButtonElement>('[data-mobilleistungen]');

      const leistungenAufklappen = (offen: boolean) => {
        if (!unter || !knopfLeistungen) return;
        knopfLeistungen.setAttribute('aria-expanded', String(offen));
        if (offen) unter.dataset.offen = 'ja';
        else delete unter.dataset.offen;
      };

      knopfLeistungen?.addEventListener('click', () => {
        leistungenAufklappen(knopfLeistungen.getAttribute('aria-expanded') !== 'true');
      });

      // Ein Klick auf ein Ziel schließt das Menü wieder (wie in a-27);
      // das Akkordeon klappt dabei zu, sobald das Menü eingefahren ist.
      document.querySelectorAll('a.mobilmenue__punkt').forEach((a) => {
        a.addEventListener('click', () => {
          navigation.removeAttribute('data-menue-offen');
          menueknopf.setAttribute('aria-expanded', 'false');
          menueknopf.setAttribute('aria-label', 'Menü öffnen');
          knopfSpieler?.playSegments([knopfSpieler.totalFrames - 1, 0], true);
          window.setTimeout(() => leistungenAufklappen(false), 700);
        });
      });
    }
  }

  navigationAufbauen();
  document.addEventListener('astro:page-load', navigationAufbauen);
</script>
