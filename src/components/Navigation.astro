---
/**
 * Navigation — Nachbau der Webflow-Vorlage.
 *
 * Zwei Leisten, die beim Scrollen die Rollen tauschen:
 *
 *   Ganz oben auf der Seite   Kontaktzeile (40 px) sichtbar,
 *                             Symbolleiste am unteren Rand sichtbar,
 *                             Kopfleiste eingefahren (Höhe 0)
 *
 *   Nach dem Scrollen         Kontaktzeile eingefahren,
 *                             Kopfleiste (80 px) ausgefahren,
 *                             Symbolleiste 110 px nach unten hinaus
 *
 * Werte aus den Abläufen `schnalz in` (a-26) und `schnalz out` (a-16):
 * 300 ms, easeOut.
 *
 * Neu gegenüber der Vorlage: Der Punkt „Leistungen" klappt als Blase
 * auf und listet die Kategorien aus leistungen.json. Das Handy-Menü
 * öffnet als dieselbe Blase, nur zum rechten Rand hin offen; die
 * Kategorien erscheinen darin als eigene Ebene (Florian, 26. September
 * 2026).
 */
import navi from '../content/navigation.json';
import leistungen from '../content/leistungen.json';
import seite from '../content/seite.json';
import neuigkeiten from '../content/neuigkeiten.json';

const { praxis } = seite;

const hatNeuigkeiten = neuigkeiten.eintraege.some((e) => e.aktiv);
const punkte = navi.eintraege
  .filter((e) => e.aktiv && (e.id !== 'neuigkeiten' || hatNeuigkeiten))
  .sort((a, b) => a.position - b.position);

/* Sprungmarken (`#team`) zeigen immer auf die Startseite — sonst
   liefen sie auf einer Unterseite ins Leere. */
const ziel = (e: { ziel: string }) => (e.ziel.startsWith('#') ? `/${e.ziel}` : e.ziel);

const kopf = punkte.filter((e) => e.in_kopfleiste);

/* Das Handy-Menü führt alle Punkte außer der Telefonnummer — die steht
   dort als Pille in der Kopfleiste zwischen Logo und Menüknopf und in
   der Symbolleiste unten (Florian, 26. September 2026). */
const menue = punkte.filter((e) => e.id !== 'telefon');
/* Die Symbolleiste unten hat in der Vorlage eine eigene Reihenfolge —
   und auf Handys eine andere als auf dem Desktop. Statt die Reihenfolge
   per CSS zu verschieben (fehleranfällig bei den Trennpunkten) werden
   beide Listen erzeugt und per Umbruchpunkt umgeschaltet. */
const fussGross = punkte
  /* Die Telefonnummer steht auf dem Desktop als Pille in der
     Kopfleiste und in der Kontaktzeile oben — in der Symbolleiste nur
     auf Handys. */
  .filter((e) => e.in_fussleiste && e.id !== 'telefon')
  .sort((a, b) => (a.position_fussleiste ?? 99) - (b.position_fussleiste ?? 99))
  .filter((e) => e.id !== 'zeiten')
  .concat(punkte.filter((e) => e.id === 'zeiten'));   // Öffnungszeiten ans Ende

/* Reihenfolge fest: Die Telefonnummer gehört in die Mitte, links und
   rechts je ein Sprungziel. Statt Kontakt stehen dort die Leistungen —
   danach wird auf dem Handy am häufigsten gesucht (Florian,
   18. September 2026); der Kontakt ist über die Telefonnummer daneben
   ohnehin einen Griff entfernt. */
const fussKlein = ['leistungen', 'telefon', 'zeiten']
  .map((id) => punkte.find((e) => e.id === id))
  .filter(Boolean);

const dienste = leistungen.eintraege.filter((e) => e.aktiv).sort((a, b) => a.position - b.position);

/* Die Kategorien kommen aus dem Inhaltsmodell — die Praxis kann dort
   eigene anlegen. Leere Kategorien erscheinen nicht. */
const kategorien = (leistungen.kategorien ?? [])
  .filter((k) => k.aktiv)
  .sort((a, b) => a.position - b.position)
  .map((k) => ({ ...k, eintraege: dienste.filter((e) => e.kategorie === k.id) }))
  .filter((k) => k.eintraege.length > 0);
---

{/*
  `transition:persist`: Beim Seitenwechsel bleibt die Navigation samt
  Zustand (offenes Menü, Leistenwechsel) stehen und wird nicht neu
  aufgebaut.

  Die Übergangsnamen (`nav-oben`, `nav-unten`) stehen im CSS unten,
  nicht als `transition:name`: Astro bindet `transition:name` an eine
  Kennung, die je Seite anders ausfällt — das mitgenommene Element
  trüge nach dem Wechsel die alte Kennung und verlöre seinen Namen.
  Dann verschwämme die Leiste mit dem Rest der Seite und blitzte
  doppelt auf. Über die Klasse bleibt der Name auf jeder Seite gleich
  (styles/uebergaenge.css hält die Leisten still).
*/}
{/*
  Der Schleier hinter dem offenen Handy-Menü: weiß und weichgezeichnet
  über der ganzen Seite. Er steht AUSSERHALB der Navigation, weil deren
  Maske (`clip-path`, siehe CSS) ihn sonst mit beschnitte — und ist
  damit nicht persistiert: Das Skript fragt ihn bei Bedarf frisch ab.
*/}
<div class="menue-schleier" data-menue-schleier hidden></div>

<div class="navigation" transition:persist="navigation">
{/* Kontaktzeile — oben auf der Seite sichtbar */}
<div class="kontaktzeile" data-leiste="kontakt">
  <div class="kontaktzeile__inhalt">
    {/* Der Praxisname steht der Anschrift voran — nur auf dem Desktop,
        darunter wird die Zeile sonst zu lang (Florian, 17. September
        2026). Er steht fest im Code: `seite.json` führt allein den
        langen Namen „Dres. Nold – Zahnarztpraxis und Kieferorthopädie". */}
    <span class="kontaktzeile__text kontaktzeile__text--ab-tablet kontaktzeile__name">Praxis Dres. Nold</span>
    <span class="punkt punkt--ab-tablet" aria-hidden="true"></span>
    <span class="kontaktzeile__text">{praxis.strasse}</span>
    <span class="punkt" aria-hidden="true"></span>
    <span class="kontaktzeile__text">{praxis.plz} {praxis.ort}</span>
    <span class="punkt punkt--ab-tablet" aria-hidden="true"></span>
    <span class="kontaktzeile__text kontaktzeile__text--ab-tablet">
      <a href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>
    </span>
    <span class="punkt" aria-hidden="true"></span>
    <span class="kontaktzeile__text">
      <a href={`mailto:${praxis.email}`}><span class="kontaktzeile__mail">{praxis.email}</span></a>
    </span>
  </div>
</div>

{/* Kopfleiste — fährt beim Scrollen ein */}
<header class="kopfleiste" data-leiste="kopf">
  <nav class="kopfleiste__inhalt" aria-label="Hauptnavigation">
    {/* Auf Handys: Logo und Menü-Knopf statt der Menüpunkte */}
    <div class="kopfleiste__mobil">
      <a class="logo" href="/" aria-label={`${praxis.name} — zur Startseite`}>
        <img src="/icons/logo.svg" alt="" width="80" height="80" />
      </a>
      {/* Der Hörer — das Telefon-Symbol der Navigation, mit Kreis wie die
          Symbole im Menü. Er steht absolut in der Zeile und hat drei
          Plätze (Skript `telefonStellen`): zu rechts neben dem Punkt vor
          dem Menüknopf; allein geöffnet mit der Nummer daneben genau
          zwischen Logo und Menüknopf; bei offenem Menü als dessen erste
          Zeile, bündig mit den Symbolen darunter (Florian, 27. September
          2026). */}
      <div class="kopftelefon" data-kopftelefon>
        <button
          class="kopftelefon__knopf"
          type="button"
          aria-expanded="false"
          aria-controls="kopftelefon-nummer"
          aria-label="Telefonnummer anzeigen"
          data-kopftelefonknopf
        >
          <img class="kopftelefon__symbol" src="/icons/navigation/telefon.svg" alt="" width="40" height="40" />
        </button>
        <a class="kopftelefon__nummer" id="kopftelefon-nummer" href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>
      </div>
      <div class="kopfleiste__handyrechts">
        <span class="punkt" data-kopfpunkt aria-hidden="true"></span>
        <button
          class="menueknopf"
          type="button"
          data-menueknopf
          aria-expanded="false"
          aria-controls="mobilmenue"
          aria-label="Menü öffnen"
        >
          <span class="menueknopf__lottie" data-menuelottie aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <a class="logo logo--desktop" href="/" aria-label={`${praxis.name} — zur Startseite`}>
      <img src="/icons/logo.svg" alt="" width="80" height="80" />
    </a>

    {/* Menüpunkte und Telefonnummer stehen rechts, das Logo links —
        beide an der Inhaltsbreite ausgerichtet (Entwurf, 17. September
        2026). Vorher saß der ganze Block mittig in 700 px. */}
    <div class="kopfleiste__rechts">
    {kopf.map((e, i) => (
      <>
        {e.id === 'leistungen' ? (
          <div class="aufklapp" data-aufklapp data-richtung="runter">
            <button class="menuepunkt menuepunkt--knopf" type="button" aria-expanded="false" aria-controls="leistungsmenue">
              <span class="menuepunkt__rolle">
                <span class="menuepunkt__text">{e.titel}</span>
                <span class="menuepunkt__text" aria-hidden="true">{e.titel}</span>
              </span>
              {/* Kleiner Haken: zeigt, dass hier etwas aufgeht */}
              <span class="menuepunkt__pfeil" aria-hidden="true"></span>
            </button>

            <div class="aufklapp__inhalt" id="leistungsmenue" hidden>
              <span class="aufklapp__linie" aria-hidden="true"></span>

              <div class="aufklapp__spalten">
                {kategorien.map((k, i) => (
                  <a class="oberpunkt" href={`/#leistungen-${k.id}`} style={`--stufe: ${i}; --stufe-hoch: ${kategorien.length - 1 - i}`}>
                    {k.icon && <img class="oberpunkt__symbol" src={k.icon} alt="" width="36" height="36" />}
                    <span class="oberpunkt__text">
                      <span class="oberpunkt__titel">{k.titel}</span>
                      {k.kurz && <span class="oberpunkt__kurz">{k.kurz}</span>}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="menuepunkt" href={ziel(e)}>
            <span class="menuepunkt__rolle">
              <span class="menuepunkt__text">{e.titel}</span>
              <span class="menuepunkt__text" aria-hidden="true">{e.titel}</span>
            </span>
          </a>
        )}
        <span class="punkt" aria-hidden="true"></span>
      </>
    ))}

    <a class="kn kn--klein kopfleiste__telefon" href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>
      <span class="kn__f" aria-hidden="true"></span>{praxis.telefon}
    </a>
    </div>

    {/*
      Das Handy-Menü — klappt als Blase aus der Punktlinie der Kopfleiste
      auf (Skript: `mobilmenueAufbauen`, Zeichnung wie beim Aufklappmenü
      „Leistungen" auf dem Desktop). Es steht IN der Kopfleiste, damit
      es dieselbe Bezugsfläche hat wie deren Blase (`top: 100%`).

      Jede Zeile ist ein kleines Raster (`.mobilmenue__zeile`), das sich
      über die Rasterhöhe auf Null schließen lässt. So funktioniert der
      Ebenenwechsel: Ein Tipp auf „Leistungen" schließt alle anderen
      Zeilen, die Leistungen-Zeile rückt dadurch an den Kopf und wird zum
      Zurück-Knopf, und die Kategorien darunter wachsen von Null auf ihre
      Größe (Florian, 26. September 2026). Kein Akkordeon, kein
      Rollkasten: Die Liste ist kompakt genug für jedes Handy.
    */}
    <div class="mobilmenue" id="mobilmenue" data-mobilmenue hidden>
      {menue.map((e, i) => (
        e.id === 'leistungen' ? (
          <>
            <div class="mobilmenue__zeile mobilmenue__zeile--leistungen" style={`--stufe: ${i}; --stufe-hoch: ${menue.length - 1 - i}`}>
              <div class="mobilmenue__zelle">
                <button
                  class="mobilmenue__punkt mobilmenue__punkt--knopf"
                  type="button"
                  data-mobilleistungen
                  aria-expanded="false"
                  aria-controls="mobil-leistungen"
                >
                  <img class="mobilmenue__symbol" src={e.icon} alt="" width="60" height="60" />
                  <span class="mobilmenue__text">{e.titel}</span>
                  <span class="mobilmenue__pfeil" aria-hidden="true"></span>
                  <span class="mobilmenue__zurueck" aria-hidden="true">Zurück</span>
                </button>
              </div>
            </div>
            {/* Die Kategorien: eigene Zeilen, in Ruhe auf Null geschlossen.
                `display: contents` — der Rahmen ist nur das Ziel von
                `aria-controls`, die Zeilen bleiben Kinder des Menüs. */}
            <div class="mobilmenue__ebene" id="mobil-leistungen" role="group" aria-label="Leistungen">
              {kategorien.map((k, j) => (
                <div class="mobilmenue__zeile mobilmenue__zeile--unter" style={`--stufe: ${j}`}>
                  <div class="mobilmenue__zelle">
                    <a class="mobilmenue__punkt mobilmenue__unterpunkt" href={`/#leistungen-${k.id}`}>
                      {k.icon && <img class="mobilmenue__symbol mobilmenue__symbol--klein" src={k.icon} alt="" width="40" height="40" />}
                      <span class="mobilmenue__untertext">
                        <span class="mobilmenue__text">{k.titel}</span>
                        {k.kurz && <span class="mobilmenue__kurz">{k.kurz}</span>}
                      </span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="mobilmenue__zeile" style={`--stufe: ${i}; --stufe-hoch: ${menue.length - 1 - i}`}>
            <div class="mobilmenue__zelle">
              <a class="mobilmenue__punkt" href={ziel(e)}>
                <img class="mobilmenue__symbol" src={e.icon} alt="" width="60" height="60" />
                <span class="mobilmenue__text">{e.titel}</span>
              </a>
            </div>
          </div>
        )
      ))}
    </div>
  </nav>
</header>
</div>

{/* Symbolleiste am unteren Rand — oben auf der Seite sichtbar */}
{/*
  Der Umschlag trägt Grund, Weichzeichner, Punktlinie und den
  Übergangsnamen (siehe CSS); die Leiste darin nur den Inhalt.
*/}
<div class="fussleiste-huelle" data-fusshuelle>
<nav class="fussleiste" data-leiste="fuss" aria-label="Schnellzugriff">
  <div class="fussleiste__inhalt fussleiste__inhalt--gross">
    {fussGross.map((e, i) => (
      <>
        {e.id === 'leistungen' ? (
          <div class="aufklapp" data-aufklapp data-richtung="hoch">
            <button class="fussknopf fussknopf--knopf" type="button" aria-expanded="false" aria-controls="leistungsmenue-unten">
              <img class="fussknopf__symbol" src={e.icon} alt="" width="60" height="60" />
              <span class="fussknopf__text">{e.titel}</span>
            </button>

            <div class="aufklapp__inhalt" id="leistungsmenue-unten" hidden>
              <span class="aufklapp__linie" aria-hidden="true"></span>

              <div class="aufklapp__spalten">
                {kategorien.map((k, i) => (
                  <a class="oberpunkt" href={`/#leistungen-${k.id}`} style={`--stufe: ${i}; --stufe-hoch: ${kategorien.length - 1 - i}`}>
                    {k.icon && <img class="oberpunkt__symbol" src={k.icon} alt="" width="36" height="36" />}
                    <span class="oberpunkt__text">
                      <span class="oberpunkt__titel">{k.titel}</span>
                      {k.kurz && <span class="oberpunkt__kurz">{k.kurz}</span>}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="fussknopf" href={ziel(e)} data-punkt={e.id}>
            <img class="fussknopf__symbol" src={e.icon} alt="" width="60" height="60" />
            <span class="fussknopf__text">{e.titel}</span>
          </a>
        )}
        {i < fussGross.length - 1 && <span class="punkt punkt--fuss" aria-hidden="true"></span>}
      </>
    ))}
  </div>

  <div class="fussleiste__inhalt fussleiste__inhalt--klein">
    {fussKlein.map((e, i) => (
      <>
        <a class="fussknopf" href={ziel(e)} data-punkt={e.id}>
          <img class="fussknopf__symbol" src={e.icon} alt="" width="60" height="60" />
          <span class="fussknopf__text">{e.titel}</span>
        </a>
        {i < fussKlein.length - 1 && <span class="punkt punkt--fuss" aria-hidden="true"></span>}
      </>
    ))}
  </div>
</nav>
</div>

<style>
  /* ---------- Umschlag beider Leisten ----------
     Oben fixiert, volle Breite, mit Weichzeichner und der Punktlinie
     am unteren Rand — wie in der Vorlage (.nav). */
  /* Werte aus .nav der Vorlage */
  .navigation {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--ebene-navigation);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* Grund (milchiges Weiß mit Weichzeichner), Punktlinie und Übergangs-
     name liegen auf den beiden Umschlägen SELBST, nicht auf einem Kind:
     Ein Element mit Übergangsnamen bildet eine eigene Zeichenwurzel —
     ein Weichzeichner in einem Kind sähe die Seite dahinter nicht mehr,
     der eigene sieht sie.

     Offenes Aufklappmenü: Der Umschlag wächst per Innenabstand um die
     Höhe der Blase und wird per Maske (clip-path) auf „Leiste plus
     Blase" zugeschnitten. Ein Element, also keine Kante zwischen Leiste
     und Blase. Werte setzt das Skript (`--blase-hoehe`, `--blase-form`). */
  .navigation,
  .fussleiste-huelle {
    /* 74 % statt 80: Die Randverläufe darunter (styles/global.css)
       sollen eine Spur durchscheinen (Florian, 27. September 2026) */
    background: rgb(255 255 255 / 74%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .navigation {
    padding-bottom: var(--blase-hoehe, 0px);
    clip-path: var(--blase-form, inset(0 0 var(--blase-hoehe, 0px) 0));
    view-transition-name: nav-oben;
  }

  .fussleiste-huelle {
    padding-top: var(--blase-hoehe, 0px);
    clip-path: var(--blase-form, inset(var(--blase-hoehe, 0px) 0 0 0));
    view-transition-name: nav-unten;
  }

  /* Die Punktlinie: unten am Rand der Kopfleiste, oben am Rand der
     Symbolleiste — jeweils am Rand des Inhalts, nicht des Innenabstands. */
  .navigation::after,
  .fussleiste-huelle::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    height: 1px;
    background: url('/bilder/deko/punktlinie.png') 0 0 repeat-x;
    pointer-events: none;
  }

  .navigation::after { bottom: var(--blase-hoehe, 0px); }
  .fussleiste-huelle::after { top: var(--blase-hoehe, 0px); }

  /* Solange die Blase gezeichnet wird, übernimmt sie die Punktlinie */
  .navigation[data-ohne-linie]::after,
  .fussleiste-huelle[data-ohne-linie]::after { display: none; }

  .navigation > :not(.blase),
  .fussleiste-huelle > .fussleiste {
    position: relative;
    z-index: 1;
  }

  /* Alle Beschriftungen der Navigation stehen in der Überschriftenschrift
     (`--schrift-titel`, derzeit dieselbe wie der Fließtext). */
  .menuepunkt__text,
  .mobilmenue__text,
  .mobilmenue__kurz,
  .oberpunkt__titel,
  .oberpunkt__kurz,
  .fussknopf__text {
    font-weight: var(--gewicht-normal);
    font-family: var(--schrift-titel);
  }

  /* ---------- Kontaktzeile ---------- */
  .kontaktzeile {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    height: 40px;
    overflow: hidden;
    transition: height 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  /* Genau so breit wie die Symbolleiste unten: Beide rahmen den
     Startbereich und stehen als Paar. Zwischendurch lief die Zeile auf
     der vollen Inhaltsbreite und war damit deutlich breiter als die
     Leiste darunter (Florian, 18. September 2026). */
  .kontaktzeile__inhalt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(100% - 2 * var(--abstand-m), var(--breite-leiste));
    height: 40px;
  }

  /* 14 px wie die Beschriftung unter den Symbolen der Fußleiste —
     dieselbe Größe, damit die beiden Leisten zusammengehören. */
  .kontaktzeile__text {
    display: flex;
    align-items: center;
    color: var(--farbe-primaer);
    font-family: var(--schrift-titel);
    font-size: 14px;
    font-weight: var(--gewicht-normal);
    white-space: nowrap;
  }

  /* Der Name trägt die Zeile — halbfett, damit er sich von den Angaben
     dahinter absetzt. */
  .kontaktzeile__name { font-weight: var(--gewicht-halbfett); }

  .kontaktzeile__text a {
    color: inherit;
    text-decoration: none;
  }

  /* Keine Unterstreichung beim Zeigen — die Zeile soll ruhig bleiben.
     Nur die E-Mail-Adresse reagiert, und zwar mit einem kleinen
     Aufziehen statt mit einem Strich. */
  .kontaktzeile__mail {
    display: inline-block;
    font-weight: var(--gewicht-mittel);
    transform-origin: center;
    transition: transform var(--dauer-schnell) var(--verlauf);
  }

  .kontaktzeile__text a:hover .kontaktzeile__mail,
  .kontaktzeile__text a:focus-visible .kontaktzeile__mail {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .kontaktzeile__mail { transition: none; }
    .kontaktzeile__text a:hover .kontaktzeile__mail,
    .kontaktzeile__text a:focus-visible .kontaktzeile__mail { transform: none; }
  }

  /* ---------- Kopfleiste ---------- */
  .kopfleiste {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    height: 0;
    overflow: hidden;
    transition: height 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  /* Aufklappmenü und Handy-Menü ragen aus der Leiste heraus — solange
     eines offen ist, darf sie den Überlauf nicht beschneiden. */
  .navigation:is([data-menue-aktiv], :has(.aufklapp[data-aktiv])) .kopfleiste { overflow: visible; }

  .fussleiste-huelle:has(.aufklapp[data-aktiv]),
  .fussleiste:has(.aufklapp[data-aktiv]) { overflow: visible; }



  /* Logo links, Menü und Telefonnummer rechts — auf der Inhaltsbreite,
     wie jeder andere Abschnitt der Seite. */
  .kopfleiste__inhalt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    height: 80px;
  }

  .kopfleiste__rechts {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Die Telefonnummer steht als Knopf ganz außen — mit etwas mehr Luft
     zum letzten Menüpunkt als zwischen den Punkten selbst. */
  .kopfleiste__telefon { margin-left: 4px; white-space: nowrap; }

  /* Handys: rechts der Punkt und der Menüknopf; der Hörer steht
     absolut in der Zeile (siehe Markup) */
  .kopfleiste__handyrechts {
    display: flex;
    align-items: center;
    gap: var(--abstand-s);
  }

  /* Der Punkt tritt zurück, sobald der Hörer geöffnet ist — dann hängt
     er nicht mehr am Menüknopf */
  .kopfleiste__handyrechts .punkt { transition: opacity 240ms var(--verlauf); }
  .kopfleiste__mobil[data-telefon-offen] .punkt { opacity: 0; }

  /* Der Hörer: absolut, senkrecht mittig, waagerecht an `--telefon-x`
     (Skript). Bis das Skript den ersten Platz gemessen hat, hängt er
     rechts vor Punkt und Menüknopf. Der Platz wechselt weich. */
  .kopftelefon {
    position: absolute;
    top: 50%;
    right: calc(50px + 2 * var(--abstand-s) + 3px);
    display: flex;
    align-items: center;
    transform: translateY(-50%);
    transition: left 420ms var(--verlauf-betont);
  }

  .kopftelefon[data-gestellt] {
    right: auto;
    left: var(--telefon-x, 0px);
  }

  /* 40-px-Symbol wie im Menü, in einer 44-px-Tippfläche */
  .kopftelefon__knopf {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .kopftelefon__symbol {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  /* Die Nummer liegt zusammengeschoben hinter dem Hörer (Breite 0) und
     bekommt beim Öffnen ihre gemessene Breite (`--nummer-breite`, setzt
     das Skript). Schrift wie die Menüpunkte. `visibility` nimmt den
     Verweis aus der Tab-Reihenfolge, solange er nicht zu sehen ist. */
  .kopftelefon__nummer {
    display: block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    color: var(--farbe-primaer);
    font-size: 17px;
    font-weight: var(--gewicht-normal);
    text-decoration: none;
    white-space: nowrap;
    /* Der Abstand zum Hörer kommt erst mit der Nummer — zu hätte die
       Gruppe sonst 12 px unsichtbaren Zwischenraum */
    margin-left: 0;
    transition:
      max-width 420ms var(--verlauf-betont),
      margin-left 420ms var(--verlauf-betont),
      opacity 240ms var(--verlauf),
      visibility 0s linear 420ms;
  }

  .kopftelefon[data-offen] .kopftelefon__nummer {
    max-width: var(--nummer-breite, 140px);
    margin-left: var(--abstand-xs);
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s, 120ms, 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .kopftelefon,
    .kopftelefon__nummer,
    .kopfleiste__handyrechts .punkt { transition: none; }
  }

  /* .nav-buttons-mobile / -desktop: beide 80 px hoch.
     Logo ganz links, Menüknopf ganz rechts — und weil die Zeile so breit
     ist wie die Liste im Aufklappmenü, steht das Logo genau über deren
     Symbolen (Florian, 18. September 2026). */
  /* 72 px hoch, das Logo 68 (Florian, 27. September 2026; vorher 80
     und 80 wie auf dem Desktop) */
  .kopfleiste__mobil {
    position: relative;
    display: none;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 72px;
    overflow: hidden;
  }

  .kopfleiste__mobil .logo img {
    width: 68px;
    height: 68px;
  }

  /* .lottie-animation-3: 50 × 50 */
  .menueknopf {
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menueknopf__lottie {
    display: block;
    width: 50px;
    height: 50px;
    /* Rückfall ohne Lottie: drei Striche */
    background:
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 14px / 26px 2px no-repeat,
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 24px / 26px 2px no-repeat,
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 34px / 26px 2px no-repeat;
  }

  .menueknopf__lottie[data-lottie-bereit] { background: none; }

  /* ---------- Handy-Menü ----------
     Klappt als Blase aus der Punktlinie der Kopfleiste auf — dieselbe
     Zeichnung und Bewegung wie das Aufklappmenü „Leistungen" auf dem
     Desktop (`blaseAnlegen` im Skript), nur mit anderer Form: Der Teil
     der Linie unter dem Logo bleibt oben, rechts davon senkt sie sich
     in eine senkrechte Wand, und die Blase ist zum rechten Rand hin
     offen (Florian, 26. September 2026). Das Menü selbst ist nur der
     Inhalt darin; die Maske am Umschlag (`clip-path`) gibt ihn frei,
     während die Blase wächst.

     Vorher klappte es über die Rasterhöhe auf (0fr → 1fr) und rollte
     bei Platzmangel in einem Rahmen. Beides ist weg: Die Blase bringt
     die Bewegung mit, und die Liste ist kompakt genug für jedes Handy —
     die Hauptliste braucht 452 px samt Kopfleiste, die Ebene
     „Leistungen" noch weniger. */
  .mobilmenue {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: var(--ebene-menue);
    display: flex;
    flex-direction: column;
    /* Links beginnt die Spalte genau unter dem Hörer in der Kopfleiste
       (`--menue-spalte`, vom Skript gemessen: der Hörer steht mit der
       Nummer mittig zwischen Logo und Kreuz, die Symbole der Zeilen
       bündig darunter — Florians Entwurf, 27. September 2026); ohne
       Messung an der Wand der Blase (`--menue-wand`) plus Luft. Rechts
       der Seitenrand. */
    padding: var(--abstand-2xs) var(--abstand-seitenrand) var(--abstand-s)
             var(--menue-spalte, calc(var(--menue-wand, var(--abstand-seitenrand)) + var(--abstand-m)));
  }

  .mobilmenue[hidden] { display: none; }

  /* Der Rahmen um die Kategorien ist nur das Ziel von `aria-controls` */
  .mobilmenue__ebene { display: contents; }

  /*
    Jede Zeile ein Raster, das sich über die Rasterhöhe schließen lässt
    (1fr → 0fr) — so braucht der Ebenenwechsel unten keine festen Höhen.
    Die Zeile trägt außerdem das Einfahren beim Öffnen des Menüs: leicht
    von oben, dabei aufblendend, jede eine Spur später als die davor;
    beim Schließen rückwärts (`--stufe-hoch` zählt von unten), deshalb
    steht die Schließ-Verzögerung im Grundzustand.

    Die Zeilen stehen genau untereinander — die Wand der Blase läuft
    senkrecht wie beim Aufklappmenü auf dem Desktop; die Neigung aus
    Florians erstem Entwurf ist zurückgenommen (26. September 2026).
  */
  .mobilmenue__zeile {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 0;
    transform: translateY(-10px);
    transition-property: grid-template-rows, opacity, transform;
    transition-duration: 320ms, 260ms, 260ms;
    transition-timing-function: var(--verlauf-betont);
    /* Die Rasterhöhe läuft in JEDER Zeile und JEDEM Zustand gleich:
       320 ms, ohne Verzögerung. Nur dann geht die Summe aller Zeilen —
       und mit ihr die Blase — beim Ebenenwechsel in einer Bewegung von
       der alten zur neuen Höhe, statt erst zu sinken und dann zu wachsen
       (Florian, 26. September 2026). Gestaffelt ist allein der Inhalt
       der Zellen. */
    transition-delay: 0ms, calc(var(--stufe-hoch, 0) * 45ms), calc(var(--stufe-hoch, 0) * 45ms);
  }

  .navigation[data-menue-offen] .mobilmenue__zeile {
    opacity: 1;
    transform: none;
    transition-duration: 320ms, 420ms, 420ms;
    transition-delay: 0ms, calc(60ms + var(--stufe, 0) * 45ms), calc(60ms + var(--stufe, 0) * 45ms);
  }

  /* Die Zelle trägt Inhalt und Haarlinie — beides verschwindet mit der
     Zeile, statt dass die Linie als Doppelstrich stehen bliebe. Beim
     Schrumpfen zieht sie sich zusätzlich in die linke obere Ecke zusammen
     und blendet aus; `visibility` nimmt die Verweise dabei aus der
     Tab-Reihenfolge, sobald sie unsichtbar sind. */
  .mobilmenue__zelle {
    min-height: 0;
    overflow: hidden;
    /* Vom linken Rand, senkrecht mittig: Die Zeile schrumpft in Höhe
       UND Breite auf nichts und wächst von dort wieder (Florian,
       27. September 2026; vorher nur die Höhe, dann die linke obere
       Ecke) */
    transform-origin: 0 50%;
    transition-property: opacity, transform, visibility, border-color;
    transition-duration: 320ms, 320ms, 0s, 320ms;
    transition-timing-function: var(--verlauf-betont), var(--verlauf-betont), linear, var(--verlauf-betont);
    transition-delay: 120ms, 120ms, 0s, 0s;
  }

  /* Eine Haarlinie ÜBER jeder Zeile — auch über der ersten: Darüber
     steht in der Kopfleiste der Hörer als erste „Zeile" des Menüs
     (Florian, 27. September 2026). Unter der letzten Zeile keine. Die
     Kategorien-Zeilen zeigen ihre Linie nur auf ihrer Ebene (unten),
     die Hauptzeilen nur auf der Hauptebene — sonst blieben von den
     geschlossenen Zeilen Linien übrig, oder es fehlte die unter
     „Leistungen". */
  .mobilmenue__zelle {
    border-top: 1px solid var(--farbe-linie-leise);
  }

  .mobilmenue__zeile--unter .mobilmenue__zelle { border-top-color: transparent; }

  /* ---- Ebene „Leistungen" ----
     Ein Tipp auf „Leistungen" schließt alle anderen Zeilen; die
     Leistungen-Zeile rückt allein durch das Nachrücken des Rasters an
     den Kopf — in derselben Kurve und Dauer — und bleibt dort als
     Zurück-Knopf stehen. Die Kategorien-Zeilen wachsen im selben Takt
     von Null (Summe der Höhen: eine Bewegung, siehe oben); ihr Inhalt
     kommt gestaffelt nach (ab 80 ms, je 50 ms später). Zurück
     spiegelbildlich: Der Inhalt der Kategorien blendet sofort aus, die
     Zeilen tauschen ihre Höhen im Gleichtakt. (Florian, 26. September
     2026) */
  .mobilmenue__zeile--unter {
    grid-template-rows: 0fr;
    transition-duration: 320ms, 260ms, 260ms;
    transition-delay: 0ms;
  }

  .mobilmenue__zeile--unter .mobilmenue__zelle {
    opacity: 0;
    transform: scale(0);
    visibility: hidden;
    transition-duration: 260ms, 260ms, 0s, 260ms;
    transition-delay: 0ms, 0ms, 260ms, 0ms;
  }

  .mobilmenue[data-ebene='leistungen'] .mobilmenue__zeile:not(.mobilmenue__zeile--leistungen):not(.mobilmenue__zeile--unter) {
    grid-template-rows: 0fr;
    transition-delay: 0ms;
  }

  .mobilmenue[data-ebene='leistungen'] .mobilmenue__zeile:not(.mobilmenue__zeile--leistungen):not(.mobilmenue__zeile--unter) .mobilmenue__zelle {
    opacity: 0;
    transform: scale(0);
    visibility: hidden;
    transition-delay: 0ms, 0ms, 320ms, 0ms;
  }

  .mobilmenue[data-ebene='leistungen'] .mobilmenue__zeile--unter {
    grid-template-rows: 1fr;
    transition-duration: 320ms, 320ms, 320ms;
    transition-delay: 0ms;
  }

  .mobilmenue[data-ebene='leistungen'] .mobilmenue__zeile--unter .mobilmenue__zelle {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-duration: 320ms, 320ms, 0s, 320ms;
    transition-delay: calc(80ms + var(--stufe, 0) * 50ms), calc(80ms + var(--stufe, 0) * 50ms), 0s, 0s;
  }

  /* Auf der Ebene „Leistungen": Linien an den Kategorien, keine an den
     geschlossenen Hauptzeilen; „Leistungen" selbst behält seine Linie
     zum Hörer darüber */
  .mobilmenue[data-ebene='leistungen'] .mobilmenue__zeile--unter .mobilmenue__zelle {
    border-top-color: var(--farbe-linie-leise);
  }

  .mobilmenue[data-ebene='leistungen'] .mobilmenue__zeile:not(.mobilmenue__zeile--leistungen):not(.mobilmenue__zeile--unter) .mobilmenue__zelle {
    border-top-color: transparent;
  }

  .mobilmenue__punkt {
    display: flex;
    align-items: center;
    gap: var(--abstand-xs);
    padding: 9px 0;
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  /* Kleiner als in der unteren Leiste — so passt die ganze Liste auf
     jedes Handy, ohne dass man im Menü rollen muss (Florian,
     18. September 2026; seit dem 26. September noch eine Stufe
     kompakter). */
  .mobilmenue__symbol {
    flex: none;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .mobilmenue__text {
    font-size: 17px;
    font-weight: var(--gewicht-normal);
    line-height: 1.2;
  }

  .mobilmenue__punkt--knopf {
    position: relative;
    width: 100%;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* Der Haken rechts: Auf der Ebene „Leistungen" dreht er nach links
     und rückt ein Stück ein, dahinter blendet „Zurück" auf — aus dem
     Menüpunkt wird der Zurück-Knopf. */
  .mobilmenue__pfeil {
    flex: none;
    /* 15 × 9: Der Kasten trägt den Rand der Zeichnung mit, der sichtbare
       Haken bleibt 13 px breit (siehe pfeil-runter.svg). */
    width: 15px;
    height: 9px;
    margin-left: auto;
    margin-right: var(--abstand-2xs);
    background: url('/icons/ui/pfeil-runter.svg') center / contain no-repeat;
    transition:
      transform 320ms var(--verlauf-betont),
      margin-right 320ms var(--verlauf-betont);
  }

  .mobilmenue__punkt--knopf[aria-expanded='true'] .mobilmenue__pfeil {
    transform: rotate(90deg);
    margin-right: 62px;
  }

  .mobilmenue__zurueck {
    position: absolute;
    right: var(--abstand-2xs);
    top: 50%;
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
    opacity: 0;
    transform: translate(8px, -50%);
    transition:
      opacity 320ms var(--verlauf-betont),
      transform 320ms var(--verlauf-betont);
  }

  .mobilmenue__punkt--knopf[aria-expanded='true'] .mobilmenue__zurueck {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* Die Kategorien stehen ein Stück eingerückt — als Unterpunkte
     lesbar, ohne abgehängt zu wirken */
  .mobilmenue__zeile--unter { margin-left: 22px; }

  .mobilmenue__unterpunkt {
    gap: var(--abstand-xs);
    padding: 8px 0;
  }

  .mobilmenue__symbol--klein { width: 30px; height: 30px; }

  .mobilmenue__untertext { display: flex; flex-direction: column; }
  .mobilmenue__kurz { color: var(--farbe-text-gedeckt); font-size: var(--text-s); font-weight: var(--gewicht-normal); line-height: 1.35; }

  /* Der Schleier hinter dem offenen Menü (Element vor `.navigation`):
     die ganze Seite weiß und weichgezeichnet, wie hinter der
     Hinweis-Karte. Unter den Leisten, über allem Inhalt. Ein Tipp
     darauf schließt das Menü. */
  :global(.menue-schleier) {
    position: fixed;
    inset: 0;
    z-index: calc(var(--ebene-navigation) - 1);
    background: var(--farbe-schleier-hell);
    /* Die Seite dahinter wird selbst unscharf und tritt zurück
       (styles/global.css, `html[data-menue-unscharf]`). Der Startbereich
       mit dem Logo ist davon ausgenommen — ein Weichzeichner an ihm
       zeichnete den Saum um den Verlauf. Für ihn bleibt der
       Rückseiten-Weichzeichner am Schleier (Florian, 27. September
       2026). */
    backdrop-filter: blur(var(--weichzeichner-schleier));
    -webkit-backdrop-filter: blur(var(--weichzeichner-schleier));
    opacity: 0;
    transition: opacity var(--dauer-normal) var(--verlauf);
  }

  :global(.menue-schleier[data-sichtbar]) { opacity: 1; }
  :global(.menue-schleier[hidden]) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .mobilmenue__zeile,
    .mobilmenue__zelle,
    .mobilmenue__pfeil,
    .mobilmenue__zurueck { transition: none; }
  }

  .logo img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    transition: transform 0.5s var(--verlauf-betont);
  }

  .logo:hover img,
  .logo:focus-visible img { transform: scale(1.05); }

  @media (prefers-reduced-motion: reduce) {
    .logo img,
    .fussknopf__symbol,
    .fussknopf__text { transition: none; }
    .menuepunkt__pfeil { transition: none; }
    .logo:hover img,
    .fussknopf:hover .fussknopf__symbol,
    .fussknopf:hover .fussknopf__text { transform: none; }
  }

  /* ---------- Menüpunkte mit Text-Roll ----------
     Zwei identische Texte übereinander; beim Zeigen rollt der Block
     um genau eine Höhe hoch. Aus Ablauf a-18.

     Wichtig: Die Vorlage kennt KEIN Hover-Out. Der Ablauf rollt hoch und
     springt danach in 0 ms auf den Anfang zurück — unsichtbar, weil beide
     Texte gleich sind. Beim Verlassen läuft also nichts zurück.

     Die Rolle hängt nicht mehr an `:hover`, sondern an `data-rollt`
     (Skript: `rollenAufbauen`): Das Attribut kommt beim Betreten und
     geht erst am Ende der Animation. Eine `:hover`-Animation brach ab,
     sobald der Zeiger den Punkt verließ — der Text sprang zurück, und
     das wirkte hektisch (Florian, 26. September 2026). */
  .menuepunkt {
    display: block;
    height: 80px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--farbe-primaer);
    font: inherit;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
  }

  /*
    Der Haken am Menüpunkt „Leistungen": Er steht absolut UNTER dem
    Wort, auf dessen Mitte — nicht daneben (Florian, 18. September
    2026). Absolut deshalb, weil der Text beim Zeigen um 80 px hoch
    rollt (`.menuepunkt__rolle`); im Fluss rollte der Haken mit und
    wäre weg.

    Er steht damit auf derselben Senkrechten wie der Pfeil der Blase
    und die Symbole darin — siehe `zeichnen()` im Skript unten.
  */
  .menuepunkt--knopf {
    position: relative;
  }

  .menuepunkt__pfeil {
    position: absolute;
    left: 50%;
    bottom: 17px;
    /* 12 × 7 samt Rand der Zeichnung — sichtbar ist der Haken 10 px breit */
    width: 12px;
    height: 7px;
    margin-left: -6px;
    background: url('/icons/ui/pfeil-runter.svg') center / contain no-repeat;
    transition:
      opacity 220ms var(--verlauf),
      transform 220ms var(--verlauf);
  }

  /*
    Beim Öffnen wird aus diesem Haken der Pfeil der Blase: Er sinkt ab
    und blendet aus, während der andere ein paar Bildpunkte tiefer
    aufblendet (`blaseAnlegen` im Skript). Ein Drehen an Ort und Stelle wäre das
    Gegenteil davon (Florian, 18. September 2026).
  */
  .menuepunkt--knopf[aria-expanded='true'] .menuepunkt__pfeil {
    opacity: 0;
    transform: translateY(8px);
  }

  .menuepunkt__rolle {
    display: flex;
    flex-direction: column;
  }

  @keyframes menue-rolle {
    to { transform: translateY(-80px); }
  }

  .menuepunkt__text {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80px;
    flex: none;
    font-size: var(--text-s);
    font-weight: var(--gewicht-normal);
  }

  /* Einmal hoch, kein Zurückrollen — etwas länger und weicher als die
     300 ms easeInOut der Vorlage */
  .menuepunkt[data-rollt] .menuepunkt__rolle {
    animation: menue-rolle 420ms var(--verlauf-betont);
  }

  /* Solange das Aufklappmenü offen ist, steht der Text still oben —
     aber erst, wenn eine laufende Rolle zu Ende ist: Sie endet ohnehin
     genau dort. Vorher tötete `animation: none` hier die gerade
     gestartete Rolle, und der Text sprang. */
  .aufklapp[data-offen] .menuepunkt:not([data-rollt]) .menuepunkt__rolle {
    transform: translateY(-80px);
  }

  /* Tastatur: kein Rollen, dafür eine sichtbare Fokuslinie */
  .menuepunkt:focus-visible {
    outline: 2px solid var(--farbe-primaer);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .menuepunkt[data-rollt] .menuepunkt__rolle { animation: none; }
    .menuepunkt__pfeil { transition: none; }
  }

  /* ---------- Aufklappmenü („Blase") ----------
     Die Punktlinie der Leiste wölbt sich zu einem abgerundeten Feld
     auf — nach oben aus der Symbolleiste, nach unten aus der Kopfleiste.
     Gezeichnet wird das als SVG (Skript unten: `blaseAnlegen`), das
     Feld selbst ist nur der Inhalt darüber. */
  .aufklapp {
    position: relative;
  }

  .aufklapp__inhalt {
    position: absolute;
    left: 0;
    z-index: var(--ebene-menue);
    width: min(400px, 100vw - 2rem);
    padding: 26px 36px;
  }

  /* Untere Leiste: das Feld steht über der Leiste; obere: darunter.
     Jeweils Platz für den kleinen Pfeil an der Grundlinie. */
  .aufklapp[data-richtung='hoch'] .aufklapp__inhalt { bottom: 100%; padding-bottom: 40px; }
  .aufklapp[data-richtung='runter'] .aufklapp__inhalt { top: 100%; padding-top: 40px; }

  .aufklapp__inhalt[hidden] { display: none; }

  /* Die Wölbung: ein milchiger Grund wie die Leisten selbst (weiß mit
     Weichzeichner dahinter), auf die Form der Blase zugeschnitten —
     darüber die gestrichelte Linie als SVG. Beides liegt über die volle
     Breite auf der Punktlinie der Leiste; Maße setzt das Skript. */
  :global(.blase) {
    position: absolute;
    left: 0;
    display: block;
    pointer-events: none;
  }

  :global(.blase) {
    z-index: calc(var(--ebene-menue) - 1);
    overflow: visible;
  }

  /* Wie punktlinie.png: 1 px Punkt, 2 px Lücke, gleiche Farbe */
  :global(.blase__linie) {
    fill: none;
    stroke: var(--farbe-punktlinie);
    stroke-width: 1;
    stroke-dasharray: 1 2;
  }

  /*
    Derselbe Haken wie unter „Leistungen" — nur größer.

    Er war vorher dünner (1 statt 1,5), hatte runde Enden und einen
    flacheren Winkel (104° statt 90°). Neben den übrigen Pfeilen der
    Seite wirkte seine Spitze dadurch stumpf (Florian, 18. September
    2026). Jetzt stimmen Strichstärke, Winkel und Enden mit
    `icons/ui/pfeil-runter.svg` überein; die Spitze ist ein spitzer
    Gehrungsstoß, kein abgerundeter.
  */
  :global(.blase__pfeil) {
    fill: none;
    stroke: var(--farbe-punktlinie);
    stroke-width: 1.5;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    stroke-miterlimit: 10;
  }

  /* Die Oberpunkte blenden nacheinander ein, während die Blase wächst:
     von der Leiste her — unten also der letzte zuerst, oben der erste. */
  .oberpunkt {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 320ms var(--verlauf-betont),
      transform 320ms var(--verlauf-betont),
      background-color var(--dauer-schnell) var(--verlauf);
    transition-delay: calc(160ms + var(--stufe, 0) * 80ms), calc(160ms + var(--stufe, 0) * 80ms), 0ms;
  }

  .aufklapp[data-richtung='hoch'] .oberpunkt {
    transform: translateY(-6px);
    transition-delay: calc(160ms + var(--stufe-hoch, 0) * 80ms), calc(160ms + var(--stufe-hoch, 0) * 80ms), 0ms;
  }

  .aufklapp[data-offen] .oberpunkt {
    opacity: 1;
    transform: translateY(0);
  }

  /* Beim Schließen sofort weg, ohne Staffelung */
  .aufklapp:not([data-offen]) .oberpunkt { transition-delay: 0ms; transition-duration: 120ms; }

  @media (prefers-reduced-motion: reduce) {
    .oberpunkt { transition: none; opacity: 1; transform: none; }
  }

  .aufklapp__spalten {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Ein Oberpunkt je Kategorie — Symbol links, Titel und Kurztext rechts */
  .oberpunkt {
    display: flex;
    align-items: center;
    gap: 14px;
    /* Die Luft steckt jetzt im Eintrag selbst statt im Abstand
       dazwischen — so wächst auch die Fläche, die auf das Zeigen
       reagiert, und die Einträge stehen ruhiger beieinander. */
    padding: 10px 12px;
    margin: 0 -12px;
    border-radius: var(--radius-m);
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  .oberpunkt:hover,
  .oberpunkt:focus-visible { background: rgb(255 255 255 / 60%); }

  .oberpunkt__symbol {
    flex: none;
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .oberpunkt__text {
