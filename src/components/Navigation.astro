  /* ---------- Symbolleiste unten ---------- */
  /* .nav-bottom: fest am unteren Rand, Punktlinie oben */
  .fussleiste-huelle {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--ebene-navigation);
