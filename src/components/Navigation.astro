  /* .nav-bottom-button: 4 px Abstand nach oben */
  .fussknopf {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    margin-top: 4px;
    color: var(--farbe-primaer);
    text-decoration: none;
