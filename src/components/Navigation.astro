</style>

<script>
  import { schnalzWeg } from '../scripts/scrollwege';
  import { zuSprungmarke } from '../scripts/anker';
  import { KURVEN } from '../scripts/easing';
  import { navigate } from 'astro:transitions/client';
  /**
   * Verhalten der Navigation.
   *
   * 1. Leistenwechsel beim Scrollen: Sobald der Startbereich verlassen
   *    wird, trägt <body> die Markierung `data-gescrollt`. Alles Weitere
   *    erledigt CSS. Der Wechsel wird mit einem Puffer geschaltet, damit
   *    die Leisten an der Schwelle nicht flackern.
   *
   * 2. Aufklappmenü unter „Leistungen": öffnet per Klick, schließt per
   *    Escape, Klick nach außen oder wenn der Fokus den Bereich verlässt.
   *
   * 3. Handy-Menü: dieselbe Blase, zum rechten Rand hin offen; darin
   *    die Ebene „Leistungen" mit den Kategorien. Solange es offen ist,
   *    liegt ein Schleier über der Seite und sie steht still.
   *
   * 4. Die Text-Rolle der Menüpunkte läuft immer zu Ende (`data-rollt`).
   */
  /* Der Leistenwechsel hängt sich an Fenster und Dokument — das darf
     nur einmal geschehen, auch wenn Astro nach jedem Seitenwechsel
     `astro:page-load` auslöst (die Navigation selbst bleibt erhalten). */
  let leistenwechselBereit = false;

  function navigationAufbauen() {
    if (!leistenwechselBereit) {
      leistenwechselBereit = true;
      leistenwechselAufbauen();
    }
    aufklappmenuesAufbauen();
    rollenAufbauen();
    mobilmenueAufbauen();
  }

  function leistenwechselAufbauen() {
    // ---- Leistenwechsel ----
    // In der Vorlage hängt der Wechsel an einem eigenen unsichtbaren
    // Streifen (`.trigger-schnalz`, 250vh ab Dokumentanfang): sobald er
    // oben aus dem Bild läuft, fährt die untere Leiste weg und die obere
    // ein (Abläufe a-26 / a-16). Das ist deutlich später als das
    // Einrasten der Öffnungszeiten — die Blase steht also schon eine
    // Weile, bevor die Leisten tauschen.

    let gescrollt = document.body.hasAttribute('data-gescrollt');
    let geplant = false;

    /* Ab welcher Scrolltiefe die Leisten tauschen: sobald der Zipfel der
       Sprechstunden beginnt, sich einzuziehen (scripts/scrollwege.ts) */
    const schwelle = () => schnalzWeg() * window.innerHeight;

    /** Gehört zu dieser Scrolltiefe der gescrollte Zustand? */
    const gescrolltBei = (y: number, startseite: boolean) =>
      // Unterseiten (Leistung, Beitrag, Rechtliches) haben keinen
      // Logobereich: dort steht von Anfang an die Kopfleiste mit dem
      // Menü, die Symbolleiste bleibt eingefahren.
      startseite ? y > schwelle() : true;

    const pruefen = () => {
      geplant = false;
      const sollGescrollt = gescrolltBei(window.scrollY, !!document.querySelector('.ozbereich'));

      if (sollGescrollt !== gescrollt) {
        gescrollt = sollGescrollt;
        if (gescrollt) document.body.dataset.gescrollt = 'ja';
        else delete document.body.dataset.gescrollt;
      }
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(pruefen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    pruefen();

    // Beim Seitenwechsel tauscht Astro den <body> samt Attributen aus —
    // die Markierung wäre weg, die Kopfleiste würde in ihrer 300-ms-
    // Bewegung kurz auf Höhe 0 fallen und während des Übergangs
    // aufblitzen. Deshalb bekommt schon das NEUE Dokument die
    // Markierung, bevor es eingetauscht wird: Der Zustand steht dann
    // vom ersten Bild an fest, nichts bewegt sich.
    document.addEventListener('astro:before-swap', (ereignis) => {
      const e = ereignis as Event & { newDocument: Document; to: URL; navigationType: string };
      const startseite = !!e.newDocument.querySelector('.ozbereich');
      let merker = '';
      try { merker = sessionStorage.getItem('uebergang-ziel') || ''; } catch { /* egal */ }

      let soll: boolean;
      if (e.navigationType === 'traverse') {
        // Vor/Zurück im Verlauf: Astro stellt die gemerkte Scrolltiefe wieder her
        const y = (history.state && typeof history.state.scrollY === 'number') ? history.state.scrollY : 0;
        soll = gescrolltBei(y, startseite);
      } else if (!startseite || merker) {
        // Unterseite — oder zurück zur Übersicht, wo die Karte mittig gestellt wird
        soll = true;
      } else {
        // Sprungmarke tiefer auf der Seite? Der Anfang und die
        // Öffnungszeiten liegen oben, alles andere ist gescrollt.
        soll = !!e.to.hash && !['#start', '#oz_anchor', '#inhalt'].includes(e.to.hash);
      }
      if (soll) e.newDocument.body.dataset.gescrollt = 'ja';
      else delete e.newDocument.body.dataset.gescrollt;
      gescrollt = soll;
    });

    // Nach dem Tausch (noch vor dem ersten Bild) gegenprüfen — die
    // Scrollposition steht dann fest.
    document.addEventListener('astro:after-swap', () => {
      queueMicrotask(pruefen);
    });

  }

  /* ---------- Die Blase ----------
     Die Punktlinie einer Leiste wölbt sich zu einem abgerundeten Feld
     auf. Gezeichnet wird das als SVG über die volle Breite (die
     gestrichelte Linie) plus einer Maske (`clip-path`) auf dem Umschlag
     der Leiste, die Leiste und Blase zu EINER milchigen Fläche
     zuschneidet — keine Kante dazwischen. Die Höhe wächst Bild für Bild
     von 0 auf die Höhe des Inhalts.

     Zwei Formen teilen sich Zeichnung, Maske und Bewegung
     (`blaseAnlegen`): die Blase unter „Leistungen" (Desktop; aus der
     Symbolleiste auch nach oben) und das Handy-Menü, das zum rechten
     Rand hin offen ist. Die Form selbst liefert je eine
     `Geometrie`-Funktion. Ein Überschwingen beim Öffnen gab es bis zum
     26. September 2026 (ein kleiner Sinus-Zusatz); es ist weg — Florian
     wollte es glatter. */

  type Geometrie = (k: {
    breite: number;                // Fensterbreite
    h: number;                     // aktuelle Höhe der Wölbung
    anteil: number;                // 0 = Linie, 1 = voll aufgewölbt
    y0: number;                    // y der Grundlinie in der Zeichnung
    s: number;                     // Richtung: 1 nach unten, -1 nach oben
    k: number;                     // Kreiskonstante der Viertelbögen
    f: (n: number) => string;
  }) => {
    /** Die Wölbung ab dem linken Rand bis zum rechten Rand, in
        Leserichtung — um `dy` verschoben und um `auf` nach außen geweitet */
    woelbung: (dy: number, auf: number) => string;
    /** Dieselbe Wölbung vom rechten zum linken Rand (Maske der oberen Leiste) */
    rueckwaerts: (dy: number, auf: number) => string;
    /** Kleiner Pfeil an der Grundlinie, wenn die Form einen hat */
    pfeil?: { d: string; sicht: number };
  };

  /** Weiche Kurve (ease-in-out quad) für das Breiterwerden der Blase */
  const weich = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

  function blaseAnlegen(opt: {
    /** Trägt die Zeichnung (`.kopfleiste` / `.fussleiste`) */
    leiste: HTMLElement;
    /** Trägt Maske und Punktlinie (`.navigation` / `.fussleiste-huelle`) */
    linienTraeger: HTMLElement;
    hoch: boolean;
    geometrie: Geometrie;
    /** Aufräumen, wenn die Blase ganz zu ist */
    beimZu: () => void;
  }) {
    const { leiste, linienTraeger, hoch, geometrie, beimZu } = opt;
    const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Die Zeichnung: gestrichelte Linie und Pfeil; der milchige Grund
    // ist die Maske am Umschlag
    const NS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('class', 'blase');
    svg.setAttribute('aria-hidden', 'true');
    const linie = document.createElementNS(NS, 'path'); linie.setAttribute('class', 'blase__linie');
    const pfeil = document.createElementNS(NS, 'path'); pfeil.setAttribute('class', 'blase__pfeil');
    svg.append(linie, pfeil);
    svg.style.display = 'none';
    leiste.append(svg);

    let anteil = 0;        // 0 = Linie, 1 = voll aufgewölbt
    let ziel = 0;
    let laeuft = false;
    let hoehe = 0;         // Höhe der Wölbung in px
    let start = 0, von = 0, dauer = 520;
    const s = hoch ? -1 : 1;   // Richtung: nach oben oder unten
    const k = 0.5523;          // Viertelkreis als Bézier
    const rand = 4;            // Luft in der Zeichnung ober- und unterhalb

    /* Öffnen mit derselben Kurve wie alle betonten Bewegungen der Seite,
       Schließen ease-in-out */
    const kurveAuf = KURVEN.betont;
    const kurveZu = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const zeichnen = () => {
      const breite = document.documentElement.clientWidth;
      const h = Math.max(0, hoehe * anteil);
      /* Grundlinie im SVG — auf halbe Pixel gelegt, damit der 1-px-Strich
         genau auf der Punktreihe der Leiste liegt und nicht verschmiert */
      const y0 = hoch ? hoehe + rand + 0.5 : rand - 0.5;
      const gesamt = hoehe + 2 * rand;

      svg.style.width = `${breite}px`;
      svg.style.height = `${gesamt}px`;
      svg.style[hoch ? 'bottom' : 'top'] = `calc(100% - ${rand}px)`;
      svg.setAttribute('viewBox', `0 0 ${breite} ${gesamt}`);

      const f = (n: number) => n.toFixed(2);
      const form = geometrie({ breite, h, anteil: Math.min(1, anteil), y0, s, k, f });

      /* Bei (fast) null Höhe eine reine Linie: Die Bögen hätten sonst
         Punkte, die um Bruchteile eines Pixels wackeln, und aus den
         Strichen würde in der Mitte ein durchgezogener Strich */
      linie.setAttribute('d', h < 1.5 ? `M0 ${f(y0)} L${breite} ${f(y0)}` : `M0 ${f(y0)} ${form.woelbung(0, 0)}`);

      /* Die Maske des Leistengrunds: Leiste plus Blase als eine Form,
         in den Koordinaten des Umschlags. Der reicht per Innenabstand
         (`--blase-hoehe`) über die Leiste hinaus — gemessen wird die
         Leiste selbst, also ohne diesen Abstand. */
      const lr = linienTraeger.getBoundingClientRect();
      const cs = getComputedStyle(linienTraeger);
      const leisteH = lr.height - (parseFloat(cs.paddingTop) || 0) - (parseFloat(cs.paddingBottom) || 0);
      linienTraeger.style.setProperty('--blase-hoehe', `${gesamt}px`);
      /* Nullpunkt-Versatz zwischen Zeichnung und Maske: unten liegt die
         Zeichnung `rand` unter dem oberen Umschlagrand, oben liegt die
         Grundlinie erst unter der Leiste */
      const dy = hoch ? rand : leisteH - rand;
      /* Der Strich liegt in der Zeichnung, die mit maskiert wird — die
         Maske greift deshalb 1 px über ihn hinaus */
      const auf = 1;
      const yM = y0 + dy + s * auf;
      const maske = hoch
        ? `M0 ${f(gesamt + leisteH)} L0 ${f(yM)} ${form.woelbung(dy, auf)}L${breite} ${f(yM)} L${breite} ${f(gesamt + leisteH)} Z`
        : `M0 0 L${breite} 0 L${breite} ${f(yM)} ${form.rueckwaerts(dy, auf)}L0 ${f(yM)} Z`;
      linienTraeger.style.setProperty('--blase-form', `path("${maske}")`);

      if (form.pfeil) {
        pfeil.setAttribute('d', form.pfeil.d);
        pfeil.setAttribute('opacity', f(form.pfeil.sicht));
      } else {
        pfeil.removeAttribute('d');
      }
    };

    const schritt = (jetzt: number) => {
      const t = Math.min(1, (jetzt - start) / dauer);
      const kurve = ziel === 1 ? kurveAuf : kurveZu;
      anteil = von + (ziel - von) * kurve(t);
      zeichnen();
      if (t < 1) { requestAnimationFrame(schritt); return; }
      laeuft = false;
      anteil = ziel;
      if (ziel === 0) {
        svg.style.display = 'none';
        linienTraeger.style.removeProperty('--blase-form');
        linienTraeger.style.removeProperty('--blase-hoehe');
        delete linienTraeger.dataset.ohneLinie;
        beimZu();
      }
    };

    const animieren = (nachZiel: number, sofort = false) => {
      ziel = nachZiel;
      von = anteil;
      start = performance.now();
      dauer = nachZiel === 1 ? 520 : 400;
      if (wenigerBewegung || sofort) { anteil = ziel; zeichnen(); dauer = 0; start = -1e9; }
      if (!laeuft) { laeuft = true; requestAnimationFrame(schritt); }
    };

    return {
      /** Aufwölben auf die gegebene Inhaltshöhe */
      oeffnen(h: number) {
        hoehe = h;
        linienTraeger.dataset.ohneLinie = 'ja';
        svg.style.display = 'block';
        zeichnen();
        animieren(1);
      },
      schliessen(sofort = false) { animieren(0, sofort); },
      /** Der Inhalt ist anders hoch geworden — die Blase folgt sofort */
      hoeheSetzen(h: number) {
        if (svg.style.display === 'none') return;
        hoehe = h;
        zeichnen();
      },
      get aktiv() { return svg.style.display !== 'none'; },
    };
  }

  function aufklappmenuesAufbauen() {
    // ---- Aufklappmenü „Leistungen" ----
    // Die Wölbung sitzt unter (oder über) dem Menüpunkt; ein kleiner
    // Pfeil an der Grundlinie zeigt auf ihn.
    document.querySelectorAll<HTMLElement>('[data-aufklapp]').forEach((huelle) => {
      if (huelle.dataset.bereit) return;
      huelle.dataset.bereit = 'ja';

      const knopf = huelle.querySelector<HTMLButtonElement>('button[aria-expanded]');
      const inhalt = huelle.querySelector<HTMLElement>('.aufklapp__inhalt');
      const hoch = huelle.dataset.richtung === 'hoch';
      /* Wo die Zeichnung hängt und wer die Punktlinie trägt. Beides muss
         im selben Stapelkontext wie der Inhalt liegen — die Kopfleiste
         trägt einen Übergangsnamen und bildet damit einen eigenen. */
      const leiste = hoch ? huelle.closest<HTMLElement>('.fussleiste') : huelle.closest<HTMLElement>('.kopfleiste');
      const linienTraeger = hoch ? huelle.closest<HTMLElement>('.fussleiste-huelle') : huelle.closest<HTMLElement>('.navigation');
      if (!knopf || !inhalt || !leiste || !linienTraeger) return;

      const ECKE = 40;             // Rundung am Ende — wie im Entwurf

      const geometrie: Geometrie = ({ breite, h, anteil, y0, s, k, f }) => {
        const boxBreite = Math.min(400, breite - 32);
        const kr = knopf.getBoundingClientRect();
        const knopfX = kr.left + kr.width / 2;
        /*
          Die Blase sitzt so, dass die SYMBOLE darin genau unter der
          Mitte des Menüpunkts stehen — und damit auf derselben
          Senkrechten wie der Pfeil und der Haken am Knopf darüber
          (Florian, 18. September 2026).

          Bis zur Mitte eines Symbols sind es vom linken Rand der Blase:
          36 px Innenabstand (`.aufklapp__inhalt`) plus die halbe
          Symbolbreite. Vorher stand hier ein geschätztes Verhältnis —
          es traf beinahe, aber eben nur beinahe.
        */
        const bisSymbolmitte = 36 + 18;
        const links = Math.max(16, Math.min(breite - boxBreite - 16, knopfX - bisSymbolmitte));
        const mitte = links + boxBreite / 2;

        /* Sie wächst in Höhe UND Breite — die Linie fließt auf, statt
           eine fertige Form hochzuschieben. Die Rundung ist nie größer
           als die halbe Höhe: so bleibt jede Zwischenform weich.
           Der Fuß der Blase steht fest (Außenmaß = Endbreite + Rundung);
           nur der Scheitel weitet sich mit der Höhe, die Bögen werden
           dadurch von breit-flach zu 40-px-Kreisen und die Seiten steiler.
           So gibt es in keiner Phase eine Ecke. */
        const aussen = boxBreite / 2 + ECKE;                   // halbe Fußbreite, fest
        /* Scheitelbreite: beginnt bei der halben Fußbreite — dann sind die
           Bögen genau so breit wie der halbe Scheitel und stoßen in der
           Mitte aneinander (reiner Hügel ohne Plateau). Breiter dürfen
           die Bögen nie sein, sonst liefe die Linie über sich zurück. */
        const w = aussen + (boxBreite - aussen) * weich(anteil);
        const fa = Math.min(ECKE, h / 2);                       // Höhe der Bögen
        const aB = Math.min(w / 2, Math.max(fa, aussen - w / 2)); // Breite der Bögen

        const woelbung = (dy: number, auf: number) => {
          const g = (n: number) => f(n + dy);
          const xL = mitte - w / 2 - auf;
          const xR = mitte + w / 2 + auf;
          const yb = y0 + s * auf;
          return (
            /* Fuß links: flacher Bogen von der Linie in die Wand */
            `L${f(xL - aB)} ${g(yb)} C${f(xL - aB + k * aB)} ${g(yb)} ${f(xL)} ${g(yb + s * (fa - k * fa))} ${f(xL)} ${g(yb + s * fa)} ` +
            /* Wand */
            `L${f(xL)} ${g(yb + s * (h - fa))} ` +
            /* Schulter links */
            `C${f(xL)} ${g(yb + s * (h - fa + k * fa))} ${f(xL + aB - k * aB)} ${g(yb + s * h)} ${f(xL + aB)} ${g(yb + s * h)} ` +
            /* Scheitel */
            `L${f(xR - aB)} ${g(yb + s * h)} ` +
            /* Schulter rechts */
            `C${f(xR - aB + k * aB)} ${g(yb + s * h)} ${f(xR)} ${g(yb + s * (h - fa + k * fa))} ${f(xR)} ${g(yb + s * (h - fa))} ` +
            /* Wand */
            `L${f(xR)} ${g(yb + s * fa)} ` +
            /* Fuß rechts, dann weiter auf der Linie bis zum Rand */
            `C${f(xR)} ${g(yb + s * (fa - k * fa))} ${f(xR + aB - k * aB)} ${g(yb)} ${f(xR + aB)} ${g(yb)} ` +
            `L${breite} ${g(yb)} `
          );
        };

        const rueckwaerts = (dy: number, auf: number) => {
          const g = (n: number) => f(n + dy);
          const xL = mitte - w / 2 - auf;
          const xR = mitte + w / 2 + auf;
          const yb = y0 + s * auf;
          return (
            `L${f(xR + aB)} ${g(yb)} ` +
            `C${f(xR + aB - k * aB)} ${g(yb)} ${f(xR)} ${g(yb + s * (fa - k * fa))} ${f(xR)} ${g(yb + s * fa)} ` +
            `L${f(xR)} ${g(yb + s * (h - fa))} ` +
            `C${f(xR)} ${g(yb + s * (h - fa + k * fa))} ${f(xR - aB + k * aB)} ${g(yb + s * h)} ${f(xR - aB)} ${g(yb + s * h)} ` +
            `L${f(xL + aB)} ${g(yb + s * h)} ` +
            `C${f(xL + aB - k * aB)} ${g(yb + s * h)} ${f(xL)} ${g(yb + s * (h - fa + k * fa))} ${f(xL)} ${g(yb + s * (h - fa))} ` +
            `L${f(xL)} ${g(yb + s * fa)} ` +
            `C${f(xL)} ${g(yb + s * (fa - k * fa))} ${f(xL - aB + k * aB)} ${g(yb)} ${f(xL - aB)} ${g(yb)} `
          );
        };

        /* Kleiner Pfeil an der Grundlinie, auf den Menüpunkt zeigend —
           Schenkel unter 45° wie der Haken am Menüpunkt, nur größer. Er
           blendet im letzten Drittel des Wachsens auf. */
        const py = y0 + s * 22;
        const sicht = Math.min(1, Math.max(0, (anteil - 0.6) / 0.4));
        const arm = 9;
        const pfeil = {
          d: `M${f(knopfX - arm)} ${f(py + s * -arm)} L${f(knopfX)} ${f(py)} L${f(knopfX + arm)} ${f(py + s * -arm)}`,
          sicht,
        };

        /* Der Inhalt liegt in der voll aufgewölbten Blase */
        const hr = huelle.getBoundingClientRect();
        inhalt.style.left = `${links - hr.left}px`;

        return { woelbung, rueckwaerts, pfeil };
      };

      const blase = blaseAnlegen({
        leiste, linienTraeger, hoch, geometrie,
        beimZu: () => {
          delete huelle.dataset.aktiv;
          if (knopf.getAttribute('aria-expanded') !== 'true') inhalt.hidden = true;
        },
      });

      const setzen = (offen: boolean) => {
        if ((knopf.getAttribute('aria-expanded') === 'true') === offen) return;
        knopf.setAttribute('aria-expanded', String(offen));
        if (offen) {
          inhalt.hidden = false;
          huelle.dataset.aktiv = 'ja';
          blase.oeffnen(inhalt.getBoundingClientRect().height);
          requestAnimationFrame(() => { huelle.dataset.offen = 'ja'; });
        } else {
          delete huelle.dataset.offen;
          blase.schliessen();
        }
      };

      /*
        Der Menüpunkt „Leistungen" tut zweierlei — in dieser Reihenfolge:

          1. Klick, solange zu:   die Blase geht auf
          2. Klick, während offen: sie schließt, und die Seite springt
             an den Anfang des Leistungsbereichs

        Mit der Maus ist Schritt 1 schon durch das Überfahren erledigt;
        der erste Klick springt also gleich (Florian, 18. September
        2026). Mit Tastatur oder Finger gibt es kein Überfahren — dort
        öffnet der erste Druck, der zweite springt. So kommt man auf
        jedem Weg an beides.
      */
      knopf.addEventListener('click', () => {
        if (knopf.getAttribute('aria-expanded') !== 'true') { setzen(true); return; }
        setzen(false);
        /* Auf einer Unterseite gibt es die Marke nicht — dann zur
           Startseite, den Rest erledigt scripts/anker.ts. */
        if (!zuSprungmarke('#leistungen')) { navigate('/#leistungen'); return; }
        /* Adresse mitführen, ohne neuen Verlaufseintrag — wie bei den
           Sprungmarken in scripts/anker.ts. */
        try { history.replaceState(history.state, '', '#leistungen'); } catch { /* egal */ }
      });

      /* Eine Kategorie in der Blase: sofort zu, nicht erst beim
         Wegziehen des Zeigers (Florian, 18. September 2026). */
      inhalt.addEventListener('click', (e) => {
        if ((e.target as Element | null)?.closest?.('a')) setzen(false);
      });

      // Auf Zeigegeräten öffnet auch das Überfahren — die Blase gehört dazu
      let schliessTimer = 0;
      huelle.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse') return;
        window.clearTimeout(schliessTimer);
        setzen(true);
      });
      huelle.addEventListener('pointerleave', (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse') return;
        schliessTimer = window.setTimeout(() => setzen(false), 120);
      });

      // Schließen, wenn der Fokus den Bereich verlässt
      huelle.addEventListener('focusout', (e) => {
        const ziel = e.relatedTarget as Node | null;
        if (!ziel || !huelle.contains(ziel)) setzen(false);
      });

      // Schließen bei Klick außerhalb
      document.addEventListener('click', (e) => {
        if (!huelle.contains(e.target as Node)) setzen(false);
      });

      // Schließen mit Escape, Fokus zurück auf den Knopf
      huelle.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          setzen(false);
          knopf.focus();
        }
      });

      window.addEventListener('resize', () => {
        if (huelle.dataset.aktiv) blase.hoeheSetzen(inhalt.getBoundingClientRect().height);
      }, { passive: true });
      // Beim Seitenwechsel schließen
      document.addEventListener('astro:before-preparation', () => setzen(false));
    });
  }

  /**
   * Die Text-Rolle der Menüpunkte (CSS `.menuepunkt__rolle`): Das
   * Attribut kommt beim Betreten und geht erst, wenn die Animation zu
   * Ende ist — eine `:hover`-Animation brach ab, sobald der Zeiger den
   * Punkt verließ, und der Text sprang zurück (Florian, 26. September
   * 2026). Zurückgerollt wird nie (Ablauf a-18).
   */
  function rollenAufbauen() {
    const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.menuepunkt').forEach((punkt) => {
      if (punkt.dataset.rolleBereit) return;
      punkt.dataset.rolleBereit = 'ja';
      const rolle = punkt.querySelector('.menuepunkt__rolle');
      punkt.addEventListener('pointerenter', () => { if (!wenigerBewegung) punkt.dataset.rollt = 'ja'; });
      const fertig = (e: AnimationEvent) => { if (e.target === rolle) delete punkt.dataset.rollt; };
      punkt.addEventListener('animationend', fertig);
      /* Etwa beim Umbruch auf Handybreite mitten in der Rolle */
      punkt.addEventListener('animationcancel', fertig);
    });
  }

  function mobilmenueAufbauen() {
    // ---- Handy-Menü ----
    // Dieselbe Blase wie unter „Leistungen", nur zum rechten Rand hin
    // offen: Die Punktlinie bleibt unter dem Logo oben, senkt sich rechts
    // davon in eine senkrechte Wand und läuft am Fuß des Menüs bis zum
    // rechten Fensterrand (Florian, 26. September 2026). Der Lottie-Knopf
    // läuft von Bild 0 auf 59 und zurück (Ablauf a-25 / a-27), mit
    // `KNOPF_TEMPO` beschleunigt.
    const menueknopf = document.querySelector<HTMLButtonElement>('[data-menueknopf]');
    const navigation = document.querySelector<HTMLElement>('.navigation');
    const kopfleiste = navigation?.querySelector<HTMLElement>('.kopfleiste');
    const logo = navigation?.querySelector<HTMLElement>('.kopfleiste__mobil .logo');
    const menue = document.querySelector<HTMLElement>('[data-mobilmenue]');
    const lottieKasten = document.querySelector<HTMLElement>('[data-menuelottie]');
    if (!menueknopf || !navigation || !kopfleiste || !logo || !menue || menueknopf.dataset.bereit) return;
    menueknopf.dataset.bereit = 'ja';

    let knopfSpieler: { playSegments: (b: [number, number], s?: boolean) => void; setSpeed: (f: number) => void; totalFrames: number } | null = null;
    /* Die Datei ist auf 600 ms angelegt (Ablauf a-25); der Wechsel
       Burger ↔ X soll flotter sein als die Blase, die 520 ms wächst:
       1,6-fach → 375 ms (Florian, 26. September 2026). */
    const KNOPF_TEMPO = 1.6;
    /* Das letzte Bild, EINMAL beim Laden gemerkt: lottie-web setzt
       `totalFrames` nach `playSegments` auf die Länge des gespielten
       Abschnitts. Wer den Wert bei jedem Klick neu liest, spielt jedes
       Mal ein Bild weniger — das X wurde mit jedem Klick schmaler,
       bis die Balken gar nicht mehr drehten (Florian, 26. September
       2026). */
    let letztesBild = 0;
    if (lottieKasten) {
      import('../scripts/lottie').then(({ ladeAnimation }) => {
        ladeAnimation(lottieKasten, '/lottie/menue-button.json').then((s) => {
          knopfSpieler = s as never;
          letztesBild = s ? s.totalFrames - 1 : 0;
          s?.setSpeed(KNOPF_TEMPO);
        });
      });
    }

    /* ---- Form der Blase ----
       Die linke Hälfte der Desktop-Blase, zum rechten Rand hin offen:
       Fuß auf der Leistenlinie, senkrechte Wand rechts neben dem Logo,
       unten die Schulter in die Grundlinie, die bis zum Fensterrand
       läuft. Und dieselbe Bewegung: Der Fuß steht fest, die Bögen sind
       anfangs breit und flach (ein Hügel, der von unten gegen die Linie
       drückt) und ziehen sich mit der Höhe auf die 40-px-Rundung
       zusammen, während die Wand nach links an ihren Platz rückt. So
       gibt es in keiner Phase eine Ecke. Der erste Entwurf hatte einen
       großen Schwung oben und eine geneigte Wand — das wirkte beim
       Öffnen weniger „blasig" als der Desktop (Florian, 26. September
       2026). */
    const LOGO_ABSTAND = 12;    // Luft zwischen Logo und Wand
    const ECKE = 40;            // Rundung am Ende — wie bei der Desktop-Blase
    const HUEGEL = 150;         // Breite der Bögen am Anfang: so flach beginnt der Hügel

    const geometrie: Geometrie = ({ breite, h, anteil, y0, k, f }) => {
      /* `.navigation` liegt bei left 0 — Fensterkoordinaten sind
         Zeichnungskoordinaten */
      const xL = logo.getBoundingClientRect().right + LOGO_ABSTAND;   // die Wand am Ende
      const xF = xL - ECKE;                                             // der Fuß, fest
      const fa = Math.min(ECKE, h / 2);                                 // Höhe der Bögen
      /* Breite der Bögen: vom flachen Hügel zur Rundung, nie flacher
         als hoch — wie `aB` bei der Desktop-Blase */
      const aB = Math.max(fa, HUEGEL - (HUEGEL - ECKE) * weich(anteil));
      const xW = xF + aB;                                               // die Wand jetzt
      menue.style.setProperty('--menue-wand', `${xL.toFixed(1)}px`);

      const woelbung = (dy: number, auf: number) => {
        const g = (n: number) => f(n + dy);
        const yb = y0 + auf;
        return (
          /* auf der Linie bis zum Fuß, Bogen von der Linie in die Wand */
          `L${f(xF - auf)} ${g(yb)} C${f(xF - auf + k * aB)} ${g(yb)} ${f(xW - auf)} ${g(y0 + fa - k * fa)} ${f(xW - auf)} ${g(y0 + fa)} ` +
          /* die Wand */
          `L${f(xW - auf)} ${g(y0 + h - fa)} ` +
          /* die Schulter in die Grundlinie, dann offen bis zum rechten Rand */
          `C${f(xW - auf)} ${g(y0 + h - fa + k * fa)} ${f(xW + aB - k * aB)} ${g(y0 + h + auf)} ${f(xW + aB)} ${g(y0 + h + auf)} ` +
          `L${breite} ${g(y0 + h + auf)} `
        );
      };

      const rueckwaerts = (dy: number, auf: number) => {
        const g = (n: number) => f(n + dy);
        const yb = y0 + auf;
        return (
          `L${breite} ${g(y0 + h + auf)} L${f(xW + aB)} ${g(y0 + h + auf)} ` +
          `C${f(xW + aB - k * aB)} ${g(y0 + h + auf)} ${f(xW - auf)} ${g(y0 + h - fa + k * fa)} ${f(xW - auf)} ${g(y0 + h - fa)} ` +
          `L${f(xW - auf)} ${g(y0 + fa)} ` +
          `C${f(xW - auf)} ${g(y0 + fa - k * fa)} ${f(xF - auf + k * aB)} ${g(yb)} ${f(xF - auf)} ${g(yb)} `
        );
      };

      return { woelbung, rueckwaerts };
    };

    /* ---- Ebene „Leistungen" ---- */
    const knopfLeistungen = menue.querySelector<HTMLButtonElement>('[data-mobilleistungen]');
    const ebeneSetzen = (leistungen: boolean) => {
      if (!knopfLeistungen) return;
      knopfLeistungen.setAttribute('aria-expanded', String(leistungen));
      if (leistungen) {
        knopfLeistungen.setAttribute('aria-label', 'Zurück zum Menü');
        menue.dataset.ebene = 'leistungen';
      } else {
        knopfLeistungen.removeAttribute('aria-label');
        delete menue.dataset.ebene;
      }
    };
    knopfLeistungen?.addEventListener('click', () => {
      ebeneSetzen(knopfLeistungen.getAttribute('aria-expanded') !== 'true');
    });

    /* ---- Schleier ----
       Er steht außerhalb der persistierten Navigation und wird bei
       jedem Seitenwechsel neu gebaut — deshalb hier stets frisch
       abgefragt statt gemerkt. */
    const schleier = () => document.querySelector<HTMLElement>('[data-menue-schleier]');
    const schleierZeigen = () => {
      const s = schleier();
      if (!s) return;
      s.hidden = false;
      requestAnimationFrame(() => { s.dataset.sichtbar = 'ja'; });
    };
    const schleierAusblenden = () => { const s = schleier(); if (s) delete s.dataset.sichtbar; };
    const schleierVerstecken = () => { const s = schleier(); if (s) s.hidden = true; };

    /* ---- Seite stillhalten ----
       Solange das Menü offen ist, steht die Seite still: Sonst scrollte
       beim Wischen über dem Menü der Inhalt dahinter weg — und mit ihm
       fährt die Einstiegskarte, weil sie am Scrollweg hängt (Florian,
       18. September 2026). Kein `position: fixed` am Body: Das setzte
       `scrollY` auf 0 und würfe die Karte aus der Bahn. Stattdessen
       `overflow: hidden` an der Wurzel plus — nur solange offen — ein
       Zuhörer, der das Wischen mit einem Finger unterbindet; iOS Safari
       hält sich sonst nicht an das `overflow`. Pinch-Zoom bleibt. */
    const beiTouch = (e: TouchEvent) => { if (e.touches.length === 1) e.preventDefault(); };
    const seiteSperren = (sperren: boolean) => {
      const html = document.documentElement;
      html.style.overflow = sperren ? 'hidden' : '';
      html.style.overscrollBehavior = sperren ? 'none' : '';
      if (sperren) document.addEventListener('touchmove', beiTouch, { passive: false });
      else document.removeEventListener('touchmove', beiTouch);
    };

    /* ---- Die Seite tritt zurück ----
       Solange das Menü offen ist, wird alles außer der Navigation
       unscharf und eine Spur kleiner (styles/global.css). Der
       Bezugspunkt der Verkleinerung ist die Fenstermitte — je Element
       als Abstand von seiner Oberkante, sonst schrumpfte ein langer
       Inhalt um seine eigene, weit entfernte Mitte. */
    const zuruecktreten = (zurueck: boolean) => {
      const html = document.documentElement;
      if (zurueck) {
        for (const el of document.querySelectorAll<HTMLElement>('.seiteninhalt, .ozbereich__buehne, .fuss')) {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--zurueck-mitte', `${Math.round(window.innerHeight / 2 - r.top)}px`);
        }
        html.dataset.menueUnscharf = 'ja';
      } else {
        delete html.dataset.menueUnscharf;
      }
    };

    const blase = blaseAnlegen({
      leiste: kopfleiste, linienTraeger: navigation, hoch: false, geometrie,
      beimZu: () => {
        delete navigation.dataset.menueAktiv;
        menue.hidden = true;
        schleierVerstecken();
        ebeneSetzen(false);
      },
    });

    const istOffen = () => navigation.hasAttribute('data-menue-offen');
    /* Der logische Zustand — `data-menue-aktiv` bleibt bis zum Ende der
       Schließbewegung stehen, der Hörer braucht aber sofort den
       Zielplatz */
    let menueGewollt = false;

    /* ---- Der Hörer in der Kopfleiste ----
       Drei Plätze (Florian, 27. September 2026): zu — rechts neben dem
       Punkt vor dem Menüknopf; allein geöffnet — mit der Nummer daneben
       genau in der Mitte zwischen Logo und Menüknopf; bei offenem Menü —
       als dessen erste Zeile, sein Symbol bündig mit den Symbolen der
       Zeilen darunter. Der Platz ist eine `left`-Angabe in der
       Kopfleiste, die das Skript misst; das CSS fährt dorthin. */
    const kopfleisteMobil = navigation.querySelector<HTMLElement>('.kopfleiste__mobil');
    const telefon = navigation.querySelector<HTMLElement>('[data-kopftelefon]');
    const telefonKnopf = telefon?.querySelector<HTMLButtonElement>('[data-kopftelefonknopf]');
    const nummer = telefon?.querySelector<HTMLElement>('.kopftelefon__nummer');
    const punkt = navigation.querySelector<HTMLElement>('[data-kopfpunkt]');
    let telefonOffen = false;

    const telefonStellen = () => {
      if (!kopfleisteMobil || !telefon || !telefonKnopf) return;
      const k = kopfleisteMobil.getBoundingClientRect();
      if (!k.width) return;   // Desktop: die Zeile ist ausgeblendet
      const b = menueknopf.getBoundingClientRect();
      const knopfBreite = telefonKnopf.getBoundingClientRect().width || 44;
      const luft = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--abstand-xs')) * 16 || 12;
      const abstand = parseFloat(getComputedStyle(kopfleisteMobil.querySelector('.kopfleiste__handyrechts') as Element).columnGap) || 16;
      let x: number;
      if (telefonOffen || menueGewollt) {
        /* Geöffnet — allein wie mit Menü — steht die Gruppe mittig
           zwischen Logo und Menüknopf; mit Menü rückt die Symbolspalte
           des Menüs unter das Symbol des Hörers (Florians Entwurf,
           27. September 2026). Der Hörer-Knopf ist 44 px, sein Symbol
           40: die Spalte beginnt 2 px innerhalb des Knopfs. */
        const breite = knopfBreite + luft + (nummer?.scrollWidth ?? 0);
        x = (logo.getBoundingClientRect().right + b.left) / 2 - breite / 2 - k.left;
        menue.style.setProperty('--menue-spalte', `${Math.round(k.left + x + (knopfBreite - 40) / 2)}px`);
      } else {
        const p = punkt?.getBoundingClientRect();
        x = (p && p.width ? p.left : b.left) - abstand - knopfBreite - k.left;
      }
      telefon.style.setProperty('--telefon-x', `${Math.round(x)}px`);
      telefon.dataset.gestellt = 'ja';
    };

    const telefonSetzen = (offen: boolean) => {
      if (!telefon || !telefonKnopf) return;
      telefonOffen = offen;
      telefonKnopf.setAttribute('aria-expanded', String(offen));
      telefonKnopf.setAttribute('aria-label', offen ? 'Telefonnummer verbergen' : 'Telefonnummer anzeigen');
      if (offen) {
        /* Die Breite des Texts, jetzt gemessen — die Schrift könnte beim
           Laden noch gewechselt haben */
        telefon.style.setProperty('--nummer-breite', `${nummer?.scrollWidth ?? 0}px`);
        telefon.dataset.offen = 'ja';
        kopfleisteMobil?.setAttribute('data-telefon-offen', '');
      } else {
        delete telefon.dataset.offen;
        kopfleisteMobil?.removeAttribute('data-telefon-offen');
      }
      telefonStellen();
    };

    telefonKnopf?.addEventListener('click', () => {
      /* Bei offenem Menü ist der Hörer ein Menüpunkt: ein Tipp ruft an */
      if (menueGewollt) { nummer?.click(); return; }
      telefonSetzen(!telefonOffen);
    });
    window.addEventListener('resize', telefonStellen, { passive: true });
    telefonStellen();

    const oeffnen = () => {
      if (istOffen()) return;
      menueGewollt = true;
      menue.hidden = false;
      navigation.dataset.menueAktiv = 'ja';
      /* Wie `data-offen` bei der Desktop-Blase: einen Frame später, damit
         die Zeilen aus ihrem Grundzustand heraus einfahren */
      requestAnimationFrame(() => { navigation.dataset.menueOffen = 'ja'; });
      menueknopf.setAttribute('aria-expanded', 'true');
      menueknopf.setAttribute('aria-label', 'Menü schließen');
      knopfSpieler?.playSegments([0, letztesBild], true);
      schleierZeigen();
      seiteSperren(true);
      zuruecktreten(true);
      blase.oeffnen(menue.getBoundingClientRect().height);
      /* Der Hörer öffnet sich mit und rückt als erste Zeile an die
         Symbolspalte — erst jetzt, die Wand der Blase ist gerade
         gemessen */
      telefonSetzen(true);
    };

    const menueSchliessen = (sofort = false) => {
      if (!istOffen() && !navigation.dataset.menueAktiv) return;
      menueGewollt = false;
      telefonSetzen(false);
      delete navigation.dataset.menueOffen;
      menueknopf.setAttribute('aria-expanded', 'false');
      menueknopf.setAttribute('aria-label', 'Menü öffnen');
      knopfSpieler?.playSegments([letztesBild, 0], true);
      schleierAusblenden();
      seiteSperren(false);
      zuruecktreten(false);
      blase.schliessen(sofort);
    };

    /* Nach dem logischen Zustand, nicht nach `data-menue-offen`: Das
       Attribut kommt erst ein Bild später — ein zweiter Tipp innerhalb
       dieses Bilds öffnete sonst noch einmal statt zu schließen */
    menueknopf.addEventListener('click', () => { if (menueGewollt) menueSchliessen(); else oeffnen(); });

    /* Die Blase folgt der Höhe des Menüs Bild für Bild — beim
       Ebenenwechsel, bei Drehung des Geräts, beim Laden der Schrift. */
    new ResizeObserver(() => {
      if (!navigation.dataset.menueAktiv) return;
      blase.hoeheSetzen(menue.getBoundingClientRect().height);
    }).observe(menue);

    // Ein Tipp auf ein Ziel schließt das Menü (wie in a-27)
    menue.querySelectorAll('a.mobilmenue__punkt').forEach((a) => {
      a.addEventListener('click', () => menueSchliessen());
    });

    // Tipp auf den Schleier
    document.addEventListener('click', (e) => {
      if ((e.target as Element | null)?.closest?.('[data-menue-schleier]')) menueSchliessen();
    });

    // Escape: erst die Ebene zurück, dann das Menü zu
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !istOffen()) return;
      if (menue.dataset.ebene) { ebeneSetzen(false); knopfLeistungen?.focus(); return; }
      menueSchliessen();
      menueknopf.focus();
    });

    // Fokus verlässt die Navigation (Tastatur)
    navigation.addEventListener('focusout', (e) => {
      const z = e.relatedTarget as Node | null;
      if (z && !navigation.contains(z) && istOffen()) menueSchliessen();
    });

    // Beim Seitenwechsel zu — noch vor dem Tausch, damit die Sperre an
    // der Wurzel nicht mit dem neuen Dokument verloren geht
    document.addEventListener('astro:before-preparation', () => menueSchliessen());

    // Wird das Fenster breiter als ein Handy, gibt es das Menü nicht mehr:
    // sofort zu, ohne Bewegung — die Form misst das dann versteckte Logo
    window.matchMedia('(max-width: 991px)').addEventListener('change', (e) => {
      if (!e.matches) menueSchliessen(true);
    });
  }

  navigationAufbauen();
  document.addEventListener('astro:page-load', navigationAufbauen);
</script>
