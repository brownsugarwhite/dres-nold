  /* ---------- Zustand „gescrollt" ----------
     Gesetzt vom Skript, sobald der Startbereich verlassen wird. */
  :global(body[data-gescrollt]) .kontaktzeile { height: 0; }
  :global(body[data-gescrollt]) .kopfleiste { height: 80px; }
  :global(body[data-gescrollt]) .fussleiste-huelle { transform: translateY(110px); }

  /* ---------- Punkte als Trenner ---------- */
  /* .dot.dot-bottom der Vorlage: in der Hausfarbe, 24 px angehoben —
     damit sitzen sie auf Höhe der Symbole, nicht der Beschriftung */
  .punkt.punkt--fuss {
    align-self: center;
    margin-bottom: 24px;
    background: var(--farbe-primaer);
  }

  /* .dot: 3 × 3 px. In der Vorlage schwarz — das sprang neben der
     Aubergine heraus. Jetzt der leiseste Ton der Farbfamilie: ein
     Trennzeichen, kein Text (Handoff, 17. September 2026). */
  .punkt {
    flex: none;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    /* Dieselbe Hausfarbe wie die Punkte zwischen den Symbolen unten —
       oben und unten sollen gleich aussehen (Florian, 18. September
       2026). Zwischendurch stand hier der leiseste Ton der Familie. */
    background: var(--farbe-primaer);
  }

  /* ---------- Kleine Bildschirme (Umbruchpunkt der Vorlage) ---------- */
  @media (max-width: 991px) {
    .fussleiste__inhalt { width: 90%; }

    /* Derselbe Seitenrand wie überall sonst — vorher standen Straße und
       E-Mail dicht an der Kante (Florian, 18. September 2026). */
    .kontaktzeile__inhalt {
      width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-leiste));
    }

    /* Dieselbe Breite wie die Liste im Aufklappmenü darunter */
    .kopfleiste__inhalt {
      width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    }

    /* Auf Handys die kurze Leiste statt der langen */
    .fussleiste__inhalt--gross { display: none; }
    .fussleiste__inhalt--klein { display: flex; }

    /* Ohne Telefonnummer — die steht als Pille in der Kopfleiste und
       unten als eigener Knopf */
    .punkt--ab-tablet,
    .kontaktzeile__text--ab-tablet { display: none; }

    /* Statt der Menüpunkte: Logo mit Menü-Knopf */
    .kopfleiste__mobil { display: flex; }
    .logo--desktop,
    .kopfleiste__rechts { display: none; }

  }

  /* Schmale Handys: die Kontaktzeile muss in eine Zeile passen; die
     drei Knöpfe unten teilen sich die Breite gleichmäßig (Vorlage:
     `.nav-bottom-button { flex: 1 }`), so stehen die Punkte genau
     zwischen den Symbolen */
  @media (max-width: 479px) {
    .kontaktzeile__inhalt { gap: var(--abstand-2xs); }
    .kontaktzeile__text { font-size: var(--text-xs); }
    .fussleiste__inhalt { width: 94%; }
    .fussleiste__inhalt--klein .fussknopf { flex: 1; }
