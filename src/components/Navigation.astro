  }

  /* Die Oberpunkte blenden nacheinander ein, während die Blase wächst:
     von der Leiste her — unten also der letzte zuerst, oben der erste. */
  .oberpunkt {
    opacity: 0;
    transform: translateY(6px);
    transition:
