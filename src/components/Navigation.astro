---
/**
 * Navigation — Nachbau der Webflow-Vorlage.
 *
 * Zwei Leisten, die beim Scrollen die Rollen tauschen:
 *
 *   Ganz oben auf der Seite   Kontaktzeile (40 px) sichtbar,
 *                             Symbolleiste am unteren Rand sichtbar,
 *                             Kopfleiste eingefahren (Höhe 0)
 *
 *   Nach dem Scrollen         Kontaktzeile eingefahren,
 *                             Kopfleiste (80 px) ausgefahren,
 *                             Symbolleiste 110 px nach unten hinaus
 *
 * Werte aus den Abläufen `schnalz in` (a-26) und `schnalz out` (a-16):
 * 300 ms, easeOut.
 *
 * Neu gegenüber der Vorlage: Der Punkt „Leistungen" klappt als Blase
 * auf und listet die Kategorien aus leistungen.json. Das Handy-Menü
 * öffnet als dieselbe Blase, nur zum rechten Rand hin offen; die
 * Kategorien erscheinen darin als eigene Ebene (Florian, 26. September
 * 2026).
 */
import { menue as punkte } from '../content/inhalte';
import seite from '../content/seite.json';

const { praxis } = seite;
const telefonZiel = `tel:${praxis.telefon.replace(/\s/g, '')}`;

/*
  Das Menü kommt fertig aus dem Seitenaufbau (lib/aufbau.ts,
  `menueBauen`): vorn die Sprechstunden, dann jeder Block mit Menüangaben
  in der Reihenfolge der Seite. Kopfleiste und Handy-Menü zeigen genau
  diese Folge (Florian, Oktober 2026).

  Jeder Punkt mit Unterpunkten klappt als Blase auf; Unterpunkte haben
  kein Symbol, nur Hauptpunkte.
*/
type Punkt = (typeof punkte)[number];

/*
  Die Symbolleiste unten: dieselbe Folge, aber die Sprechstunden ganz
  rechts — dorthin zeigt der Zipfel der Karte (Florian, 17. Oktober 2026).
  Davor auf Handys die Telefonnummer. Wie viele Symbole stehen, hängt am
  Platz (Skript `leisteEinpassen`): Von hinten fallen Punkte weg, bis der
  Rest nicht gequetscht wirkt. Leistungen, Telefon und Sprechstunden
  bleiben immer.
*/
const telefon: Punkt = { id: 'telefon', titel: praxis.telefon, symbol: '/icons/navigation/telefon.svg', ziel: telefonZiel, unterpunkte: [] };
const zeiten = punkte.find((e) => e.id === 'zeiten');
const fussPunkte = [...punkte.filter((e) => e.id !== 'zeiten'), telefon, ...(zeiten ? [zeiten] : [])];
const IMMER = new Set(['leistungen', 'telefon', 'zeiten']);

/** Kennung des Aufklappmenüs eines Punkts — je Leiste eine eigene */
const menueId = (e: Punkt, wo: 'oben' | 'unten' | 'mobil') => `untermenue-${wo}-${e.id}`;
---

{/*
  `transition:persist`: Beim Seitenwechsel bleibt die Navigation samt
  Zustand (offenes Menü, Leistenwechsel) stehen und wird nicht neu
  aufgebaut.

  Die Übergangsnamen (`nav-oben`, `nav-unten`) stehen im CSS unten,
  nicht als `transition:name`: Astro bindet `transition:name` an eine
  Kennung, die je Seite anders ausfällt — das mitgenommene Element
  trüge nach dem Wechsel die alte Kennung und verlöre seinen Namen.
  Dann verschwämme die Leiste mit dem Rest der Seite und blitzte
  doppelt auf. Über die Klasse bleibt der Name auf jeder Seite gleich
  (styles/uebergaenge.css hält die Leisten still).
*/}
{/*
  Der Schleier hinter dem offenen Handy-Menü: weiß und weichgezeichnet
  über der ganzen Seite. Er steht AUSSERHALB der Navigation, weil deren
  Maske (`clip-path`, siehe CSS) ihn sonst mit beschnitte — und ist
  damit nicht persistiert: Das Skript fragt ihn bei Bedarf frisch ab.
*/}
<div class="menue-schleier" data-menue-schleier hidden></div>

<div class="navigation" transition:persist="navigation">
{/* Kontaktzeile — oben auf der Seite sichtbar */}
<div class="kontaktzeile" data-leiste="kontakt">
  <div class="kontaktzeile__inhalt">
    {/* Der Praxisname steht der Anschrift voran — nur auf dem Desktop,
        darunter wird die Zeile sonst zu lang (Florian, 17. September
        2026). Er steht fest im Code: `seite.json` führt allein den
        langen Namen „Dres. Nold – Zahnarztpraxis und Kieferorthopädie". */}
    <span class="kontaktzeile__text kontaktzeile__text--ab-tablet kontaktzeile__name">Praxis Dres. Nold</span>
    <span class="punkt punkt--ab-tablet" aria-hidden="true"></span>
    <span class="kontaktzeile__text">{praxis.strasse}</span>
    <span class="punkt" aria-hidden="true"></span>
    <span class="kontaktzeile__text">{praxis.plz} {praxis.ort}</span>
    <span class="punkt punkt--ab-tablet" aria-hidden="true"></span>
    <span class="kontaktzeile__text kontaktzeile__text--ab-tablet">
      <a href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>
    </span>
    <span class="punkt" aria-hidden="true"></span>
    <span class="kontaktzeile__text">
      <a href={`mailto:${praxis.email}`}><span class="kontaktzeile__mail">{praxis.email}</span></a>
    </span>
  </div>
</div>

{/* Kopfleiste — fährt beim Scrollen ein */}
<header class="kopfleiste" data-leiste="kopf">
  <nav class="kopfleiste__inhalt" aria-label="Hauptnavigation">
    {/* Auf Handys: Logo und Menü-Knopf statt der Menüpunkte */}
    <div class="kopfleiste__mobil">
      <a class="logo" href="/" aria-label={`${praxis.name} — zur Startseite`}>
        <img src="/icons/logo.svg" alt="" width="80" height="80" />
      </a>
      {/* Der Hörer — das Telefon-Symbol der Navigation, mit Kreis wie die
          Symbole im Menü. Er steht absolut in der Zeile und hat drei
          Plätze (Skript `telefonStellen`): zu rechts neben dem Punkt vor
          dem Menüknopf; allein geöffnet nur so weit links davon, dass die
          Nummer daneben Platz hat; bei offenem Menü als dessen erste
          Zeile, bündig mit den Symbolen darunter (Florian, 27. September
          und 17. Oktober 2026). */}
      <div class="kopftelefon" data-kopftelefon>
        <button
          class="kopftelefon__knopf"
          type="button"
          aria-expanded="false"
          aria-controls="kopftelefon-nummer"
          aria-label="Telefonnummer anzeigen"
          data-kopftelefonknopf
        >
          <img class="kopftelefon__symbol" src="/icons/navigation/telefon.svg" alt="" width="40" height="40" />
        </button>
        <a class="kopftelefon__nummer" id="kopftelefon-nummer" href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a>
      </div>
      <div class="kopfleiste__handyrechts">
        <span class="punkt" data-kopfpunkt aria-hidden="true"></span>
        <button
          class="menueknopf"
          type="button"
          data-menueknopf
          aria-expanded="false"
          aria-controls="mobilmenue"
          aria-label="Menü öffnen"
        >
          <span class="menueknopf__lottie" data-menuelottie aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <a class="logo logo--desktop" href="/" aria-label={`${praxis.name} — zur Startseite`}>
      <img src="/icons/logo.svg" alt="" width="80" height="80" />
    </a>

    {/* Menüpunkte und Telefonnummer stehen rechts, das Logo links —
        beide an der Inhaltsbreite ausgerichtet (Entwurf, 17. September
        2026). Vorher saß der ganze Block mittig in 700 px. */}
    <div class="kopfleiste__rechts">
    {punkte.map((e) => (
      <>
        {e.unterpunkte.length > 0 ? (
          <div class="aufklapp" data-aufklapp data-richtung="runter">
            <button class="menuepunkt menuepunkt--knopf" type="button" aria-expanded="false" aria-controls={menueId(e, 'oben')} data-ziel={e.ziel}>
              <span class="menuepunkt__rolle">
                <span class="menuepunkt__text">{e.titel}</span>
                <span class="menuepunkt__text" aria-hidden="true">{e.titel}</span>
              </span>
              {/* Kleiner Haken: zeigt, dass hier etwas aufgeht */}
              <span class="menuepunkt__pfeil" aria-hidden="true"></span>
            </button>

            <div class="aufklapp__inhalt" id={menueId(e, 'oben')} hidden>
              <span class="aufklapp__linie" aria-hidden="true"></span>

              <div class="aufklapp__spalten">
                {e.unterpunkte.map((u, i) => (
                  <a class="oberpunkt" href={u.ziel} style={`--stufe: ${i}; --stufe-hoch: ${e.unterpunkte.length - 1 - i}`}>
                    <span class="oberpunkt__text">
                      <span class="oberpunkt__titel">{u.titel}</span>
                      {u.kurz && <span class="oberpunkt__kurz">{u.kurz}</span>}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="menuepunkt" href={e.ziel}>
            <span class="menuepunkt__rolle">
              <span class="menuepunkt__text">{e.titel}</span>
              <span class="menuepunkt__text" aria-hidden="true">{e.titel}</span>
            </span>
          </a>
        )}
        <span class="punkt" aria-hidden="true"></span>
      </>
    ))}

    <a class="kn kn--klein kopfleiste__telefon" href={telefonZiel}>
      <span class="kn__f" aria-hidden="true"></span>{praxis.telefon}
    </a>
    </div>

    {/*
      Das Handy-Menü — klappt als Blase aus der Punktlinie der Kopfleiste
      auf (Skript: `mobilmenueAufbauen`, Zeichnung wie beim Aufklappmenü
      „Leistungen" auf dem Desktop). Es steht IN der Kopfleiste, damit
      es dieselbe Bezugsfläche hat wie deren Blase (`top: 100%`).

      Jede Zeile ist ein kleines Raster (`.mobilmenue__zeile`), das sich
      über die Rasterhöhe auf Null schließen lässt. So funktioniert der
      Ebenenwechsel: Ein Tipp auf „Leistungen" schließt alle anderen
      Zeilen, die Leistungen-Zeile rückt dadurch an den Kopf und wird zum
      Zurück-Knopf, und die Kategorien darunter wachsen von Null auf ihre
      Größe (Florian, 26. September 2026). Kein Akkordeon, kein
      Rollkasten: Die Liste ist kompakt genug für jedes Handy.
    */}
    <div class="mobilmenue" id="mobilmenue" data-mobilmenue hidden>
      {punkte.map((e, i) => (
        e.unterpunkte.length > 0 ? (
          <>
            <div class="mobilmenue__zeile mobilmenue__zeile--mit-unter" data-gruppe={e.id} style={`--stufe: ${i}; --stufe-hoch: ${punkte.length - 1 - i}`}>
              <div class="mobilmenue__zelle">
                <button
                  class="mobilmenue__punkt mobilmenue__punkt--knopf"
                  type="button"
                  data-ebene-knopf={e.id}
                  aria-expanded="false"
                  aria-controls={menueId(e, 'mobil')}
                >
                  {e.symbol ? <img class="mobilmenue__symbol" src={e.symbol} alt="" width="60" height="60" /> : <span class="mobilmenue__symbol symbol-leer" aria-hidden="true"></span>}
                  <span class="mobilmenue__text">{e.titel}</span>
                  <span class="mobilmenue__pfeil" aria-hidden="true"></span>
                  <span class="mobilmenue__zurueck" aria-hidden="true">Zurück</span>
                </button>
              </div>
            </div>
            {/* Die Unterpunkte: eigene Zeilen, in Ruhe auf Null geschlossen.
                `display: contents` — der Rahmen ist nur das Ziel von
                `aria-controls`, die Zeilen bleiben Kinder des Menüs.
                Die erste Zeile führt zum Hauptpunkt selbst — sonst wäre
                er auf dieser Ebene nicht erreichbar (Oktober 2026). */}
            <div class="mobilmenue__ebene" id={menueId(e, 'mobil')} role="group" aria-label={e.titel}>
              {[{ titel: `${e.titel} – Übersicht`, kurz: '', ziel: e.ziel }, ...e.unterpunkte].map((u, j) => (
                <div class="mobilmenue__zeile mobilmenue__zeile--unter" data-gruppe={e.id} style={`--stufe: ${j}`}>
                  <div class="mobilmenue__zelle">
                    <a class="mobilmenue__punkt mobilmenue__unterpunkt" href={u.ziel}>
                      <span class="mobilmenue__untertext">
                        <span class="mobilmenue__text">{u.titel}</span>
                        {u.kurz && <span class="mobilmenue__kurz">{u.kurz}</span>}
                      </span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="mobilmenue__zeile" style={`--stufe: ${i}; --stufe-hoch: ${punkte.length - 1 - i}`}>
            <div class="mobilmenue__zelle">
              <a class="mobilmenue__punkt" href={e.ziel}>
                {e.symbol ? <img class="mobilmenue__symbol" src={e.symbol} alt="" width="60" height="60" /> : <span class="mobilmenue__symbol symbol-leer" aria-hidden="true"></span>}
                <span class="mobilmenue__text">{e.titel}</span>
              </a>
            </div>
          </div>
        )
      ))}
    </div>
  </nav>
</header>
</div>

{/* Symbolleiste am unteren Rand — oben auf der Seite sichtbar */}
{/*
  Der Umschlag trägt Grund, Weichzeichner, Punktlinie und den
  Übergangsnamen (siehe CSS); die Leiste darin nur den Inhalt.
*/}
<div class="fussleiste-huelle" data-fusshuelle>
<nav class="fussleiste" data-leiste="fuss" aria-label="Schnellzugriff">
  <div class="fussleiste__inhalt" data-fussinhalt>
    {fussPunkte.map((e, i) => (
      <>
        {i > 0 && <span class="punkt punkt--fuss" aria-hidden="true" data-trenner></span>}
        {e.unterpunkte.length > 0 ? (
          <div class="aufklapp fusspunkt" data-aufklapp data-richtung="hoch" data-fusspunkt={e.id} data-immer={IMMER.has(e.id) ? '' : undefined}>
            <button class="fussknopf fussknopf--knopf" type="button" aria-expanded="false" aria-controls={menueId(e, 'unten')} data-ziel={e.ziel} data-punkt={e.id}>
              {e.symbol ? <img class="fussknopf__symbol" src={e.symbol} alt="" width="60" height="60" /> : <span class="fussknopf__symbol symbol-leer" aria-hidden="true"></span>}
              <span class="fussknopf__text">{e.titel}</span>
            </button>

            <div class="aufklapp__inhalt" id={menueId(e, 'unten')} hidden>
              <span class="aufklapp__linie" aria-hidden="true"></span>

              <div class="aufklapp__spalten">
                {e.unterpunkte.map((u, i) => (
                  <a class="oberpunkt" href={u.ziel} style={`--stufe: ${i}; --stufe-hoch: ${e.unterpunkte.length - 1 - i}`}>
                    <span class="oberpunkt__text">
                      <span class="oberpunkt__titel">{u.titel}</span>
                      {u.kurz && <span class="oberpunkt__kurz">{u.kurz}</span>}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class:list={['fussknopf', 'fusspunkt', { 'fusspunkt--handy': e.id === 'telefon' }]} href={e.ziel} data-punkt={e.id} data-fusspunkt={e.id} data-immer={IMMER.has(e.id) ? '' : undefined}>
            {e.symbol ? <img class="fussknopf__symbol" src={e.symbol} alt="" width="60" height="60" /> : <span class="fussknopf__symbol symbol-leer" aria-hidden="true"></span>}
            <span class="fussknopf__text">{e.titel}</span>
          </a>
        )}
      </>
    ))}
  </div>
</nav>
</div>

<style>
  /* ---------- Umschlag beider Leisten ----------
     Oben fixiert, volle Breite, mit Weichzeichner und der Punktlinie
     am unteren Rand — wie in der Vorlage (.nav). */
  /* Werte aus .nav der Vorlage */
  .navigation {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--ebene-navigation);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* Grund (milchiges Weiß mit Weichzeichner), Punktlinie und Übergangs-
     name liegen auf den beiden Umschlägen SELBST, nicht auf einem Kind:
     Ein Element mit Übergangsnamen bildet eine eigene Zeichenwurzel —
     ein Weichzeichner in einem Kind sähe die Seite dahinter nicht mehr,
     der eigene sieht sie.

     Offenes Aufklappmenü: Der Umschlag wächst per Innenabstand um die
     Höhe der Blase und wird per Maske (clip-path) auf „Leiste plus
     Blase" zugeschnitten. Ein Element, also keine Kante zwischen Leiste
     und Blase. Werte setzt das Skript (`--blase-hoehe`, `--blase-form`). */
  .navigation,
  .fussleiste-huelle {
    /* 74 % statt 80: Die Randverläufe darunter (styles/global.css)
       sollen eine Spur durchscheinen (Florian, 27. September 2026) */
    background: rgb(255 255 255 / 74%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .navigation {
    padding-bottom: var(--blase-hoehe, 0px);
    clip-path: var(--blase-form, inset(0 0 var(--blase-hoehe, 0px) 0));
    view-transition-name: nav-oben;
  }

  .fussleiste-huelle {
    padding-top: var(--blase-hoehe, 0px);
    clip-path: var(--blase-form, inset(var(--blase-hoehe, 0px) 0 0 0));
    view-transition-name: nav-unten;
  }

  /* Die Punktlinie: unten am Rand der Kopfleiste, oben am Rand der
     Symbolleiste — jeweils am Rand des Inhalts, nicht des Innenabstands. */
  .navigation::after,
  .fussleiste-huelle::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    height: 1px;
    background: url('/bilder/deko/punktlinie.png') 0 0 repeat-x;
    pointer-events: none;
  }

  .navigation::after { bottom: var(--blase-hoehe, 0px); }
  .fussleiste-huelle::after { top: var(--blase-hoehe, 0px); }

  /* Solange die Blase gezeichnet wird, übernimmt sie die Punktlinie */
  .navigation[data-ohne-linie]::after,
  .fussleiste-huelle[data-ohne-linie]::after { display: none; }

  .navigation > :not(.blase),
  .fussleiste-huelle > .fussleiste {
    position: relative;
    z-index: 1;
  }

  /* Alle Beschriftungen der Navigation stehen in der Überschriftenschrift
     (`--schrift-titel`, derzeit dieselbe wie der Fließtext). */
  .menuepunkt__text,
  .mobilmenue__text,
  .mobilmenue__kurz,
  .oberpunkt__titel,
  .oberpunkt__kurz,
  .fussknopf__text {
    font-weight: var(--gewicht-normal);
    font-family: var(--schrift-titel);
  }

  /* ---------- Kontaktzeile ---------- */
  .kontaktzeile {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    height: 40px;
    overflow: hidden;
    transition: height 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  /* Genau so breit wie die Symbolleiste unten: Beide rahmen den
     Startbereich und stehen als Paar. Zwischendurch lief die Zeile auf
     der vollen Inhaltsbreite und war damit deutlich breiter als die
     Leiste darunter (Florian, 18. September 2026). */
  .kontaktzeile__inhalt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(100% - 2 * var(--abstand-m), var(--breite-leiste));
    height: 40px;
  }

  /* 14 px wie die Beschriftung unter den Symbolen der Fußleiste —
     dieselbe Größe, damit die beiden Leisten zusammengehören. */
  .kontaktzeile__text {
    display: flex;
    align-items: center;
    color: var(--farbe-primaer);
    font-family: var(--schrift-titel);
    font-size: 14px;
    font-weight: var(--gewicht-normal);
    white-space: nowrap;
  }

  /* Der Name trägt die Zeile — halbfett, damit er sich von den Angaben
     dahinter absetzt. */
  .kontaktzeile__name { font-weight: var(--gewicht-halbfett); }

  .kontaktzeile__text a {
    color: inherit;
    text-decoration: none;
  }

  /* Keine Unterstreichung beim Zeigen — die Zeile soll ruhig bleiben.
     Nur die E-Mail-Adresse reagiert, und zwar mit einem kleinen
     Aufziehen statt mit einem Strich. */
  .kontaktzeile__mail {
    display: inline-block;
    font-weight: var(--gewicht-mittel);
    transform-origin: center;
    transition: transform var(--dauer-schnell) var(--verlauf);
  }

  .kontaktzeile__text a:hover .kontaktzeile__mail,
  .kontaktzeile__text a:focus-visible .kontaktzeile__mail {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .kontaktzeile__mail { transition: none; }
    .kontaktzeile__text a:hover .kontaktzeile__mail,
    .kontaktzeile__text a:focus-visible .kontaktzeile__mail { transform: none; }
  }

  /* ---------- Kopfleiste ---------- */
  .kopfleiste {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    height: 0;
    overflow: hidden;
    transition: height 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  /* Aufklappmenü und Handy-Menü ragen aus der Leiste heraus — solange
     eines offen ist, darf sie den Überlauf nicht beschneiden. */
  .navigation:is([data-menue-aktiv], :has(.aufklapp[data-aktiv])) .kopfleiste { overflow: visible; }

  .fussleiste-huelle:has(.aufklapp[data-aktiv]),
  .fussleiste:has(.aufklapp[data-aktiv]) { overflow: visible; }



  /* Logo links, Menü und Telefonnummer rechts — auf der Inhaltsbreite,
     wie jeder andere Abschnitt der Seite. */
  .kopfleiste__inhalt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    height: 80px;
  }

  /* 20 px zwischen Punkten und Trennern — auf schmalen Desktops bis
     herab auf 12 px: Mit sieben Menüpunkten (seit der Dentosophie,
     Oktober 2026) wurde es bei 992 px sonst zu eng für das Logo daneben
     (gemessen: 871 px Bedarf bei 893 px Platz). Ab etwa 1100 px steht
     alles wie bisher. */
  .kopfleiste__rechts {
    display: flex;
    align-items: center;
    gap: clamp(12px, calc((100vw - 992px) * 0.08 + 12px), 20px);
  }

  /* Die Telefonnummer steht als Knopf ganz außen — mit etwas mehr Luft
     zum letzten Menüpunkt als zwischen den Punkten selbst. */
  .kopfleiste__telefon { margin-left: 4px; white-space: nowrap; }

  /* Handys: rechts der Punkt und der Menüknopf; der Hörer steht
     absolut in der Zeile (siehe Markup) */
  .kopfleiste__handyrechts {
    display: flex;
    align-items: center;
    gap: var(--abstand-s);
  }

  /* Der Punkt tritt zurück, sobald der Hörer geöffnet ist — dann hängt
     er nicht mehr am Menüknopf */
  .kopfleiste__handyrechts .punkt { transition: opacity 240ms var(--verlauf); }
  .kopfleiste__mobil[data-telefon-offen] .punkt { opacity: 0; }

  /* Der Hörer: absolut, senkrecht mittig, waagerecht an `--telefon-x`
     (Skript). Bis das Skript den ersten Platz gemessen hat, hängt er
     rechts vor Punkt und Menüknopf. Der Platz wechselt weich. */
  .kopftelefon {
    position: absolute;
    top: 50%;
    right: calc(50px + 2 * var(--abstand-s) + 3px);
    display: flex;
    align-items: center;
    transform: translateY(-50%);
    transition: left 420ms var(--verlauf-betont);
  }

  .kopftelefon[data-gestellt] {
    right: auto;
    left: var(--telefon-x, 0px);
  }

  /* 40-px-Symbol wie im Menü, in einer 44-px-Tippfläche */
  .kopftelefon__knopf {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .kopftelefon__symbol {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  /* Die Nummer liegt zusammengeschoben hinter dem Hörer (Breite 0) und
     bekommt beim Öffnen ihre gemessene Breite (`--nummer-breite`, setzt
     das Skript). Schrift wie die Menüpunkte. `visibility` nimmt den
     Verweis aus der Tab-Reihenfolge, solange er nicht zu sehen ist. */
  .kopftelefon__nummer {
    display: block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    color: var(--farbe-primaer);
    font-size: 17px;
    font-weight: var(--gewicht-normal);
    text-decoration: none;
    white-space: nowrap;
    /* Der Abstand zum Hörer kommt erst mit der Nummer — zu hätte die
       Gruppe sonst 12 px unsichtbaren Zwischenraum */
    margin-left: 0;
    transition:
      max-width 420ms var(--verlauf-betont),
      margin-left 420ms var(--verlauf-betont),
      opacity 240ms var(--verlauf),
      visibility 0s linear 420ms;
  }

  .kopftelefon[data-offen] .kopftelefon__nummer {
    max-width: var(--nummer-breite, 140px);
    margin-left: var(--abstand-xs);
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s, 120ms, 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .kopftelefon,
    .kopftelefon__nummer,
    .kopfleiste__handyrechts .punkt { transition: none; }
  }

  /* .nav-buttons-mobile / -desktop: beide 80 px hoch.
     Logo ganz links, Menüknopf ganz rechts — und weil die Zeile so breit
     ist wie die Liste im Aufklappmenü, steht das Logo genau über deren
     Symbolen (Florian, 18. September 2026). */
  /* 72 px hoch, das Logo 68 (Florian, 27. September 2026; vorher 80
     und 80 wie auf dem Desktop) */
  .kopfleiste__mobil {
    position: relative;
    display: none;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 72px;
    overflow: hidden;
  }

  .kopfleiste__mobil .logo img {
    width: 68px;
    height: 68px;
  }

  /* .lottie-animation-3: 50 × 50 */
  .menueknopf {
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menueknopf__lottie {
    display: block;
    width: 50px;
    height: 50px;
    /* Rückfall ohne Lottie: drei Striche */
    background:
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 14px / 26px 2px no-repeat,
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 24px / 26px 2px no-repeat,
      linear-gradient(var(--farbe-primaer), var(--farbe-primaer)) center 34px / 26px 2px no-repeat;
  }

  .menueknopf__lottie[data-lottie-bereit] { background: none; }

  /* ---------- Handy-Menü ----------
     Klappt als Blase aus der Punktlinie der Kopfleiste auf — dieselbe
     Zeichnung und Bewegung wie das Aufklappmenü „Leistungen" auf dem
     Desktop (`blaseAnlegen` im Skript), nur mit anderer Form: Der Teil
     der Linie unter dem Logo bleibt oben, rechts davon senkt sie sich
     in eine senkrechte Wand, und die Blase ist zum rechten Rand hin
     offen (Florian, 26. September 2026). Das Menü selbst ist nur der
     Inhalt darin; die Maske am Umschlag (`clip-path`) gibt ihn frei,
     während die Blase wächst.

     Vorher klappte es über die Rasterhöhe auf (0fr → 1fr) und rollte
     bei Platzmangel in einem Rahmen. Beides ist weg: Die Blase bringt
     die Bewegung mit, und die Liste ist kompakt genug für jedes Handy —
     die Hauptliste braucht 452 px samt Kopfleiste, die Ebene
     „Leistungen" noch weniger. */
  .mobilmenue {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: var(--ebene-menue);
    display: flex;
    flex-direction: column;
    /* Links beginnt die Spalte unter dem Hörer in der Kopfleiste
       (`--menue-spalte`, vom Skript gemessen: mittig zwischen Logo und
       Kreuz, aber höchstens 40 px von der Wand der Blase — Florian,
       27. September und 17. Oktober 2026); ohne Messung an der Wand der
       Blase (`--menue-wand`) plus Luft. Rechts der Seitenrand. */
    padding: var(--abstand-2xs) var(--abstand-seitenrand) var(--abstand-s)
             var(--menue-spalte, calc(var(--menue-wand, var(--abstand-seitenrand)) + var(--abstand-m)));
  }

  .mobilmenue[hidden] { display: none; }

  /* Der Rahmen um die Kategorien ist nur das Ziel von `aria-controls` */
  .mobilmenue__ebene { display: contents; }

  /*
    Jede Zeile ein Raster, das sich über die Rasterhöhe schließen lässt
    (1fr → 0fr) — so braucht der Ebenenwechsel unten keine festen Höhen.
    Die Zeile trägt außerdem das Einfahren beim Öffnen des Menüs: leicht
    von oben, dabei aufblendend, jede eine Spur später als die davor;
    beim Schließen rückwärts (`--stufe-hoch` zählt von unten), deshalb
    steht die Schließ-Verzögerung im Grundzustand.

    Die Zeilen stehen genau untereinander — die Wand der Blase läuft
    senkrecht wie beim Aufklappmenü auf dem Desktop; die Neigung aus
    Florians erstem Entwurf ist zurückgenommen (26. September 2026).
  */
  .mobilmenue__zeile {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 0;
    transform: translateY(-10px);
    transition-property: grid-template-rows, opacity, transform;
    transition-duration: 320ms, 260ms, 260ms;
    transition-timing-function: var(--verlauf-betont);
    /* Die Rasterhöhe läuft in JEDER Zeile und JEDEM Zustand gleich:
       320 ms, ohne Verzögerung. Nur dann geht die Summe aller Zeilen —
       und mit ihr die Blase — beim Ebenenwechsel in einer Bewegung von
       der alten zur neuen Höhe, statt erst zu sinken und dann zu wachsen
       (Florian, 26. September 2026). Gestaffelt ist allein der Inhalt
       der Zellen. */
    transition-delay: 0ms, calc(var(--stufe-hoch, 0) * 45ms), calc(var(--stufe-hoch, 0) * 45ms);
  }

  .navigation[data-menue-offen] .mobilmenue__zeile {
    opacity: 1;
    transform: none;
    transition-duration: 320ms, 420ms, 420ms;
    transition-delay: 0ms, calc(60ms + var(--stufe, 0) * 45ms), calc(60ms + var(--stufe, 0) * 45ms);
  }

  /* Die Zelle trägt Inhalt und Haarlinie — beides verschwindet mit der
     Zeile, statt dass die Linie als Doppelstrich stehen bliebe. Beim
     Schrumpfen zieht sie sich zusätzlich in die linke obere Ecke zusammen
     und blendet aus; `visibility` nimmt die Verweise dabei aus der
     Tab-Reihenfolge, sobald sie unsichtbar sind. */
  .mobilmenue__zelle {
    min-height: 0;
    overflow: hidden;
    /* Vom linken Rand, senkrecht mittig: Die Zeile schrumpft in Höhe
       UND Breite auf nichts und wächst von dort wieder (Florian,
       27. September 2026; vorher nur die Höhe, dann die linke obere
       Ecke) */
    transform-origin: 0 50%;
    transition-property: opacity, transform, visibility, border-color;
    transition-duration: 320ms, 320ms, 0s, 320ms;
    transition-timing-function: var(--verlauf-betont), var(--verlauf-betont), linear, var(--verlauf-betont);
    transition-delay: 120ms, 120ms, 0s, 0s;
  }

  /* Eine Haarlinie ÜBER jeder Zeile — auch über der ersten: Darüber
     steht in der Kopfleiste der Hörer als erste „Zeile" des Menüs
     (Florian, 27. September 2026). Unter der letzten Zeile keine. Die
     Kategorien-Zeilen zeigen ihre Linie nur auf ihrer Ebene (unten),
     die Hauptzeilen nur auf der Hauptebene — sonst blieben von den
     geschlossenen Zeilen Linien übrig, oder es fehlte die unter
     „Leistungen". */
  .mobilmenue__zelle {
    border-top: 1px solid var(--farbe-linie-leise);
  }

  .mobilmenue__zeile--unter .mobilmenue__zelle { border-top-color: transparent; }

  /* ---- Ebene „Leistungen" ----
     Ein Tipp auf „Leistungen" schließt alle anderen Zeilen; die
     Leistungen-Zeile rückt allein durch das Nachrücken des Rasters an
     den Kopf — in derselben Kurve und Dauer — und bleibt dort als
     Zurück-Knopf stehen. Die Kategorien-Zeilen wachsen im selben Takt
     von Null (Summe der Höhen: eine Bewegung, siehe oben); ihr Inhalt
     kommt gestaffelt nach (ab 80 ms, je 50 ms später). Zurück
     spiegelbildlich: Der Inhalt der Kategorien blendet sofort aus, die
     Zeilen tauschen ihre Höhen im Gleichtakt. (Florian, 26. September
     2026) */
  .mobilmenue__zeile--unter {
    grid-template-rows: 0fr;
    transition-duration: 320ms, 260ms, 260ms;
    transition-delay: 0ms;
  }

  .mobilmenue__zeile--unter .mobilmenue__zelle {
    opacity: 0;
    transform: scale(0);
    visibility: hidden;
    transition-duration: 260ms, 260ms, 0s, 260ms;
    transition-delay: 0ms, 0ms, 260ms, 0ms;
  }

  .mobilmenue[data-ebene] .mobilmenue__zeile:not([data-gewaehlt]) {
    grid-template-rows: 0fr;
    transition-delay: 0ms;
  }

  .mobilmenue[data-ebene] .mobilmenue__zeile:not([data-gewaehlt]) .mobilmenue__zelle {
    opacity: 0;
    transform: scale(0);
    visibility: hidden;
    transition-delay: 0ms, 0ms, 320ms, 0ms;
  }

  .mobilmenue[data-ebene] .mobilmenue__zeile--unter[data-gewaehlt] {
    grid-template-rows: 1fr;
    transition-duration: 320ms, 320ms, 320ms;
    transition-delay: 0ms;
  }

  .mobilmenue[data-ebene] .mobilmenue__zeile--unter[data-gewaehlt] .mobilmenue__zelle {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-duration: 320ms, 320ms, 0s, 320ms;
    transition-delay: calc(80ms + var(--stufe, 0) * 50ms), calc(80ms + var(--stufe, 0) * 50ms), 0s, 0s;
  }

  /* Auf der Ebene „Leistungen": Linien an den Kategorien, keine an den
     geschlossenen Hauptzeilen; „Leistungen" selbst behält seine Linie
     zum Hörer darüber */
  .mobilmenue[data-ebene] .mobilmenue__zeile--unter[data-gewaehlt] .mobilmenue__zelle {
    border-top-color: var(--farbe-linie-leise);
  }

  .mobilmenue[data-ebene] .mobilmenue__zeile:not([data-gewaehlt]) .mobilmenue__zelle {
    border-top-color: transparent;
  }

  .mobilmenue__punkt {
    display: flex;
    align-items: center;
    gap: var(--abstand-xs);
    padding: 9px 0;
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  /* Kleiner als in der unteren Leiste — so passt die ganze Liste auf
     jedes Handy, ohne dass man im Menü rollen muss (Florian,
     18. September 2026; seit dem 26. September noch eine Stufe
     kompakter). */
  .mobilmenue__symbol {
    flex: none;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  /* Ein Hauptpunkt ohne eigenes Symbol: ein leerer Kreis an seiner
     Stelle, damit die Zeilen und Knöpfe bündig bleiben */
  .symbol-leer {
    display: block;
    box-sizing: border-box;
    border: 1px solid var(--farbe-primaer);
    border-radius: 50%;
  }

  .mobilmenue__text {
    font-size: 17px;
    font-weight: var(--gewicht-normal);
    line-height: 1.2;
  }

  .mobilmenue__punkt--knopf {
    position: relative;
    width: 100%;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* Der Haken rechts: Auf der Ebene „Leistungen" dreht er nach links
     und rückt ein Stück ein, dahinter blendet „Zurück" auf — aus dem
     Menüpunkt wird der Zurück-Knopf. */
  .mobilmenue__pfeil {
    flex: none;
    /* 15 × 9: Der Kasten trägt den Rand der Zeichnung mit, der sichtbare
       Haken bleibt 13 px breit (siehe pfeil-runter.svg). */
    width: 15px;
    height: 9px;
    margin-left: auto;
    margin-right: var(--abstand-2xs);
    background: url('/icons/ui/pfeil-runter.svg') center / contain no-repeat;
    transition:
      transform 320ms var(--verlauf-betont),
      margin-right 320ms var(--verlauf-betont);
  }

  .mobilmenue__punkt--knopf[aria-expanded='true'] .mobilmenue__pfeil {
    transform: rotate(90deg);
    margin-right: 62px;
  }

  .mobilmenue__zurueck {
    position: absolute;
    right: var(--abstand-2xs);
    top: 50%;
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
    opacity: 0;
    transform: translate(8px, -50%);
    transition:
      opacity 320ms var(--verlauf-betont),
      transform 320ms var(--verlauf-betont);
  }

  .mobilmenue__punkt--knopf[aria-expanded='true'] .mobilmenue__zurueck {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* Die Kategorien stehen ein Stück eingerückt — als Unterpunkte
     lesbar, ohne abgehängt zu wirken */
  .mobilmenue__zeile--unter { margin-left: 22px; }

  /* Ohne Symbole brauchen die Unterpunkte mehr Luft untereinander
     (Florian, 17. Oktober 2026: 12 statt 8 px) */
  .mobilmenue__unterpunkt {
    gap: var(--abstand-xs);
    padding: var(--abstand-xs) 0;
  }

  .mobilmenue__untertext { display: flex; flex-direction: column; }
  .mobilmenue__kurz { color: var(--farbe-text-gedeckt); font-size: var(--text-s); font-weight: var(--gewicht-normal); line-height: 1.35; }

  /* Der Schleier hinter dem offenen Menü (Element vor `.navigation`):
     die ganze Seite weiß und weichgezeichnet, wie hinter der
     Hinweis-Karte. Unter den Leisten, über allem Inhalt. Ein Tipp
     darauf schließt das Menü. */
  :global(.menue-schleier) {
    position: fixed;
    inset: 0;
    z-index: calc(var(--ebene-navigation) - 1);
    background: var(--farbe-schleier-hell);
    /* Die Seite dahinter wird selbst unscharf und tritt zurück
       (styles/global.css, `html[data-menue-unscharf]`). Der Startbereich
       mit dem Logo ist davon ausgenommen — ein Weichzeichner an ihm
       zeichnete den Saum um den Verlauf. Für ihn bleibt der
       Rückseiten-Weichzeichner am Schleier (Florian, 27. September
       2026). */
    backdrop-filter: blur(var(--weichzeichner-schleier));
    -webkit-backdrop-filter: blur(var(--weichzeichner-schleier));
    opacity: 0;
    transition: opacity var(--dauer-normal) var(--verlauf);
  }

  :global(.menue-schleier[data-sichtbar]) { opacity: 1; }
  :global(.menue-schleier[hidden]) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .mobilmenue__zeile,
    .mobilmenue__zelle,
    .mobilmenue__pfeil,
    .mobilmenue__zurueck { transition: none; }
  }

  .logo img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    transition: transform 0.5s var(--verlauf-betont);
  }

  .logo:hover img,
  .logo:focus-visible img { transform: scale(1.05); }

  @media (prefers-reduced-motion: reduce) {
    .logo img,
    .fussknopf__symbol,
    .fussknopf__text { transition: none; }
    .menuepunkt__pfeil { transition: none; }
    .logo:hover img,
    .fussknopf:hover .fussknopf__symbol,
    .fussknopf:hover .fussknopf__text { transform: none; }
  }

  /* ---------- Menüpunkte mit Text-Roll ----------
     Zwei identische Texte übereinander; beim Zeigen rollt der Block
     um genau eine Höhe hoch. Aus Ablauf a-18.

     Wichtig: Die Vorlage kennt KEIN Hover-Out. Der Ablauf rollt hoch und
     springt danach in 0 ms auf den Anfang zurück — unsichtbar, weil beide
     Texte gleich sind. Beim Verlassen läuft also nichts zurück.

     Die Rolle hängt nicht mehr an `:hover`, sondern an `data-rollt`
     (Skript: `rollenAufbauen`): Das Attribut kommt beim Betreten und
     geht erst am Ende der Animation. Eine `:hover`-Animation brach ab,
     sobald der Zeiger den Punkt verließ — der Text sprang zurück, und
     das wirkte hektisch (Florian, 26. September 2026). */
  .menuepunkt {
    display: block;
    height: 80px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--farbe-primaer);
    font: inherit;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
  }

  /*
    Der Haken am Menüpunkt „Leistungen": Er steht absolut UNTER dem
    Wort, auf dessen Mitte — nicht daneben (Florian, 18. September
    2026). Absolut deshalb, weil der Text beim Zeigen um 80 px hoch
    rollt (`.menuepunkt__rolle`); im Fluss rollte der Haken mit und
    wäre weg.

    Er steht damit auf derselben Senkrechten wie der Pfeil der Blase
    und die Symbole darin — siehe `zeichnen()` im Skript unten.
  */
  .menuepunkt--knopf {
    position: relative;
  }

  .menuepunkt__pfeil {
    position: absolute;
    left: 50%;
    bottom: 17px;
    /* 12 × 7 samt Rand der Zeichnung — sichtbar ist der Haken 10 px breit */
    width: 12px;
    height: 7px;
    margin-left: -6px;
    background: url('/icons/ui/pfeil-runter.svg') center / contain no-repeat;
    transition:
      opacity 320ms var(--verlauf-ruhig),
      transform 320ms var(--verlauf-ruhig);
  }

  /*
    Beim Öffnen wird aus diesem Haken der Pfeil der Blase: Er sinkt ab
    und blendet aus, während der andere ein paar Bildpunkte tiefer
    aufblendet (`blaseAnlegen` im Skript). Ein Drehen an Ort und Stelle wäre das
    Gegenteil davon (Florian, 18. September 2026).
  */
  .menuepunkt--knopf[aria-expanded='true'] .menuepunkt__pfeil {
    opacity: 0;
    transform: translateY(8px);
  }

  .menuepunkt__rolle {
    display: flex;
    flex-direction: column;
  }

  @keyframes menue-rolle {
    to { transform: translateY(-80px); }
  }

  .menuepunkt__text {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80px;
    flex: none;
    font-size: var(--text-s);
    font-weight: var(--gewicht-normal);
  }

  /* Einmal hoch, kein Zurückrollen. Ruhig an- und auslaufend und
     gemächlicher als die 300 ms der Vorlage (Florian, 17. Oktober 2026:
     420 ms mit der betonten Kurve waren zu hektisch) */
  .menuepunkt[data-rollt] .menuepunkt__rolle {
    animation: menue-rolle 750ms var(--verlauf-ruhig);
  }

  /* Solange das Aufklappmenü offen ist, steht der Text still oben —
     aber erst, wenn eine laufende Rolle zu Ende ist: Sie endet ohnehin
     genau dort. Vorher tötete `animation: none` hier die gerade
     gestartete Rolle, und der Text sprang. */
  .aufklapp[data-offen] .menuepunkt:not([data-rollt]) .menuepunkt__rolle {
    transform: translateY(-80px);
  }

  /* Tastatur: kein Rollen, dafür eine sichtbare Fokuslinie */
  .menuepunkt:focus-visible {
    outline: 2px solid var(--farbe-primaer);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .menuepunkt[data-rollt] .menuepunkt__rolle { animation: none; }
    .menuepunkt__pfeil { transition: none; }
  }

  /* ---------- Aufklappmenü („Blase") ----------
     Die Punktlinie der Leiste wölbt sich zu einem abgerundeten Feld
     auf — nach oben aus der Symbolleiste, nach unten aus der Kopfleiste.
     Gezeichnet wird das als SVG (Skript unten: `blaseAnlegen`), das
     Feld selbst ist nur der Inhalt darüber. */
  .aufklapp {
    position: relative;
  }

  .aufklapp__inhalt {
    position: absolute;
    left: 0;
    z-index: var(--ebene-menue);
    /* So breit wie der längste Unterpunkt, höchstens 400 px — die Blase
       misst nach (Skript `geometrie`) */
    width: max-content;
    min-width: 220px;
    max-width: min(400px, 100vw - 2rem);
    padding: 26px 36px;
  }

  /* Untere Leiste: das Feld steht über der Leiste; obere: darunter.
     Jeweils Platz für den kleinen Pfeil an der Grundlinie. */
  .aufklapp[data-richtung='hoch'] .aufklapp__inhalt { bottom: 100%; padding-bottom: 40px; }
  .aufklapp[data-richtung='runter'] .aufklapp__inhalt { top: 100%; padding-top: 40px; }

  .aufklapp__inhalt[hidden] { display: none; }

  /* Die Wölbung: ein milchiger Grund wie die Leisten selbst (weiß mit
     Weichzeichner dahinter), auf die Form der Blase zugeschnitten —
     darüber die gestrichelte Linie als SVG. Beides liegt über die volle
     Breite auf der Punktlinie der Leiste; Maße setzt das Skript. */
  :global(.blase) {
    position: absolute;
    left: 0;
    display: block;
    pointer-events: none;
  }

  :global(.blase) {
    z-index: calc(var(--ebene-menue) - 1);
    overflow: visible;
  }

  /* Wie punktlinie.png: 1 px Punkt, 2 px Lücke, gleiche Farbe */
  :global(.blase__linie) {
    fill: none;
    stroke: var(--farbe-punktlinie);
    stroke-width: 1;
    stroke-dasharray: 1 2;
  }

  /*
    Derselbe Haken wie unter „Leistungen" — nur größer.

    Er war vorher dünner (1 statt 1,5), hatte runde Enden und einen
    flacheren Winkel (104° statt 90°). Neben den übrigen Pfeilen der
    Seite wirkte seine Spitze dadurch stumpf (Florian, 18. September
    2026). Jetzt stimmen Strichstärke, Winkel und Enden mit
    `icons/ui/pfeil-runter.svg` überein; die Spitze ist ein spitzer
    Gehrungsstoß, kein abgerundeter.
  */
  :global(.blase__pfeil) {
    fill: none;
    stroke: var(--farbe-punktlinie);
    stroke-width: 1.5;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    stroke-miterlimit: 10;
  }

  /* Die Oberpunkte blenden nacheinander ein, während die Blase wächst:
     von der Leiste her — unten also der letzte zuerst, oben der erste. */
  .oberpunkt {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 320ms var(--verlauf-betont),
      transform 320ms var(--verlauf-betont),
      background-color var(--dauer-schnell) var(--verlauf);
    transition-delay: calc(160ms + var(--stufe, 0) * 80ms), calc(160ms + var(--stufe, 0) * 80ms), 0ms;
  }

  .aufklapp[data-richtung='hoch'] .oberpunkt {
    transform: translateY(-6px);
    transition-delay: calc(160ms + var(--stufe-hoch, 0) * 80ms), calc(160ms + var(--stufe-hoch, 0) * 80ms), 0ms;
  }

  .aufklapp[data-offen] .oberpunkt {
    opacity: 1;
    transform: translateY(0);
  }

  /* Kommt die Blase von einem anderen Menüpunkt herüber, ist sie schon
     offen — die Unterpunkte laufen früher und dichter ein, während die
     Form noch wandert */
  .aufklapp[data-uebergabe] .oberpunkt {
    transition-delay: calc(60ms + var(--stufe, 0) * 60ms), calc(60ms + var(--stufe, 0) * 60ms), 0ms;
  }

  /* Beim Schließen sofort weg, ohne Staffelung */
  .aufklapp:not([data-offen]) .oberpunkt { transition-delay: 0ms; transition-duration: 120ms; }

  @media (prefers-reduced-motion: reduce) {
    .oberpunkt { transition: none; opacity: 1; transform: none; }
  }

  .aufklapp__spalten {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Ein Oberpunkt je Unterpunkt — Titel, darunter der Kurztext.
     Symbole tragen nur die Hauptpunkte (Florian, Oktober 2026). */
  .oberpunkt {
    display: flex;
    align-items: center;
    gap: 14px;
    /* Die Luft steckt jetzt im Eintrag selbst statt im Abstand
       dazwischen — so wächst auch die Fläche, die auf das Zeigen
       reagiert, und die Einträge stehen ruhiger beieinander. */
    padding: 10px 12px;
    margin: 0 -12px;
    border-radius: var(--radius-m);
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  /* Ein leises Grau — Weiß war auf dem milchigen Grund nicht zu sehen
     (Florian, 17. Oktober 2026) */
  .oberpunkt:hover,
  .oberpunkt:focus-visible { background: var(--farbe-flaeche-gedeckt); }


  .oberpunkt__text {
    display: flex;
    flex-direction: column;
  }

  .oberpunkt__text {
    gap: 2px;
  }

  .oberpunkt__titel {
    font-size: var(--text-m);
    font-weight: var(--gewicht-halbfett);
    line-height: 1.25;
  }

  .oberpunkt__kurz {
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
    font-weight: var(--gewicht-normal);
    line-height: 1.35;
  }

  /* ---------- Symbolleiste unten ---------- */
  /* .nav-bottom: fest am unteren Rand, Punktlinie oben */
  .fussleiste-huelle {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--ebene-navigation);
    width: 100%;
    transition: transform 300ms cubic-bezier(0, 0, 0.58, 1);
  }

  .fussleiste {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  /* .nav-bottom-wrapper: feste Breite 700px, Höhe 110px */
  /* Die Leiste war mit festen 700 px eng getaktet. Jetzt darf sie bis
     980 px atmen und staucht sich auf schmalen Fenstern von selbst.
     Zipfel und Aufklappmenue richten sich nach der gemessenen Knopfmitte
     (Oeffnungszeiten.astro `vermessen()`, Navigation `zeichnen()`) und
     wandern deshalb automatisch mit. */
  .fussleiste__inhalt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* Dieselbe Breite wie die Kontaktzeile oben — siehe dort */
    width: min(100% - 2 * var(--abstand-m), var(--breite-leiste));
    height: 110px;
  }

  /* Was nicht passt, blendet `leisteEinpassen` aus — samt Trenner */
  .fussleiste .fussleiste__inhalt > [data-weg][data-weg] { display: none; }

  /* Die Telefonnummer steht unten nur auf Handys; auf dem Desktop steht
     sie als Pille in der Kopfleiste */
  .fussleiste__inhalt > .fusspunkt--handy,
  .fussleiste__inhalt > .punkt--fuss:has(+ .fusspunkt--handy) { display: none; }

  .fussknopf--knopf {
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  /* Über die volle Leistenhöhe, damit das Aufklappfeld bündig an der
     Punktlinie der Leiste ansetzt und die Linie von dort losfährt */
  .fussleiste .aufklapp {
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  /* .nav-bottom-button: 4 px Abstand nach oben */
  .fussknopf {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    margin-top: 4px;
    color: var(--farbe-primaer);
    text-decoration: none;
  }

  /* Beim Zeigen wächst das Symbol um seine Mitte, die Beschriftung
     darunter rückt ein paar Bildpunkte nach unten (Florian,
     27. September 2026; vorher hob sich das Symbol um 4 px) */
  .fussknopf__symbol {
    transform-origin: 50% 50%;
    transition: transform 0.45s var(--verlauf-betont);
  }

  .fussknopf:hover .fussknopf__symbol,
  .fussknopf:focus-visible .fussknopf__symbol {
    transform: scale(1.1);
  }

  /* Die Beschriftung behält Farbe und Deckkraft — sie rückt nur
     (Florian, 27. September 2026; vorher blendete sie auf 65 %) */
  .fussknopf__text {
    transition: transform 0.45s var(--verlauf-betont);
  }

  .fussknopf:hover .fussknopf__text,
  .fussknopf:focus-visible .fussknopf__text {
    transform: translateY(3px);
  }

  /* .nav-bottom-button-txt: 14 px, Gewicht 400 */
  .fussknopf__text {
    color: var(--farbe-primaer);
    font-size: 14px;
    font-weight: 400;
    text-align: center;
    /* Nie umbrechen — passt ein Punkt nicht, fällt er ganz weg */
    white-space: nowrap;
  }

  /* .nav-bottom-button-icon: 60 × 60 px, 5 px Abstand nach unten */
  .fussknopf__symbol {
    width: 60px;
    height: 60px;
    margin-bottom: 5px;
    object-fit: contain;
  }

  /* Die Vorlage kennt keinen Hover-Zustand für die Symbolknöpfe;
     nur die Tastatur bekommt eine sichtbare Fokuslinie. */
  .fussknopf:focus-visible {
    outline: 2px solid var(--farbe-primaer);
    outline-offset: 2px;
    border-radius: var(--radius-s);
  }

  /* ---------- Zustand „gescrollt" ----------
     Gesetzt vom Skript, sobald der Startbereich verlassen wird. */
  :global(body[data-gescrollt]) .kontaktzeile { height: 0; }
  :global(body[data-gescrollt]) .kopfleiste { height: 80px; }
  :global(body[data-gescrollt]) .fussleiste-huelle { transform: translateY(110px); }

  /* ---------- Punkte als Trenner ---------- */
  /* .dot.dot-bottom der Vorlage: in der Hausfarbe, 24 px angehoben —
     damit sitzen sie auf Höhe der Symbole, nicht der Beschriftung */
  .punkt.punkt--fuss {
    align-self: center;
    margin-bottom: 24px;
    background: var(--farbe-primaer);
  }

  /* .dot: 3 × 3 px. In der Vorlage schwarz — das sprang neben der
     Aubergine heraus. Jetzt der leiseste Ton der Farbfamilie: ein
     Trennzeichen, kein Text (Handoff, 17. September 2026). */
  .punkt {
    flex: none;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    /* Dieselbe Hausfarbe wie die Punkte zwischen den Symbolen unten —
       oben und unten sollen gleich aussehen (Florian, 18. September
       2026). Zwischendurch stand hier der leiseste Ton der Familie. */
    background: var(--farbe-primaer);
  }

  /* ---------- Kleine Bildschirme (Umbruchpunkt der Vorlage) ---------- */
  @media (max-width: 991px) {
    .fussleiste__inhalt { width: 90%; }

    /* Derselbe Seitenrand wie überall sonst — vorher standen Straße und
       E-Mail dicht an der Kante (Florian, 18. September 2026). */
    .kontaktzeile__inhalt {
      width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-leiste));
    }

    /* Dieselbe Breite wie die Liste im Aufklappmenü darunter */
    .kopfleiste__inhalt {
      width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    }

    /* Auf Handys auch die Telefonnummer unten */
    .fussleiste__inhalt > .fusspunkt--handy { display: flex; }

    /* Gleich breite Zellen: So stehen die äußeren Symbole gleich weit vom
       Rand und die Punkte genau dazwischen (Florian, 17. Oktober 2026 —
       „Leistungen" war breiter als „Sprechstunden" schmal) */
    .fussleiste__inhalt > .fusspunkt:not([data-weg]) { flex: 1 1 0; min-width: 0; }
    .fussleiste__inhalt > .aufklapp.fusspunkt { display: flex; justify-content: center; }
    .fussleiste__inhalt > .punkt--fuss:has(+ .fusspunkt--handy) { display: block; }

    /* Ohne Telefonnummer — die steht als Pille in der Kopfleiste und
       unten als eigener Knopf */
    .punkt--ab-tablet,
    .kontaktzeile__text--ab-tablet { display: none; }

    /* Statt der Menüpunkte: Logo mit Menü-Knopf */
    .kopfleiste__mobil { display: flex; }
    .logo--desktop,
    .kopfleiste__rechts { display: none; }

  }

  /* Schmale Handys: die Kontaktzeile muss in eine Zeile passen */
  @media (max-width: 479px) {
    .kontaktzeile__inhalt { gap: var(--abstand-2xs); }
    .kontaktzeile__text { font-size: var(--text-xs); }
    .fussleiste__inhalt { width: 94%; }
  }

</style>

<script>
  import { schnalzWeg } from '../scripts/scrollwege';
  import { zuSprungmarke } from '../scripts/anker';
  import { KURVEN } from '../scripts/easing';
  import { navigate } from 'astro:transitions/client';
  /**
   * Verhalten der Navigation.
   *
   * 1. Leistenwechsel beim Scrollen: Sobald der Startbereich verlassen
   *    wird, trägt <body> die Markierung `data-gescrollt`. Alles Weitere
   *    erledigt CSS. Der Wechsel wird mit einem Puffer geschaltet, damit
   *    die Leisten an der Schwelle nicht flackern.
   *
   * 2. Aufklappmenü unter „Leistungen": öffnet per Klick, schließt per
   *    Escape, Klick nach außen oder wenn der Fokus den Bereich verlässt.
   *
   * 3. Handy-Menü: dieselbe Blase, zum rechten Rand hin offen; darin
   *    die Ebene eines Menüpunkts mit seinen Unterpunkten. Solange es offen ist,
   *    liegt ein Schleier über der Seite und sie steht still.
   *
   * 4. Die Text-Rolle der Menüpunkte läuft immer zu Ende (`data-rollt`).
   */
  /* Der Leistenwechsel hängt sich an Fenster und Dokument — das darf
     nur einmal geschehen, auch wenn Astro nach jedem Seitenwechsel
     `astro:page-load` auslöst (die Navigation selbst bleibt erhalten). */
  let leistenwechselBereit = false;

  function navigationAufbauen() {
    if (!leistenwechselBereit) {
      leistenwechselBereit = true;
      leistenwechselAufbauen();
    }
    /* Die Symbolleiste wird mit jeder Seite neu gebaut (sie steht
       außerhalb der mitgenommenen `.navigation`) — also je Seite einpassen */
    leisteEinpassenAufbauen();
    aufklappmenuesAufbauen();
    rollenAufbauen();
    mobilmenueAufbauen();
  }

  /**
   * Die Symbolleiste unten zeigt so viele Punkte, wie Platz haben, ohne
   * gequetscht zu wirken (Florian, 17. Oktober 2026). Vorher sprang sie
   * bei 991 px von allen auf drei.
   *
   * Gemessen wird die natürliche Breite jedes Punkts; dazwischen soll je
   * ein Trennpunkt mit mindestens `LUFT` Platz zu beiden Seiten stehen.
   * Passt das nicht, fällt der hinterste Punkt weg, der nicht immer
   * bleiben muss (`data-immer`: Leistungen, Telefon, Sprechstunden) —
   * so lange, bis es passt. Die Trennpunkte stehen nur zwischen
   * sichtbaren Punkten. Danach misst die Sprechstunden-Karte den Knopf
   * für ihren Zipfel neu (Ereignis `leiste:eingepasst`).
   */
  function leisteEinpassenAufbauen() {
    const inhalt = document.querySelector<HTMLElement>('[data-fussinhalt]');
    if (!inhalt || inhalt.dataset.bereit) return;
    inhalt.dataset.bereit = 'ja';
    const LUFT = 22;
    const kinder = [...inhalt.children] as HTMLElement[];
    const punkte = kinder.filter((k) => k.hasAttribute('data-fusspunkt'));
    /* Die natürliche Breite eines Punkts: Symbol oder Beschriftung, was
       breiter ist — nicht die seiner Zelle, die auf Handys gleich breit
       verteilt wird (siehe CSS „gleich breite Zellen") */
    const natur = (p: HTMLElement) => Math.max(0, ...[...p.querySelectorAll<HTMLElement>('.fussknopf__symbol, .fussknopf__text')].map((e) => e.getBoundingClientRect().width));
    const gleicheZellen = () => window.matchMedia('(max-width: 991px)').matches;

    const einpassen = () => {
      for (const k of kinder) k.removeAttribute('data-weg');
      const verfuegbar = inhalt.clientWidth;
      if (!verfuegbar) return;
      /* Was das CSS ohnehin verbirgt (Telefon auf dem Desktop), zählt nicht */
      const da = punkte.filter((p) => getComputedStyle(p).display !== 'none');
      const breite = new Map(da.map((p) => [p, natur(p)]));
      const trenner = 3 + 2 * LUFT;
      /* Gleich breite Zellen brauchen für jeden Punkt so viel Platz wie
         für den breitesten */
      const bedarf = (liste: HTMLElement[]) => gleicheZellen()
        ? liste.length * (Math.max(0, ...liste.map((p) => breite.get(p) ?? 0)) + 2 * LUFT) + Math.max(0, liste.length - 1) * 3
        : liste.reduce((n, p) => n + (breite.get(p) ?? 0), 0) + Math.max(0, liste.length - 1) * trenner;
      const sichtbar = [...da];
      while (bedarf(sichtbar) > verfuegbar) {
        const weg = [...sichtbar].reverse().find((p) => !p.hasAttribute('data-immer'));
        if (!weg) break;
        sichtbar.splice(sichtbar.indexOf(weg), 1);
      }
      for (const p of punkte) if (!sichtbar.includes(p) && da.includes(p)) {
        p.setAttribute('data-weg', '');
      }
      /* Trennpunkte nur zwischen zwei sichtbaren Punkten */
      let davor = false;
      let offen: HTMLElement | null = null;
      for (const k of kinder) {
        if (k.hasAttribute('data-trenner')) {
          k.setAttribute('data-weg', '');
          if (davor) offen = k;
          continue;
        }
        if (!sichtbar.includes(k)) continue;
        if (offen) offen.removeAttribute('data-weg');
        offen = null;
        davor = true;
      }
      window.dispatchEvent(new Event('leiste:eingepasst'));
    };

    new ResizeObserver(einpassen).observe(inhalt);
    /* Die Schrift ändert die Breiten — nach dem Laden noch einmal */
    document.fonts?.ready.then(einpassen);
    einpassen();
  }

  function leistenwechselAufbauen() {
    // ---- Leistenwechsel ----
    // In der Vorlage hängt der Wechsel an einem eigenen unsichtbaren
    // Streifen (`.trigger-schnalz`, 250vh ab Dokumentanfang): sobald er
    // oben aus dem Bild läuft, fährt die untere Leiste weg und die obere
    // ein (Abläufe a-26 / a-16). Das ist deutlich später als das
    // Einrasten der Öffnungszeiten — die Blase steht also schon eine
    // Weile, bevor die Leisten tauschen.

    let gescrollt = document.body.hasAttribute('data-gescrollt');
    let geplant = false;

    /* Ab welcher Scrolltiefe die Leisten tauschen: sobald der Zipfel der
       Sprechstunden beginnt, sich einzuziehen (scripts/scrollwege.ts) */
    const schwelle = () => schnalzWeg() * window.innerHeight;

    /** Gehört zu dieser Scrolltiefe der gescrollte Zustand? */
    const gescrolltBei = (y: number, startseite: boolean) =>
      // Unterseiten (Leistung, Beitrag, Rechtliches) haben keinen
      // Logobereich: dort steht von Anfang an die Kopfleiste mit dem
      // Menü, die Symbolleiste bleibt eingefahren.
      startseite ? y > schwelle() : true;

    const pruefen = () => {
      geplant = false;
      const sollGescrollt = gescrolltBei(window.scrollY, !!document.querySelector('.ozbereich'));

      if (sollGescrollt !== gescrollt) {
        gescrollt = sollGescrollt;
        if (gescrollt) document.body.dataset.gescrollt = 'ja';
        else delete document.body.dataset.gescrollt;
      }
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(pruefen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    pruefen();

    /*
      Beim Seitenwechsel tauscht Astro den <body> samt Attributen aus.

      Das NEUE Dokument beginnt im Zustand des alten — die Leisten stehen
      im ersten Bild also genau so wie eben. Erst nach dem Tausch fahren
      sie mit ihrem gewöhnlichen 300-ms-Wechsel in den richtigen Zustand,
      im lebenden Abbild des Übergangs (styles/uebergaenge.css blendet das
      stehende alte Abbild der Leisten aus). Bis zum 17. Oktober 2026
      bekam das neue Dokument gleich den Zielzustand: Dann lagen altes
      und neues Abbild übereinander, und das alte verschwand am Ende
      schlagartig (Florian).
    */
    let vorhersage = gescrollt;
    let durchVerlauf = false;
    document.addEventListener('astro:before-swap', (ereignis) => {
      const e = ereignis as Event & { newDocument: Document; to: URL; navigationType: string };
      const startseite = !!e.newDocument.querySelector('.ozbereich');
      let merker = '';
      try { merker = sessionStorage.getItem('uebergang-ziel') || ''; } catch { /* egal */ }

      let soll: boolean;
      if (e.navigationType === 'traverse') {
        // Vor/Zurück im Verlauf: Astro stellt die gemerkte Scrolltiefe wieder her
        const y = (history.state && typeof history.state.scrollY === 'number') ? history.state.scrollY : 0;
        soll = gescrolltBei(y, startseite);
      } else if (!startseite || merker) {
        // Unterseite — oder zurück zur Übersicht, wo die Karte mittig gestellt wird
        soll = true;
      } else {
        // Sprungmarke tiefer auf der Seite? Der Anfang und die
        // Öffnungszeiten liegen oben, alles andere ist gescrollt.
        soll = !!e.to.hash && !['#start', '#oz_anchor', '#inhalt'].includes(e.to.hash);
      }
      vorhersage = soll;
      durchVerlauf = e.navigationType === 'traverse';
      const jetzt = document.body.hasAttribute('data-gescrollt');
      if (jetzt) e.newDocument.body.dataset.gescrollt = 'ja';
      else delete e.newDocument.body.dataset.gescrollt;
      gescrollt = jetzt;
    });

    const zustandSetzen = (soll: boolean) => {
      if (soll === gescrollt) return;
      gescrollt = soll;
      if (soll) document.body.dataset.gescrollt = 'ja';
      else delete document.body.dataset.gescrollt;
    };

    // Nach dem Tausch: die Leisten einmal im alten Zustand messen — erst
    // dann hat die neue Symbolleiste einen Ausgangswert, von dem ihr
    // Übergang losläuft —, dann umschalten. Die Scrollposition steht da
    // schon fest (die Zielkarte wird synchron mittig gestellt); beim
    // Blättern im Verlauf gilt die Vorhersage aus der gemerkten Tiefe.
    document.addEventListener('astro:after-swap', () => {
      document.querySelector('.fussleiste-huelle')?.getBoundingClientRect();
      document.querySelector('.kopfleiste')?.getBoundingClientRect();
      queueMicrotask(() => {
        if (durchVerlauf) zustandSetzen(vorhersage);
        else pruefen();
        requestAnimationFrame(pruefen);
      });
    });

  }

  /* ---------- Die Blase ----------
     Die Punktlinie einer Leiste wölbt sich zu einem abgerundeten Feld
     auf. Gezeichnet wird das als SVG über die volle Breite (die
     gestrichelte Linie) plus einer Maske (`clip-path`) auf dem Umschlag
     der Leiste, die Leiste und Blase zu EINER milchigen Fläche
     zuschneidet — keine Kante dazwischen. Die Höhe wächst Bild für Bild
     von 0 auf die Höhe des Inhalts.

     Zwei Formen teilen sich Zeichnung, Maske und Bewegung
     (`blaseAnlegen`): die Blase unter „Leistungen" (Desktop; aus der
     Symbolleiste auch nach oben) und das Handy-Menü, das zum rechten
     Rand hin offen ist. Die Form selbst liefert je eine
     `Geometrie`-Funktion. Ein Überschwingen beim Öffnen gab es bis zum
     26. September 2026 (ein kleiner Sinus-Zusatz); es ist weg — Florian
     wollte es glatter. */

  /** Lage und Breite einer offenen Desktop-Blase — für die Übergabe */
  type BlasenLage = { links: number; boxBreite: number; knopfX: number };

  type Geometrie = (k: {
    breite: number;                // Fensterbreite
    h: number;                     // aktuelle Höhe der Wölbung
    anteil: number;                // 0 = Linie, 1 = voll aufgewölbt
    y0: number;                    // y der Grundlinie in der Zeichnung
    s: number;                     // Richtung: 1 nach unten, -1 nach oben
    k: number;                     // Kreiskonstante der Viertelbögen
    f: (n: number) => string;
    /** Übergabe von einer anderen Blase: deren Lage und der Fortschritt */
    von?: { lage: BlasenLage; t: number };
  }) => {
    /** Die Wölbung ab dem linken Rand bis zum rechten Rand, in
        Leserichtung — um `dy` verschoben und um `auf` nach außen geweitet */
    woelbung: (dy: number, auf: number) => string;
    /** Dieselbe Wölbung vom rechten zum linken Rand (Maske der oberen Leiste) */
    rueckwaerts: (dy: number, auf: number) => string;
    /** Kleiner Pfeil an der Grundlinie, wenn die Form einen hat */
    pfeil?: { d: string; sicht: number };
    /** Die gezeichnete Lage — nur Formen, die übergeben können */
    lage?: BlasenLage;
  };

  /** Weiche Kurve (ease-in-out quad) für das Breiterwerden der Blase */
  const weich = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

  /*
    Alle Blasen einer Leiste teilen sich den Umschlag: seine Maske
    (`--blase-form`) und das Ausblenden der Punktlinie (`data-ohne-linie`).
    Diesen Zustand schreibt und räumt nur die zuletzt geöffnete Blase.
    Geht eine neue auf, verschwindet jede andere sofort — auch eine, die
    gerade noch zuklappt. Vorher räumte die schließende Blase am Ende
    ihrer Bewegung den Zustand der neuen mit ab, und die Punktlinie lag
    quer über der offenen Blase (Florian, 17. Oktober 2026).
  */
  const blasenJeTraeger = new WeakMap<HTMLElement, Set<{ beenden: () => void; vorlage: () => { lage: BlasenLage; h: number } | null }>>();
  const blasenBesitzer = new WeakMap<HTMLElement, object>();

  function blaseAnlegen(opt: {
    /** Trägt die Zeichnung (`.kopfleiste` / `.fussleiste`) */
    leiste: HTMLElement;
    /** Trägt Maske und Punktlinie (`.navigation` / `.fussleiste-huelle`) */
    linienTraeger: HTMLElement;
    hoch: boolean;
    geometrie: Geometrie;
    /** Aufräumen, wenn die Blase ganz zu ist */
    beimZu: () => void;
  }) {
    const { leiste, linienTraeger, hoch, geometrie, beimZu } = opt;
    const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Die Zeichnung: gestrichelte Linie und Pfeil; der milchige Grund
    // ist die Maske am Umschlag
    const NS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('class', 'blase');
    svg.setAttribute('aria-hidden', 'true');
    const linie = document.createElementNS(NS, 'path'); linie.setAttribute('class', 'blase__linie');
    const pfeil = document.createElementNS(NS, 'path'); pfeil.setAttribute('class', 'blase__pfeil');
    svg.append(linie, pfeil);
    svg.style.display = 'none';
    leiste.append(svg);

    let anteil = 0;        // 0 = Linie, 1 = voll aufgewölbt
    let ziel = 0;
    let laeuft = false;
    let lauf = 0;          // zählt Bewegungen; eine abgebrochene läuft nicht weiter
    let hoehe = 0;         // Höhe der Wölbung in px
    let start = 0, von = 0, dauer = 520;
    /* Übergabe: Geht diese Blase auf, während eine andere derselben
       Leiste offen ist, wandert die Form von dort hierher und nimmt
       dabei ihre Höhe an, statt zu und neu aufzugehen (Florian,
       17. Oktober 2026) */
    const UEBERGABE = 450;
    let uebergabe: { lage: BlasenLage; h: number; start: number } | null = null;
    let letzteLage: BlasenLage | undefined;
    let letzteH = 0;
    const s = hoch ? -1 : 1;   // Richtung: nach oben oder unten
    const k = 0.5523;          // Viertelkreis als Bézier
    const rand = 4;            // Luft in der Zeichnung ober- und unterhalb

    /* Öffnen mit derselben Kurve wie alle betonten Bewegungen der Seite,
       Schließen ease-in-out */
    const kurveAuf = KURVEN.betont;
    const kurveZu = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const zeichnen = () => {
      const breite = document.documentElement.clientWidth;
      let h = Math.max(0, hoehe * anteil);
      let vonLage: { lage: BlasenLage; t: number } | undefined;
      let rahmen = hoehe;
      if (uebergabe) {
        const t = KURVEN.betont(Math.min(1, (performance.now() - uebergabe.start) / UEBERGABE));
        h = uebergabe.h + (hoehe - uebergabe.h) * t;
        rahmen = Math.max(hoehe, uebergabe.h);
        vonLage = { lage: uebergabe.lage, t };
        if (t >= 1) uebergabe = null;
      }
      letzteH = h;
      /* Grundlinie im SVG — auf halbe Pixel gelegt, damit der 1-px-Strich
         genau auf der Punktreihe der Leiste liegt und nicht verschmiert */
      const y0 = hoch ? rahmen + rand + 0.5 : rand - 0.5;
      const gesamt = rahmen + 2 * rand;

      svg.style.width = `${breite}px`;
      svg.style.height = `${gesamt}px`;
      svg.style[hoch ? 'bottom' : 'top'] = `calc(100% - ${rand}px)`;
      svg.setAttribute('viewBox', `0 0 ${breite} ${gesamt}`);

      const f = (n: number) => n.toFixed(2);
      const form = geometrie({ breite, h, anteil: Math.min(1, anteil), y0, s, k, f, von: vonLage });
      letzteLage = form.lage;

      /* Bei (fast) null Höhe eine reine Linie: Die Bögen hätten sonst
         Punkte, die um Bruchteile eines Pixels wackeln, und aus den
         Strichen würde in der Mitte ein durchgezogener Strich */
      linie.setAttribute('d', h < 1.5 ? `M0 ${f(y0)} L${breite} ${f(y0)}` : `M0 ${f(y0)} ${form.woelbung(0, 0)}`);

      /* Die Maske des Leistengrunds: Leiste plus Blase als eine Form,
         in den Koordinaten des Umschlags. Der reicht per Innenabstand
         (`--blase-hoehe`) über die Leiste hinaus — gemessen wird die
         Leiste selbst, also ohne diesen Abstand. */
      if (!istBesitzer()) return;
      const lr = linienTraeger.getBoundingClientRect();
      const cs = getComputedStyle(linienTraeger);
      const leisteH = lr.height - (parseFloat(cs.paddingTop) || 0) - (parseFloat(cs.paddingBottom) || 0);
      linienTraeger.style.setProperty('--blase-hoehe', `${gesamt}px`);
      /* Nullpunkt-Versatz zwischen Zeichnung und Maske: unten liegt die
         Zeichnung `rand` unter dem oberen Umschlagrand, oben liegt die
         Grundlinie erst unter der Leiste */
      const dy = hoch ? rand : leisteH - rand;
      /* Der Strich liegt in der Zeichnung, die mit maskiert wird — die
         Maske greift deshalb 1 px über ihn hinaus */
      const auf = 1;
      const yM = y0 + dy + s * auf;
      const maske = hoch
        ? `M0 ${f(gesamt + leisteH)} L0 ${f(yM)} ${form.woelbung(dy, auf)}L${breite} ${f(yM)} L${breite} ${f(gesamt + leisteH)} Z`
        : `M0 0 L${breite} 0 L${breite} ${f(yM)} ${form.rueckwaerts(dy, auf)}L0 ${f(yM)} Z`;
      linienTraeger.style.setProperty('--blase-form', `path("${maske}")`);
      /* Dieselbe Form für den Übergang: Dort trägt die Gruppe der Leiste
         einen eigenen milchigen Weichzeichner, und der muss an der Kontur
         von Leiste und Blase enden — als Rechteck um den hohen Umschlag
         lag er sonst als harter Kasten über der Seite (Florian,
         17. Oktober 2026). Am <html>, weil dort die Übergangsebenen
         hängen; nach dem Tausch setzt es das nächste Bild neu. */
      document.documentElement.style.setProperty(hoch ? '--nav-unten-form' : '--nav-oben-form', `path("${maske}")`);

      if (form.pfeil) {
        pfeil.setAttribute('d', form.pfeil.d);
        pfeil.setAttribute('opacity', f(form.pfeil.sicht));
      } else {
        pfeil.removeAttribute('d');
      }
    };

    const ich = {};
    const istBesitzer = () => blasenBesitzer.get(linienTraeger) === ich;
    const zustandRaeumen = () => {
      if (!istBesitzer()) return;
      blasenBesitzer.delete(linienTraeger);
      linienTraeger.style.removeProperty('--blase-form');
      document.documentElement.style.removeProperty(hoch ? '--nav-unten-form' : '--nav-oben-form');
      linienTraeger.style.removeProperty('--blase-hoehe');
      delete linienTraeger.dataset.ohneLinie;
    };

    const schritt = (jetzt: number, mein: number) => {
      if (mein !== lauf) return;
      const t = Math.min(1, (jetzt - start) / dauer);
      const kurve = ziel === 1 ? kurveAuf : kurveZu;
      anteil = von + (ziel - von) * kurve(t);
      zeichnen();
      if (t < 1) { requestAnimationFrame((n) => schritt(n, mein)); return; }
      laeuft = false;
      anteil = ziel;
      if (uebergabe) { uebergabe = null; zeichnen(); }
      if (ziel === 0) {
        svg.style.display = 'none';
        zustandRaeumen();
        beimZu();
      }
    };

    const animieren = (nachZiel: number, sofort = false) => {
      ziel = nachZiel;
      von = anteil;
      start = performance.now();
      dauer = nachZiel === 1 ? 520 : 400;
      if (wenigerBewegung || sofort) { anteil = ziel; zeichnen(); dauer = 0; start = -1e9; }
      if (!laeuft) { laeuft = true; const mein = ++lauf; requestAnimationFrame((n) => schritt(n, mein)); }
    };

    /* Sofort weg, ohne Bewegung — wenn eine andere Blase derselben
       Leiste aufgeht */
    const beenden = () => {
      if (svg.style.display === 'none') return;
      lauf++;
      laeuft = false;
      anteil = 0;
      ziel = 0;
      uebergabe = null;
      svg.style.display = 'none';
      zustandRaeumen();
      beimZu();
    };
    const geschwister = blasenJeTraeger.get(linienTraeger) ?? new Set();
    blasenJeTraeger.set(linienTraeger, geschwister);
    /* Was eine neue Blase von dieser übernimmt: Lage und gerade
       gezeichnete Höhe — nur solange sie sichtbar aufgewölbt ist */
    const vorlage = () => (svg.style.display !== 'none' && anteil > 0.02 && letzteLage ? { lage: letzteLage, h: letzteH } : null);
    const eintrag = { beenden, vorlage };
    geschwister.add(eintrag);

    return {
      /** Aufwölben auf die gegebene Inhaltshöhe */
      oeffnen(h: number) {
        let vorher: { lage: BlasenLage; h: number } | null = null;
        for (const andere of geschwister) {
          if (andere === eintrag) continue;
          vorher ??= andere.vorlage();
          andere.beenden();
        }
        blasenBesitzer.set(linienTraeger, ich);
        hoehe = h;
        linienTraeger.dataset.ohneLinie = 'ja';
        svg.style.display = 'block';
        if (vorher && !wenigerBewegung) {
          /* Übergabe: voll offen von Anfang an, die Form wandert */
          uebergabe = { ...vorher, start: performance.now() };
          anteil = 1; von = 1; ziel = 1;
          start = uebergabe.start; dauer = UEBERGABE;
          zeichnen();
          if (!laeuft) { laeuft = true; const mein = ++lauf; requestAnimationFrame((n) => schritt(n, mein)); }
          return true;
        }
        zeichnen();
        animieren(1);
        return false;
      },
      schliessen(sofort = false) { animieren(0, sofort); },
      /** Sofort und ganz weg — samt Maske und Höhe am Umschlag */
      beenden,
      /** Der Inhalt ist anders hoch geworden — die Blase folgt sofort */
      hoeheSetzen(h: number) {
        if (svg.style.display === 'none') return;
        hoehe = h;
        zeichnen();
      },
      get aktiv() { return svg.style.display !== 'none'; },
    };
  }

  /** Die gerade offene Blase je Leiste — zum Schließen, wenn eine andere aufgeht */
  const offeneJeLeiste = new Map<HTMLElement, { huelle: HTMLElement; abgeben: () => void }>();

  /**
   * Zum Ziel eines Menüpunkts: Liegt es auf dieser Seite, gleitet sie
   * hin (scripts/anker.ts); sonst wechselt die Seite, und die Sprungmarke
   * wird nach dem Wechsel angefahren.
   */
  function zumZiel(ziel: string) {
    if (!ziel) return;
    const url = new URL(ziel, location.href);
    if (url.pathname === location.pathname && url.hash && zuSprungmarke(url.hash)) {
      /* Adresse mitführen, ohne neuen Verlaufseintrag — wie bei den
         Sprungmarken in scripts/anker.ts. */
      try { history.replaceState(history.state, '', url.hash); } catch { /* egal */ }
      return;
    }
    if (url.origin === location.origin) navigate(url.pathname + url.hash);
    else location.href = url.href;
  }

  function aufklappmenuesAufbauen() {
    // ---- Aufklappmenüs: jeder Menüpunkt mit Unterpunkten ----
    // Die Wölbung sitzt unter (oder über) dem Menüpunkt; ein kleiner
    // Pfeil an der Grundlinie zeigt auf ihn.
    document.querySelectorAll<HTMLElement>('[data-aufklapp]').forEach((huelle) => {
      if (huelle.dataset.bereit) return;
      huelle.dataset.bereit = 'ja';
      let schliessTimer = 0;

      const knopf = huelle.querySelector<HTMLButtonElement>('button[aria-expanded]');
      const inhalt = huelle.querySelector<HTMLElement>('.aufklapp__inhalt');
      const hoch = huelle.dataset.richtung === 'hoch';
      /* Wo die Zeichnung hängt und wer die Punktlinie trägt. Beides muss
         im selben Stapelkontext wie der Inhalt liegen — die Kopfleiste
         trägt einen Übergangsnamen und bildet damit einen eigenen. */
      const leiste = hoch ? huelle.closest<HTMLElement>('.fussleiste') : huelle.closest<HTMLElement>('.kopfleiste');
      const linienTraeger = hoch ? huelle.closest<HTMLElement>('.fussleiste-huelle') : huelle.closest<HTMLElement>('.navigation');
      if (!knopf || !inhalt || !leiste || !linienTraeger) return;

      const ECKE = 40;             // Rundung am Ende — wie im Entwurf

      const geometrie: Geometrie = ({ breite, h, anteil, y0, s, k, f, von }) => {
        const boxBreite = Math.min(inhalt.offsetWidth || 400, breite - 32);
        const kr = knopf.getBoundingClientRect();
        const knopfX = kr.left + kr.width / 2;
        /*
          Die Unterpunkte beginnen genau unter dem Wort des Menüpunkts:
          linke Textkante der Blase = linke Kante der Beschriftung. Der
          Pfeil an der Grundlinie bleibt auf der Mitte des Punkts.

          Bis zum 18. September 2026 standen hier die Kategorie-Symbole
          unter der Knopfmitte (`knopfX − 54`). Seit Unterpunkte keine
          Symbole mehr tragen (Florian, Oktober 2026), richtet sich die
          Blase am Text aus — 36 px ist ihr Innenabstand
          (`.aufklapp__inhalt`).
        */
        const wort = knopf.querySelector<HTMLElement>('.menuepunkt__text, .fussknopf__text');
        const textLinks = wort ? wort.getBoundingClientRect().left : knopfX;
        const zielLinks = Math.max(16, Math.min(breite - boxBreite - 16, textLinks - 36));
        /* Bei der Übergabe von einer anderen Blase gleiten Lage, Breite
           und Pfeil von dort hierher */
        const zwischen = (a: number, b: number) => (von ? a + (b - a) * von.t : b);
        const links = zwischen(von?.lage.links ?? 0, zielLinks);
        const bBreite = zwischen(von?.lage.boxBreite ?? 0, boxBreite);
        const pfeilX = zwischen(von?.lage.knopfX ?? 0, knopfX);
        const mitte = links + bBreite / 2;

        /* Sie wächst in Höhe UND Breite — die Linie fließt auf, statt
           eine fertige Form hochzuschieben. Die Rundung ist nie größer
           als die halbe Höhe: so bleibt jede Zwischenform weich.
           Der Fuß der Blase steht fest (Außenmaß = Endbreite + Rundung);
           nur der Scheitel weitet sich mit der Höhe, die Bögen werden
           dadurch von breit-flach zu 40-px-Kreisen und die Seiten steiler.
           So gibt es in keiner Phase eine Ecke. */
        const aussen = bBreite / 2 + ECKE;                     // halbe Fußbreite, fest
        /* Scheitelbreite: beginnt bei der halben Fußbreite — dann sind die
           Bögen genau so breit wie der halbe Scheitel und stoßen in der
           Mitte aneinander (reiner Hügel ohne Plateau). Breiter dürfen
           die Bögen nie sein, sonst liefe die Linie über sich zurück. */
        const w = aussen + (bBreite - aussen) * weich(anteil);
        const fa = Math.min(ECKE, h / 2);                       // Höhe der Bögen
        const aB = Math.min(w / 2, Math.max(fa, aussen - w / 2)); // Breite der Bögen

        const woelbung = (dy: number, auf: number) => {
          const g = (n: number) => f(n + dy);
          const xL = mitte - w / 2 - auf;
          const xR = mitte + w / 2 + auf;
          const yb = y0 + s * auf;
          return (
            /* Fuß links: flacher Bogen von der Linie in die Wand */
            `L${f(xL - aB)} ${g(yb)} C${f(xL - aB + k * aB)} ${g(yb)} ${f(xL)} ${g(yb + s * (fa - k * fa))} ${f(xL)} ${g(yb + s * fa)} ` +
            /* Wand */
            `L${f(xL)} ${g(yb + s * (h - fa))} ` +
            /* Schulter links */
            `C${f(xL)} ${g(yb + s * (h - fa + k * fa))} ${f(xL + aB - k * aB)} ${g(yb + s * h)} ${f(xL + aB)} ${g(yb + s * h)} ` +
            /* Scheitel */
            `L${f(xR - aB)} ${g(yb + s * h)} ` +
            /* Schulter rechts */
            `C${f(xR - aB + k * aB)} ${g(yb + s * h)} ${f(xR)} ${g(yb + s * (h - fa + k * fa))} ${f(xR)} ${g(yb + s * (h - fa))} ` +
            /* Wand */
            `L${f(xR)} ${g(yb + s * fa)} ` +
            /* Fuß rechts, dann weiter auf der Linie bis zum Rand */
            `C${f(xR)} ${g(yb + s * (fa - k * fa))} ${f(xR + aB - k * aB)} ${g(yb)} ${f(xR + aB)} ${g(yb)} ` +
            `L${breite} ${g(yb)} `
          );
        };

        const rueckwaerts = (dy: number, auf: number) => {
          const g = (n: number) => f(n + dy);
          const xL = mitte - w / 2 - auf;
          const xR = mitte + w / 2 + auf;
          const yb = y0 + s * auf;
          return (
            `L${f(xR + aB)} ${g(yb)} ` +
            `C${f(xR + aB - k * aB)} ${g(yb)} ${f(xR)} ${g(yb + s * (fa - k * fa))} ${f(xR)} ${g(yb + s * fa)} ` +
            `L${f(xR)} ${g(yb + s * (h - fa))} ` +
            `C${f(xR)} ${g(yb + s * (h - fa + k * fa))} ${f(xR - aB + k * aB)} ${g(yb + s * h)} ${f(xR - aB)} ${g(yb + s * h)} ` +
            `L${f(xL + aB)} ${g(yb + s * h)} ` +
            `C${f(xL + aB - k * aB)} ${g(yb + s * h)} ${f(xL)} ${g(yb + s * (h - fa + k * fa))} ${f(xL)} ${g(yb + s * (h - fa))} ` +
            `L${f(xL)} ${g(yb + s * fa)} ` +
            `C${f(xL)} ${g(yb + s * (fa - k * fa))} ${f(xL - aB + k * aB)} ${g(yb)} ${f(xL - aB)} ${g(yb)} `
          );
        };

        /* Kleiner Pfeil an der Grundlinie, auf den Menüpunkt zeigend —
           Schenkel unter 45° wie der Haken am Menüpunkt, nur größer. Er
           blendet im letzten Drittel des Wachsens auf. */
        const py = y0 + s * 22;
        const sicht = Math.min(1, Math.max(0, (anteil - 0.6) / 0.4));
        const arm = 9;
        const pfeil = {
          d: `M${f(pfeilX - arm)} ${f(py + s * -arm)} L${f(pfeilX)} ${f(py)} L${f(pfeilX + arm)} ${f(py + s * -arm)}`,
          sicht,
        };

        /* Der Inhalt liegt in der voll aufgewölbten Blase */
        const hr = huelle.getBoundingClientRect();
        inhalt.style.left = `${zielLinks - hr.left}px`;

        return { woelbung, rueckwaerts, pfeil, lage: { links, boxBreite: bBreite, knopfX: pfeilX } };
      };

      const blase = blaseAnlegen({
        leiste, linienTraeger, hoch, geometrie,
        beimZu: () => {
          /* Bei einer Übergabe blenden die Unterpunkte noch aus — sie
             verschwinden dann selbst (`abgeben`) */
          if (huelle.dataset.ausblenden) return;
          delete huelle.dataset.aktiv;
          if (knopf.getAttribute('aria-expanded') !== 'true') inhalt.hidden = true;
        },
      });

      /* Eine andere Blase dieser Leiste geht auf: Die Unterpunkte blenden
         aus (120 ms, CSS), dann erst verschwinden sie. Die Form übernimmt
         die andere Blase. */
      let ausblendTimer = 0;
      const abgeben = () => {
        window.clearTimeout(schliessTimer);
        if (offeneJeLeiste.get(linienTraeger)?.huelle === huelle) offeneJeLeiste.delete(linienTraeger);
        knopf.setAttribute('aria-expanded', 'false');
        delete huelle.dataset.offen;
        delete huelle.dataset.uebergabe;
        huelle.dataset.ausblenden = 'ja';
        window.clearTimeout(ausblendTimer);
        ausblendTimer = window.setTimeout(() => {
          delete huelle.dataset.ausblenden;
          if (knopf.getAttribute('aria-expanded') === 'true') return;
          inhalt.hidden = true;
          if (!blase.aktiv) delete huelle.dataset.aktiv;
        }, 160);
      };

      const setzen = (offen: boolean, sofort = false) => {
        if ((knopf.getAttribute('aria-expanded') === 'true') === offen) return;
        knopf.setAttribute('aria-expanded', String(offen));
        if (offen) {
          /* Je Leiste ist nur eine Blase offen: Alle teilen sich die Maske
             des Leistenumschlags (`--blase-form`). Ist schon eine offen,
             gibt sie ab: Ihre Unterpunkte blenden aus, und die Form
             wandert hierher (`blaseAnlegen`, Übergabe). */
          const andere = offeneJeLeiste.get(linienTraeger);
          if (andere && andere.huelle !== huelle) andere.abgeben();
          offeneJeLeiste.set(linienTraeger, { huelle, abgeben });
          window.clearTimeout(ausblendTimer);
          delete huelle.dataset.ausblenden;
          inhalt.hidden = false;
          huelle.dataset.aktiv = 'ja';
          const uebergeben = blase.oeffnen(inhalt.getBoundingClientRect().height);
          /* Kommt die Form von nebenan, laufen die Unterpunkte früher ein */
          if (uebergeben) huelle.dataset.uebergabe = 'ja';
          else delete huelle.dataset.uebergabe;
          requestAnimationFrame(() => { huelle.dataset.offen = 'ja'; });
        } else {
          if (offeneJeLeiste.get(linienTraeger)?.huelle === huelle) offeneJeLeiste.delete(linienTraeger);
          delete huelle.dataset.offen;
          blase.schliessen(sofort);
          if (sofort) inhalt.hidden = true;
        }
      };

      /*
        Der Menüpunkt „Leistungen" tut zweierlei — in dieser Reihenfolge:

          1. Klick, solange zu:   die Blase geht auf
          2. Klick, während offen: sie schließt, und die Seite springt
             an den Anfang des Leistungsbereichs

        Mit der Maus ist Schritt 1 schon durch das Überfahren erledigt;
        der erste Klick springt also gleich (Florian, 18. September
        2026). Mit Tastatur oder Finger gibt es kein Überfahren — dort
        öffnet der erste Druck, der zweite springt. So kommt man auf
        jedem Weg an beides.
      */
      /* Unten auf Handys und Tablets springt ein Punkt mit Unterpunkten
         gleich — dort gibt es das Menü mit seinen Ebenen, eine Blase
         über der Symbolleiste wäre zu viel (wie bisher bei „Leistungen") */
      const nurSprung = () => hoch && window.matchMedia('(max-width: 991px)').matches;

      knopf.addEventListener('click', () => {
        if (nurSprung()) { zumZiel(knopf.dataset.ziel ?? ''); return; }
        if (knopf.getAttribute('aria-expanded') !== 'true') { setzen(true); return; }
        setzen(false);
        zumZiel(knopf.dataset.ziel ?? '');
      });

      /* Eine Kategorie in der Blase: sofort zu, nicht erst beim
         Wegziehen des Zeigers (Florian, 18. September 2026). */
      inhalt.addEventListener('click', (e) => {
        if ((e.target as Element | null)?.closest?.('a')) setzen(false);
      });

      // Auf Zeigegeräten öffnet auch das Überfahren — die Blase gehört dazu
      huelle.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse' || nurSprung()) return;
        window.clearTimeout(schliessTimer);
        setzen(true);
      });
      huelle.addEventListener('pointerleave', (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse') return;
        schliessTimer = window.setTimeout(() => setzen(false), 120);
      });

      // Schließen, wenn der Fokus den Bereich verlässt
      huelle.addEventListener('focusout', (e) => {
        const ziel = e.relatedTarget as Node | null;
        if (!ziel || !huelle.contains(ziel)) setzen(false);
      });

      // Schließen bei Klick außerhalb
      document.addEventListener('click', (e) => {
        if (!huelle.contains(e.target as Node)) setzen(false);
      });

      /* Beim Seitenwechsel schließen — mit Bewegung, sie läuft im
         Übergang weiter (Florian, 17. Oktober 2026: „es muss trotzdem
         animiert schließen"). Der milchige Weichzeichner der Kopfleiste
         folgt dabei der Form der Blase (`--nav-oben-form`, siehe
         `blaseAnlegen`), statt als Kasten über der Seite zu liegen. */
      document.addEventListener('astro:before-preparation', () => {
        if (!huelle.isConnected) return;
        setzen(false);
      });

      // Schließen mit Escape, Fokus zurück auf den Knopf
      huelle.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          setzen(false);
          knopf.focus();
        }
      });

      window.addEventListener('resize', () => {
        if (huelle.dataset.aktiv) blase.hoeheSetzen(inhalt.getBoundingClientRect().height);
      }, { passive: true });
    });
  }

  /**
   * Die Text-Rolle der Menüpunkte (CSS `.menuepunkt__rolle`): Das
   * Attribut kommt beim Betreten und geht erst, wenn die Animation zu
   * Ende ist — eine `:hover`-Animation brach ab, sobald der Zeiger den
   * Punkt verließ, und der Text sprang zurück (Florian, 26. September
   * 2026). Zurückgerollt wird nie (Ablauf a-18).
   */
  function rollenAufbauen() {
    const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.menuepunkt').forEach((punkt) => {
      if (punkt.dataset.rolleBereit) return;
      punkt.dataset.rolleBereit = 'ja';
      const rolle = punkt.querySelector('.menuepunkt__rolle');
      punkt.addEventListener('pointerenter', () => { if (!wenigerBewegung) punkt.dataset.rollt = 'ja'; });
      const fertig = (e: AnimationEvent) => { if (e.target === rolle) delete punkt.dataset.rollt; };
      punkt.addEventListener('animationend', fertig);
      /* Etwa beim Umbruch auf Handybreite mitten in der Rolle */
      punkt.addEventListener('animationcancel', fertig);
    });
  }

  function mobilmenueAufbauen() {
    // ---- Handy-Menü ----
    // Dieselbe Blase wie unter „Leistungen", nur zum rechten Rand hin
    // offen: Die Punktlinie bleibt unter dem Logo oben, senkt sich rechts
    // davon in eine senkrechte Wand und läuft am Fuß des Menüs bis zum
    // rechten Fensterrand (Florian, 26. September 2026). Der Lottie-Knopf
    // läuft von Bild 0 auf 59 und zurück (Ablauf a-25 / a-27), mit
    // `KNOPF_TEMPO` beschleunigt.
    const menueknopf = document.querySelector<HTMLButtonElement>('[data-menueknopf]');
    const navigation = document.querySelector<HTMLElement>('.navigation');
    const kopfleiste = navigation?.querySelector<HTMLElement>('.kopfleiste');
    const logo = navigation?.querySelector<HTMLElement>('.kopfleiste__mobil .logo');
    const menue = document.querySelector<HTMLElement>('[data-mobilmenue]');
    const lottieKasten = document.querySelector<HTMLElement>('[data-menuelottie]');
    if (!menueknopf || !navigation || !kopfleiste || !logo || !menue || menueknopf.dataset.bereit) return;
    menueknopf.dataset.bereit = 'ja';

    let knopfSpieler: { playSegments: (b: [number, number], s?: boolean) => void; setSpeed: (f: number) => void; totalFrames: number } | null = null;
    /* Die Datei ist auf 600 ms angelegt (Ablauf a-25); der Wechsel
       Burger ↔ X soll flotter sein als die Blase, die 520 ms wächst:
       1,6-fach → 375 ms (Florian, 26. September 2026). */
    const KNOPF_TEMPO = 1.6;
    /* Das letzte Bild, EINMAL beim Laden gemerkt: lottie-web setzt
       `totalFrames` nach `playSegments` auf die Länge des gespielten
       Abschnitts. Wer den Wert bei jedem Klick neu liest, spielt jedes
       Mal ein Bild weniger — das X wurde mit jedem Klick schmaler,
       bis die Balken gar nicht mehr drehten (Florian, 26. September
       2026). */
    let letztesBild = 0;
    if (lottieKasten) {
      import('../scripts/lottie').then(({ ladeAnimation }) => {
        ladeAnimation(lottieKasten, '/lottie/menue-button.json').then((s) => {
          knopfSpieler = s as never;
          letztesBild = s ? s.totalFrames - 1 : 0;
          s?.setSpeed(KNOPF_TEMPO);
        });
      });
    }

    /* ---- Form der Blase ----
       Die linke Hälfte der Desktop-Blase, zum rechten Rand hin offen:
       Fuß auf der Leistenlinie, senkrechte Wand rechts neben dem Logo,
       unten die Schulter in die Grundlinie, die bis zum Fensterrand
       läuft. Und dieselbe Bewegung: Der Fuß steht fest, die Bögen sind
       anfangs breit und flach (ein Hügel, der von unten gegen die Linie
       drückt) und ziehen sich mit der Höhe auf die 40-px-Rundung
       zusammen, während die Wand nach links an ihren Platz rückt. So
       gibt es in keiner Phase eine Ecke. Der erste Entwurf hatte einen
       großen Schwung oben und eine geneigte Wand — das wirkte beim
       Öffnen weniger „blasig" als der Desktop (Florian, 26. September
       2026). */
    const LOGO_ABSTAND = 12;    // Luft zwischen Logo und Wand
    const ECKE = 40;            // Rundung am Ende — wie bei der Desktop-Blase
    const HUEGEL = 150;         // Breite der Bögen am Anfang: so flach beginnt der Hügel
    const WAND_LUFT = 32;       // Luft zwischen Wand und Symbolspalte

    const geometrie: Geometrie = ({ breite, h, anteil, y0, k, f }) => {
      /* `.navigation` liegt bei left 0 — Fensterkoordinaten sind
         Zeichnungskoordinaten */
      /* Die Wand steht 32 px links der Symbolspalte — die Blase rückt an
         die Knöpfe heran, nicht umgekehrt (Florian, 17. Oktober 2026).
         Nie aber näher ans Logo als 12 px. */
      const xL = Math.max(logo.getBoundingClientRect().right + LOGO_ABSTAND, spalteBerechnen() - WAND_LUFT);
      const xF = xL - ECKE;                                             // der Fuß, fest
      const fa = Math.min(ECKE, h / 2);                                 // Höhe der Bögen
      /* Breite der Bögen: vom flachen Hügel zur Rundung, nie flacher
         als hoch — wie `aB` bei der Desktop-Blase */
      const aB = Math.max(fa, HUEGEL - (HUEGEL - ECKE) * weich(anteil));
      const xW = xF + aB;                                               // die Wand jetzt
      menue.style.setProperty('--menue-wand', `${xL.toFixed(1)}px`);

      const woelbung = (dy: number, auf: number) => {
        const g = (n: number) => f(n + dy);
        const yb = y0 + auf;
        return (
          /* auf der Linie bis zum Fuß, Bogen von der Linie in die Wand */
          `L${f(xF - auf)} ${g(yb)} C${f(xF - auf + k * aB)} ${g(yb)} ${f(xW - auf)} ${g(y0 + fa - k * fa)} ${f(xW - auf)} ${g(y0 + fa)} ` +
          /* die Wand */
          `L${f(xW - auf)} ${g(y0 + h - fa)} ` +
          /* die Schulter in die Grundlinie, dann offen bis zum rechten Rand */
          `C${f(xW - auf)} ${g(y0 + h - fa + k * fa)} ${f(xW + aB - k * aB)} ${g(y0 + h + auf)} ${f(xW + aB)} ${g(y0 + h + auf)} ` +
          `L${breite} ${g(y0 + h + auf)} `
        );
      };

      const rueckwaerts = (dy: number, auf: number) => {
        const g = (n: number) => f(n + dy);
        const yb = y0 + auf;
        return (
          `L${breite} ${g(y0 + h + auf)} L${f(xW + aB)} ${g(y0 + h + auf)} ` +
          `C${f(xW + aB - k * aB)} ${g(y0 + h + auf)} ${f(xW - auf)} ${g(y0 + h - fa + k * fa)} ${f(xW - auf)} ${g(y0 + h - fa)} ` +
          `L${f(xW - auf)} ${g(y0 + fa)} ` +
          `C${f(xW - auf)} ${g(y0 + fa - k * fa)} ${f(xF - auf + k * aB)} ${g(yb)} ${f(xF - auf)} ${g(yb)} `
        );
      };

      return { woelbung, rueckwaerts };
    };

    /* ---- Ebenen ----
       Jeder Punkt mit Unterpunkten wechselt die Ebene: Die anderen
       Zeilen schließen sich, seine Zeile rückt an den Kopf und wird zum
       Zurück-Knopf, die Unterpunkte wachsen darunter (Florian,
       26. September 2026 — damals nur „Leistungen"). Welche Zeilen dazu
       gehören, sagt `data-gruppe`; das CSS sieht nur `data-gewaehlt`. */
    const ebenenKnoepfe = [...menue.querySelectorAll<HTMLButtonElement>('[data-ebene-knopf]')];
    /** Der Knopf der gerade offenen Ebene — für Escape und das Schließen */
    let ebenenKnopf: HTMLButtonElement | null = null;
    const ebeneSetzen = (knopf: HTMLButtonElement | null) => {
      if (ebenenKnopf) {
        ebenenKnopf.setAttribute('aria-expanded', 'false');
        ebenenKnopf.removeAttribute('aria-label');
      }
      menue.querySelectorAll('[data-gewaehlt]').forEach((z) => z.removeAttribute('data-gewaehlt'));
      ebenenKnopf = knopf;
      if (!knopf) {
        delete menue.dataset.ebene;
        return;
      }
      const gruppe = knopf.dataset.ebeneKnopf!;
      knopf.setAttribute('aria-expanded', 'true');
      knopf.setAttribute('aria-label', 'Zurück zum Menü');
      menue.querySelectorAll(`[data-gruppe="${CSS.escape(gruppe)}"]`).forEach((z) => z.setAttribute('data-gewaehlt', ''));
      menue.dataset.ebene = gruppe;
    };
    for (const knopf of ebenenKnoepfe) {
      knopf.addEventListener('click', () => ebeneSetzen(ebenenKnopf === knopf ? null : knopf));
    }

    /* ---- Schleier ----
       Er steht außerhalb der persistierten Navigation und wird bei
       jedem Seitenwechsel neu gebaut — deshalb hier stets frisch
       abgefragt statt gemerkt. */
    const schleier = () => document.querySelector<HTMLElement>('[data-menue-schleier]');
    const schleierZeigen = () => {
      const s = schleier();
      if (!s) return;
      s.hidden = false;
      requestAnimationFrame(() => { s.dataset.sichtbar = 'ja'; });
    };
    const schleierAusblenden = () => { const s = schleier(); if (s) delete s.dataset.sichtbar; };
    const schleierVerstecken = () => { const s = schleier(); if (s) s.hidden = true; };

    /* ---- Seite stillhalten ----
       Solange das Menü offen ist, steht die Seite still: Sonst scrollte
       beim Wischen über dem Menü der Inhalt dahinter weg — und mit ihm
       fährt die Einstiegskarte, weil sie am Scrollweg hängt (Florian,
       18. September 2026). Kein `position: fixed` am Body: Das setzte
       `scrollY` auf 0 und würfe die Karte aus der Bahn. Stattdessen
       `overflow: hidden` an der Wurzel plus — nur solange offen — ein
       Zuhörer, der das Wischen mit einem Finger unterbindet; iOS Safari
       hält sich sonst nicht an das `overflow`. Pinch-Zoom bleibt. */
    const beiTouch = (e: TouchEvent) => { if (e.touches.length === 1) e.preventDefault(); };
    const seiteSperren = (sperren: boolean) => {
      const html = document.documentElement;
      html.style.overflow = sperren ? 'hidden' : '';
      html.style.overscrollBehavior = sperren ? 'none' : '';
      if (sperren) document.addEventListener('touchmove', beiTouch, { passive: false });
      else document.removeEventListener('touchmove', beiTouch);
    };

    /* ---- Die Seite tritt zurück ----
       Solange das Menü offen ist, wird alles außer der Navigation
       unscharf und eine Spur kleiner (styles/global.css). Der
       Bezugspunkt der Verkleinerung ist die Fenstermitte — je Element
       als Abstand von seiner Oberkante, sonst schrumpfte ein langer
       Inhalt um seine eigene, weit entfernte Mitte. */
    const zuruecktreten = (zurueck: boolean) => {
      const html = document.documentElement;
      if (zurueck) {
        for (const el of document.querySelectorAll<HTMLElement>('.seiteninhalt, .ozbereich__buehne, .fuss')) {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--zurueck-mitte', `${Math.round(window.innerHeight / 2 - r.top)}px`);
        }
        html.dataset.menueUnscharf = 'ja';
      } else {
        delete html.dataset.menueUnscharf;
      }
    };

    const blase = blaseAnlegen({
      leiste: kopfleiste, linienTraeger: navigation, hoch: false, geometrie,
      beimZu: () => {
        delete navigation.dataset.menueAktiv;
        menue.hidden = true;
        schleierVerstecken();
        ebeneSetzen(null);
      },
    });

    const istOffen = () => navigation.hasAttribute('data-menue-offen');
    /* Der logische Zustand — `data-menue-aktiv` bleibt bis zum Ende der
       Schließbewegung stehen, der Hörer braucht aber sofort den
       Zielplatz */
    let menueGewollt = false;

    /* ---- Der Hörer in der Kopfleiste ----
       Drei Plätze (Florian, 27. September 2026 / 17. Oktober 2026): zu —
       rechts neben dem Punkt vor dem Menüknopf; allein geöffnet — nur so
       weit links davon, dass die Nummer Platz hat; bei offenem Menü —
       als dessen erste Zeile, sein Symbol bündig mit den Symbolen der
       Zeilen darunter. Der Platz ist eine `left`-Angabe in der
       Kopfleiste, die das Skript misst; das CSS fährt dorthin. */
    const kopfleisteMobil = navigation.querySelector<HTMLElement>('.kopfleiste__mobil');
    const telefon = navigation.querySelector<HTMLElement>('[data-kopftelefon]');
    const telefonKnopf = telefon?.querySelector<HTMLButtonElement>('[data-kopftelefonknopf]');
    const nummer = telefon?.querySelector<HTMLElement>('.kopftelefon__nummer');
    const punkt = navigation.querySelector<HTMLElement>('[data-kopfpunkt]');
    let telefonOffen = false;

    /* Die Symbolspalte des Menüs: Hörer samt Nummer mittig zwischen Logo
       und Menüknopf, die Symbole der Zeilen bündig darunter (Florians
       Entwurf, 27. September 2026). Die Wand der Blase richtet sich
       danach (siehe `geometrie` oben). Der Hörer-Knopf ist 44 px, sein
       Symbol 40: die Spalte beginnt 2 px innerhalb des Knopfs. */
    function spalteBerechnen(): number {
      const b = menueknopf.getBoundingClientRect();
      const knopfBreite = telefonKnopf?.getBoundingClientRect().width || 44;
      const luft = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--abstand-xs')) * 16 || 12;
      const gruppe = knopfBreite + luft + (nummer?.scrollWidth ?? 0);
      return (logo.getBoundingClientRect().right + b.left) / 2 - gruppe / 2 + (knopfBreite - 40) / 2;
    }

    const telefonStellen = () => {
      if (!kopfleisteMobil || !telefon || !telefonKnopf) return;
      const k = kopfleisteMobil.getBoundingClientRect();
      if (!k.width) return;   // Desktop: die Zeile ist ausgeblendet
      const b = menueknopf.getBoundingClientRect();
      const knopfBreite = telefonKnopf.getBoundingClientRect().width || 44;
      const luft = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--abstand-xs')) * 16 || 12;
      const abstand = parseFloat(getComputedStyle(kopfleisteMobil.querySelector('.kopfleiste__handyrechts') as Element).columnGap) || 16;
      const spalte = spalteBerechnen();
      menue.style.setProperty('--menue-spalte', `${Math.round(spalte)}px`);

      let x: number;
      if (menueGewollt) {
        /* Mit Menü ist der Hörer dessen erste Zeile: sein Symbol bündig
           mit den Symbolen darunter. Der Knopf ist 44 px, das Symbol 40 —
           die Spalte beginnt 2 px innerhalb des Knopfs. */
        x = spalte - (knopfBreite - 40) / 2 - k.left;
      } else {
        /* Zu: rechts neben dem Punkt vor dem Menüknopf. Allein geöffnet
           rückt er nur so weit nach links, dass die Nummer zwischen ihm
           und dem Punkt Platz hat (Florian, 17. Oktober 2026) — vorher
           fuhr die Gruppe bis in die Mitte. */
        const p = punkt?.getBoundingClientRect();
        x = (p && p.width ? p.left : b.left) - abstand - knopfBreite - k.left;
        if (telefonOffen) x -= luft + (nummer?.scrollWidth ?? 0);
      }
      telefon.style.setProperty('--telefon-x', `${Math.round(x)}px`);
      telefon.dataset.gestellt = 'ja';
    };

    const telefonSetzen = (offen: boolean) => {
      if (!telefon || !telefonKnopf) return;
      telefonOffen = offen;
      telefonKnopf.setAttribute('aria-expanded', String(offen));
      telefonKnopf.setAttribute('aria-label', offen ? 'Telefonnummer verbergen' : 'Telefonnummer anzeigen');
      if (offen) {
        /* Die Breite des Texts, jetzt gemessen — die Schrift könnte beim
           Laden noch gewechselt haben */
        telefon.style.setProperty('--nummer-breite', `${nummer?.scrollWidth ?? 0}px`);
        telefon.dataset.offen = 'ja';
        kopfleisteMobil?.setAttribute('data-telefon-offen', '');
      } else {
        delete telefon.dataset.offen;
        kopfleisteMobil?.removeAttribute('data-telefon-offen');
      }
      telefonStellen();
    };

    telefonKnopf?.addEventListener('click', () => {
      /* Bei offenem Menü ist der Hörer ein Menüpunkt: ein Tipp ruft an */
      if (menueGewollt) { nummer?.click(); return; }
      telefonSetzen(!telefonOffen);
    });
    window.addEventListener('resize', telefonStellen, { passive: true });
    telefonStellen();

    const oeffnen = () => {
      if (istOffen()) return;
      menueGewollt = true;
      menue.hidden = false;
      navigation.dataset.menueAktiv = 'ja';
      /* Wie `data-offen` bei der Desktop-Blase: einen Frame später, damit
         die Zeilen aus ihrem Grundzustand heraus einfahren */
      requestAnimationFrame(() => { navigation.dataset.menueOffen = 'ja'; });
      menueknopf.setAttribute('aria-expanded', 'true');
      menueknopf.setAttribute('aria-label', 'Menü schließen');
      knopfSpieler?.playSegments([0, letztesBild], true);
      schleierZeigen();
      seiteSperren(true);
      zuruecktreten(true);
      blase.oeffnen(menue.getBoundingClientRect().height);
      /* Der Hörer öffnet sich mit und rückt als erste Zeile an die
         Symbolspalte — erst jetzt, die Wand der Blase ist gerade
         gemessen */
      telefonSetzen(true);
    };

    const menueSchliessen = (sofort = false) => {
      if (!istOffen() && !navigation.dataset.menueAktiv) return;
      menueGewollt = false;
      telefonSetzen(false);
      delete navigation.dataset.menueOffen;
      menueknopf.setAttribute('aria-expanded', 'false');
      menueknopf.setAttribute('aria-label', 'Menü öffnen');
      knopfSpieler?.playSegments([letztesBild, 0], true);
      schleierAusblenden();
      seiteSperren(false);
      zuruecktreten(false);
      blase.schliessen(sofort);
    };

    /* Nach dem logischen Zustand, nicht nach `data-menue-offen`: Das
       Attribut kommt erst ein Bild später — ein zweiter Tipp innerhalb
       dieses Bilds öffnete sonst noch einmal statt zu schließen */
    menueknopf.addEventListener('click', () => { if (menueGewollt) menueSchliessen(); else oeffnen(); });

    /* Die Blase folgt der Höhe des Menüs Bild für Bild — beim
       Ebenenwechsel, bei Drehung des Geräts, beim Laden der Schrift. */
    new ResizeObserver(() => {
      if (!navigation.dataset.menueAktiv) return;
      blase.hoeheSetzen(menue.getBoundingClientRect().height);
    }).observe(menue);

    // Ein Tipp auf ein Ziel schließt das Menü (wie in a-27)
    menue.querySelectorAll('a.mobilmenue__punkt').forEach((a) => {
      a.addEventListener('click', () => menueSchliessen());
    });

    // Tipp auf den Schleier
    document.addEventListener('click', (e) => {
      if ((e.target as Element | null)?.closest?.('[data-menue-schleier]')) menueSchliessen();
    });

    // Escape: erst die Ebene zurück, dann das Menü zu
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !istOffen()) return;
      if (ebenenKnopf) { const k = ebenenKnopf; ebeneSetzen(null); k.focus(); return; }
      menueSchliessen();
      menueknopf.focus();
    });

    // Fokus verlässt die Navigation (Tastatur)
    navigation.addEventListener('focusout', (e) => {
      const z = e.relatedTarget as Node | null;
      if (z && !navigation.contains(z) && istOffen()) menueSchliessen();
    });

    // Beim Seitenwechsel zu — noch vor dem Tausch, damit die Sperre an
    // der Wurzel nicht mit dem neuen Dokument verloren geht. Mit
    // Bewegung; der Weichzeichner im Übergang folgt der Form der Blase
    // (wie bei den Aufklappmenüs, siehe dort).
    document.addEventListener('astro:before-preparation', () => menueSchliessen());

    // Wird das Fenster breiter als ein Handy, gibt es das Menü nicht mehr:
    // sofort zu, ohne Bewegung — die Form misst das dann versteckte Logo
    window.matchMedia('(max-width: 991px)').addEventListener('change', (e) => {
      if (!e.matches) menueSchliessen(true);
    });
  }

  navigationAufbauen();
  document.addEventListener('astro:page-load', navigationAufbauen);
</script>
