---
/**
 * Hinweis-Sprechblase für Urlaub, Vertretung oder Notfälle.
 *
 * Nachbau des Info-Popups der Webflow-Seite: weiße Sprechblase mit
 * Zipfel, daneben das News-Symbol, über einem abgedunkelten Hintergrund.
 *
 * Sichtbar nur, wenn der Hinweis aktiv geschaltet ist UND das heutige
 * Datum im eingetragenen Zeitraum liegt. Ein Urlaubshinweis verschwindet
 * dadurch von selbst — niemand muss daran denken.
 *
 * Maße und Farben stammen aus der Vorlage (siehe docs/referenz/).
 *
 * Der Entwurf vom 17. September 2026 zeigt hier eine schlichte Karte
 * ohne Zipfel. Die Sprechblase bleibt (CLAUDE.md nennt sie die
 * wichtigste Funktion für die Praxis, und sie ist das Erkennungsbild
 * der alten Seite); übernommen sind Kicker, die leichte Überschrift mit
 * bewegtem Verlauf und der Knopf der ganzen Seite.
 */
import daten from '../content/hinweis.json';

const heute = new Date().toISOString().slice(0, 10);
const sichtbar =
  daten.aktiv &&
  (!daten.von || heute >= daten.von) &&
  (!daten.bis || heute <= daten.bis);

// Kennung des Hinweises: ändert sich der Text, meldet sich die Blase erneut
const kennung = `hinweis-${daten.von}-${daten.bis}-${daten.titel}`;
---

{sichtbar && (
  <div
    class="hinweis"
    id="information"
    data-kennung={kennung}
    data-einmalig={daten.einmal_pro_besuch ? 'ja' : 'nein'}
    role="dialog"
    aria-modal="true"
    aria-labelledby="hinweis-titel"
    hidden
  >
    <div class="hinweis__blase-umgebung">
      <img class="hinweis__symbol" src="/icons/navigation/neuigkeiten.svg" alt="" width="80" height="80" />
      <img class="hinweis__zipfel" src="/icons/ui/sprechblase-zipfel.png" alt="" width="30" height="100" />

      <div class="hinweis__blase">
        <button class="hinweis__schliessen" type="button" aria-label="Hinweis schließen"></button>
        <div class="kicker kicker--klein">Hinweis</div>
        <h2 class="hinweis__titel verlauf" id="hinweis-titel">{daten.titel}</h2>
        <div class="hinweis__text redaktionstext" set:html={daten.text} />

        {daten.mehr_erfahren_ziel && (
          <div class="hinweis__mehr">
            <a class="kn kn--voll" href={daten.mehr_erfahren_ziel}>
              <span class="kn__f" aria-hidden="true"></span>
              {daten.mehr_erfahren_text || 'Mehr erfahren'}
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
)}

<style>
  .hinweis {
    position: fixed;
    inset: 0;
    z-index: var(--ebene-hinweis);
    display: flex;
    align-items: center;
    justify-content: center;
    /* Aubergine, stark abgedunkelt — Wert aus der Vorlage */
    /* Ablauf a-36: Hintergrund dunkelt in 500 ms nach */
    background-color: #13000d99;
    padding: var(--abstand-m);
    transition: background-color 500ms linear;
  }

  .hinweis[data-schliesst] { background-color: rgb(255 255 255 / 0%); }

  .hinweis[hidden] { display: none; }

  .hinweis[data-offen] .hinweis__blase-umgebung { transform: translateX(0); }

  .hinweis[data-schliesst] .hinweis__blase-umgebung {
    transform: translateX(-100vw);
    transition: transform 800ms cubic-bezier(0.55, 0.055, 0.675, 0.19);
  }

  /* Ablauf a-36: fährt von links herein, 800 ms outCubic mit
     400 ms Verzögerung. a-30 schließt in 800 ms inCubic. */
  .hinweis__blase-umgebung {
    transform: translateX(-100vw);
    transition: transform 800ms cubic-bezier(0.215, 0.61, 0.355, 1) 400ms;
    display: flex;
    align-items: flex-start;
    width: 100%;
    max-width: var(--breite-inhalt);
    padding-inline: var(--abstand-l);
  }

  .hinweis__symbol {
    flex: none;
    width: 5rem;
    height: 5rem;
    /* Symbol weiß einfärben — wie in der Vorlage */
    filter: brightness(0) invert(1);
  }

  .hinweis__zipfel {
    flex: none;
    width: 30px;
    height: 100px;
    margin-left: 5px;
    object-fit: contain;
    object-position: right bottom;
  }

  .hinweis__blase {
    position: relative;
    background: var(--farbe-flaeche);
    border-radius: 30px;
    padding: var(--abstand-l) var(--abstand-l) var(--abstand-m);
    max-width: 34rem;
    max-height: 80vh;
    overflow-y: auto;
  }

  .hinweis__schliessen {
    position: absolute;
    top: var(--abstand-m);
    right: var(--abstand-m);
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: url('/icons/ui/schliessen.svg') center / contain no-repeat transparent;
    cursor: pointer;
    /* Dreht sich beim Zeigen — wie in der Vorlage (a-34 / a-35) */
    /* Ablauf a-34 / a-35: 300 ms, outQuad */
    transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hinweis__schliessen:hover,
  .hinweis__schliessen:focus-visible {
    transform: rotate(90deg);
  }

  .hinweis__titel {
    margin: 16px 0 var(--abstand-s);
    padding-right: var(--abstand-l);
    font-size: 34px;
    font-weight: var(--gewicht-leicht);
    line-height: 1.16;
    letter-spacing: -0.011em;
  }

  @media (max-width: 30rem) {
    .hinweis__titel { font-size: 28px; }
  }

  .hinweis__text :global(p) {
    margin-bottom: var(--abstand-2xs);
  }

  .hinweis__text :global(p:last-child) {
    margin-bottom: 0;
  }

  .hinweis__mehr {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    width: 100%;
    margin-top: 28px;
  }

  @media (max-width: 40rem) {
    .hinweis__blase-umgebung {
      flex-direction: column;
      padding-inline: 0;
    }
    .hinweis__zipfel { display: none; }
    .hinweis__symbol { margin-bottom: var(--abstand-s); }
  }
</style>

<script>
  /**
   * Zeigt die Sprechblase kurz nach dem Laden.
   * Wurde sie in diesem Besuch schon weggeklickt, bleibt sie fort —
   * gespeichert wird das nur im Browser des Besuchers.
   */
  function hinweisAufbauen() {
    const kasten = document.querySelector<HTMLElement>('.hinweis');
    if (!kasten || kasten.dataset.bereit) return;
    kasten.dataset.bereit = 'ja';

    const kennung = kasten.dataset.kennung ?? 'hinweis';
    const einmalig = kasten.dataset.einmalig === 'ja';

    let schonGesehen = false;
    try {
      schonGesehen = einmalig && sessionStorage.getItem(kennung) === 'gesehen';
    } catch {
      // Manche Browser verbieten den Zugriff — dann eben immer zeigen.
    }
    if (schonGesehen) return;

    // Merken, wohin der Fokus nach dem Schließen zurückkehrt
    const zuletztFokussiert = document.activeElement as HTMLElement | null;

    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const schliessen = () => {
      try { sessionStorage.setItem(kennung, 'gesehen'); } catch { /* egal */ }
      if (ruhig) { kasten.hidden = true; zuletztFokussiert?.focus(); return; }
      kasten.removeAttribute('data-offen');
      kasten.setAttribute('data-schliesst', 'ja');
      window.setTimeout(() => { kasten.hidden = true; kasten.removeAttribute('data-schliesst'); }, 800);
      zuletztFokussiert?.focus();
    };

    kasten.hidden = false;
    // Zwei Bilder abwarten, damit der Ausgangszustand gezeichnet ist
    requestAnimationFrame(() => requestAnimationFrame(() => {
      kasten.setAttribute('data-offen', 'ja');
    }));
    kasten.querySelector<HTMLButtonElement>('.hinweis__schliessen')?.focus();

    kasten.querySelector('.hinweis__schliessen')?.addEventListener('click', schliessen);

    // Klick auf den abgedunkelten Hintergrund schließt ebenfalls
    kasten.addEventListener('click', (e) => {
      if (e.target === kasten) schliessen();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !kasten.hidden) schliessen();
    });
  }

  hinweisAufbauen();
  // Nach einem Seitenwechsel erneut aufbauen
  document.addEventListener('astro:page-load', hinweisAufbauen);
</script>
