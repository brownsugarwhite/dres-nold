---
/**
 * Eine Beitragskarte: Bild, darunter Zeile, Überschrift, Anriss und
 * „Beitrag lesen" — ohne Rahmen und ohne Kasten (Florian, 17. September
 * 2026). Ein Klick morpht sie in die Seite, die sie ankündigt.
 *
 * Genutzt von den Blogs (Blog.astro, früher Neuigkeiten.astro) und von
 * der Ankündigung einer eigenen Seite auf der Startseite
 * (SeitenTeaser.astro) — dort in der breiten Form: Bild links, Text
 * rechts, auf Handys untereinander.
 *
 * Beim Zeigen vergrößert sich das Bild innerhalb seines Ausschnitts
 * (Handoff, 17. September 2026). Den Übergangsnamen trägt deshalb der
 * Ausschnitt und nicht das Bild: Seine Kante steht still, also beginnt
 * der Morph genau dort, wo das Bild gerade steht — ohne Sprung
 * (Florian, 18. September 2026). Die Zielseite trägt dieselben Namen
 * (layouts/Inhaltsseite.astro); beide bildet `morphName()`.
 *
 * Beim Scrollen wächst das Bild zusätzlich langsam — dieselbe Bewegung
 * wie das Gruppenfoto im Team-Abschnitt (Ablauf a-3, scripts/bildlauf.ts).
 */
import { existsSync } from 'node:fs';
import { trennen } from '../lib/silben';
import { morphName } from '../lib/aufbau';

interface Props {
  href: string;
  bild?: string;
  bild_alt?: string;
  /** Datum (JJJJ-MM-TT) — erscheint als kleine Zeile über dem Titel */
  datum?: string;
  /** Statt eines Datums: eine kleine Zeile über dem Titel */
  kicker?: string;
  titel: string;
  kurz?: string;
  mehr?: string;
  /** Die Überschriftenebene: h3 in einer Liste, h2 als Ankündigung */
  ebene?: 'h2' | 'h3';
  breit?: boolean;
}

const { href, bild = '', bild_alt = '', datum = '', kicker = '', titel, kurz = '', mehr = 'Beitrag lesen', ebene = 'h3', breit = false } = Astro.props;
const Titel = ebene;
const name = morphName(href);

/* Die 600-px-Variante der Karte (scripts/bilder-varianten.mjs) — wenn
   sie da ist; sonst das Original (etwa im Entwicklungsmodus vor dem
   ersten Build). Die breite Karte nimmt die 900er. */
const bildKlein = (pfad: string) => {
  const m = /^(.*)\.(jpe?g|png)$/i.exec(pfad);
  if (!m) return pfad;
  const variante = `${m[1]}-${breit ? 900 : 600}.${m[2]}`;
  return existsSync(`public${variante}`) ? variante : pfad;
};

const alsDatum = (iso: string) =>
  iso ? new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
---

<article class:list={['beitrag', { 'beitrag--breit': breit }]} data-rein>
  <a class="beitrag__link" data-karte href={href} transition:name={`beitrag-${name}`}>
    {bild && (
      <span class="beitrag__ausschnitt" transition:name={`beitrag-bild-${name}`}>
        {/* Drei Ebenen, damit sich die Bewegungen nicht ins
            Gehege kommen: Der Ausschnitt steht still, der Lauf
            trägt die Skalierung beim Scrollen, das Bild die
            beim Zeigen. Zwei `transform` auf einem Element
            ließen sich nicht getrennt überblenden. */}
        <span class="beitrag__lauf" data-bildlauf>
          {/* Die kleine Variante und `decoding="sync"`: Safari dekodiert
              große Bilder asynchron und legt beim Seitenwechsel die Ebene
              des Bildes neu an — die Karte blitzte dabei für ein Bild weiß
              auf, vor dem Morph und nach dem Rückweg (Florian,
              27. September 2026). Klein und synchron dekodiert gibt es
              dieses Bild nicht. */}
          <img class="beitrag__bild" src={bildKlein(bild)} alt={bild_alt} width={breit ? 900 : 600} height={breit ? 506 : 338} loading="lazy" decoding="sync" />
        </span>
      </span>
    )}
    <span class="beitrag__text">
      {datum && <time class="beitrag__datum kicker kicker--klein" datetime={datum}>{alsDatum(datum)}</time>}
      {!datum && kicker && <span class="beitrag__datum kicker kicker--klein">{kicker}</span>}
      <Titel class="beitrag__titel ohne-verlauf">{titel}</Titel>
      {kurz && <span class="beitrag__kurz">{trennen(kurz)}</span>}
      <span class="beitrag__mehr">
        <span class="tl">
          {mehr}
          <span class="tl__pfeil" aria-hidden="true">
            <svg viewBox="0 0 9 14" focusable="false">
              <polyline fill="none" stroke="currentColor" stroke-miterlimit="10" points="2 2 7 7 2 12" />
            </svg>
          </span>
        </span>
      </span>
    </span>
  </a>
</article>

<style>
  .beitrag { margin: 0; }

  /* Ohne Rahmen und ohne Kasten: Die Karte ist das Bild mit dem Text
     darunter, mehr braucht sie nicht (Florian, 17. September 2026).
     Zusammengehalten wird sie beim Zeigen allein von der Bewegung —
     das Bild wächst, die Karte hebt sich leicht. */
  .beitrag__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    color: var(--farbe-text);
    text-decoration: none;
    transition: transform 0.45s var(--verlauf-betont);
  }

  /* Zeige-Zustände nur, wo es einen Zeiger gibt. Auf Touch-Geräten löst
     der Tipp Hover UND Klick zugleich aus: Die Karte begann ihre
     Anhebung, das Bild sein Wachsen, und der Seitenwechsel schaltete im
     selben Moment die Überblendung ab — ein Sprung vor dem Morph; nach
     dem Rückweg hing der Hover noch am Ziel und löste sich später — ein
     Sprung danach (Florian, 27. September 2026). */
  .beitrag__link:focus-visible {
    transform: translateY(-3px);
  }

  @media (hover: hover) {
    .beitrag__link:hover { transform: translateY(-3px); }
  }

  /* Der Ausschnitt steht still, das Bild darin wächst.

     Er ist es deshalb auch, der den Übergangsnamen trägt: Seine Kante
     ist genau das, was man sieht — egal, wie weit das Bild darin beim
     Zeigen oder beim Scrollen gerade vergrößert ist. Der Morph beginnt
     damit exakt an der sichtbaren Kante, statt vorher auf die
     unvergrößerte Lage zurückzuspringen (Florian, 18. September 2026). */
  .beitrag__ausschnitt {
    display: block;
    overflow: hidden;
  }

  /* Ablauf a-3, wie beim Gruppenfoto des Teams: Über den Scrollweg
     wächst das Bild von 1 auf 1,1. Den Wert setzt das Skript unten;
     eine Überblendung steht hier bewusst nicht, der Wert wird in jedem
     Bild neu gesetzt und läuft im Skript schon weich nach. */
  .beitrag__lauf {
    display: block;
    transform: scale(var(--bild-groesse, 1));
  }

  .beitrag__bild {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.55s var(--verlauf-betont);
  }

  /* Die Gruppe „bild" (styles/uebergaenge.css: Abbild der Karte
     entfällt, Zoom) am Ausschnitt der morphenden Karte */
  .beitrag__link[data-morph] .beitrag__ausschnitt { view-transition-class: bild; }

  .beitrag__link:focus-visible .beitrag__bild {
    transform: scale(1.07);
  }

  @media (hover: hover) {
    .beitrag__link:hover .beitrag__bild { transform: scale(1.07); }
  }

  /* Nur der Beitrag, der gerade morpht, bekommt Übergangsebenen — alle
     anderen geben ihre Namen ab, genau wie die Leistungskacheln
     (LeistungKachel.astro). Ein Versuch mit dauerhaften Namen (27.
     September 2026) brachte nichts gegen das Blitzen und ließ den
     Nachbarn mit eigener Ebene statt mit der Seite erscheinen. */
  .beitrag__link[data-morph] {
    view-transition-class: karte;
  }

  .beitrag__link:not([data-morph]),
  .beitrag__link:not([data-morph]) .beitrag__ausschnitt {
    view-transition-name: none;
  }

  /* Beim Klick bleibt alles stehen, wie es steht: Der Ausschnitt trägt
     den Übergangsnamen und ändert seine Größe durch Zeigen und Scrollen
     ohnehin nicht — der Morph beginnt also genau am sichtbaren Bild.

     Nur die Überblendungen werden angehalten, damit während der
     Momentaufnahme nichts mehr nachläuft. Vorher wurden hier die
     Vergrößerungen zurückgesetzt; das war der Sprung, den man sah
     (Florian, 18. September 2026). */
  .beitrag__link[data-morph],
  .beitrag__link[data-morph] .beitrag__bild {
    transition: none;
  }

  /* Ohne eigenen Übergangsnamen: Datum, Überschrift und Anriss gehören
     zur Karte, machen deren Bewegung und Skalierung mit und blenden
     dabei aus — siehe styles/uebergaenge.css */
  /* Kein Innenabstand seitlich mehr — der Text steht bündig unter dem
     Bild, weil es keinen Kasten gibt, von dem er einrücken müsste. */
  .beitrag__text {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 11px;
    padding: 22px 0 0;
  }

  .beitrag__datum { letter-spacing: 0.16em; }

  .beitrag__titel {
    margin: 0;
    color: var(--farbe-primaer);
    font-size: 21px;
    font-weight: var(--gewicht-titel);
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .beitrag__kurz {
    /* Als Block, damit der Blocksatz (global.css) greift */
    display: block;
    color: var(--farbe-text-gedeckt);
    font-size: 16px;
    line-height: 1.6;
  }

  .beitrag__mehr {
    margin-top: auto;
    padding-top: 10px;
  }

  @media (prefers-reduced-motion: reduce) {
    .beitrag__link,
    .beitrag__bild { transition: none; }
    .beitrag__lauf { transform: none; }
    .beitrag__link:hover,
    .beitrag__link:focus-visible { transform: none; }
    .beitrag__link:hover .beitrag__bild,
    .beitrag__link:focus-visible .beitrag__bild { transform: none; }
  }

  /* ---- Die breite Karte: Ankündigung einer eigenen Seite ----
     Eine einzelne Karte im Raster der Beiträge ließe zwei Drittel der
     Zeile leer. Breit steht das Bild links über gut die Hälfte, der
     Text rechts daneben, unten bündig (Oktober 2026). */
  .beitrag--breit .beitrag__link {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  .beitrag--breit .beitrag__text {
    padding: 0;
    gap: 14px;
  }

  .beitrag--breit .beitrag__titel {
    font-size: var(--text-titel);
    line-height: 1.12;
    letter-spacing: -0.010em;
  }

  .beitrag--breit .beitrag__kurz {
    font-size: 17px;
    line-height: var(--zeilenhoehe-lese);
  }

  .beitrag--breit .beitrag__mehr { margin-top: 8px; }

  @media (max-width: 800px) {
    .beitrag--breit .beitrag__link {
      display: flex;
      gap: 0;
    }

    .beitrag--breit .beitrag__text { padding-top: 22px; gap: 11px; }
  }
</style>

<script>
  /* Ablauf a-3 auf den Beitragsbildern: das gemeinsame Skript
     scripts/bildlauf.ts */
  import '../scripts/bildlauf';
</script>
