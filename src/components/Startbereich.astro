---
/**
 * Startbereich — das große Logo beim Öffnen der Seite.
 *
 * Nachbau aus der Vorlage:
 *   .landing     Logo, am Bildschirm fixiert, füllt die Höhe
 *   .start_space Weiße Fläche darunter (130vh) — schafft den Scrollweg,
 *                über den das Logo animiert wird
 *   .fixedbg     Grauer Grund mit Symbolmuster dahinter
 *
 * Ablauf `a-7` (PAGE_SCROLL): Über die ersten 10 % des Scrollwegs
 * skaliert das Logo auf 1,3, wandert 30 px nach unten, spielt dabei
 * seine Lottie-Animation ab und blendet aus.
 *
 * Ohne JavaScript und bei reduzierter Bewegung steht das statische
 * Logo — die Seite ist nie leer.
 */
import seite from '../content/seite.json';
const { praxis } = seite;
---

<div class="grund" aria-hidden="true"></div>

<div class="startbereich" data-startbereich>
  <div class="startbereich__mitte">
    <div class="logo">
      {/*
        Zwei exakt deckungsgleiche Ebenen:
        unten der bewegte Verlauf, darüber die Lottie-Kontur.
        Die Kontur ist eine weiße Fläche mit ausgestanzter Schrift —
        dadurch scheint der Verlauf genau durch die Buchstaben.
      */}
      <div class="logo__kontur" data-logo>
        <img
          class="logo__bild"
          src="/icons/logo.svg"
          alt={praxis.name}
          width="868"
          height="590"
        />
      </div>
      <div class="logo__verlauf" aria-hidden="true"></div>
    </div>

    <div class="scrollhinweis" aria-hidden="true">
      <p class="scrollhinweis__text">
        Scrollen Sie, um mehr von unserer Praxis zu entdecken
      </p>
      <span class="scrollhinweis__pfeil"></span>
    </div>
  </div>
</div>

{/* Schafft den Scrollweg, über den das Logo animiert wird */}
<div class="startraum" aria-hidden="true"></div>

<style>
  .grund {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: #f3f3f3 url('/bilder/deko/icon-hintergrund.png') center / 600px;
  }

  .startbereich {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    pointer-events: none;
  }

  .startbereich__mitte {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
  }

  /* Logo — Maße aus der Vorlage (.logo, .logo-wrapper) */
  .logo {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* Auch die Fensterbreite begrenzen — sonst ragt das Logo auf
       Handys seitlich hinaus (50vh sind dort breiter als der Schirm). */
    width: min(50vh, 84vw);
    height: min(40vh, 67vw);
    margin-top: -100px;
    margin-left: -50px;
    /* Auf schmalen Schirmen mittig statt versetzt */
    @media (max-width: 40rem) {
      margin-left: 0;
      margin-top: -40px;
    }
    /* Wird vom Skript am Scrollfortschritt entlang gesetzt */
    transform: scale(var(--logo-groesse, 1)) translateY(var(--logo-versatz, 0px));
    opacity: var(--logo-deckkraft, 1);
    will-change: transform, opacity;
  }

  /* Der bewegte Verlauf, der die Schrift des Logos einfärbt.

     Die Lottie-Grafik darüber ist eine weiße Fläche mit ausgesparter
     Schrift — der Verlauf scheint also genau durch die Buchstaben.
     Entscheidend ist nur, dass er die weiße Fläche nirgends überragt,
     sonst steht er als Farbstreifen daneben.

     Die Vorlage nutzt 48vh × 32vh; hier etwas knapper, weil unsere
     Lottie-Fläche minimal kleiner ausfällt. Das Verlaufsbild selbst
     ist 20 × 10 px und enthält nur Farbtöne ohne Struktur — seine
     genaue Größe ist deshalb unkritisch. */
  /* Verlaufsbild unter der Logo-Grafik — Maße und Versatz wie
     .div-block-29 in der Vorlage. Beide Elemente stehen im normalen
     Fluss, der negative Abstand schiebt den Verlauf hinter die Grafik. */
  .logo__verlauf {
    z-index: 10;
    width: 48vh;
    height: 27vh;
    /* Etwas tiefer als in der Vorlage: Die weisse Flaeche der Grafik
       reicht oben nicht ganz bis zum Rand, dort stuende der Verlauf
       sonst frei. Die Schrift sitzt im unteren Teil und bleibt so
       vollstaendig gefaerbt. */
    margin-top: -31vh;
    background: url('/bilder/deko/verlauf.gif') center / cover no-repeat;
  }

  .logo__kontur {
    z-index: 20;
    width: 100%;
    height: 100%;
  }

  .logo__bild {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Läuft die Lottie-Animation, tritt das statische Bild zurück */
  .logo__kontur[data-lottie-bereit] .logo__bild {
    display: none;
  }



  /* Scroll-Hinweis darunter */
  .scrollhinweis {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--abstand-m);
  }

  .scrollhinweis__text {
    max-width: 250px;
    margin: 0 0 var(--abstand-2xs);
    color: var(--farbe-primaer);
    font-size: 1rem;
    font-weight: 300;
    text-align: center;
  }

  .scrollhinweis__pfeil {
    width: 40px;
    height: 20px;
    background: url('/icons/ui/pfeil-runter.svg') center / contain no-repeat;
  }

  .startraum {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 130vh;
    height: 130dvh;
    background: var(--farbe-flaeche);
  }

  @media (prefers-reduced-motion: reduce) {
    .startbereich__logo {
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { ladeAnimation, anScrollKoppeln } from '../scripts/lottie';

  function startbereichAufbauen() {
    const bereich = document.querySelector<HTMLElement>('[data-startbereich]');
    const logo = document.querySelector<HTMLElement>('[data-logo]');
    const huelle = logo?.closest<HTMLElement>('.logo');
    if (!bereich || !logo || logo.dataset.bereit) return;
    logo.dataset.bereit = 'ja';

    const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (wenigerBewegung) return;

    /** Anteil des Startbereichs, der bereits weggescrollt ist (0 … 1). */
    const fortschritt = () => {
      const weg = window.innerHeight * 1.3; // Höhe von .startraum
      return weg > 0 ? window.scrollY / weg : 0;
    };

    let geplant = false;
    const zeichnen = () => {
      geplant = false;
      // Die Vorlage nutzt die ersten 10 % des Scrollwegs
      const p = Math.min(1, Math.max(0, fortschritt() / 0.1));
      huelle?.style.setProperty('--logo-groesse', String(1 + 0.3 * p));
      huelle?.style.setProperty('--logo-versatz', `${30 * p}px`);
      huelle?.style.setProperty('--logo-deckkraft', String(1 - p));
      // Ist es ganz ausgeblendet, aus dem Weg nehmen
      bereich.style.visibility = p >= 1 ? 'hidden' : '';
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(zeichnen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    zeichnen();

    // Lottie-Logo nachladen und ebenfalls an den Scrollweg koppeln
    // Bild 0 zeigt das Logo, Bild 99 ist leer. Beim Scrollen läuft die
    // Animation vorwärts und gibt den Blick frei — wie in Ablauf a-7.
    ladeAnimation(logo, '/lottie/logo.json').then((spieler) => {
      if (!spieler) return;
      spieler.goToAndStop(0, true);
      anScrollKoppeln(spieler, () => fortschritt() / 0.1);
    });
  }

  startbereichAufbauen();
  document.addEventListener('astro:page-load', startbereichAufbauen);
</script>
