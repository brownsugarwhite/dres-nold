---
/**
 * Startbereich — das große Logo beim Öffnen der Seite.
 *
 * Nachbau aus der Vorlage:
 *   .landing     Logo, am Bildschirm fixiert, füllt die Höhe
 *   .start_space Weiße Fläche darunter (130vh) — schafft den Scrollweg,
 *                über den das Logo animiert wird
 *
 * Der graue Symbolgrund der Vorlage (`.fixedbg`) entfällt: Das Logo
 * steht auf Weiß, und auch weiter unten scheint kein Kachelmuster mehr
 * hinter dem Kontaktbereich durch (Florian, 17. September 2026).
 *
 * Ablauf `a-7` (PAGE_SCROLL): Über die ersten 10 % des Scrollwegs
 * skaliert das Logo auf 1,3, wandert 30 px nach unten, spielt dabei
 * seine Lottie-Animation ab und blendet aus.
 *
 * Ohne JavaScript und bei reduzierter Bewegung steht das statische
 * Logo — die Seite ist nie leer.
 */
import seite from '../content/seite.json';
const { praxis } = seite;
---

<div class="startbereich" data-startbereich>
  <div class="startbereich__mitte">
    <div class="logo">
      {/*
        Zwei exakt deckungsgleiche Ebenen:
        unten der bewegte Verlauf, darüber die Lottie-Kontur.
        Die Kontur ist eine weiße Fläche mit ausgestanzter Schrift —
        dadurch scheint der Verlauf genau durch die Buchstaben.
      */}
      <div class="logo__kontur" data-logo>
        <img
          class="logo__bild"
          src="/icons/logo.svg"
          alt={praxis.name}
          width="868"
          height="590"
        />
      </div>
      <div class="logo__verlauf" aria-hidden="true"></div>
    </div>

    <div class="scrollhinweis" aria-hidden="true">
      <p class="scrollhinweis__text">
        Scrollen Sie, um mehr von unserer Praxis zu entdecken
      </p>
      <span class="scrollhinweis__pfeil"></span>
    </div>
  </div>
</div>

{/*
  In der Vorlage folgt hier `.start_space` mit 130vh — der Scrollweg,
  über den das Logo animiert wird. Bei uns entfällt er: Ablauf a-7
  hängt an PAGE_SCROLL, das Logo rechnet also mit dem gesamten
  Dokument, und die 350vh der Sprechstunden liegen ohnehin davor.
  Stünde der Raum trotzdem hier, wäre er nach den Sprechstunden eine
  bildschirmfüllende leere Fläche vor der Begrüßung.
*/}

<style>
  .startbereich {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    pointer-events: none;
  }

  .startbereich__mitte {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
  }

  /* Auf Handys sitzt der Block etwas tiefer: Oben steht nur die schmale
     Kontaktzeile, unten die 110 px hohe Symbolleiste — mittig wirkte er
     dadurch nach oben gerutscht (Florian, 18. September 2026). Der
     Innenabstand verschiebt den mittig gesetzten Block um seine Hälfte. */
  @media (max-width: 991px) {
    .startbereich__mitte { padding-top: 12vh; }
  }

  /* Logo — Aufbau und Maße wie in der Vorlage.

     Beide Ebenen stehen im Fluss untereinander: erst die Lottie-Grafik,
     dann der Verlauf, den ein negativer Abstand wieder hinaufzieht. Er
     sitzt dadurch NICHT mittig — und, was entscheidend ist, sein
     Versatz bezieht sich auf die tatsächliche Höhe der Grafik.

     Ab 479 px steht die Grafik auf `height: auto`, ist also nur so hoch,
     wie ihr Seitenverhältnis es vorgibt (868 : 590), und nicht so hoch
     wie das Logo. Genau darum darf der Verlauf dort nicht mittig oder
     mit festem Abstand gesetzt werden: Er stünde unten heraus, sobald
     sich das Logo beim Scrollen auflöst und die weiße Fläche schrumpft.
     Das war die Ursache des sichtbaren Verlaufsrands.

     Die Vorlage wechselt bei 767 und 479 nicht nur die Einheit von vh
     auf vw, sondern auch das Seitenverhältnis des Logos. */
  .logo {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    /* Das Logo wächst über seine MASSE, nicht über `transform`.

       Die Vorlage nimmt hier `transform`. Bei uns zeigt sich damit ein
       heller Saum um das Verlaufsbild — und zwar erst beim Scrollen,
       nicht beim Laden. Gegenprobe, bei der ALLES gleich blieb (gleiches
       Lottie-Bild, gleiches `cover`, gleiche Maße, gleiche Scrollstelle)
       und nur der Skalierungsfaktor wechselte:

           transform: scale(1.15)  →  Saum da
           transform: scale(1)     →  Saum weg

       Es liegt also nicht am Bild und nicht am Lottie-Bild, sondern an
       der Vergrößerung: Der Browser rastert die Zeichenebene einmal und
       skaliert dann das fertige Bild; die Kanten werden dabei
       weichgezeichnet. Beim Laden steht der Faktor auf 1, es gibt keine
       Skalierung — deshalb war es dort immer sauber. Dasselbe hatte
       zuvor schon `will-change: transform` ausgelöst.

       Über Breite und Höhe wird jedes Bild neu gezeichnet statt ein
       fertiges Bild skaliert. Die Bewegung ist dieselbe — das Logo
       wächst von 1 auf 1,3 um seine Mitte, weil `.startbereich__mitte`
       es zentriert hält. Der Aufwand ist vertretbar, es geht um ein
       einzelnes Element. */
    width: calc(var(--logo-breite, 50vh) * var(--logo-groesse, 1));
    height: calc(var(--logo-hoehe, 40vh) * var(--logo-groesse, 1));
    margin-top: -100px;
    margin-left: -50px;
  }

  /* `.lottie-animation-2`: weiße Fläche mit ausgesparter Schrift */
  .logo__kontur {
    position: relative;
    z-index: 20;
    width: 100%;
    height: var(--kontur-hoehe, 100%);
    flex: none;
  }

  /* `.div-block-29`: der bewegte Verlauf, der durch die Buchstaben
     scheint. Der negative Abstand zieht ihn hinter die Grafik. */
  .logo__verlauf {
    position: relative;
    z-index: 10;
    width: calc(var(--verlauf-breite, 48vh) * var(--logo-groesse, 1));
    height: calc(var(--verlauf-hoehe, 32vh) * var(--logo-groesse, 1));
    margin-top: calc(var(--verlauf-versatz, -36vh) * var(--logo-groesse, 1));
    flex: none;
    /* Wie in Webflow eingestellt: Cover, Position 50 % / 50 %, kein Tile.

       Das GIF ist nur 20 × 10 px groß und wird hier rund 30-fach
       vergrößert. Solange das Logo nicht über `transform` skaliert wird,
       zeichnet der Browser es sauber bis an die Kante. */
    background: url('/bilder/deko/verlauf.gif') 50% 50% / cover no-repeat;
    /* Ohne die Lottie-Grafik gibt es keine weiße Fläche, die ihn
       abdeckt — dann stünde hier ein farbiger Kasten hinter dem
       statischen Ersatzbild. */
    visibility: hidden;
  }

  .logo:has(.logo__kontur[data-lottie-bereit]) .logo__verlauf {
    visibility: visible;
  }

  /* Am Ende von Ablauf a-7 hat sich die weiße Fläche der Lottie-Grafik
     aufgelöst. Der Verlauf liegt dann frei und steht als Kasten da.
     Gemessen: bis Fortschritt 0,995 deckt die Fläche noch, bei 1,0
     nicht mehr. Er wird deshalb kurz vorher herausgenommen — sichtbar
     sind zu dem Zeitpunkt ohnehin nur noch einzelne Splitter der
     Buchstaben. */
  .logo[data-ende]:has(.logo__kontur[data-lottie-bereit]) .logo__verlauf {
    visibility: hidden;
  }

  @media (max-width: 991px) {
    .logo { margin-left: -40px; }
  }

  @media (max-width: 767px) {
    .logo {
      --logo-breite: 50vw;
      --logo-hoehe: 40vw;
      --verlauf-breite: 48vw;
      --verlauf-hoehe: 31vw;
      --verlauf-versatz: -35vw;
      margin-left: -30px;
    }
  }

  @media (max-width: 479px) {
    .logo {
      --logo-breite: 80vw;
      --logo-hoehe: 60vw;
      --verlauf-breite: 78vw;
      --verlauf-hoehe: 50vw;
      --verlauf-versatz: -53vw;
      /* `.lottie-animation-2 { height: auto }` der Vorlage */
      --kontur-hoehe: auto;
      margin-top: -180px;
      margin-left: -4px;
    }
    .logo__kontur { aspect-ratio: 868 / 590; }
  }

  .logo__bild {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Läuft die Lottie-Animation, tritt das statische Bild zurück */
  .logo__kontur[data-lottie-bereit] .logo__bild {
    display: none;
  }



  /* Scroll-Hinweis darunter */
  /* Der Scroll-Hinweis schrumpft, sinkt und blendet aus — in der
     Vorlage sind das die Schritte auf `a766a871` in Ablauf a-7. */
  .scrollhinweis {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* In der Vorlage folgt `.scroll2action` ohne Abstand direkt auf das
       Logo (live-webflow.css `.logo` / `.scroll2action`). Der Abstand
       entsteht dort allein aus der Logohöhe. */
    margin-top: 0;
    opacity: var(--hinweis-deckkraft, 1);
    transform: scale(var(--hinweis-groesse, 1)) translateY(var(--hinweis-versatz, 0px));
  }

  /* `.text-block` der Vorlage: 250 px breit, 16 px, 10 px über dem Pfeil.
     Etwas kräftiger als die Vorlage (400 statt 300) und mit engerem
     Zeilenabstand, damit die zwei Zeilen zusammengehören. */
  .scrollhinweis__text {
    max-width: 250px;
    margin: 0 0 10px;
    color: var(--farbe-primaer);
    font-family: var(--schrift-titel);
    font-size: 1rem;
    font-weight: var(--gewicht-normal);
    line-height: 1.25;
    text-align: center;
  }

  /* Sichtbar 32 × 16 — etwas kleiner als die 40 × 20 der Vorlage, neben
     der feinen Schrift wirkte der Haken zu groß (Florian, 18. September
     2026). Der Kasten ist größer, weil die Zeichnung ringsum Rand für
     die Spitze trägt (siehe pfeil-runter.svg). */
  .scrollhinweis__pfeil {
    width: 44px;
    height: 22px;
    background: url('/icons/ui/pfeil-runter.svg') center / contain no-repeat;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo { --logo-groesse: 1; }
    .scrollhinweis { transform: none; opacity: 1; }
  }
</style>

<script>
  import { ladeAnimation, anScrollKoppeln } from '../scripts/lottie';

  function startbereichAufbauen() {
    const bereich = document.querySelector<HTMLElement>('[data-startbereich]');
    const logo = document.querySelector<HTMLElement>('[data-logo]');
    const huelle = logo?.closest<HTMLElement>('.logo');
    if (!bereich || !logo || logo.dataset.bereit) return;
    const hinweis = bereich.querySelector<HTMLElement>('.scrollhinweis');
    logo.dataset.bereit = 'ja';

    const wenigerBewegung = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (wenigerBewegung) return;

    /* Ablauf a-7 ist in der Vorlage an PAGE_SCROLL gehängt: gezählt
       wird der Anteil am GESAMTEN Dokument, nicht am Startbereich. Das
       ist der Grund, warum das Logo so lange stehen bleibt — die Seite
       ist viele Fensterhöhen lang, 10 % davon sind entsprechend weit.
       Genau darüber fahren die Öffnungszeiten herein. */
    /* Gedeckelt auf anderthalb Fensterhöhen: Je länger die Seite wird
       (die Praxis legt Beiträge und Abschnitte an), desto länger wären
       sonst die 10 % — auf Handys stünde das Logo dann noch, wenn die
       Sprechstunden schon darüberfahren. */
    const fortschritt = () => {
      const weg = document.documentElement.scrollHeight - window.innerHeight;
      const logoWeg = Math.min(0.1 * weg, 1.5 * window.innerHeight);
      return logoWeg > 0 ? (window.scrollY / logoWeg) * 0.1 : 0;
    };

    let geplant = false;
    const zeichnen = () => {
      geplant = false;
      // Die Vorlage nutzt die ersten 10 % des Scrollwegs
      const p = Math.min(1, Math.max(0, fortschritt() / 0.1));
      // Das Logo wächst nur — Versatz, Verkleinern und Ausblenden
      // gehören in der Vorlage zum Scroll-Hinweis, nicht zum Logo.
      huelle?.style.setProperty('--logo-groesse', String(1 + 0.3 * p));
      hinweis?.style.setProperty('--hinweis-groesse', String(1 - 0.2 * p));
      hinweis?.style.setProperty('--hinweis-versatz', `${30 * p}px`);
      hinweis?.style.setProperty('--hinweis-deckkraft', String(1 - p));
      // Kurz vor Schluss löst sich die weiße Fläche auf — dann darf der
      // Verlauf nicht mehr stehen bleiben
      if (huelle) {
        if (p >= 0.99) huelle.dataset.ende = 'ja';
        else delete huelle.dataset.ende;
      }
      // Ist es ganz ausgeblendet, aus dem Weg nehmen (bei 10,0001 %)
      bereich.style.visibility = p >= 1 ? 'hidden' : '';
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(zeichnen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    zeichnen();

    // Lottie-Logo nachladen und ebenfalls an den Scrollweg koppeln
    /*
      Ladeanimation (Ablauf a-24):
      Das Logo startet bei Bild 99 — dort ist die Grafik leer. Über
      2500 ms fährt sie auf Bild 0, wodurch das Logo erscheint.
      Erst danach folgt sie dem Scrollweg (Ablauf a-7).
    */
    ladeAnimation(logo, '/lottie/logo.json').then((spieler) => {
      if (!spieler) return;

      /* Die Vorlage arbeitet mit Prozentwerten und trägt hier 99 ein,
         nicht 100 — sowohl für den Startwert der Ladeanimation
         (`data-ix2-initial-state="99"`) als auch für das Ende von
         Ablauf a-7. */
      const ENDE = 0.99;
      const letztes = (spieler.totalFrames - 1) * ENDE;
      spieler.goToAndStop(letztes, true);

      const DAUER = 2500;
      let start: number | null = null;
      let fertig = false;

      const einblenden = (jetzt: number) => {
        if (start === null) start = jetzt;
        const p = Math.min(1, (jetzt - start) / DAUER);
        // Weiche Kurve wie in der Vorlage
        const weich = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
        spieler.goToAndStop(letztes * (1 - weich), true);
        if (p < 1) requestAnimationFrame(einblenden);
        else {
          fertig = true;
          // Ab jetzt folgt das Logo dem Scrollweg
          anScrollKoppeln(spieler, () => fortschritt() / 0.1, ENDE);
        }
      };
      requestAnimationFrame(einblenden);
    });
  }

  startbereichAufbauen();
  document.addEventListener('astro:page-load', startbereichAufbauen);
</script>
