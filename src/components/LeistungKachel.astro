---
import { trennen, trennenTitel } from '../lib/silben';
/**
 * Kachel einer Leistung auf der Startseite.
 *
 * Der `transition:name` verbindet diese Kachel mit dem gleichnamigen
 * Element auf der Zielseite. Der Browser morpht dann beim Klick das
 * eine ins andere — Position, Größe und Form berechnet er selbst.
 *
 * Beim Zeigen: Der Rahmen nimmt die Hausfarbe an, die Kachel hebt sich
 * 3 px, das Symbol wächst leicht. Bewusst OHNE Schlagschatten — der
 * Entwurf sah einen vor, die feine Rahmenbewegung gefällt besser
 * (Florian, 17. September 2026).
 *
 * Beim Scrollen läuft außerdem Ablauf a-8 der Vorlage (Skript unten):
 * Die Kachel wächst von 0,9 auf 1 und ihr Grund hellt dabei von Grau
 * auf Weiß auf. Zwischendurch war das durch das Einblenden aus 18 px
 * Tiefe ersetzt — das war zu wenig, der Ablauf ist wieder da, mitsamt
 * dem Aufhellen (Florian).
 */
interface Props {
  id: string;
  titel: string;
  kurz: string;
  icon: string;
}
const { id, titel, kurz, icon } = Astro.props;
---

<a class="kachel" data-kachel data-karte href={`/leistungen/${id}/`} transition:name={`leistung-${id}`}>
  <img class="kachel__icon" src={icon} alt="" width="64" height="64" transition:name={`leistung-symbol-${id}`} />
  <h3 class="kachel__titel" transition:name={`leistung-titel-${id}`}>{trennenTitel(titel)}</h3>
  <p class="kachel__kurz">{trennen(kurz)}</p>
  <span class="kachel__mehr">
    <span class="tl">
      Mehr erfahren
      <span class="tl__pfeil" aria-hidden="true">
        <svg viewBox="0 0 9 14" focusable="false">
          <polyline fill="none" stroke="currentColor" stroke-miterlimit="10" points="2 2 7 7 2 12" />
        </svg>
      </span>
    </span>
  </span>
</a>

<style>
  .kachel {
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding: 28px 26px 24px;
    /* Der Grund gehört zu Ablauf a-8: grau beim Hereinscrollen, weiß in
       der Mitte des Wegs, am Ende wieder grau. Den Anteil (0 = grau,
       1 = weiß) setzt das Skript unten.

       In Ruhe — und ohne Skript — steht hier Weiß. Die Kachel bleibt
       damit die Kachel ohne eigene Fläche, die nur ihr Rahmen
       abzeichnet (Florian, September 2026); im Seitenwechsel bekommt
       sie ihre deckende Fläche von styles/uebergaenge.css.

       Die erste Zeile ist der Rückfall für Browser ohne color-mix. */
    background: var(--farbe-flaeche);
    background: color-mix(
      in srgb,
      var(--farbe-flaeche) calc(var(--kachel-grund, 1) * 100%),
      var(--farbe-flaeche-kachel)
    );
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius-m);
    text-decoration: none;
    color: var(--farbe-text);
    /* Der zweite Teil von a-8: Über den Scrollweg wächst die Kachel von
       0,9 auf 1 — am Ende wieder zurück. Auch diesen Wert setzt das
       Skript. Die Anhebung beim Zeigen kommt in denselben `transform`;
       deshalb steht die Skalierung dort noch einmal. */
    transform: scale(var(--kachel-groesse, 1));
    transition:
      border-color 0.45s var(--verlauf-betont),
      transform var(--dauer-schnell) var(--verlauf);
  }

  /* Zeige-Zustände nur, wo es einen Zeiger gibt — auf Touch-Geräten
     löste der Tipp sie mit dem Klick zugleich aus, und der Morph begann
     mit einem Sprung (siehe Neuigkeiten.astro; Florian, 27. September
     2026). */
  .kachel:focus-visible {
    border-color: var(--farbe-primaer);
    transform: scale(var(--kachel-groesse, 1)) translateY(-3px);
  }

  .kachel:focus-visible .kachel__icon {
    transform: scale(1.07);
  }

  @media (hover: hover) {
    .kachel:hover {
      border-color: var(--farbe-primaer);
      transform: scale(var(--kachel-groesse, 1)) translateY(-3px);
    }

    .kachel:hover .kachel__icon {
      transform: scale(1.07);
    }
  }

  /*
    ÜBERGANG: nur die eine Karte, die wirklich morpht
    ----------------------------------------------------------------
    `data-morph` setzt scripts/uebergaenge.ts — beim Öffnen auf die
    angeklickte Kachel, beim Schließen auf die, in die zurückgemorpht
    wird.

    Alle anderen Kacheln geben ihre Übergangsnamen ab. Das ist der
    entscheidende Punkt fürs Tempo: Jeder Name erzeugt eine eigene
    Ebene, die der Browser während des Wechsels einzeln zeichnen und
    zusammensetzen muss. Mit zwölf Kacheln à Hülle, Symbol und Titel
    waren das 36 Ebenen statt drei — daher das Ruckeln. Ohne Namen
    stecken sie einfach im Abbild der Seite.

    Nebenbei löst das auch die Stapelfrage: Es gibt gar keine
    Nachbarebenen mehr, hinter denen die Karte liegen könnte.
  */
  .kachel[data-morph] {
    view-transition-class: karte;
  }

  /* Beim Klick bleibt alles stehen, wie es steht — wie bei den
     Beitragskarten (Neuigkeiten.astro, 18. September 2026). Das
     Kennzeichen steht schon VOR der Momentaufnahme; bis zum 26.
     September 2026 setzte diese Regel hier Anhebung, Scroll-Skalierung
     und Grund zurück (`transform: none`, weißer Grund). Das war der
     Sprung, den man sah: Die gezeigte Kachel rutschte 3 px herunter und
     wuchs um ihre Scroll-Skalierung, bevor der Morph begann (Florian).
     Der Browser nimmt Anhebung, Skalierung und das vergrößerte Symbol
     in die Ausgangslage der Hüllen auf — der Morph beginnt also genau
     dort, wo die Kachel gerade steht; ein grauer Grund blendet im
     Kreuzen der Abbilder nach Weiß. */

  .kachel:not([data-morph]),
  .kachel:not([data-morph]) .kachel__icon,
  .kachel:not([data-morph]) .kachel__titel {
    view-transition-name: none;
  }

  .kachel__icon {
    width: 46px;
    height: 46px;
    object-fit: contain;
    transition: transform 0.55s var(--verlauf-betont);
    /* Gruppe für den Übergang, siehe styles/uebergaenge.css */
    view-transition-class: symbol;
  }

  .kachel__titel {
    margin: 0;
    color: var(--farbe-primaer);
    font-size: 19px;
    font-weight: var(--gewicht-titel);
    line-height: 1.3;
    letter-spacing: -0.012em;
    view-transition-class: titel;
  }

  .kachel__kurz {
    margin: 0;
    max-width: none;
    color: var(--farbe-text-gedeckt);
    font-size: 15px;
    line-height: 1.6;
  }

  .kachel__mehr {
    margin-top: auto;
    padding-top: 14px;
  }

  /* Handys: kompakter. Symbol links neben dem Titel statt darüber,
     weniger Innenabstand — sonst stehen zwölf Kacheln à 200 px
     untereinander. */
  @media (max-width: 600px) {
    .kachel {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: var(--abstand-2xs) var(--abstand-s);
      align-items: center;
      padding: var(--abstand-s);
    }

    .kachel__icon {
      grid-row: 1;
      width: 2.5rem;
      height: 2.5rem;
    }

    .kachel__titel {
      grid-row: 1;
      font-size: var(--text-m);
    }

    .kachel__kurz {
      grid-column: 1 / -1;
      /* Anriss auf zwei Zeilen begrenzen */
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* „Mehr erfahren" ist auf dem Handy überflüssig — die ganze
       Kachel ist ohnehin anklickbar. */
    .kachel__mehr { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kachel,
    .kachel__icon { transition: none; transform: none; }
    .kachel:hover,
    .kachel:focus-visible { transform: none; }
    .kachel:hover .kachel__icon,
    .kachel:focus-visible .kachel__icon { transform: none; }
  }
</style>

<script>
  /**
   * Ablauf a-8: Die Kacheln wachsen beim Hereinscrollen von 0,9 auf 1;
   * am Ende des Scrollwegs geht der Wert zurück.
   *
   *   0 %   Skalierung 0,9   Grund grau
   *  30 %   Skalierung 1     Grund weiß
   *  75 %   unverändert
   * 100 %   Skalierung 0,9   Grund grau
   *
   * Beide Werte gehen als Anteil an die Kachel: `--kachel-groesse` als
   * Faktor, `--kachel-grund` als Mischung zwischen `--farbe-flaeche-kachel`
   * (0) und Weiß (1). Die Vorlage blendet #f1f1f1 auf Weiß; das Token
   * hat denselben Helligkeitsschritt, nur in der Farbfamilie der Seite.
   */
  function kachelnAufbauen() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const kacheln = [...document.querySelectorAll<HTMLElement>('[data-kachel]')];
    if (!kacheln.length || kacheln[0].dataset.bereit) return;
    kacheln.forEach((k) => { k.dataset.bereit = 'ja'; });

    const zwischen = (p: number, vonP: number, bisP: number, vonW: number, bisW: number) => {
      if (p <= vonP) return vonW;
      if (p >= bisP) return bisW;
      return vonW + ((p - vonP) / (bisP - vonP)) * (bisW - vonW);
    };

    let geplant = false;
    const zeichnen = () => {
      geplant = false;
      kacheln.forEach((k) => {
        const r = k.getBoundingClientRect();
        const weg = window.innerHeight + r.height;
        const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / weg));

        const groesse = p < 0.3 ? zwischen(p, 0, 0.3, 0.9, 1)
                      : p > 0.75 ? zwischen(p, 0.75, 1, 1, 0.9)
                      : 1;

        const grund = p < 0.3 ? zwischen(p, 0, 0.3, 0, 1)
                    : p > 0.75 ? zwischen(p, 0.75, 1, 1, 0)
                    : 1;

        k.style.setProperty('--kachel-groesse', groesse.toFixed(3));
        k.style.setProperty('--kachel-grund', grund.toFixed(3));
      });
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(zeichnen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    zeichnen();
  }

  kachelnAufbauen();
  document.addEventListener('astro:page-load', kachelnAufbauen);
</script>
