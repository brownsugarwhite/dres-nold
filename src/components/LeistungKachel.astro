---
/**
 * Kachel einer Leistung auf der Startseite.
 *
 * Der `transition:name` verbindet diese Kachel mit dem gleichnamigen
 * Element auf der Zielseite. Der Browser morpht dann beim Klick das
 * eine ins andere — Position, Größe und Form berechnet er selbst.
 */
interface Props {
  id: string;
  titel: string;
  kurz: string;
  icon: string;
}
const { id, titel, kurz, icon } = Astro.props;
---

<a class="kachel" data-kachel data-karte href={`/leistungen/${id}/`} transition:name={`leistung-${id}`}>
  <img class="kachel__icon" src={icon} alt="" width="64" height="64" transition:name={`leistung-symbol-${id}`} />
  <h3 class="kachel__titel" transition:name={`leistung-titel-${id}`}>{titel}</h3>
  <p class="kachel__kurz">{kurz}</p>
  <span class="kachel__mehr" aria-hidden="true">Mehr erfahren →</span>
</a>

<style>
  .kachel {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-2xs);
    padding: var(--abstand-m);
    background: var(--farbe-flaeche);
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius-m);
    text-decoration: none;
    color: var(--farbe-text);
    /* Ablauf a-8: Über den Scrollweg wächst die Kachel von 0,9 auf 1
       und ihr Grund hellt von #f1f1f1 auf Weiß auf — am Ende wieder
       zurück. Die Werte setzt das Skript. */
    transform: scale(var(--kachel-groesse, 1));
    background-color: var(--kachel-grund, #fff);
    transition:
      border-color var(--dauer-schnell) var(--verlauf),
      box-shadow var(--dauer-schnell) var(--verlauf),
      transform var(--dauer-schnell) var(--verlauf);
  }

  .kachel:hover,
  .kachel:focus-visible {
    border-color: var(--farbe-primaer);
    transform: scale(var(--kachel-groesse, 1)) translateY(-2px);
  }

  /* Angeklickt: legt nur den Schatten darunter — das Größerwerden
     übernimmt der Übergang selbst, damit es EINE Bewegung bleibt
     (styles/uebergaenge.css). */
  .kachel[data-gehoben] {
    position: relative;
    z-index: 2;
    border-color: transparent;
    background-color: var(--farbe-flaeche);
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 30%);
  }

  /* Handys: kompakter. Symbol links neben dem Titel statt darüber,
     weniger Innenabstand, Anriss auf zwei Zeilen — sonst stehen zwölf
     Kacheln à 200 px untereinander. */
  @media (max-width: 600px) {
    .kachel {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: var(--abstand-2xs) var(--abstand-s);
      align-items: center;
      padding: var(--abstand-s);
    }

    .kachel__icon {
      grid-row: 1;
      width: 2.5rem;
      height: 2.5rem;
    }

    .kachel__titel {
      grid-row: 1;
      font-size: var(--text-m);
    }

    .kachel__kurz {
      grid-column: 1 / -1;
      -webkit-line-clamp: 2;
    }

    /* „Mehr erfahren →" ist auf dem Handy überflüssig — die ganze
       Kachel ist ohnehin anklickbar. */
    .kachel__mehr { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kachel { transform: none; background-color: #fff; }
  }

  .kachel__icon {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    /* Gruppe für den Übergang, siehe styles/uebergaenge.css */
    view-transition-class: symbol;
  }

  .kachel__titel {
    margin: 0;
    font-size: var(--text-l);
    view-transition-class: titel;
  }

  .kachel__kurz {
    margin: 0;
    font-size: var(--text-s);
    color: var(--farbe-text-gedeckt);
    /* Anriss auf drei Zeilen begrenzen */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .kachel__mehr {
    margin-top: auto;
    padding-top: var(--abstand-2xs);
    font-size: var(--text-s);
    font-weight: var(--gewicht-halbfett);
    color: var(--farbe-primaer);
  }
</style>

<script>
  /**
   * Ablauf a-8: Die Kacheln wachsen beim Hereinscrollen von 0,9 auf 1
   * und hellen dabei von #f1f1f1 auf Weiß auf; am Ende des Scrollwegs
   * gehen beide Werte zurück.
   *
   *   0 %   Skalierung 0,9 · Grund #f1f1f1
   *  30 %   Skalierung 1   · Grund Weiß
   *  75 %   unverändert
   * 100 %   Skalierung 0,9 · Grund #f1f1f1
   */
  function kachelnAufbauen() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const kacheln = [...document.querySelectorAll<HTMLElement>('[data-kachel]')];
    if (!kacheln.length || kacheln[0].dataset.bereit) return;
    kacheln.forEach((k) => { k.dataset.bereit = 'ja'; });

    const zwischen = (p: number, vonP: number, bisP: number, vonW: number, bisW: number) => {
      if (p <= vonP) return vonW;
      if (p >= bisP) return bisW;
      return vonW + ((p - vonP) / (bisP - vonP)) * (bisW - vonW);
    };

    let geplant = false;
    const zeichnen = () => {
      geplant = false;
      kacheln.forEach((k) => {
        const r = k.getBoundingClientRect();
        const weg = window.innerHeight + r.height;
        const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / weg));

        const groesse = p < 0.3 ? zwischen(p, 0, 0.3, 0.9, 1)
                      : p > 0.75 ? zwischen(p, 0.75, 1, 1, 0.9)
                      : 1;
        // 241 → 255 → 241
        const ton = Math.round(p < 0.3 ? zwischen(p, 0, 0.3, 241, 255)
                             : p > 0.75 ? zwischen(p, 0.75, 1, 255, 241)
                             : 255);

        k.style.setProperty('--kachel-groesse', groesse.toFixed(3));
        k.style.setProperty('--kachel-grund', `rgb(${ton},${ton},${ton})`);
      });
    };

    const beiScroll = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(zeichnen);
    };

    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    zeichnen();
  }

  kachelnAufbauen();
  document.addEventListener('astro:page-load', kachelnAufbauen);
</script>
