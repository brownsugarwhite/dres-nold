---
/**
 * Begrüßung — der erste Abschnitt, der sich über das Logo schiebt.
 *
 * Als einziger Abschnitt steht er mittig: Er nimmt die Zentrierung des
 * Logos darüber auf. Alles Weitere auf der Seite ist linksbündig.
 *
 * Der Entwurf zeigte darüber noch ein kleines Echo des Logos. Das ist
 * wieder heraus (Florian, 17. September 2026): Das große Logo steht
 * unmittelbar davor, ein zweites daneben wäre eine Wiederholung.
 *
 * Überschrift und Beschreibungstext kommen aus der Redaktion
 * (src/content/startseite.json). Die beiden Knöpfe darunter führen an
 * feste Stellen derselben Seite und stehen deshalb hier im Code, nicht
 * in der Redaktion.
 */
import startseite from '../content/startseite.json';

const texte = startseite.willkommen;

/* Die Überschrift darf in der Redaktion umbrechen, wo es passt: ein
   doppelter Zeilenumbruch im Feld wird zu einem Zeilenumbruch auf der
   Seite. Ohne Umbruch bricht sie von selbst (`text-wrap: balance`). */
const zeilen = texte.titel.split('\n').filter((z) => z.trim() !== '');
---

<section class="willkommen" id="praxis">
  <h1 class="willkommen__titel" data-rein>
    {zeilen.map((zeile, i) => (
      <>
        {i > 0 && <br />}
        {zeile}
      </>
    ))}
  </h1>

  {texte.text && <p class="willkommen__text" data-rein>{texte.text}</p>}

  <div class="willkommen__knoepfe" data-rein>
    <a class="kn kn--voll" href="#contact"><span class="kn__f" aria-hidden="true"></span>Termin vereinbaren</a>
    <a class="kn" href="#leistungen"><span class="kn__f" aria-hidden="true"></span>Unsere Leistungen</a>
  </div>
</section>

<style>
  .willkommen {
    --oben: clamp(72px, 9vw, 124px);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--oben) clamp(56px, 7vw, 96px);
    padding-inline: var(--abstand-seitenrand);
    /* Keine eigene Fläche: Die Begrüßung steht auf der weißen Karte des
       Einstiegs (`.ozblase__flaeche`). Die doppelte Fläche brachte
       nichts und machte nur schwerer nachvollziehbar, wer das Weiß
       setzt (Florian, 18. September 2026). */
    text-align: center;
  }

  /* Handys: Die Begrüßung steht NACH der Einstiegskarte
     (Oeffnungszeiten.astro verschiebt sie, `vorspannAnordnen`). Oben so
     viel Luft, dass der Zipfel in Ruhelage über leerem Weiß steht und die
     Überschrift noch unter der Symbolleiste liegt — die fährt beim
     Schnalz weg und gibt sie frei. Als Außenabstand, damit die
     Sprungmarke „Praxis" den Titel wie überall unter die Kopfleiste
     setzt. Nach dem Schnalz bleibt dadurch etwas mehr Weiß zwischen
     Karte und Begrüßung als sonst zwischen zwei Abschnitten — auf Handys
     unvermeidlich (Florian, 26. September 2026). */
  .willkommen[data-nach-karte] {
    margin-top: calc(var(--zipfel-laenge, 154px) + var(--abstand-s) - var(--oben));
  }

  /* Eine Stufe größer als `--text-titel` (die übrigen Überschriften),
     im Gewicht aller Überschriften (`--gewicht-titel`) und eng
     gesperrt. */
  .willkommen__titel {
    max-width: 19ch;
    margin: 0;
    font-size: var(--text-willkommen);
    font-weight: var(--gewicht-titel);
    line-height: 1.07;
    letter-spacing: -0.010em;
    text-wrap: balance;
  }

  .willkommen__text {
    max-width: var(--breite-absatz);
    margin: 26px 0 0;
    color: var(--farbe-text);
    font-size: var(--text-lead);
    font-weight: var(--gewicht-normal);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .willkommen__knoepfe {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }
</style>
