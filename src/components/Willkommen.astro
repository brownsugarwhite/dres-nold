---
/**
 * Begrüßung — der erste Abschnitt nach der Einstiegskarte.
 *
 * Aufbau nach Florians Entwurf (27. September 2026), auf breiten
 * Fenstern zwei Spalten: links die Überschrift in zwei Zeilen — oben
 * „Willkommen in unserer" in der Größe der übrigen Überschriften,
 * darunter „Praxis Dres. Nold" groß —, rechts, durch eine Haarlinie
 * getrennt, der kurze Text und darunter die beiden Knöpfe. Die rechte
 * Spalte ist genau so breit wie die beiden Knöpfe nebeneinander (der
 * Text bricht in dieser Breite um) und genau so hoch wie die
 * Überschrift: Text oben, Knöpfe unten. Der Block steht linksbündig in
 * der Inhaltsbreite.
 *
 * Auf Handys (bis 767 px) steht alles untereinander: Beide Zeilen der
 * Überschrift füllen genau die Breite des Bildschirms (das Skript unten
 * misst sie ein), darunter der Text, darunter die beiden Knöpfe
 * nebeneinander mit kürzeren Beschriftungen.
 *
 * Bis zum 27. September stand die Begrüßung mittig und — auf breiten
 * Fenstern — in der Einstiegskarte vor den Sprechstunden. Jetzt folgt
 * sie auf allen Größen der Karte (src/pages/index.astro).
 *
 * Überschrift und Text kommen aus der Redaktion
 * (src/content/startseite.json): Ein Zeilenumbruch im Titel trennt die
 * kleine von der großen Zeile. Die beiden Knöpfe führen an feste
 * Stellen derselben Seite und stehen deshalb hier im Code.
 */
import startseite from '../content/startseite.json';
import { trennen } from '../lib/silben';

const texte = startseite.willkommen;

const zeilen = texte.titel.split('\n').map((z) => z.trim()).filter(Boolean);
/* Die letzte Zeile ist die große; alles davor die kleine. Ohne Umbruch
   gibt es nur die große. */
const gross = zeilen.length ? zeilen[zeilen.length - 1] : texte.titel;
const klein = zeilen.slice(0, -1).join(' ');
---

<section class="willkommen" id="praxis">
  <div class="willkommen__inhalt">
    <h1 class="willkommen__titel" data-rein data-willkommentitel>
      {klein && <span class="willkommen__klein" data-zeile>{klein}</span>}
      <span class="willkommen__gross" data-zeile>{gross}</span>
    </h1>

    <div class="willkommen__rechts" data-rein>
      {texte.text && <p class="willkommen__text">{trennen(texte.text)}</p>}
      <div class="willkommen__knoepfe">
        <a class="kn kn--voll" href="#contact">
          <span class="kn__f" aria-hidden="true"></span>
          <span class="willkommen__lang">Termin vereinbaren</span><span class="willkommen__kurz" aria-hidden="true">Termin</span>
        </a>
        <a class="kn" href="#leistungen">
          <span class="kn__f" aria-hidden="true"></span>
          <span class="willkommen__lang">Unsere Leistungen</span><span class="willkommen__kurz" aria-hidden="true">Leistungen</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .willkommen {
    --oben: clamp(72px, 9vw, 124px);
    /* Die Begrüßung folgt der Einstiegskarte. Oben so viel Luft, dass
       der Zipfel der Karte in Ruhelage über leerem Weiß steht und die
       Überschrift noch unter der Symbolleiste liegt — die fährt beim
       Schnalz weg und gibt sie frei. Als Außenabstand, damit die
       Sprungmarke „Praxis" den Titel wie überall unter die Kopfleiste
       setzt. */
    margin-top: calc(var(--zipfel-laenge, 154px) + var(--abstand-s) - var(--oben));
    padding-block: var(--oben) clamp(56px, 7vw, 96px);
    padding-inline: var(--abstand-seitenrand);
  }

  /* Zwei Spalten, gleich hoch; linksbündig in der Inhaltsbreite */
  .willkommen__inhalt {
    display: flex;
    align-items: stretch;
    width: min(100%, var(--breite-inhalt));
    margin-inline: auto;
  }

  /* Die beiden Zeilen rücken so weit auseinander, dass die Überschrift
     die Höhe der rechten Spalte hat (Florian, 27. September 2026) */
  .willkommen__titel {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: space-between;
    margin: 0;
    line-height: 1.05;
  }

  /* Die kleine Zeile — genau so breit wie die große darunter; das
     Skript unten misst sie ein. Die Größe der übrigen Überschriften ist
     der Rückfall ohne Skript. */
  .willkommen__klein {
    display: block;
    font-size: var(--text-titel);
    font-weight: var(--gewicht-titel);
    letter-spacing: -0.010em;
    white-space: nowrap;
  }

  /* … die große eine Stufe darüber */
  .willkommen__gross {
    display: block;
    font-size: var(--text-willkommen);
    font-weight: var(--gewicht-titel);
    letter-spacing: -0.012em;
    white-space: nowrap;
  }

  /* Rechts: Text oben, Knöpfe unten, dazwischen so viel Raum, dass die
     Spalte die Höhe der Überschrift hat. Ihre Breite ist die der Knöpfe
     nebeneinander (`max-content`); der Text zählt dafür nicht mit
     (`width: 0; min-width: 100%`) und bricht in eben dieser Breite um. */
  .willkommen__rechts {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: space-between;
    width: max-content;
    margin-left: clamp(24px, 3vw, 48px);
    padding-left: clamp(24px, 3vw, 48px);
    border-left: 1px solid var(--farbe-linie);
  }

  /* Im Blocksatz wie die Lesetexte (Trennstellen setzt der Build,
     src/lib/silben.ts); die letzte Zeile bleibt linksbündig */
  .willkommen__text {
    width: 0;
    min-width: 100%;
    margin: 0 0 20px;
    color: var(--farbe-text);
    font-size: var(--text-lead);
    font-weight: var(--gewicht-normal);
    line-height: 1.5;
    text-align: justify;
    text-align-last: left;
    -webkit-hyphens: auto;
    hyphens: auto;
  }

  .willkommen__knoepfe {
    display: flex;
    gap: 12px;
    white-space: nowrap;
  }

  .willkommen__kurz { display: none; }

  /* Handys: untereinander. Beide Zeilen der Überschrift füllen die
     Breite (Skript); die Knöpfe teilen sich eine Zeile und tragen die
     kurzen Beschriftungen. */
  @media (max-width: 767px) {
    .willkommen__inhalt { flex-direction: column; }

    .willkommen__titel { line-height: 1.02; }

    /* Über und unter dem Satz derselbe Abstand (Florian, 27. September
       2026); der Satz eine Stufe größer und über die ganze Breite */
    .willkommen__rechts {
      width: auto;
      /* 16 statt 22: Die Überschrift hat unter „Praxis Dres. Nold" noch
         ihren Durchschuss — so stehen über und unter dem Satz sichtbar
         gleiche Lücken */
      margin: 16px 0 0;
      padding: 0;
      border-left: 0;
    }

    .willkommen__text {
      width: auto;
      min-width: 0;
      margin-bottom: 22px;
      font-size: 1.2rem;
      line-height: 1.45;
    }

    .willkommen__knoepfe :global(.kn) {
      flex: 1 1 0;
      justify-content: center;
      padding-inline: 14px;
    }

    .willkommen__lang { display: none; }
    .willkommen__kurz { display: inline; }
  }
</style>

<script>
  /**
   * Die Zeilen der Überschrift einmessen (Florian, 27. September 2026):
   *
   *   Handys   — beide Zeilen füllen genau die Breite des Bildschirms.
   *   Desktop  — die große Zeile behält ihre Größe aus dem CSS, die
   *              kleine wird genau so breit wie die große.
   *
   * Eine Zeile wird bei 100 px gemessen und dann auf die Breite
   * verkleinert, die sie füllen soll. Auf dem Desktop ist die
   * Überschrift so breit wie ihre breiteste Zeile — die kleine wird
   * deshalb vorher winzig gestellt, damit die Messung allein die große
   * sieht. Läuft beim Aufbau, bei Größenänderung, nach dem Laden der
   * Schrift und nach jedem Seitenwechsel.
   */
  function titelFuellen() {
    const titel = document.querySelector<HTMLElement>('[data-willkommentitel]');
    if (!titel) return;
    const zeilen = [...titel.querySelectorAll<HTMLElement>('[data-zeile]')];
    zeilen.forEach((z) => z.style.removeProperty('font-size'));
    const handy = window.matchMedia('(max-width: 767px)').matches;

    const einpassen = (z: HTMLElement, platz: number) => {
      z.style.fontSize = '100px';
      const noetig = z.scrollWidth;
      z.style.fontSize = noetig > 0 ? `${Math.floor(((100 * platz) / noetig) * 100) / 100}px` : '';
    };

    if (handy) {
      const platz = titel.clientWidth;
      if (platz) zeilen.forEach((z) => einpassen(z, platz));
      return;
    }

    const klein = titel.querySelector<HTMLElement>('.willkommen__klein');
    if (!klein) return;
    klein.style.fontSize = '1px';
    const platz = titel.clientWidth;
    if (platz) einpassen(klein, platz);
    else klein.style.removeProperty('font-size');
  }

  let angemeldet = false;
  function willkommenAufbauen() {
    titelFuellen();
    if (angemeldet) return;
    angemeldet = true;
    window.addEventListener('resize', titelFuellen, { passive: true });
    document.fonts?.ready.then(titelFuellen);
  }

  willkommenAufbauen();
  document.addEventListener('astro:page-load', willkommenAufbauen);
</script>
