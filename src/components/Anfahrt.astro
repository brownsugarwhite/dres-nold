---
/**
 * Anfahrt — das Kartenband am Fuß der Startseite.
 *
 * Über die volle Breite liegt ein entsättigtes, nach oben und unten ins
 * Weiß auslaufendes Kartenbild; darauf ein pulsierender Punkt an der
 * Praxis. Links unten Anschrift und Hinweis, rechts unten die beiden
 * Knöpfe (Entwurf, 18. September 2026).
 *
 * Die Karte selbst kommt von Google und lädt erst auf Klick — das war
 * vorher im Kontaktbereich und ist hierher gewandert. Bis dahin lädt die
 * Seite nichts von fremden Servern, deshalb braucht sie kein
 * Einwilligungs-Banner beim Aufruf; der Hinweis steht dort, wo die
 * Entscheidung ansteht (CLAUDE.md, „Rechtliches").
 */
import seite from '../content/seite.json';

const { praxis } = seite;
const adresse = `${praxis.strasse}, ${praxis.plz} ${praxis.ort}`;
const routenZiel = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(adresse);
const karteEinbettung = 'https://maps.google.com/maps?q=' + encodeURIComponent(adresse) + '&z=16&hl=de&output=embed';
---

<section class="anfahrt" id="anfahrt" data-landkarte data-einbettung={karteEinbettung} aria-label="Anfahrt">
  {/* Das Vorschaubild trägt keinen Alternativtext: Die Anschrift steht
      darunter im Text, das Bild ist reine Ausschmückung. */}
  <div class="anfahrt__karte" data-landkarte-vorschau>
    <span class="anfahrt__bild" role="img" aria-label={`Kartenausschnitt: ${adresse}`}></span>
    <span class="anfahrt__punkt" aria-hidden="true">
      <span class="anfahrt__welle"></span>
    </span>
  </div>

  <div class="anfahrt__inhalt">
    <div class="anfahrt__text">
      <div class="kicker">Anfahrt</div>
      <h2 class="anfahrt__titel">{praxis.strasse} · {praxis.plz} {praxis.ort}</h2>
      <p class="anfahrt__hinweis">
        Parkplätze direkt vor der Praxis. Die Karte lädt erst auf Klick —
        dabei erhält Google Ihre IP-Adresse.
      </p>
    </div>

    <div class="anfahrt__knoepfe">
      <button class="kn kn--voll" type="button" data-landkarte-laden>
        <span class="kn__f" aria-hidden="true"></span>Karte anzeigen
      </button>
      <a class="kn" href={routenZiel} target="_blank" rel="noopener">
        <span class="kn__f" aria-hidden="true"></span>Route planen
      </a>
    </div>
  </div>
</section>

<style>
  .anfahrt {
    /* Die Stelle der Praxis im Vorschaubild — Bildausrichtung und Punkt
       benutzen dieselben Werte, deshalb stehen sie hier einmal. */
    --marke-x: 52.77%;
    --marke-y: 48.94%;
    position: relative;
    z-index: 40;
    display: flex;
    align-items: flex-end;
    width: 100%;
    min-height: clamp(380px, 42vw, 620px);
    overflow: hidden;
    background: var(--farbe-flaeche);
  }

  /*
    Auf schmalen Fenstern rückt die Kartenebene nach oben, damit der
    Punkt nicht hinter der Anschrift landet. Sie wird dabei um dasselbe
    Maß höher, damit unten keine Lücke entsteht — und weil Bild und
    Punkt beide in dieser Ebene liegen, bleiben sie dabei aufeinander.
  */
  .anfahrt__karte {
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% + var(--karte-hoch, 0px));
    transform: translateY(calc(-1 * var(--karte-hoch, 0px)));
  }

  .anfahrt__karte[hidden] { display: none; }

  /*
    Die Karte als Hintergrund statt als <img>: Mit `cover` richtet
    `background-position` denselben Punkt des Bildes auf denselben Punkt
    der Fläche aus. Die Google-Marke im Bild sitzt bei 52,77 % / 48,94 %
    (ausgemessen: Mitte des Kopfes bei 844 / 474 von 1600 × 969) —
    damit steht sie bei jeder Fenstergröße genau dort, wo unten der
    eigene Punkt sitzt.

    Entsättigt und aufgehellt, oben und unten ins Weiß auslaufend: Das
    Band soll den Ort andeuten, nicht ihn zeigen — lesbar bleiben muss
    der Text darüber.
  */
  .anfahrt__bild {
    position: absolute;
    inset: 0;
    display: block;
    background: url('/bilder/deko/karte-vorschau.jpg') var(--marke-x) var(--marke-y) / cover no-repeat;
    filter: grayscale(1) contrast(0.82);
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 58%, transparent 96%);
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 58%, transparent 96%);
  }

  /*
    Der Punkt deckt die Google-Marke im Bild zu — dieselbe Stelle,
    dieselbe Größe.

    Die Marke ist im Bild 37,5 Bildpunkte hoch (Kopf 29,5 plus die
    Spitze darunter). Wie groß sie auf dem Schirm erscheint, hängt vom
    Maßstab ab, mit dem `cover` das Bild einpasst: Ist das Fenster breit,
    ist er Fensterbreite / 1600, also 37,5 / 1600 = 2,34 % der
    Fensterbreite. Ist das Band dagegen hoch und schmal (Handy), zählt
    die Höhe — dort bleibt die Marke unter 28 px. Beides zusammen:
  */
  .anfahrt__punkt {
    position: absolute;
    left: var(--marke-x);
    top: var(--marke-y);
    width: max(28px, 2.4vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: var(--radius-rund);
    background: var(--farbe-primaer);
    /* Weißer Saum: trennt den Punkt von der Karte darunter */
    box-shadow: 0 0 0 max(3px, 0.22vw) var(--farbe-flaeche);
  }

  /* Der Ring geht immer wieder auf und verliert sich dabei */
  .anfahrt__welle {
    position: absolute;
    inset: 0;
    border: 1px solid var(--farbe-primaer);
    border-radius: var(--radius-rund);
    animation: anfahrt-welle 2.8s var(--verlauf) infinite;
  }

  @keyframes anfahrt-welle {
    0% { transform: scale(1); opacity: 0.8; }
    70% { transform: scale(2.8); opacity: 0; }
    100% { transform: scale(2.8); opacity: 0; }
  }

  .anfahrt__inhalt {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--abstand-m) clamp(24px, 4vw, 64px);
    align-items: flex-end;
    justify-content: space-between;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    margin-inline: auto;
    padding-block: clamp(48px, 6vw, 96px);
  }

  .anfahrt__text { min-width: 0; }

  .anfahrt__titel {
    margin: 16px 0 0;
    color: var(--farbe-primaer);
    font-size: var(--text-titel-klein);
    font-weight: var(--gewicht-leicht);
    line-height: 1.18;
    letter-spacing: -0.011em;
  }

  .anfahrt__hinweis {
    max-width: 46ch;
    margin: 12px 0 0;
    color: var(--farbe-text-gedeckt);
    font-size: 15px;
    line-height: 1.6;
  }

  .anfahrt__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  /* Die geladene Karte füllt das ganze Band */
  .anfahrt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Ist die Karte geladen, stünde der Text auf ihr — dann bekommt er
     eine eigene weiße Fläche, damit er lesbar bleibt. */
  .anfahrt[data-geladen] .anfahrt__inhalt {
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-m);
    background: rgb(255 255 255 / 92%);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    margin-block: clamp(24px, 3vw, 40px);
  }

  @media (max-width: 700px) {
    .anfahrt {
      min-height: 480px;
      --karte-hoch: 150px;
    }
    .anfahrt__inhalt { align-items: flex-start; }
    .anfahrt__knoepfe { width: 100%; }
    .anfahrt__knoepfe .kn {
      justify-content: center;
      padding-inline: 22px;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anfahrt__welle { animation: none; opacity: 0.5; }
  }
</style>

<script>
  import { lesen, setzen, EREIGNIS } from '../scripts/einwilligung';

  /**
   * Lädt die Google-Karte, sobald die Einwilligung vorliegt — und nimmt
   * sie wieder heraus, wenn sie widerrufen wird.
   */
  function landkarteAufbauen() {
    const kasten = document.querySelector<HTMLElement>('[data-landkarte]');
    if (!kasten || kasten.dataset.bereit) return;
    kasten.dataset.bereit = 'ja';

    const vorschau = kasten.querySelector<HTMLElement>('[data-landkarte-vorschau]');
    const einbettung = kasten.dataset.einbettung || '';
    let rahmen: HTMLIFrameElement | null = null;

    const anwenden = () => {
      const erlaubt = lesen()?.karte === true;
      if (erlaubt && !rahmen) {
        rahmen = document.createElement('iframe');
        rahmen.src = einbettung;
        rahmen.title = 'Google-Maps-Karte: Lage der Praxis';
        rahmen.loading = 'lazy';
        rahmen.referrerPolicy = 'no-referrer-when-downgrade';
        rahmen.setAttribute('allowfullscreen', '');
        kasten.insertBefore(rahmen, kasten.firstChild);
        if (vorschau) vorschau.hidden = true;
        kasten.dataset.geladen = 'ja';
      } else if (!erlaubt && rahmen) {
        rahmen.remove();
        rahmen = null;
        if (vorschau) vorschau.hidden = false;
        delete kasten.dataset.geladen;
      }
    };

    kasten.querySelector('[data-landkarte-laden]')?.addEventListener('click', () => setzen(true));
    document.addEventListener(EREIGNIS, anwenden);
    anwenden();
  }

  landkarteAufbauen();
  document.addEventListener('astro:page-load', landkarteAufbauen);
</script>
