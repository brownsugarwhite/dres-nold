---
/**
 * Neuigkeiten — Übersicht auf der Startseite.
 *
 * Neu gegenüber der Vorlage. Blendet sich samt Menüpunkt aus, wenn kein
 * Beitrag aktiv ist. Jeder Beitrag hat eine eigene Adresse und öffnet
 * sich mit demselben Morph-Übergang wie die Leistungen.
 */
import daten from '../content/neuigkeiten.json';

const beitraege = daten.eintraege
  .filter((e) => e.aktiv)
  .sort((a, b) => (b.datum || '').localeCompare(a.datum || ''));

const alsDatum = (iso: string) =>
  iso ? new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
---

{beitraege.length > 0 && (
  <section class="neuigkeiten" id="neuigkeiten" data-verlauf>
    <h2 class="neuigkeiten__titel">{daten.titel}</h2>
    {daten.einleitung && <p class="neuigkeiten__einleitung">{daten.einleitung}</p>}

    <div class="neuigkeiten__liste inhalt">
      {beitraege.map((b) => (
        <article class="beitrag">
          <a class="beitrag__link" data-karte href={`/neuigkeiten/${b.id}/`} transition:name={`beitrag-${b.id}`}>
            {b.bild && (
              <img class="beitrag__bild" src={b.bild} alt={b.bild_alt || ''} width="600" height="360" loading="lazy" transition:name={`beitrag-bild-${b.id}`} />
            )}
            <div class="beitrag__text" transition:name={`beitrag-vorschautext-${b.id}`}>
              {b.datum && <time class="beitrag__datum" datetime={b.datum}>{alsDatum(b.datum)}</time>}
              <h3 class="beitrag__titel">{b.titel}</h3>
              {b.kurz && <p class="beitrag__kurz">{b.kurz}</p>}
              <span class="beitrag__mehr" aria-hidden="true">Weiterlesen →</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .neuigkeiten {
    position: relative;
    z-index: 40;
    padding-block: 60px 100px;
    background: var(--farbe-flaeche);
  }

  .neuigkeiten__titel { text-align: center; }

  .neuigkeiten__einleitung {
    max-width: none;
    margin-bottom: var(--abstand-l);
    color: var(--farbe-text);
    font-size: 20px;
    font-weight: 300;
    text-align: center;
  }

  .neuigkeiten__liste {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--abstand-l);
  }

  .beitrag {
    flex: 1 1 20rem;
    max-width: 30rem;
    margin: 0;
  }

  .beitrag__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--abstand-xs);
    margin: calc(-1 * var(--abstand-xs));
    border-radius: var(--radius-m);
    background: var(--farbe-flaeche);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow var(--dauer-schnell) var(--verlauf),
      transform var(--dauer-schnell) var(--verlauf);
  }

  /* Angeklickt: legt nur den Schatten darunter — gewachsen wird im
     Übergang selbst (styles/uebergaenge.css). */
  .beitrag__link[data-gehoben] {
    position: relative;
    z-index: 2;
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 30%);
  }

  .beitrag__bild {
    width: 100%;
    height: 220px;
    object-fit: cover;
    margin-bottom: var(--abstand-s);
    view-transition-class: bild;
  }

  /* Blendet im Übergang unten an seiner Stelle aus, statt durch das
     Bild nach oben zu wandern — siehe styles/uebergaenge.css */
  .beitrag__text {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--abstand-3xs);
    view-transition-class: beitragtext;
  }

  .beitrag__datum {
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-xs);
  }

  .beitrag__titel {
    margin: 0;
    font-size: var(--text-l);
    color: var(--farbe-primaer);
  }

  .beitrag__kurz {
    margin: 0;
    color: var(--farbe-text);
    font-size: var(--text-s);
  }

  .beitrag__mehr {
    margin-top: auto;
    padding-top: var(--abstand-2xs);
    color: var(--farbe-primaer);
    font-size: var(--text-s);
    font-weight: var(--gewicht-halbfett);
  }

  .beitrag__link:hover .beitrag__mehr,
  .beitrag__link:focus-visible .beitrag__mehr { text-decoration: underline; }
</style>
