---
import { trennen } from '../lib/silben';
/**
 * Neuigkeiten — Übersicht auf der Startseite.
 *
 * Neu gegenüber der Vorlage. Blendet sich samt Menüpunkt aus, wenn kein
 * Beitrag aktiv ist. Jeder Beitrag hat eine eigene Adresse und öffnet
 * sich mit demselben Morph-Übergang wie die Leistungen.
 *
 * Beim Zeigen vergrößert sich das Bild innerhalb seines Ausschnitts
 * (Handoff, 17. September 2026). Den Übergangsnamen trägt deshalb der
 * Ausschnitt und nicht das Bild: Seine Kante steht still, also beginnt
 * der Morph genau dort, wo das Bild gerade steht — ohne Sprung
 * (Florian, 18. September 2026).
 *
 * Beim Scrollen wächst das Bild zusätzlich langsam von 1 auf 1,1 —
 * dieselbe Bewegung wie das Gruppenfoto im Team-Abschnitt (Ablauf a-3,
 * Skript unten; Florian, 17. September 2026).
 */
import daten from '../content/neuigkeiten.json';

const beitraege = daten.eintraege
  .filter((e) => e.aktiv)
  .sort((a, b) => (b.datum || '').localeCompare(a.datum || ''));

const alsDatum = (iso: string) =>
  iso ? new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
---

{beitraege.length > 0 && (
  <section class="neuigkeiten bereich bereich--ohne-oben" id="neuigkeiten" data-verlauf>
    <div class="bereich__inhalt">
      <div class="kicker" data-rein>Aktuelles</div>
      <h2 class="bereich__titel" data-rein>{daten.titel}</h2>
      {daten.einleitung && <p class="bereich__einleitung" data-rein>{daten.einleitung}</p>}

      <div class="neuigkeiten__liste">
        {beitraege.map((b) => (
          <article class="beitrag" data-rein>
            <a class="beitrag__link" data-karte href={`/neuigkeiten/${b.id}/`} transition:name={`beitrag-${b.id}`}>
              {b.bild && (
                <span class="beitrag__ausschnitt" transition:name={`beitrag-bild-${b.id}`}>
                  {/* Drei Ebenen, damit sich die Bewegungen nicht ins
                      Gehege kommen: Der Ausschnitt steht still, der Lauf
                      trägt die Skalierung beim Scrollen, das Bild die
                      beim Zeigen. Zwei `transform` auf einem Element
                      ließen sich nicht getrennt überblenden. */}
                  <span class="beitrag__lauf" data-bildlauf>
                    <img class="beitrag__bild" src={b.bild} alt={b.bild_alt || ''} width="600" height="338" loading="lazy" />
                  </span>
                </span>
              )}
              <span class="beitrag__text">
                {b.datum && <time class="beitrag__datum kicker kicker--klein" datetime={b.datum}>{alsDatum(b.datum)}</time>}
                <h3 class="beitrag__titel">{b.titel}</h3>
                {b.kurz && <span class="beitrag__kurz">{trennen(b.kurz)}</span>}
                <span class="beitrag__mehr">
                  <span class="tl">
                    Beitrag lesen
                    <span class="tl__pfeil" aria-hidden="true">
                      <svg viewBox="0 0 9 14" focusable="false">
                        <polyline fill="none" stroke="currentColor" stroke-miterlimit="10" points="2 2 7 7 2 12" />
                      </svg>
                    </span>
                  </span>
                </span>
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .neuigkeiten {
    position: relative;
    z-index: 40;
    background: var(--farbe-flaeche);
  }

  .neuigkeiten__liste {
    display: grid;
    /* `min(320px, 100%)`: Auf sehr schmalen Handys ist die Spalte
       breiter als der Platz — ohne die Schranke schob die Liste die
       ganze Seite waagerecht auf (320-px-Geräte, 18. September 2026). */
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    /* Auf breiten Schirmen deutlich mehr Luft zwischen den Beiträgen —
       nebeneinander standen sie zu dicht (Florian, 18. September 2026).
       Untereinander bleibt es beim engeren Maß. */
    gap: 34px clamp(24px, 4.5vw, 72px);
    margin-top: 44px;
  }

  .beitrag { margin: 0; }

  /* Ohne Rahmen und ohne Kasten: Die Karte ist das Bild mit dem Text
     darunter, mehr braucht sie nicht (Florian, 17. September 2026).
     Zusammengehalten wird sie beim Zeigen allein von der Bewegung —
     das Bild wächst, die Karte hebt sich leicht. */
  .beitrag__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    color: var(--farbe-text);
    text-decoration: none;
    transition: transform 0.45s var(--verlauf-betont);
  }

  .beitrag__link:hover,
  .beitrag__link:focus-visible {
    transform: translateY(-3px);
  }

  /* Der Ausschnitt steht still, das Bild darin wächst.

     Er ist es deshalb auch, der den Übergangsnamen trägt: Seine Kante
     ist genau das, was man sieht — egal, wie weit das Bild darin beim
     Zeigen oder beim Scrollen gerade vergrößert ist. Der Morph beginnt
     damit exakt an der sichtbaren Kante, statt vorher auf die
     unvergrößerte Lage zurückzuspringen (Florian, 18. September 2026). */
  .beitrag__ausschnitt {
    display: block;
    overflow: hidden;
  }

  /* Ablauf a-3, wie beim Gruppenfoto des Teams: Über den Scrollweg
     wächst das Bild von 1 auf 1,1. Den Wert setzt das Skript unten;
     eine Überblendung steht hier bewusst nicht, der Wert wird in jedem
     Bild neu gesetzt und läuft im Skript schon weich nach. */
  .beitrag__lauf {
    display: block;
    transform: scale(var(--bild-groesse, 1));
  }

  .beitrag__bild {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.55s var(--verlauf-betont);
  }

  .beitrag__ausschnitt { view-transition-class: bild; }

  .beitrag__link:hover .beitrag__bild,
  .beitrag__link:focus-visible .beitrag__bild {
    transform: scale(1.07);
  }

  /* Nur der Beitrag, der gerade morpht, bekommt Übergangsebenen — alle
     anderen geben ihre Namen ab. Ausführlich begründet in
     LeistungKachel.astro; es geht um die Anzahl der Ebenen, die der
     Browser während des Wechsels zusammensetzen muss. */
  .beitrag__link[data-morph] {
    view-transition-class: karte;
  }

  /* Beim Klick bleibt alles stehen, wie es steht: Der Ausschnitt trägt
     den Übergangsnamen und ändert seine Größe durch Zeigen und Scrollen
     ohnehin nicht — der Morph beginnt also genau am sichtbaren Bild.

     Nur die Überblendungen werden angehalten, damit während der
     Momentaufnahme nichts mehr nachläuft. Vorher wurden hier die
     Vergrößerungen zurückgesetzt; das war der Sprung, den man sah
     (Florian, 18. September 2026). */
  .beitrag__link[data-morph],
  .beitrag__link[data-morph] .beitrag__bild {
    transition: none;
  }

  .beitrag__link:not([data-morph]),
  .beitrag__link:not([data-morph]) .beitrag__ausschnitt {
    view-transition-name: none;
  }

  /* Ohne eigenen Übergangsnamen: Datum, Überschrift und Anriss gehören
     zur Karte, machen deren Bewegung und Skalierung mit und blenden
     dabei aus — siehe styles/uebergaenge.css */
  /* Kein Innenabstand seitlich mehr — der Text steht bündig unter dem
     Bild, weil es keinen Kasten gibt, von dem er einrücken müsste. */
  .beitrag__text {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 11px;
    padding: 22px 0 0;
  }

  .beitrag__datum { letter-spacing: 0.16em; }

  .beitrag__titel {
    margin: 0;
    color: var(--farbe-primaer);
    font-size: 21px;
    font-weight: var(--gewicht-titel);
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .beitrag__kurz {
    /* Als Block, damit der Blocksatz (global.css) greift */
    display: block;
    color: var(--farbe-text-gedeckt);
    font-size: 16px;
    line-height: 1.6;
  }

  .beitrag__mehr {
    margin-top: auto;
    padding-top: 10px;
  }

  @media (prefers-reduced-motion: reduce) {
    .beitrag__link,
    .beitrag__bild { transition: none; }
    .beitrag__lauf { transform: none; }
    .beitrag__link:hover,
    .beitrag__link:focus-visible { transform: none; }
    .beitrag__link:hover .beitrag__bild,
    .beitrag__link:focus-visible .beitrag__bild { transform: none; }
  }
</style>

<script>
  /* Ablauf a-3 auf den Beitragsbildern: das gemeinsame Skript
     scripts/bildlauf.ts (seit dem 27. September 2026 auch für die
     Bilder der eigenen Abschnitte). */
  import '../scripts/bildlauf';
</script>
