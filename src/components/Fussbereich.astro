---
/**
 * Fußbereich mit den Rechtsverweisen.
 * In der Vorlage ein einzelner Verweis „Datenschutz & Impressum";
 * hier getrennt, weil beides eigene Seiten sind.
 *
 * Eine Haarlinie oben, darunter links die Zeile mit dem Namen der
 * Praxis, rechts die Verweise (Entwurf, 18. September 2026). Das Logo
 * ist heraus (Florian, 17. September 2026): Es steht schon in der
 * Kopfleiste und im Startbereich.
 *
 * Der große Innenabstand unten hält die Symbolleiste frei, die auf der
 * Startseite dort steht.
 */
import seite from '../content/seite.json';

const { praxis } = seite;
const jahr = new Date().getFullYear();
/* „Dres. Nold – Zahnarztpraxis und Kieferorthopädie": vorn der Name,
   der Rest steht auf Handys nicht (Florian, 17. Oktober 2026) */
const [kurzname, ...zusatz] = praxis.name.split('–').map((t) => t.trim());
---
<footer class="fuss">
  <div class="fuss__inhalt">
    <p class="fuss__marke">© {jahr} {kurzname}<span class="fuss__zusatz">{zusatz.map((t) => ` · ${t}`).join('')} · {praxis.ort}</span></p>

    <nav class="fuss__links" aria-label="Rechtliches">
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/impressum/">Impressum</a>
      <button class="fuss__knopf" type="button" data-nach-oben>Nach oben</button>
    </nav>
  </div>
</footer>

<style>
  .fuss {
    position: relative;
    z-index: 40;
    width: 100%;
    background: var(--farbe-flaeche);
  }

  /* Name links, Verweise rechts */
  .fuss__inhalt {
    display: flex;
    flex-wrap: wrap;
    gap: 14px clamp(24px, 4vw, 64px);
    align-items: center;
    justify-content: space-between;
    width: min(100% - 2 * var(--abstand-seitenrand), var(--breite-inhalt));
    margin-inline: auto;
    /* Keine Linie darüber: Der Kontaktbereich endet mit der harten
       Kante seiner Karte, das ist Trennung genug (Florian,
       18. September 2026). */
    /* Früher stand hier so viel Luft, dass die Symbolleiste nichts
       verdecken konnte. Die braucht es nicht: Sie fährt aus dem Bild,
       sobald der Startbereich verlassen ist (`body[data-gescrollt]`),
       und auf Unterseiten ist sie von Anfang an unten. Am Seitenende
       ist sie also nie zu sehen — die 150 px waren leerer Raum
       (Florian, 18. September 2026). */
    padding-block: var(--abstand-m) clamp(40px, 5vw, 64px);
  }

  .fuss__marke {
    margin: 0;
    max-width: none;
    color: var(--farbe-text-gedeckt);
    font-size: 14.5px;
    line-height: 1.4;
  }

  .fuss__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    font-size: 14.5px;
    line-height: 1;
  }

  .fuss__links a,
  .fuss__knopf {
    padding: 0;
    border: 0;
    background: none;
    color: var(--farbe-text);
    font: inherit;
    font-family: var(--schrift);
    text-decoration: none;
    cursor: pointer;
  }

  .fuss__links a:hover,
  .fuss__links a:focus-visible,
  .fuss__knopf:hover,
  .fuss__knopf:focus-visible {
    color: var(--farbe-primaer);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  /* Handys: nur „© 2026 Dres. Nold", alles linksbündig (Florian,
     17. Oktober 2026; vorher mittig) */
  @media (max-width: 560px) {
    .fuss__inhalt { justify-content: flex-start; text-align: left; }
    .fuss__links { justify-content: flex-start; width: 100%; row-gap: var(--abstand-2xs); }
    .fuss__zusatz { display: none; }
  }
</style>

<script>
  import { sanftScrollen } from '../scripts/anker';

  /** „Nach oben" — sanft (dieselbe Bewegung wie die Sprungmarken), und
      ohne eine Raute in der Adresse zu hinterlassen. */
  function nachObenAufbauen() {
    const knopf = document.querySelector<HTMLButtonElement>('[data-nach-oben]');
    if (!knopf || knopf.dataset.bereit) return;
    knopf.dataset.bereit = 'ja';
    knopf.addEventListener('click', () => sanftScrollen(0));
  }

  nachObenAufbauen();
  document.addEventListener('astro:page-load', nachObenAufbauen);
</script>
