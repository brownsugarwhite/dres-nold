---
/**
 * Einzelseite eines Beitrags — eigene Adresse, mit Morph-Übergang
 * aus der Übersicht heraus.
 *
 * Zum Übergang: Das Bild trägt denselben Namen wie in der
 * Vorschaukarte und wandert dadurch wirklich an seinen Platz. Datum,
 * Überschrift und Text tragen bewusst KEINEN eigenen Namen — sie
 * gehören zur Karte und machen deren Bewegung und Skalierung mit,
 * während sie einblenden. Weil sie hier über dem Bild stehen und in
 * der Vorschaukarte darunter, blendet der eine unten aus, während der
 * andere oben einblendet; nichts wandert durch das Bild
 * (styles/uebergaenge.css).
 */
import Basis from '../../layouts/Basis.astro';
import Navigation from '../../components/Navigation.astro';
import Fussbereich from '../../components/Fussbereich.astro';
import daten from '../../content/neuigkeiten.json';
import seite from '../../content/seite.json';

export function getStaticPaths() {
  return daten.eintraege
    .filter((e) => e.aktiv)
    .map((e) => ({ params: { id: e.id }, props: { beitrag: e } }));
}

const { beitrag } = Astro.props;
const alsDatum = (iso: string) =>
  iso ? new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
const anhaenge = (beitrag.dateien || []).filter((d) => d.datei);
---

<Basis titel={`${beitrag.titel} – ${seite.praxis.name}`} beschreibung={beitrag.kurz}>
  <Navigation />

  <main id="inhalt" class="beitragsseite">
    <article class="beitrag karte" transition:name={`beitrag-${beitrag.id}`}>
      <span class="schliessen-wache" data-schliessen-wache aria-hidden="true"></span>
      <div class="schliessen-halter" data-schliessen-halter>
        <a class="schliessen" href="/" data-zurueck aria-label="Beitrag schließen">
          <svg class="schliessen__kreis" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" /></svg>
        </a>
      </div>
      <a class="beitrag__zurueck" href="/" data-zurueck>
        <span aria-hidden="true">←</span> Alle Neuigkeiten
      </a>

      {beitrag.datum && (
        <time class="beitrag__datum" datetime={beitrag.datum}>{alsDatum(beitrag.datum)}</time>
      )}
      <h1 class="beitrag__titel">{beitrag.titel}</h1>

      {beitrag.bild && (
        <img class="beitrag__bild" src={beitrag.bild} alt={beitrag.bild_alt || ''} width="900" height="500" transition:name={`beitrag-bild-${beitrag.id}`} />
      )}

      {/* Kein eigener Übergangsname: gehört zur Karte und wächst mit ihr */}
      <div class="beitrag__rest">
      <div class="beitrag__inhalt redaktionstext" set:html={beitrag.inhalt} />

      {anhaenge.length > 0 && (
        <section class="anhaenge">
          <h2 class="anhaenge__titel ohne-verlauf">Zum Herunterladen</h2>
          <ul class="anhaenge__liste">
            {anhaenge.map((d) => (
              <li>
                <a class="anhang" href={d.datei} download>
                  <span class="anhang__name">{d.titel}</span>
                  {d.beschreibung && <span class="anhang__text">{d.beschreibung}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      </div>
    </article>
  </main>

  <Fussbereich />
</Basis>

<style>
  .beitragsseite {
    position: relative;
    z-index: 40;
    padding-block: 140px 100px;
    background: var(--farbe-flaeche);
  }

  .beitrag {
    position: relative;
    /* Breiter als eine Leistung: Hier trägt ein Bild die Seite, und die
       Karte soll im Morph deutlich wachsen (Wunsch von Florian). */
    width: min(100% - 2 * var(--abstand-m), 58rem);
    margin-inline: auto;
  }

  .beitrag {
    /* Gruppe für den Übergang, siehe styles/uebergaenge.css */
    view-transition-class: karte;
  }

  /* Schließen-Kreuz: klebt beim Scrollen unter der Leiste, dann
     zeichnet sich ein Kreis darum. Dreht sich beim Zeigen wie das
     Kreuz der Hinweis-Blase (Abläufe a-34 / a-35).
     Das Aussehen steht in styles/global.css, hier nur die Lage. */
  .schliessen-wache { display: block; height: 0; }

  .schliessen-halter {
    position: sticky;
    top: 96px;
    z-index: 5;
    height: 0;
  }

  .schliessen {
    position: absolute;
    top: 0;
    right: 0;
  }

  .schliessen-halter[data-klebt] .schliessen {
    background-color: rgb(255 255 255 / 85%);
    border-radius: var(--radius-rund);
  }

  .schliessen-halter[data-klebt] .schliessen__kreis { stroke-dashoffset: 0; }

  .beitrag__zurueck {
    display: inline-block;
    margin-bottom: var(--abstand-m);
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
    text-decoration: none;
  }

  .beitrag__zurueck:hover,
  .beitrag__zurueck:focus-visible { color: var(--farbe-primaer); }

  .beitrag__datum {
    display: block;
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
  }

  .beitrag__titel { margin-bottom: var(--abstand-m); }

  .beitrag__bild {
    width: 100%;
    height: auto;
    margin-bottom: var(--abstand-m);
    view-transition-class: bild;
  }

  /* Vom Redaktionssystem geliefertes HTML */
  .beitrag__inhalt :global(p) { margin-bottom: var(--abstand-s); }
  .beitrag__inhalt :global(ul),
  .beitrag__inhalt :global(ol) { margin: 0 0 var(--abstand-m); padding-left: var(--abstand-m); }
  .beitrag__inhalt :global(li) { margin-bottom: var(--abstand-3xs); }

  .anhaenge {
    margin-top: var(--abstand-xl);
    padding-top: var(--abstand-m);
    border-top: 1px solid var(--farbe-linie);
  }

  .anhaenge__titel { font-size: var(--text-m); color: var(--farbe-primaer); }

  .anhaenge__liste { list-style: none; margin: 0; padding: 0; }

  .anhang {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-3xs);
    padding: var(--abstand-xs);
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius-s);
    color: inherit;
    text-decoration: none;
  }

  .anhang:hover,
  .anhang:focus-visible { border-color: var(--farbe-primaer); }

  .anhang__name { font-weight: var(--gewicht-halbfett); color: var(--farbe-primaer); }
  .anhang__text { font-size: var(--text-s); color: var(--farbe-text-gedeckt); }
</style>
