---
/**
 * Startseite — One-Pager.
 *
 * Reihenfolge:
 *
 *   Einstieg (Begrüßung + Bilderband + Sprechstunden, fährt gemeinsam
 *   über das Logo herein)  →  freie Abschnitte  →  Leistungen  →
 *   Neuigkeiten  →  Team  →  Stellen  →  Kontakt  →  Fuß
 *
 * Begrüßung und Bilderband stehen seit dem 17. September 2026 IN der
 * Sprechstunden-Karte (Oeffnungszeiten.astro). Vorher waren sie eigene
 * Abschnitte im Fluss — und weil die Karte über das fest stehende Logo
 * fahren muss, stand sie zwangsläufig davor. Jetzt fährt alles
 * gemeinsam herein und die Reihenfolge stimmt.
 */
import Startbereich from '../components/Startbereich.astro';
import Oeffnungszeiten from '../components/Oeffnungszeiten.astro';
import Abschnitte from '../components/Abschnitte.astro';
import Stellen from '../components/Stellen.astro';
import Neuigkeiten from '../components/Neuigkeiten.astro';
import Team from '../components/Team.astro';
import Kontakt from '../components/Kontakt.astro';
import Fussbereich from '../components/Fussbereich.astro';
import Navigation from '../components/Navigation.astro';
import Basis from '../layouts/Basis.astro';
import Hinweis from '../components/Hinweis.astro';
import LeistungKachel from '../components/LeistungKachel.astro';
import leistungen from '../content/leistungen.json';
import startseite from '../content/startseite.json';

const aktiv = leistungen.eintraege.filter((e) => e.aktiv).sort((a, b) => a.position - b.position);

/* Die Gruppen kommen aus den Kategorien der Inhaltsdatei, nicht aus
   fest verdrahteten Namen — legt die Praxis dort eine an, erscheint
   sie hier von selbst. Leere Kategorien bleiben aus. */
const gruppen = (leistungen.kategorien ?? [])
  .filter((k) => k.aktiv)
  .sort((a, b) => a.position - b.position)
  .map((k) => ({ ...k, eintraege: aktiv.filter((e) => e.kategorie === k.id) }))
  .filter((k) => k.eintraege.length > 0);
---

<Basis>
  {/* Das Logo zeichnet sich beim ersten Aufbau ein — seine Lottie-Datei
      soll da sein, sobald das Skript sie anfordert. `crossorigin`, weil
      lottie-web sie per XHR im CORS-Modus holt; ohne das Attribut träfe
      das Vorladen nicht. */}
  <link slot="head" rel="preload" href="/lottie/logo.json" as="fetch" crossorigin />

  <Hinweis />

  {/*
    Reihenfolge wie in der Vorlage: `.oz` steht VOR dem Logobereich im
    Seitenfluss und beginnt damit am Dokumentanfang. Nur so fährt die
    Karte über das fest stehende Logo hinweg herein. Der Logobereich
    selbst liegt fest im Fenster und nimmt keinen Platz im Fluss ein;
    im Fluss folgt nach den 350vh des Einstiegs nur noch der Inhalt.
  */}
  <Oeffnungszeiten />

  <Startbereich />

  <Navigation />

  <main id="inhalt" class="seiteninhalt">
    <Abschnitte />

    <section id="leistungen" class="leistungen bereich bereich--ohne-oben">
      <div class="bereich__inhalt">
        <div class="kicker" data-rein>Behandlung</div>
        <h2 class="bereich__titel" data-rein>{startseite.leistungen.titel}</h2>
        {startseite.leistungen.text && (
          <p class="bereich__einleitung" data-rein>{startseite.leistungen.text}</p>
        )}

        {gruppen.map((g) => (
          <div class="gruppe">
            <h3 class="gruppenzeile" id={`leistungen-${g.id}`} data-rein>
              {g.icon && <img class="gruppenzeile__symbol" src={g.icon} alt="" width="34" height="34" />}
              <span class="gruppenzeile__text">{g.titel}</span>
              <span class="gruppenzeile__linie" aria-hidden="true"></span>
            </h3>

            {g.beschreibung && (
              <div class="gruppe__text redaktionstext" data-rein set:html={g.beschreibung} />
            )}

            <div class="kacheln">
              {g.eintraege.map((l) => <LeistungKachel {...l} />)}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Neuigkeiten />
  <Team />
  <Stellen />
  <Kontakt />
  <Fussbereich />
</Basis>

<style>
  /* Handys: Steht das Bilderband vor den Leistungen (keine aktiven
     freien Abschnitte), braucht der Abschnitt seinen oberen Abstand
     wieder — er ist sonst „ohne oben", weil die Abschnitte davor ihn
     mitbringen. */
  :global(.ozband[data-nach-karte]) + .leistungen { padding-top: var(--abstand-abschnitt); }

  /* Der Inhalt schiebt sich über den fixierten Startbereich */
  .seiteninhalt {
    position: relative;
    z-index: 5;
    background: var(--farbe-flaeche);
  }

  .gruppe { margin-top: var(--abstand-gruppe); }

  /* Die Gruppenzeile ist zugleich Überschrift — ihre Gestaltung steht
     als `.gruppenzeile` in styles/global.css, weil das Team dasselbe
     Muster verwendet. */
  .gruppe > .gruppenzeile { margin: 0; }

  /* Erklärtext zwischen Gruppenzeile und Kacheln — aus der Redaktion
     (leistungen.json → kategorien → beschreibung).

     Breiter als die übliche Absatzbreite (34 rem): Der Text steht hier
     unter einer Zeile, die über die ganze Inhaltsbreite läuft, und
     wirkte daneben nach links gestaucht (Florian, 18. September 2026).
     48 rem sind bei 16 px rund 90 Zeichen je Zeile — das Ende dessen,
     was sich noch angenehm liest; weiter zu gehen ginge auf Kosten der
     Lesbarkeit. */
  .gruppe__text {
    max-width: min(48rem, 100%);
    margin-top: 20px;
  }

  .gruppe__text :global(p) {
    max-width: none;
    margin-bottom: var(--abstand-2xs);
    color: var(--farbe-text-gedeckt);
    font-size: 16px;
    line-height: 1.65;
  }

  .gruppe__text :global(p:last-child) { margin-bottom: 0; }

  .kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 22px;
    margin-top: 28px;
  }
</style>
