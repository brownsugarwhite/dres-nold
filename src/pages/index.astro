---
/**
 * Startseite — One-Pager.
 *
 * STAND: Prototyp. Die Gestaltung folgt in Phase 2 der Webflow-Vorlage;
 * hier geht es zunächst darum, den Seitenwechsel zu den Leistungen zu
 * zeigen. Siehe CLAUDE.md.
 */
import Startbereich from '../components/Startbereich.astro';
import Oeffnungszeiten from '../components/Oeffnungszeiten.astro';
import Willkommen from '../components/Willkommen.astro';
import Galerie from '../components/Galerie.astro';
import Abschnitte from '../components/Abschnitte.astro';
import Stellen from '../components/Stellen.astro';
import Neuigkeiten from '../components/Neuigkeiten.astro';
import Team from '../components/Team.astro';
import Kontakt from '../components/Kontakt.astro';
import Fussbereich from '../components/Fussbereich.astro';
import Navigation from '../components/Navigation.astro';
import Basis from '../layouts/Basis.astro';
import Hinweis from '../components/Hinweis.astro';
import LeistungKachel from '../components/LeistungKachel.astro';
import seite from '../content/seite.json';
import leistungen from '../content/leistungen.json';
import team from '../content/team.json';

const { praxis } = seite;

const aktiv = leistungen.eintraege.filter((e) => e.aktiv).sort((a, b) => a.position - b.position);

/* Die Gruppen kommen aus den Kategorien der Inhaltsdatei, nicht aus
   fest verdrahteten Namen — legt die Praxis dort eine an, erscheint
   sie hier von selbst. Leere Kategorien bleiben aus. */
const gruppen = (leistungen.kategorien ?? [])
  .filter((k) => k.aktiv)
  .sort((a, b) => a.position - b.position)
  .map((k) => ({ ...k, eintraege: aktiv.filter((e) => e.kategorie === k.id) }))
  .filter((k) => k.eintraege.length > 0);

const personen = team.eintraege.filter((e) => e.aktiv).sort((a, b) => a.position - b.position);
const aerzte = personen.filter((e) => e.gruppe === 'aerzte');
---

<Basis>
  <Hinweis />

  {/*
    Reihenfolge wie in der Vorlage: `.oz` steht VOR dem Logobereich im
    Seitenfluss und beginnt damit am Dokumentanfang. Nur so fährt die
    Blase über das fest stehende Logo hinweg herein. Der Logobereich
    selbst liegt fest im Fenster und nimmt keinen Platz im Fluss ein;
    im Fluss folgt nach den 350vh der Öffnungszeiten nur noch sein
    weißer Startraum (130vh).
  */}
  <Oeffnungszeiten />

  <Startbereich />

  <Navigation />

  <main id="inhalt" class="seiteninhalt">
    {/* Auf Handys stehen die Sprechstunden fest am Anfang des Inhalts;
        die Blase oben ist dort ausgeblendet (Oeffnungszeiten.astro) */}
    <Oeffnungszeiten statisch />
    <Willkommen />
    <Galerie />
    <Abschnitte />


    <section id="leistungen" class="inhalt abschnitt">
      <h2>Unsere Leistungen</h2>
      <p class="abschnitt__einleitung">
        Klicken Sie auf eine Leistung, um mehr zu erfahren.
      </p>

      {gruppen.map((g) => (
        <>
          <h3 class="gruppe" id={`leistungen-${g.id}`}>{g.titel}</h3>
          <div class="kacheln">
            {g.eintraege.map((l) => <LeistungKachel {...l} />)}
          </div>
        </>
      ))}
    </section>



  </main>

  <Neuigkeiten />
  <Team />
  <Stellen />
  <Kontakt />
  <Fussbereich />
</Basis>

<style>
  /* Der Inhalt schiebt sich über den fixierten Startbereich — auch
     über das Logo (Ebene 10): Auf Handys ist der Startraum nur eine
     Fensterhöhe lang, das Logo noch da, wenn der Inhalt hereinkommt.
     Er deckt es dann wie ein Blatt ab. */
  .seiteninhalt {
    position: relative;
    z-index: 15;
    background: var(--farbe-flaeche);
  }



  .abschnitt {
    padding-block: var(--abstand-l);
  }

  .abschnitt__einleitung {
    max-width: none;
    margin-bottom: var(--abstand-l);
    color: var(--farbe-text-gedeckt);
    text-align: center;
  }

  .gruppe {
    margin-top: var(--abstand-l);
    font-size: var(--text-m);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--farbe-text-gedeckt);
    text-align: center;
  }

  /* Kacheln: mittig gesetzt. Bleiben in der letzten Reihe weniger übrig,
     werden sie etwas breiter und stehen zentriert — bis zu einer
     Höchstbreite, damit eine einzelne Kachel nicht die Zeile füllt. */
  .kacheln {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--abstand-s);
    margin-bottom: var(--abstand-m);
  }

  .kacheln > :global(.kachel) {
    flex: 1 1 15rem;
    max-width: 24rem;
  }

  .aerzte {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--abstand-m);
    max-width: 46rem;
  }

  .arzt {
    margin: 0;
  }

  .arzt img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-m);
    margin-bottom: var(--abstand-2xs);
  }

  .arzt figcaption {
    display: flex;
    flex-direction: column;
    font-size: var(--text-s);
  }

  .arzt figcaption span {
    color: var(--farbe-text-gedeckt);
  }

  .notiz {
    margin-block: var(--abstand-xl);
    padding: var(--abstand-s);
    background: var(--farbe-flaeche-gedeckt);
    border-left: 4px solid var(--farbe-primaer-hell);
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
  }
</style>
