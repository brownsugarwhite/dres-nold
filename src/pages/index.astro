---
/**
 * Startseite — One-Pager.
 *
 * STAND: Prototyp. Die Gestaltung folgt in Phase 2 der Webflow-Vorlage;
 * hier geht es zunächst darum, den Seitenwechsel zu den Leistungen zu
 * zeigen. Siehe CLAUDE.md.
 */
import Startbereich from '../components/Startbereich.astro';
import Oeffnungszeiten from '../components/Oeffnungszeiten.astro';
import Willkommen from '../components/Willkommen.astro';
import Galerie from '../components/Galerie.astro';
import Neuigkeiten from '../components/Neuigkeiten.astro';
import Team from '../components/Team.astro';
import Kontakt from '../components/Kontakt.astro';
import Fussbereich from '../components/Fussbereich.astro';
import Navigation from '../components/Navigation.astro';
import Basis from '../layouts/Basis.astro';
import Hinweis from '../components/Hinweis.astro';
import LeistungKachel from '../components/LeistungKachel.astro';
import seite from '../content/seite.json';
import oz from '../content/oeffnungszeiten.json';
import leistungen from '../content/leistungen.json';
import team from '../content/team.json';

const { praxis } = seite;
const listen = [oz.zahnaerztlich, oz.kieferorthopaedisch, oz.telefonisch];

const aktiv = leistungen.eintraege.filter((e) => e.aktiv).sort((a, b) => a.position - b.position);
const zahnmedizin = aktiv.filter((e) => e.kategorie === 'zahnmedizin');
const kieferorthopaedie = aktiv.filter((e) => e.kategorie === 'kieferorthopaedie');

const personen = team.eintraege.filter((e) => e.aktiv).sort((a, b) => a.position - b.position);
const aerzte = personen.filter((e) => e.gruppe === 'aerzte');
---

<Basis>
  <Hinweis />

  <Startbereich />

  <Navigation />

  <Oeffnungszeiten />

  <main id="inhalt" class="seiteninhalt">
    <Willkommen />
    <Galerie />


    <section id="leistungen" class="inhalt abschnitt">
      <h2>Unsere Leistungen</h2>
      <p class="abschnitt__einleitung">
        Klicken Sie auf eine Leistung, um mehr zu erfahren.
      </p>

      <h3 class="gruppe">Zahnmedizin</h3>
      <div class="kacheln">
        {zahnmedizin.map((l) => <LeistungKachel {...l} />)}
      </div>

      <h3 class="gruppe">Kieferorthopädie</h3>
      <div class="kacheln">
        {kieferorthopaedie.map((l) => <LeistungKachel {...l} />)}
      </div>
    </section>



    <section class="inhalt abschnitt" hidden>
      <h2>Öffnungszeiten</h2>
      {listen.map((liste) => (
        <div class="zeiten-block">
          <h3 class="gruppe">{liste.titel}</h3>
          <dl class="zeiten">
            {liste.zeilen.map((z) => (
              <>
                <dt>{z.tag}</dt>
                <dd>{z.zeiten}</dd>
              </>
            ))}
          </dl>
        </div>
      ))}
    </section>

  </main>

  <Neuigkeiten />
  <Team />
  <Kontakt />
  <Fussbereich />
</Basis>

<style>
  /* Der Inhalt schiebt sich über den fixierten Startbereich */
  .seiteninhalt {
    position: relative;
    z-index: 5;
    background: var(--farbe-flaeche);
  }



  .abschnitt {
    padding-block: var(--abstand-l);
  }

  .abschnitt__einleitung {
    color: var(--farbe-text-gedeckt);
    margin-bottom: var(--abstand-m);
  }

  .gruppe {
    margin-top: var(--abstand-m);
    font-size: var(--text-m);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--farbe-text-gedeckt);
  }

  .kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--abstand-s);
    margin-bottom: var(--abstand-m);
  }

  .aerzte {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--abstand-m);
    max-width: 46rem;
  }

  .arzt {
    margin: 0;
  }

  .arzt img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-m);
    margin-bottom: var(--abstand-2xs);
  }

  .arzt figcaption {
    display: flex;
    flex-direction: column;
    font-size: var(--text-s);
  }

  .arzt figcaption span {
    color: var(--farbe-text-gedeckt);
  }

  .zeiten-block {
    margin-bottom: var(--abstand-m);
  }

  .zeiten {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--abstand-3xs) var(--abstand-m);
    margin: var(--abstand-2xs) 0 0;
  }

  .zeiten dt {
    font-weight: var(--gewicht-halbfett);
  }

  .zeiten dd {
    margin: 0;
  }

  .notiz {
    margin-block: var(--abstand-xl);
    padding: var(--abstand-s);
    background: var(--farbe-flaeche-gedeckt);
    border-left: 4px solid var(--farbe-primaer-hell);
    color: var(--farbe-text-gedeckt);
    font-size: var(--text-s);
  }
</style>
