---
/**
 * Startseite — One-Pager.
 *
 * Reihenfolge (Florian, Oktober 2026):
 *
 *   Logo  →  Sprechstunden-Karte  →  die Blöcke aus dem Seitenplan  →  Fuß
 *
 * Logo und Karte stehen fest oben: Die Karte fährt über das fest
 * stehende Logo herein (docs/entscheidungen.md, „Der Einstieg ist eine
 * Karte"). Alles dazwischen — Begrüßung, Bilderband, Leistungen, eigene
 * Bereiche, Team, Kontakt … — steht in der Reihenfolge von
 * content/seitenaufbau.json, die die Praxis in der Redaktion verschiebt.
 * Das Menü folgt derselben Reihenfolge (lib/aufbau.ts, `menueBauen`).
 *
 * Alle Blöcke stehen in `main` und tragen ihren Abstand unten — so passt
 * jeder an jede Stelle, ohne dass ein Nachbar etwas über ihn wissen muss.
 */
import Startbereich from '../components/Startbereich.astro';
import Willkommen from '../components/Willkommen.astro';
import Galerie from '../components/Galerie.astro';
import Oeffnungszeiten from '../components/Oeffnungszeiten.astro';
import Leistungen from '../components/Leistungen.astro';
import Bereich from '../components/Bereich.astro';
import Stellen from '../components/Stellen.astro';
import Team from '../components/Team.astro';
import Kontakt from '../components/Kontakt.astro';
import Fussbereich from '../components/Fussbereich.astro';
import Navigation from '../components/Navigation.astro';
import Basis from '../layouts/Basis.astro';
import Hinweis from '../components/Hinweis.astro';
import { bloecke } from '../content/inhalte';

/* Was auf der Startseite steht: reine Menüpunkte und Seiten ohne
   Ankündigung halten nur ihren Platz im Menü */
const sichtbar = bloecke.filter((b) => b.aufStartseite);

/* Ein unsichtbares h1, wenn die Begrüßung nicht vorn steht: Ihr
   „Willkommen in unserer Praxis" ist sonst das h1 der Seite (WCAG:
   Überschriften ohne Sprung). */
const willkommenVorn = sichtbar[0]?.block.art === 'willkommen';
---

<Basis>
  {/* Das Logo zeichnet sich beim ersten Aufbau ein — seine Lottie-Datei
      soll da sein, sobald das Skript sie anfordert. `crossorigin`, weil
      lottie-web sie per XHR im CORS-Modus holt; ohne das Attribut träfe
      das Vorladen nicht. */}
  <link slot="head" rel="preload" href="/lottie/logo.json" as="fetch" crossorigin />

  <Hinweis />

  {/*
    Reihenfolge wie in der Vorlage: `.oz` steht VOR dem Logobereich im
    Seitenfluss und beginnt damit am Dokumentanfang. Nur so fährt die
    Karte über das fest stehende Logo hinweg herein. Der Logobereich
    selbst liegt fest im Fenster und nimmt keinen Platz im Fluss ein;
    im Fluss folgt nach dem Einstieg nur noch der Inhalt.
  */}
  <Oeffnungszeiten />

  <Startbereich />

  <Navigation />

  <main id="inhalt" class="seiteninhalt">
    {!willkommenVorn && <h1 class="nur-vorleser">Zahnarztpraxis und Kieferorthopädie Dres. Nold</h1>}

    {/* Jeder Block in einer schlichten Hülle — sie trägt die Regeln, die
        von der Stelle im Plan abhängen (erster Block, Abstand oben),
        damit die Blöcke selbst davon nichts wissen müssen */}
    {sichtbar.map(({ block, bereich }) => (
      <div class="startblock" data-block={block.art}>
        {block.art === 'willkommen' && <Willkommen ueberschrift={willkommenVorn ? 'h1' : 'h2'} />}
        {block.art === 'galerie' && <div class="ozband"><Galerie /></div>}
        {block.art === 'leistungen' && <Leistungen />}
        {block.art === 'team' && <Team />}
        {block.art === 'stellen' && <Stellen />}
        {block.art === 'kontakt' && <Kontakt />}
        {block.art === 'bereich' && bereich && <Bereich bereich={bereich} />}
      </div>
    ))}
  </main>

  <Fussbereich />
</Basis>

<style>
  /*
    Abstände zwischen den Blöcken
    ------------------------------------------------------------------
    Jeder Block trägt seinen Abstand UNTEN, keiner oben — so ergibt
    jede Reihenfolge denselben Rhythmus (Oktober 2026). Vorher hingen
    die Abstände an den Nachbarn (`bereich--ohne-oben`, „Band vor
    Leistungen"), weil die Folge fest war.

    Bänder über die volle Breite (Bilderband, Team, Kontakt) beginnen
    mit ihrer Kante und bringen ihr Innenmaß selbst mit.
  */
  .startblock > :global(.bereich) { padding-top: 0; }

  /* Die Begrüßung hat ihre eigene Luft oben — mitten auf der Seite
     reicht der Abstand des Blocks davor */
  .startblock:not(:first-of-type) > :global(.willkommen) { padding-top: 0; }

  /*
    Der erste Block nach der Sprechstunden-Karte
    ------------------------------------------------------------------
    Oben so viel Luft, dass der Zipfel der Karte in Ruhelage über
    leerem Weiß steht und der Block noch unter der Symbolleiste liegt —
    die fährt beim Schnalz weg und gibt ihn frei. Bis Oktober 2026 stand
    das in Willkommen.astro, weil die Begrüßung immer zuerst kam. Seit
    der Sprechstunden-Knopf vorn im Menü steht, zeigt der Zipfel links
    in den Bereich, wo Überschriften beginnen — der Freiraum ist damit
    tragend. Als Außenabstand, damit die Sprungmarke den Block wie
    überall unter die Kopfleiste setzt. `--block-oben` ist der eigene
    Innenabstand oben, den ein Block mitbringt (die Begrüßung).
  */
  .startblock:first-of-type > :global(*) {
    margin-top: calc(var(--zipfel-laenge, 154px) + var(--abstand-s) - var(--block-oben, 0px));
  }

  /* Das Bilderband läuft über die volle Fensterbreite. `--fensterbreite`
     setzt Oeffnungszeiten.astro aus `clientWidth` — `100vw` ginge nicht,
     weil es die Rollleiste mitzählt und die Seite dann waagerecht
     überliefe. Ohne JavaScript bleibt es bei der Inhaltsbreite. */
  .ozband {
    width: var(--fensterbreite, 100%);
    margin-left: 50%;
    transform: translateX(-50%);
    /* Wie jeder Block trägt das Band seinen Abstand unten */
    padding-bottom: var(--abstand-abschnitt);
  }

  /* Der Inhalt schiebt sich über den fixierten Startbereich. Ohne
     eigenen z-index — er machte den Inhalt zu einem Stapel, in dem
     nichts über die Randverläufe der Seite hinauskam; die klebende
     Ansprechperson der Stellenliste muss das (27. September 2026).
     Die Reihenfolge bleibt dieselbe: positioniert, später im Baum, also
     über allem Unpositionierten und unter allem mit eigenem z-index. */
  .seiteninhalt {
    position: relative;
    background: var(--farbe-flaeche);
  }
</style>
