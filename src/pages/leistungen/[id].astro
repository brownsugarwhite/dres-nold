---
/**
 * Einzelseite einer Leistung.
 *
 * Eine echte, eigenständige Seite unter /leistungen/<id>/ — von Google
 * auffindbar, teilbar, druckbar und auch ohne JavaScript vollständig.
 *
 * Beim Aufruf von der Startseite morpht die zugehörige Kachel in diese
 * Seite hinein: möglich durch die gemeinsamen `transition:name`
 * (Hülle, Symbol, Titel). Der Fließtext hat bewusst KEINEN eigenen
 * Namen — er gehört zur Karte und wächst mit ihr.
 * Schließen-Kreuz, „Alle Leistungen" und Escape gehen im Verlauf
 * zurück (scripts/uebergaenge.ts).
 */
import Navigation from '../../components/Navigation.astro';
import Fussbereich from '../../components/Fussbereich.astro';
import Basis from '../../layouts/Basis.astro';
import Knopfzeile from '../../components/Knopfzeile.astro';
import daten from '../../content/leistungen.json';
import seite from '../../content/seite.json';

export function getStaticPaths() {
  return daten.eintraege
    .filter((e) => e.aktiv)
    .map((e) => ({ params: { id: e.id }, props: { leistung: e } }));
}

const { leistung } = Astro.props;
/* Die Knopfzeile ist in der Redaktion freiwillig — bestehende Einträge
   haben die Felder noch nicht (content/schema.ts lässt sie offen). */
const knoepfe = leistung as typeof leistung & {
  knoepfe_text?: string; link_text?: string; link_ziel?: string; pdf_text?: string; pdf_datei?: string;
};
const alle = daten.eintraege.filter((e) => e.aktiv);
const i = alle.findIndex((e) => e.id === leistung.id);
const vorherige = alle[i - 1];
const naechste = alle[i + 1];
---

<Basis
  titel={`${leistung.titel} – ${seite.praxis.name}`}
  beschreibung={leistung.kurz}
>
  <Navigation />

  <main id="inhalt" class="leistungsseite">
    <article class="leistung karte" transition:name={`leistung-${leistung.id}`}>
      {/* Das Schließen-Kreuz klebt beim Scrollen oben; die „Wache" meldet,
          wann es so weit ist (scripts/uebergaenge.ts) */}
      <span class="schliessen-wache" data-schliessen-wache aria-hidden="true"></span>
      <div class="schliessen-halter" data-schliessen-halter>
        <a class="schliessen" href="/" data-zurueck aria-label="Leistung schließen">
          <svg class="schliessen__kreis" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" /></svg>
        </a>
      </div>
      <header class="leistung__kopf">
        <a class="leistung__zurueck" href="/" data-zurueck>
          <span aria-hidden="true">←</span> Alle Leistungen
        </a>
        <img class="leistung__icon" src={leistung.icon} alt="" width="96" height="96" transition:name={`leistung-symbol-${leistung.id}`} />
        <h1 class="leistung__titel" transition:name={`leistung-titel-${leistung.id}`}>{leistung.titel}</h1>
      </header>

      {/* Kein eigener Übergangsname: So steckt der Fließtext in der
          Momentaufnahme der Karte und wächst mit ihr, statt separat
          hereinzugleiten (styles/uebergaenge.css). */}
      <div class="leistung__rest">
        <div class="leistung__text redaktionstext" set:html={leistung.inhalt} />

        {/* Satz und Knöpfe aus der Redaktion — ohne eigenen Übergangsnamen,
            sie gehören zur Karte und wachsen mit ihr */}
        <Knopfzeile satz={knoepfe.knoepfe_text} linkText={knoepfe.link_text} linkZiel={knoepfe.link_ziel} pdfText={knoepfe.pdf_text} pdfDatei={knoepfe.pdf_datei} />

        <nav class="leistung__nachbarn" aria-label="Weitere Leistungen">
          {vorherige && (
            <a class="nachbar nachbar--zurueck" href={`/leistungen/${vorherige.id}/`} data-blaettern="zurueck">
              <span class="nachbar__label">Vorherige</span>
              <span class="nachbar__titel">{vorherige.titel}</span>
            </a>
          )}
          {naechste && (
            <a class="nachbar nachbar--vor" href={`/leistungen/${naechste.id}/`} data-blaettern="vor">
              <span class="nachbar__label">Nächste</span>
              <span class="nachbar__titel">{naechste.titel}</span>
            </a>
          )}
        </nav>
      </div>
    </article>
  </main>

  <Fussbereich />
</Basis>

<style>
  /* Wie die Beitragsseite: Platz für die feste Leiste oben */
  .leistungsseite {
    position: relative;
    z-index: 40;
    padding-block: 140px 100px;
    background: var(--farbe-flaeche);
  }

  .leistung {
    position: relative;
    width: min(100% - 2 * var(--abstand-m), 46rem);
    margin-inline: auto;
    background: var(--farbe-flaeche);
  }

  .leistung__zurueck {
    display: inline-block;
    margin-bottom: var(--abstand-m);
    font-size: var(--text-s);
    color: var(--farbe-text-gedeckt);
    text-decoration: none;
  }

  .leistung__zurueck:hover,
  .leistung__zurueck:focus-visible {
    color: var(--farbe-primaer);
  }

  .leistung {
    /* Gruppe für den Übergang, siehe styles/uebergaenge.css */
    view-transition-class: karte;
  }

  /* Schließen-Kreuz: Aussehen steht in styles/global.css, hier nur die
     Lage. Es klebt beim Scrollen unter der Leiste — und erst dann
     zeichnet sich der Kreis darum ein. */
  .schliessen-wache { display: block; height: 0; }

  .schliessen-halter {
    position: sticky;
    top: 96px;
    z-index: 5;
    height: 0;
  }

  .schliessen {
    position: absolute;
    top: 0;
    right: 0;
  }

  /* Grund und Kreis beim Kleben: geteilte Regeln in styles/global.css */

  .leistung__icon {
    width: 5rem;
    height: 5rem;
    object-fit: contain;
    margin-bottom: var(--abstand-s);
    /* Gruppe für den Übergang, siehe styles/uebergaenge.css */
    view-transition-class: symbol;
  }

  .leistung__titel {
    margin-bottom: var(--abstand-l);
    view-transition-class: titel;
  }

  /* Vom Redaktionssystem geliefertes HTML */
  .leistung__text :global(p) {
    margin-bottom: var(--abstand-s);
  }

  .leistung__text :global(ul) {
    margin: 0 0 var(--abstand-m);
    padding-left: var(--abstand-m);
  }

  .leistung__text :global(li) {
    margin-bottom: var(--abstand-3xs);
  }

  .leistung__nachbarn {
    display: flex;
    gap: var(--abstand-s);
    justify-content: space-between;
    margin-top: var(--abstand-xl);
    padding-top: var(--abstand-m);
    border-top: 1px solid var(--farbe-linie);
  }

  .nachbar {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-3xs);
    max-width: 45%;
    text-decoration: none;
    color: var(--farbe-text);
  }

  .nachbar--vor {
    margin-left: auto;
    text-align: right;
  }

  .nachbar__label {
    font-size: var(--text-xs);
    color: var(--farbe-text-gedeckt);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nachbar__titel {
    font-weight: var(--gewicht-halbfett);
    color: var(--farbe-primaer);
  }

  @media (max-width: 34rem) {
    .leistung__nachbarn { flex-direction: column; }
    .nachbar { max-width: 100%; }
    .nachbar--vor { margin-left: 0; text-align: left; }
  }

</style>
