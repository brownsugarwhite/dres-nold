---
/**
 * Einzelseite einer Leistung.
 *
 * Eine echte, eigenständige Seite unter /leistungen/<id>/ — von Google
 * auffindbar, teilbar, druckbar und auch ohne JavaScript vollständig.
 *
 * Beim Aufruf von der Startseite morpht die zugehörige Kachel in diese
 * Seite hinein: möglich durch den gemeinsamen `transition:name`.
 */
import Basis from '../../layouts/Basis.astro';
import daten from '../../content/leistungen.json';
import seite from '../../content/seite.json';

export function getStaticPaths() {
  return daten.eintraege
    .filter((e) => e.aktiv)
    .map((e) => ({ params: { id: e.id }, props: { leistung: e } }));
}

const { leistung } = Astro.props;
const alle = daten.eintraege.filter((e) => e.aktiv);
const i = alle.findIndex((e) => e.id === leistung.id);
const vorherige = alle[i - 1];
const naechste = alle[i + 1];
---

<Basis
  titel={`${leistung.titel} – ${seite.praxis.name}`}
  beschreibung={leistung.kurz}
>
  <article class="leistung" transition:name={`leistung-${leistung.id}`}>
    <header class="leistung__kopf">
      <a class="leistung__zurueck" href="/#leistungen">
        <span aria-hidden="true">←</span> Alle Leistungen
      </a>
      <img class="leistung__icon" src={leistung.icon} alt="" width="96" height="96" />
      <h1 class="leistung__titel">{leistung.titel}</h1>
    </header>

    <div class="leistung__text" set:html={leistung.inhalt} />

    <nav class="leistung__nachbarn" aria-label="Weitere Leistungen">
      {vorherige && (
        <a class="nachbar nachbar--zurueck" href={`/leistungen/${vorherige.id}/`}>
          <span class="nachbar__label">Vorherige</span>
          <span class="nachbar__titel">{vorherige.titel}</span>
        </a>
      )}
      {naechste && (
        <a class="nachbar nachbar--vor" href={`/leistungen/${naechste.id}/`}>
          <span class="nachbar__label">Nächste</span>
          <span class="nachbar__titel">{naechste.titel}</span>
        </a>
      )}
    </nav>
  </article>
</Basis>

<style>
  .leistung {
    width: min(100% - 2 * var(--abstand-m), 46rem);
    margin-inline: auto;
    padding-block: var(--abstand-l) var(--abstand-2xl);
    background: var(--farbe-flaeche);
  }

  .leistung__zurueck {
    display: inline-block;
    margin-bottom: var(--abstand-m);
    font-size: var(--text-s);
    color: var(--farbe-text-gedeckt);
    text-decoration: none;
  }

  .leistung__zurueck:hover,
  .leistung__zurueck:focus-visible {
    color: var(--farbe-primaer);
  }

  .leistung__icon {
    width: 5rem;
    height: 5rem;
    object-fit: contain;
    margin-bottom: var(--abstand-s);
  }

  .leistung__titel {
    margin-bottom: var(--abstand-l);
  }

  /* Vom Redaktionssystem geliefertes HTML */
  .leistung__text :global(p) {
    margin-bottom: var(--abstand-s);
  }

  .leistung__text :global(ul) {
    margin: 0 0 var(--abstand-m);
    padding-left: var(--abstand-m);
  }

  .leistung__text :global(li) {
    margin-bottom: var(--abstand-3xs);
  }

  .leistung__text :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--abstand-m);
  }

  .leistung__text :global(th),
  .leistung__text :global(td) {
    padding: var(--abstand-2xs) var(--abstand-xs);
    border-bottom: 1px solid var(--farbe-linie);
    text-align: left;
  }

  .leistung__nachbarn {
    display: flex;
    gap: var(--abstand-s);
    justify-content: space-between;
    margin-top: var(--abstand-xl);
    padding-top: var(--abstand-m);
    border-top: 1px solid var(--farbe-linie);
  }

  .nachbar {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-3xs);
    max-width: 45%;
    text-decoration: none;
    color: var(--farbe-text);
  }

  .nachbar--vor {
    margin-left: auto;
    text-align: right;
  }

  .nachbar__label {
    font-size: var(--text-xs);
    color: var(--farbe-text-gedeckt);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nachbar__titel {
    font-weight: var(--gewicht-halbfett);
    color: var(--farbe-primaer);
  }

  @media (max-width: 34rem) {
    .leistung__nachbarn { flex-direction: column; }
    .nachbar { max-width: 100%; }
    .nachbar--vor { margin-left: 0; text-align: left; }
  }
</style>
