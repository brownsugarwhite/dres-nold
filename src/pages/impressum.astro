---
/**
 * Impressum — Inhalt aus der bisherigen Webflow-Seite übernommen
 * (dort standen Impressum und Datenschutz auf einer Seite).
 */
import Textseite from '../layouts/Textseite.astro';
import seite from '../content/seite.json';
const { praxis } = seite;
---

<Textseite titel="Impressum" beschreibung="Impressum der Praxis Dres. Nold, Bietigheim">
  <h2>Angaben gemäß § 5 DDG</h2>
  <address>
    <strong>Praxis Dres. Nold</strong><br />
    {praxis.strasse}<br />
    {praxis.plz} {praxis.ort}<br />
    Telefon: <a href={`tel:${praxis.telefon.replace(/\s/g, '')}`}>{praxis.telefon}</a><br />
    Fax: {praxis.fax}<br />
    E-Mail: <a href={`mailto:${praxis.email}`}>{praxis.email}</a><br />
    www.dres-nold.de
  </address>

  <h2>Inhaltlich verantwortlich</h2>
  <p>Dr. Paul Nold<br />Dr. Inge Wilhelm-Nold<br />Dr. Sarah Buchgeister-Nold</p>

  <h2>Berufsbezeichnung</h2>
  <ul>
    <li>Dr. Paul Nold – Zahnarzt</li>
    <li>Dr. Sarah Buchgeister-Nold – Zahnärztin</li>
    <li>Dr. Inge Wilhelm-Nold – Fachzahnärztin für Kieferorthopädie</li>
  </ul>
  <p>Die Berufsbezeichnungen wurden in der Bundesrepublik Deutschland verliehen.</p>

  <h2>Berufsrechtliche Regelungen</h2>
  <ul>
    <li>Zahnheilkundegesetz</li>
    <li>Heilberufe-Kammergesetz</li>
    <li>Gebührenordnung für Zahnärzte</li>
    <li>Berufsordnung für Zahnärzte</li>
  </ul>
  <p>
    Die relevanten berufsrechtlichen Regelungen der Landeszahnärztekammer
    Baden-Württemberg finden Sie unter
    <a href="https://www.lzk-bw.de/patienten/gesetzliche-regelungen-zur-zahnaerztlichen-berufsausuebung" rel="noopener">www.lzk-bw.de</a>.
  </p>

  <h2>Zuständige Kassenzahnärztliche Vereinigung</h2>
  <p>
    Kassenzahnärztliche Vereinigung Baden-Württemberg<br />
    Bezirksdirektion Karlsruhe (Sitz Mannheim), Telefon 0621 380000<br />
    Hauptverwaltung Stuttgart, Telefon 0711 78770<br />
    <a href="https://www.kzvbw.de" rel="noopener">www.kzvbw.de</a>
  </p>

  <h2>Zuständige Aufsichtsbehörde</h2>
  <p>
    Landeszahnärztekammer Baden-Württemberg<br />
    Albstadtweg 9<br />
    70567 Stuttgart<br />
    <a href="https://www.lzk-bw.de" rel="noopener">www.lzk-bw.de</a>
  </p>

  <h2>Verbraucherstreitbeilegung</h2>
  <p>
    Im Hinblick auf eine Verpflichtung aus §§ 36, 37 VSBG informieren wir
    unsere Patienten darüber, dass unsere Praxis nicht zur Teilnahme an
    einem außergerichtlichen Streitbeilegungsverfahren vor einer
    Verbraucherschlichtungsstelle verpflichtet ist und auch an keinem
    außergerichtlichen Streitbeilegungsverfahren vor einer
    Verbraucherschlichtungsstelle teilnimmt. Bei Streitigkeiten aus dem
    Behandlungsverhältnis besteht die Möglichkeit, eine außergerichtliche
    Klärung vor der Gutachterkommission für Fragen zahnärztlicher Haftung
    durchzuführen. Die Gutachterkommission ist bei der für uns zuständigen
    Bezirkszahnärztekammer eingerichtet. Nähere Informationen finden Sie
    unter
    <a href="https://www.lzk-bw.de/patienten/gutachten/gutachterkommission-fuer-fragen-zahnaerztlicher-haftung/" rel="noopener">www.lzk-bw.de</a>.
  </p>

