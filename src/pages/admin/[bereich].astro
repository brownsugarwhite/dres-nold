---
/**
 * Bearbeitungsseite eines Bereichs. Das Formular baut src/admin/redaktion.ts
 * im Browser aus der Feldbeschreibung (src/admin/bereiche.ts) und dem
 * aktuellen Stand aus dem Repo (/api/inhalt).
 */
import Redaktion from '../../layouts/Redaktion.astro';
import { bereiche, reihenfolge } from '../../admin/bereiche';

export function getStaticPaths() {
  return reihenfolge.map((id) => ({ params: { bereich: id }, props: { id } }));
}

const { id } = Astro.props;
const definition = bereiche[id];
---

<Redaktion titel={definition.titel}>
  <h1>{definition.titel}</h1>
  <p class="redaktion__einleitung">{definition.beschreibung}</p>

  <form class="formular" data-redaktion data-bereich={id} novalidate>
    <p class="laden" data-laden>Aktueller Stand wird geladen …</p>
    <div data-felder></div>
  </form>

  <div class="speichern" data-speichern hidden>
    <button class="knopf knopf--haupt" type="button" data-speichern-knopf>Speichern und veröffentlichen</button>
    <a class="knopf knopf--leise" href="/admin/">Abbrechen</a>
    <p class="meldung" data-meldung role="status" aria-live="polite"></p>
  </div>

  <script type="application/json" data-definition set:html={JSON.stringify(definition.felder)} />
  <script>
    import '../../admin/redaktion';
  </script>
</Redaktion>
