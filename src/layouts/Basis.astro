---
/**
 * Seitenrahmen für alle Seiten.
 * Enthält die Metadaten, die Schrifteinbindung und die globalen Stile.
 */
import { ClientRouter } from 'astro:transitions';
import Einwilligung from '../components/Einwilligung.astro';
import seite from '../content/seite.json';
import { alleInhaltePruefen } from '../content/laden';
import '../styles/schrift.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/uebergaenge.css';

interface Props {
  titel?: string;
  beschreibung?: string;
}

/* Bricht den Build ab, wenn eine Inhaltsdatei nicht zum Schema passt */
alleInhaltePruefen();

const { titel = seite.titel, beschreibung = seite.beschreibung } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />

    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/source-sans-3-normal.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={Astro.url.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      Sanfte Seitenwechsel. Der Router lädt die Zielseite und tauscht den
      Inhalt im selben Dokument aus — dabei morphen die Leistungskacheln
      ins Vollbild.

      Unterstützt von Chrome 111+, Safari 18+ und Firefox 144+, also
      praktisch überall. In noch älteren Browsern wird schlicht die Seite
      gewechselt — ohne Übergang, aber ohne Fehler. Ohne JavaScript
      ebenfalls: normaler Seitenwechsel, alle Inhalte vollständig.
    */}
    <ClientRouter />

    {/* Keine externen Ressourcen — siehe CLAUDE.md. Schriften liegen unter public/fonts/. */}
  </head>
  <body>
    <a class="sprungmarke" href="#inhalt">Zum Inhalt springen</a>
    <slot />
    <Einwilligung />
    <script>
      import '../scripts/uebergaenge';
      import '../scripts/anker';
    </script>
  </body>
</html>
